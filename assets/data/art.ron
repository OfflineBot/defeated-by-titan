// art.ron — the registry. ONE line per asset, ONE line to swap it (init.md §7).
//
// The code never asks for a file, always for a logical name. Swapping an asset means:
// flip `use_blend` here — not touching Rust.
//
// use_blend: false ⇒ the placeholder path built from Bevy primitives. Both paths have to
// run at any time and carry the same size, hit zone and scale.
//
// STATUS: all placeholders. Machine A has no Blender, so for now only the
// tools/blend/*.py grow here (docs/environment.md, docs/models.md).
(
    models: {
        "vanguard":     (blend: "vanguard",     use_blend: false, scale: 1.0, attribution: None),
        "titan_husk":   (blend: "titan_husk",   use_blend: false, scale: 1.0, attribution: None),
        "titan_large":  (blend: "titan_large",  use_blend: false, scale: 1.0, attribution: None),
        "vector_gear":  (blend: "vector_gear",  use_blend: false, scale: 1.0, attribution: None),
        "blade":        (blend: "blade",        use_blend: false, scale: 1.0, attribution: None),
        "house_small":   (blend: "house_small",   use_blend: false, scale: 1.0, attribution: None),
        "tree_giant":   (blend: "tree_giant",   use_blend: false, scale: 1.0, attribution: None),
        "crate_resupply": (blend: "crate_resupply", use_blend: false, scale: 1.0, attribution: None),
    },
)
