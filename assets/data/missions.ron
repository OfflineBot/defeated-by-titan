// missions.ron — the hub, the mission templates, and the difficulty levels.
// A new mission, a new door, a new difficulty: file work, not Rust (init.md §4).
//
// The loop the user asked for on 2026-08-12 — „dann fehlt auch noch eine hub! bei der man rum
// laufen kann und missionen starten kann. das game ist dann eine mission (mit
// schwierigkeitsleveln)" — is:
//
//     hub  ──(walk onto a deployment pad)──►  sortie  ──(WON | LOST)──►  hub
//
// ⚠️ Every number in this file is **UNTUNED**. What is laid down is only the SHAPE: a
// difficulty is a set of numbers, never a branch in the code.
(
    // -----------------------------------------------------------------------------------
    // The hub — the main building. Positions in meters, origin at the player's spawn.
    // -----------------------------------------------------------------------------------
    //
    // The hub is laid out on whatever map `maps.ron: current` builds, and it has two kinds of
    // furniture with two different rules:
    //
    //   deployments      OUTSIDE, on open ground. They have to stay inside
    //                    `maps.ron: layout.clear_radius_m` (24.0 m), the circle the city
    //                    generator keeps free, and on **+Z**, because the graybox has an
    //                    explicitly placed house at (0, 2, −12).
    //   refuel_stations  INSIDE the garrison headquarters (`maps.ron: ashgate`, the hall at
    //                    x = −47..−15, |z| ≤ 13, door at (−15, ., 0)), **on the aisle the door
    //                    opens onto**. „drinnen sind die nachschübe" — the user, 2026-08-12.
    //                    See `refuel_stations` below.
    hub: (
        name: "The Rookery",

        // Where you stand: at launch with `--hub`, and again after every sortie. The same
        // point `player::spawn_local_player` uses, so the two cannot drift apart visibly.
        spawn_m: (0.0, 2.0, 0.0),

        // How long WON/LOST stays up before the hub takes you back. Long enough to read the
        // word, short enough that nobody waits for it.
        debrief_s: 3.0,

        // ---- The doors -----------------------------------------------------------------
        //
        // **One pad per difficulty, and no menu.** The game has mouse-look and no cursor
        // while playing, so choosing a difficulty is a place you walk to and not a click.
        // `recruit` stands straight ahead of the spawn point —
        // it is the door you find without looking for it; the two harder ones stand off to
        // the sides.
        deployments: [
            (mission: "skirmish", difficulty: "recruit", center_m: ( 0.0, 0.0, 16.0), radius_m: 3.0),
            (mission: "skirmish", difficulty: "veteran", center_m: (-9.0, 0.0, 16.0), radius_m: 3.0),
            (mission: "skirmish", difficulty: "elite",   center_m: ( 9.0, 0.0, 16.0), radius_m: 3.0),
        ],

        // ---- The supply — INSIDE the main building --------------------------------------
        //
        // „gas refillt nur im main gebäude an bestimmten stationen/objekten" (user,
        // 2026-08-12, docs/QUESTIONS.md Q-033) and „in das gebäude muss man rein laufen
        // können. drinnen sind die nachschübe" (the same day). These two points are the whole
        // answer: there is no regeneration anywhere else in the game, `Gas::refill` has no
        // other caller, and `blades::resupply::restock` has no other caller either.
        // **How fast and how far stands in `gear.ron: resupply`**, not here — this file says
        // where the supply is, that file says what it gives back.
        //
        // The two coordinates are the **serving faces** of the two racks of `maps.ron: ashgate`
        // — the aisle side, not the middle:
        //
        //     (-42.0, 0.15, -2.0)   the south rack — the gas tanks
        //     (-42.0, 0.15,  2.0)   the north rack — the blades
        //
        // ⚠️ **They stood at z = ±6.5, the racks' centres, until 2026-08-13, and that made the
        // supply a puzzle** (`docs/FINDINGS.md` FIND-075). A rack is 5 x 9 m of collider, so a
        // trigger at its centre is 4.5 m inside solid stone: the only standing room left inside
        // the 4 m reach was a 1.15 m strip between the rack's east face and a roof post, and a
        // 1.0 m slot behind the rack against the back wall — 57 standable cells, every one of
        // them threaded. A player who walked in down the aisle and stopped at the back wall was
        // **7.20 m** from the number that decides and got nothing.
        // The rack is 5 m wide in x and its aisle face is z = ∓2.0, which is where a person
        // stands to be served. From there the reach covers 6.93 m of the aisle centre line, the
        // back-wall stop is 3.69 m out, and the standing room goes from 57 cells to 373.
        // `tests/mission.rs::f019_walking_straight_down_the_aisle_puts_you_in_reach_of_every_rack`
        // is that criterion: **hold W from the spawn point and you are supplied.**
        //
        // ⚠️ **0.15 is not decoration, it is the proof.** It is the top face of the depot floor
        // slab, and no other block in the district has that height (ground 0.0, aprons 0.05,
        // quays and bridges 0.4). A station at 0.15 m is standing on that floor and nowhere
        // else, which is what makes „drinnen" a test and not a description —
        // `tests/mission.rs::f019_every_supply_station_stands_on_the_depot_floor_of_the_main_building`
        // finds the floor by that height alone, and `scripts/f019-hq.txt` reads the same number
        // from the player's side as `assert height > 0.10`.
        //
        // ⚠️ **Both racks give back both things, and that is a deviation from the model.**
        // `maps.ron` labels the south rack "gas tanks" and the north one "blades", but a
        // `StationPad` in `src/data/mod.rs` is a bare `center_m` with nothing to say which —
        // and that file is not this hand's to widen (`docs/FINDINGS.md` FIND-066). So a station
        // is a **supply point**: it asks for gas and it asks for blades, which is also the
        // shape `gear.ron: resupply` already has — one block, one `range_m`, four numbers.
        // Walk to either rack and you leave with a full tank and a full harness.
        // **Rollback point if the user wants one rack per resource: these two lines plus the
        // `BladeRack` insert in `src/mission/hub.rs::open_hub`.**
        //
        // ⚠️ The three positions these replaced — (0, 0, 6), (±14, 0, 6) — stood on the
        // pavement outside. `scripts/f070-hub.txt` was re-cut against these two on 2026-08-13
        // and its ACT 1 is now the walk itself: `look 90 0`, `key W`, through the gate, down
        // the aisle, into the back wall, tank full. No `warp` anywhere in it.
        refuel_stations: [
            (center_m: (-42.0, 0.15, -2.0)),
            (center_m: (-42.0, 0.15,  2.0)),
        ],
    ),

    templates: {
        // The drop-in that F-070 and F-071 were built on. It has **no difficulties**: it is
        // the tutorial, and it is entered with `--mission tutorial`, which walks straight
        // into the fight and never sees the hub.
        "tutorial": (
            name: "First Ride",
            map: "ashgate",
            target_duration_s: 330.0,
            // F-071 counts to a number, and the number belongs in the file. Three:
            // the waves below spawn four titans, so the mission is winnable without
            // hunting the last straggler across 400 m of city. ⚠️ UNTUNED.
            kill_target: 3,
            waves: [
                (at_s:   0.0, kind: "husk",     count: 1),
                (at_s:  90.0, kind: "husk",     count: 2),
                (at_s: 210.0, kind: "scuttler", count: 1),
            ],
            difficulties: {},
        ),

        // ★ **The mission the hub flies.** „das game ist dann eine mission (mit
        // schwierigkeitsleveln)" — so there is one sortie here and three levels of it, not
        // three missions.
        "skirmish": (
            name: "Ashgate Skirmish",
            map: "ashgate",

            // ⚠️ The three numbers below are the DIRECT-ENTRY shape (`--mission skirmish`
            // without the hub). Every sortie deployed from a pad flies a `difficulties`
            // entry instead and never these. They exist because `--mission <name>` is the
            // door every script and every test in the repository already comes through.
            target_duration_s: 330.0,
            kill_target: 3,
            waves: [
                (at_s:   0.0, kind: "husk",     count: 2),
                (at_s: 120.0, kind: "husk",     count: 2),
                (at_s: 240.0, kind: "scuttler", count: 1),
            ],

            // ---- What a difficulty changes, and it is exactly three things -------------
            //
            //   kill_target        how many cortex kills win it
            //   target_duration_s  how long you have before the clock loses it for you
            //   waves              which kinds come, when, and how many
            //
            // Nothing else. No hidden multiplier on titan health, no scaling in Rust — a
            // level nobody can read out of this file is a level nobody can tune.
            difficulties: {
                // Two kills, seven minutes, and **nothing at all for the first minute**:
                // time to fly out, find the ring and pick a target before anything is
                // looking at you.
                "recruit": (
                    name: "Recruit",
                    target_duration_s: 420.0,
                    kill_target: 2,
                    waves: [
                        (at_s:  60.0, kind: "husk", count: 2),
                        (at_s: 180.0, kind: "husk", count: 2),
                    ],
                ),
                // The shape F-071 was written against: three kills in five and a half
                // minutes, and the first pair is already standing when you arrive.
                "veteran": (
                    name: "Veteran",
                    target_duration_s: 330.0,
                    kill_target: 3,
                    waves: [
                        (at_s:   0.0, kind: "husk",     count: 2),
                        (at_s: 120.0, kind: "husk",     count: 2),
                        (at_s: 240.0, kind: "scuttler", count: 1),
                    ],
                ),
                // Five kills, five minutes, and the kinds change: `scuttler` is fast and
                // small (11 m/s, a 0.20 m cortex), `errant` is a husk that keeps up.
                // That is the difference between "more of them" and "worse ones".
                "elite": (
                    name: "Elite",
                    target_duration_s: 300.0,
                    kill_target: 5,
                    waves: [
                        (at_s:   0.0, kind: "husk",     count: 3),
                        (at_s:  60.0, kind: "scuttler", count: 2),
                        (at_s: 150.0, kind: "errant",   count: 3),
                        (at_s: 240.0, kind: "scuttler", count: 2),
                    ],
                ),
            },
        ),
    },
)
