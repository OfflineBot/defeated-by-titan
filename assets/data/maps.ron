// maps.ron — the city as DATA, not as 200 hand-written lines of Rust.
//
// All lengths in METERS (1 Bevy unit = 1 meter, docs/conventions.md). The backlog counts
// in studs; the conversion happens on adoption INTO THIS FILE, at 0.28 m
// (docs/QUESTIONS.md Q-002) — there are no studs in the code.
//
// A map has two sources: `layout` generates blocks deterministically out of `seed` via
// shared::Rng, `blocks` places single boxes explicitly. What is placed explicitly wins:
// the generated part leaves room around every placed block and for `clear_radius_m`.
//
// No block is ROTATED. An axis-aligned box is exactly its AABB; a rotated Cuboid yields
// the enclosing, too-large AABB, and the hook catches in mid-air
// (bevy_math-0.19.0/src/bounding/bounded3d/primitive_impls.rs:100-115).
//
// ⚠️ UNTUNED. These numbers are starting values, not level design. Anchor density is the
// gate of P3 and gets calibrated against measured traversal times when Ashgate is built
// (docs/QUESTIONS.md Q-010) — until then nothing here is finished.
//
// ⚠️ EXCEPTION: `street_m`, `min_height_m` and `max_height_m` are NOT untuned. They come
// out of assets/data/scale.ron and thus from the user (2026-08-09); tests/data.rs falls
// over the moment they leave the window there. Since 2026-08-09 the same window holds for
// every `blocks` entry with `landmark: false` — before, it held only for the layout, and
// the explicitly placed boxes stood above it with 12, 14 and 18 m of ridge height.
(
    // Which map gets built at startup. Has to appear in `maps` (tests/data.rs).
    // ⚠️ **"ashgate" since 2026-08-12** (`scripts/f003-ashgate.txt`: 25 asserts, 1336 ticks,
    // `docs/images/f003-ashgate.png`). Before the flip, every test that built an app built
    // whatever stands here — `tests/vector_aiming.rs` therefore pins its map per test now
    // (`app_on("graybox")`) instead of inheriting this line, and `--test vector_aiming`,
    // `world`, `data`, `mission` are green with it.
    // **What still warps into GRAYBOX coordinates: `scripts/game-full.txt`** — 5 of its 23
    // asserts fail here (ACT 1 hooks a watchtower ashgate has no equivalent of); it was NOT
    // loosened, see `docs/FINDINGS.md` FIND-059. Check any other script before quoting it.
    current: "ashgate",

    // The one color atlas for the entire environment (bible 3.4: minimal draw calls).
    // Linear RGB. **None of the three signal colors** (cyan, amber, crimson) — those are
    // reserved exclusively for gameplay, placeholders included
    // (docs/conventions.md).
    palette: {
        "stone_gray": (0.42, 0.43, 0.40),
        "brick_red": (0.45, 0.26, 0.20),
        "olive_green": (0.29, 0.33, 0.20),
        "sand_brown": (0.55, 0.47, 0.33),
        // Added 2026-08-12 for the roofscape. The roofs are the route the player actually
        // flies (`docs/gameplay/`), and until today they were the same colour as the wall
        // under them — from twenty metres up the district was one flat mosaic. Darker and
        // slightly cooler than `stone_gray`, so a roof reads as a roof at speed and against
        // a sand-brown street. **Not a signal colour**: those three are gameplay only.
        "roof_slate": (0.24, 0.23, 0.24),
        // Added 2026-08-13 for the interior lamps (`lights` below). It is the only entry
        // here that is not an albedo but an **emission tint** — a lamp is warm, the way the
        // sun is warm (`art.ron: sun.color = (1.0, 0.945, 0.86)`), only a stop further, so
        // that a lit interior reads warm against the cool sky-blue fill. It lives in the
        // palette and not as a triple on the light for one reason: the rule "the three
        // signal colours appear nowhere else" is only a TEST as long as every colour in the
        // map is a key, and an amber lantern is the exact thing that rule was written
        // against. **Not amber** — amber is (1.0, 0.68, 0.10) and this is a warm white.
        "lamp_warm": (1.0, 0.90, 0.78),
        // Added 2026-08-19 with the fall of Ashgate. A standing remnant and a rubble mound
        // are darker and less saturated than the wall they were: a century of weather and
        // one fire. They are only ever SEEN where the ruin kit is switched off in `art.ron`
        // — the mesh covers the box otherwise — but the box is what a screenshot of a
        // model-less build shows, and a ruin the colour of a house is a ruin nobody sees.
        // **Not a signal colour**: those three are gameplay only and appear nowhere else.
        // Added 2026-08-29 with the continuous ground. The user, having played the
        // terraced sand version: *„das soll grass sein und nicht so wie jetzt!"*. Three keys
        // and not one, because the ground is now 490 000 m² of a single surface and one
        // albedo over all of it is the flat mosaic `FIND-134` measured from the air: the
        // field's own range is cut into three bands, damp low ground to dry high ground.
        // **None of them is a signal colour** — those three are gameplay only.
        "grass_low": (0.14, 0.24, 0.12),
        "grass_green": (0.22, 0.35, 0.16),
        "grass_high": (0.34, 0.40, 0.21),
        "ash_gray": (0.30, 0.30, 0.29),
        "ash_dark": (0.22, 0.21, 0.20),
    },

    // The three signal colors, linear RGB. Until 2026-08-09 they existed only as PROSE
    // (Bible 3.4, docs/conventions.md §3) and as a number nowhere — so there was nothing
    // to paint a cortex with.
    //
    // Kept in their own block, apart from `palette`: the rule is "these three appear
    // nowhere else" (no cyan set dressing, no amber lanterns, no red roofs), and with
    // two blocks that rule becomes a TEST — no map block may name a key from here.
    // In one block it would only be a sentence in a document again.
    //
    // Deliberately saturated against a muted palette; that contrast is the whole point,
    // and it is why a player at full speed still knows what matters to him.
    signals: {
        "cyan": (0.05, 0.85, 0.95),      // gas, Vector Gear, anchor points
        "amber": (1.0, 0.68, 0.10),      // cortex, weak points, objectives
        "crimson": (0.90, 0.12, 0.16),   // danger, damage, critical state
    },

    maps: {
        // Stage 2, bible 6.2 P1: „Nur Bewegung. Weisse Boxen, keine Assets, keine Gegner."
        "graybox": (
            name: "Graybox",
            size_m: (400.0, 400.0),
            // Fixed seed: the same city on every machine, in every rollback, in every test
            // run. A `rand::random()` here would be a desync (docs/multiplayer.md).
            seed: 3735928559,

            layout: (
                // Lot edge and street width. The hook reaches 90 m — a street has to be
                // narrow enough that both sides are reachable at the same time.
                lot_m: 28.0,
                // 9.0 -> 7.0: the user gives the street width as 6-8 m and writes
                // explicitly "keep them narrow" (scale.ron:reference.min_street_m/
                // -max_street_m). 7.0 is the middle of the window. Narrow streets are no
                // detail: they are the reason why speed feels like speed.
                street_m: 7.0,
                // 8.0 -> 4.5 and 34.0 -> 11.5. The generated city was FAR too tall: 34 m
                // is the size of a church (35 m), not that of a residential house. Under
                // the user's specification, normal building lies between the small house
                // (4.5 m) and the large house (11.5 m) — scale.ron:architecture.heights_m.
                //
                // ⚠️ **This makes the city FLAT. That is intended.**
                // The vertical of this game comes from the wall (120 m), the church
                // (35 m), the watchtower (12 m) and the trees (12 m) — **not from the
                // residential stock**. That is exactly the look of the reference work: a
                // flat sea of tiled roofs out of which single structures rise. Whoever
                // pulls the grid houses back up "repairs" nothing, but turns the city into
                // a skyline and the wall into one wall among many.
                // Church, watchtower and tree stand below as `blocks` with
                // `landmark: true`; the wall is still missing (docs/QUESTIONS.md Q-022, Q-023).
                //
                // What these two numbers mean for movement is computed and belongs here,
                // because otherwise nobody does the arithmetic: a clean arc needs rope
                // length <= anchor height, so <= 11.5 m — **87 % of the 90 m hook range
                // produce no swinging on a grid house, but a fall on the leash.** Pure
                // pendulum motion from 11.5 m gives at most sqrt(2 * 20 * 11.5) =
                // 21.4 m/s; the quarter period of an 11.5 m rope, at 1.19-1.41 s, is longer
                // than free fall from the same height (1.07 s). What stays usable are ropes
                // of 3 to 7 m — one street width.
                // That is a consequence of the specification, not an error in it: Q-022.
                min_height_m: 4.5,
                max_height_m: 11.5,
                // Fraction of the grid lots that really get built on (0..1).
                density: 0.72,
                // Fraction of the generated buildings that are anchorable (0..1). **Not
                // everything is anchorable** — only that makes „Kein Haken auf ungetaggten
                // Parts moeglich" (F-003) checkable at all.
                anchorable_fraction: 0.8,
                // Radius around the origin that stays clear: that is where the player
                // stands at startup, and scripts/t007-first-run.txt runs 6 m along -Z.
                clear_radius_m: 24.0,
                // `None` = one detached box per lot, and the graybox keeps it deliberately.
                // Eight tests in tests/vector_aiming.rs are pinned to THIS world as a
                // fixture (FIND-059); the closed-block layout is Ashgate's, and the `None`
                // arm in world/map.rs is byte-for-byte the generator these tests grew up on.
                perimeter: None,
                colors: ["stone_gray", "brick_red", "sand_brown"],
                // A flat lid, and no tall class. The fixture stays the world the eight aiming
                // tests grew up on — every new shape is Ashgate's.
                roof_steps: 1,
                tall_fraction: 0.0,
                tall_height_key: "house_tall",
                // **Nothing has fallen here, and that is a statement and not a default**
                // (§4, no `serde(default)`). The fixture is the world eight tests in
                // `tests/vector_aiming.rs` and four in `tests/player.rs` are pinned to; a
                // ruin would move a box one of them aims at, and the test would stay green
                // while measuring something else.
                damage: None,
            ),

            // ⚠️ **PROVABLY FLAT, and that is not laziness.** `levels: 1` and `step_m: 0.0`
            // make `shared::TerrainField` return 0 for every cell, so `world::map` emits not
            // one terrace and every generated house stands on `y = 0` exactly as it did
            // before 2026-08-13.
            //
            // It has to: eight tests in `tests/vector_aiming.rs` and four in `tests/player.rs`
            // are pinned to this fixture (`docs/FINDINGS.md` FIND-061) and every one of them
            // reasons about `y = 0` — a roof height, a fall, a ray that starts at eye level.
            // Terracing the graybox would leave all twelve green while measuring a world they
            // were never written against, which is the most expensive kind of green there is.
            //
            // The remaining fields are not defaults either (§4, no `serde(default)`): they say
            // what the terrain WOULD be, so that turning it on here is one number and not a
            // re-derivation.
            terrain: (
                cell_m: 5.0,
                rise_m: 0.25,
                // ⚠️ **PROVABLY FLAT, and that is not laziness.** An empty octave list makes
                // `shared::TerrainField` return 0 for every cell, so `world::map` emits not
                // one ground block and every generated house stands on `y = 0` exactly as it
                // did before 2026-08-13. The 400 x 400 m slab in `blocks` stays the floor of
                // this fixture.
                amplitude_m: [],
                wavelength_m: [],
                flat_radius_m: 30.0,
                max_rise_m: 0.0,
                base_m: -1.0,
                paving_top_m: 0.06,
                colors: ["olive_green"],
            ),

            // Explicitly placed. Until 2026-08-09 the blocks were 1:1 the ones out of
            // src/world/mod.rs — so that the rewrite is provably behavior-equal.
            //
            // ⚠️ Three of them stuck out over the residential stock (11.5 m) with 12.0 /
            // 18.0 / 14.0 m of ridge height — the limit the same file forbids the LAYOUT
            // three lines further up. The guard t005_the_generated_city_stays_residential
            // did not see them, because it read only `layout` — half the city stood
            // outside the rule that is supposed to keep it flat. Resolved via a new field:
            //
            //   `landmark: false` — residential. Has to stay under architecture.heights_m
            //                       `house_large` (11.5 m).
            //   `landmark: true`  — church, watchtower, tree, wall. **They carry the
            //                       vertical** and are allowed above it.
            //
            // With that, "the vertical comes out of landmarks" is no longer an intention
            // but a property of the file that tests/data.rs can check.
            blocks: [
                // The ground. Not anchorable: otherwise you hook into the ground slabs.
                (center_m: (0.0, -0.1, 0.0), size_m: (400.0, 0.2, 400.0), color: "olive_green", anchorable: false, solid: true, landmark: false),
                (center_m: (-12.0, 4.0, -20.0), size_m: (8.0, 8.0, 8.0), color: "brick_red", anchorable: true, solid: true, landmark: false),
                // Ridge 12.0 -> 11.5 m: that is `house_large`, the upper limit of the
                // residential stock. Half a meter, so that the block is what it looks
                // like — a large house.
                (center_m: (10.0, 5.75, -28.0), size_m: (10.0, 11.5, 10.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (0.0, 2.0, -12.0), size_m: (4.0, 4.0, 4.0), color: "sand_brown", anchorable: true, solid: true, landmark: false),
                // Ridge 18.0 -> 12.0 m and `landmark: true`: 18 m is neither a residential
                // house (<= 11.5) nor a size the user names. As a **watchtower** (12 m,
                // scale.ron: architecture.heights_m) it is unambiguously both — and it was
                // already the tower of this graybox anyway.
                (center_m: (24.0, 6.0, -40.0), size_m: (12.0, 12.0, 12.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                // An untagged wall IN FRONT OF an anchorable roof — the test case out of
                // F-023 („Sichtlinienpruefung verhindert Haken durch Waende"). Without a
                // pair of this kind in the level the criterion cannot be driven.
                (center_m: (-30.0, 5.0, -34.0), size_m: (14.0, 10.0, 1.0), color: "stone_gray", anchorable: false, solid: true, landmark: false),
                // Ridge 14.0 -> 11.5 m, for the same reason as above.
                (center_m: (-30.0, 5.75, -46.0), size_m: (14.0, 11.5, 10.0), color: "brick_red", anchorable: true, solid: true, landmark: false),

                // ---- The vertical ----------------------------------------------------
                // Further up, this file promised itself that "church, watchtower and wall
                // get placed as `blocks`" — until 2026-08-09 **none** of that stood in a
                // map, and so the statement "the vertical comes out of landmarks" was an
                // intention instead of a state. The consequence was measurable: highest
                // anchor 11.5 m + min_rope_m 3.0 m = **anchor ceiling 14.5 m**, while the
                // cortex of a `large` sits at 12.5 m, of a `huge` at 18.7 m and of a
                // `boss` at 24.9 m. Three of five size classes would have been attackable
                // only ballistically (docs/QUESTIONS.md Q-022).
                //
                // The church raises the ceiling to 38 m and thus covers all five classes.
                // Heights out of scale.ron: architecture.heights_m, footprints are a
                // graybox estimate and explicitly untuned.
                (center_m: (60.0, 17.5, -60.0), size_m: (14.0, 35.0, 14.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                // A tree as foreground layering: narrow, tall, anchorable. It is the
                // cheapest anchor above the eaves and the only one that may stand in the
                // middle of a street.
                (center_m: (-20.0, 6.0, -58.0), size_m: (2.5, 12.0, 2.5), color: "olive_green", anchorable: true, solid: true, landmark: true),

                // ---- The swing lane: nine gate towers along z = 70 --------------------
                // Measured, and it is the only reason any of the numbers below may be
                // believed: `scripts/f004-towers.txt` — 39 asserts, exit 0, one arc with its
                // bottom 33.32 m ABOVE the ground and then five of them chained over 208 m
                // at up to 43.3 m/s, on zero gas. Take these towers back out and the same
                // script reports 17 of 39 red, every hook "found nothing anchorable".
                // The user, 2026-08-10, after playing it: „und mehr tuerme zum lang
                // hangeln!" — and FIND-026 says the same thing with numbers: the church at
                // 35 m was the ONLY structure in this world tall enough to give a real arc.
                //
                // ## The arithmetic that decides height and spacing. Read it before you
                // ## move one of these numbers.
                //
                // `player/rope.rs::attach_ropes` sets the rope to the distance that exists
                // at the moment of the hook, and `shorten_ropes` only ever lets it get
                // SHORTER. So for an anchor at height `H` above the ground and a rope `L`
                // the bottom of the pendulum lies at
                //
                //     arc bottom = H - L
                //
                // and a swing exists at all only while that is above the ground. With
                // `L = sqrt(d^2 + u^2)` (d = horizontal distance to the anchor, u = how far
                // the anchor is above the player) that becomes, for a clearance floor `f`:
                //
                //     d < sqrt((H - f)^2 - u^2)      and in particular always   d < H - f
                //
                // **That is the whole design constraint, and it is NOT the hook range.**
                // `vector.hook_range_m` is 200 m since 2026-08-10, but a rope of 200 m needs
                // an anchor 200 m up to swing on. **A tower has to be TALLER than the gap to
                // the next one.** Whoever spaces towers by hook range gets 200 m of leash and
                // no pendulum — which is exactly the state FIND-026 measured.
                //
                // Choosing from that:
                //   * spacing = **35 m**, the layout pitch (lot 28 + street 7). The towers
                //     sit on the lot centres of the row z = 70, so each one removes exactly
                //     the lot it stands on (world/map.rs drops a generated lot whole when a
                //     placed block overlaps it) and the row becomes an open lane.
                //   * a level hook to the next tower is then L = 35 m, the arc bottom sits at
                //     H - 35, and the descent (and therefore the speed) is the spacing:
                //     v = sqrt(2 * 20 * 35) = **37.4 m/s = 6.2x running speed**.
                //   * height **60 m**: 60 - 35 = 25 m of arc bottom, i.e. 13.5 m of air over
                //     the 11.5 m residential roofs even if a swing drifts out of the lane.
                //     At the church's 35 m the same spacing would put the arc bottom at
                //     y = 0 — the church is exactly one tower short of being chainable.
                //
                // ⚠️ **60 m is above the church (35 m) and it is a decision the user has to
                // confirm.** `scale.ron` names no building above the church; 60 m is the one
                // height above it the user has written down at all
                // (`wall.platform_height_m`). Rolling it back is this block and nothing else.
                //
                // ## Why a GATE and not a plain tower
                //
                // The bottom of the pendulum lies vertically under the ANCHOR. On a solid
                // tower that point is inside the tower, so a swing that is allowed to run its
                // course ends in the wall you are hanging from. Two columns and a crossbeam
                // put the anchor over open ground: the beam spans the lane, its middle is
                // 35 m of air above the street, and the arc bottom is out there with it. The
                // player flies THROUGH the gate (20 m of clear width between the columns,
                // 56 m of clear height) instead of into it.
                //
                // **The columns are NOT anchorable, and that is the second half of the gate
                // idea rather than a restriction.** The rule two paragraphs up is that a swing
                // anchor has to stand over OPEN GROUND — the bottom of a pendulum lies
                // vertically under its anchor, and on a column that point is inside the
                // column. A hookable column is therefore an anchor that breaks the very rule
                // the gate shape exists to satisfy: you would swing straight into the thing
                // you are hanging from, which is what `docs/FINDINGS.md` FIND-029 measured on
                // the church (24.85 m/s -> 0.000 against its face, and he stays there).
                //
                // It was also measurably wrong the other way: with the columns tagged, the
                // beam sits on top of them (columns y 0..56, beam y 56..60 over z 52..88) and
                // COVERS both roofs, so `tests/vector_aiming.rs` reported exactly **18 of 87
                // tagged surfaces unreachable by free aiming** — one per column, nine gates.
                // A tagged surface nothing can hook is a lie in the map.
                //
                // So: beam `anchorable: true` in `sand_brown`, columns `anchorable: false` in
                // `stone_gray` — and the colour split now says something true, namely that the
                // part which reads from a distance is the part you can actually hook.
                //
                // Nine of them at x = -140 .. +140: 280 m of lane, eight legs. The lots at
                // x = +-175 in the same row stay built.
                //
                // ⚠️ **The row is z = 70 and not the nearer z = 35, and that is not taste.**
                // `scripts/f170-objective.txt` spawns a titan at (0, 0, 18) and
                // `scripts/f053-windup.txt` one at (0, 0, 25) — both would have stood INSIDE
                // the column at (0, ., 21). A lane one row further north touches no script in
                // the repository; the highest +z any of them uses is 76.5
                // (`scripts/f171-crosshair.txt`), and no column stands at that x.
                (center_m: (-140.0, 28.0, 56.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (-140.0, 28.0, 84.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (-140.0, 58.0, 70.0), size_m: (8.0, 4.0, 36.0), color: "sand_brown", anchorable: true, solid: true, landmark: true),
                (center_m: (-105.0, 28.0, 56.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (-105.0, 28.0, 84.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (-105.0, 58.0, 70.0), size_m: (8.0, 4.0, 36.0), color: "sand_brown", anchorable: true, solid: true, landmark: true),
                (center_m: (-70.0, 28.0, 56.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (-70.0, 28.0, 84.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (-70.0, 58.0, 70.0), size_m: (8.0, 4.0, 36.0), color: "sand_brown", anchorable: true, solid: true, landmark: true),
                (center_m: (-35.0, 28.0, 56.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (-35.0, 28.0, 84.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (-35.0, 58.0, 70.0), size_m: (8.0, 4.0, 36.0), color: "sand_brown", anchorable: true, solid: true, landmark: true),
                (center_m: (0.0, 28.0, 56.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (0.0, 28.0, 84.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (0.0, 58.0, 70.0), size_m: (8.0, 4.0, 36.0), color: "sand_brown", anchorable: true, solid: true, landmark: true),
                (center_m: (35.0, 28.0, 56.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (35.0, 28.0, 84.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (35.0, 58.0, 70.0), size_m: (8.0, 4.0, 36.0), color: "sand_brown", anchorable: true, solid: true, landmark: true),
                (center_m: (70.0, 28.0, 56.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (70.0, 28.0, 84.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (70.0, 58.0, 70.0), size_m: (8.0, 4.0, 36.0), color: "sand_brown", anchorable: true, solid: true, landmark: true),
                (center_m: (105.0, 28.0, 56.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (105.0, 28.0, 84.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (105.0, 58.0, 70.0), size_m: (8.0, 4.0, 36.0), color: "sand_brown", anchorable: true, solid: true, landmark: true),
                (center_m: (140.0, 28.0, 56.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (140.0, 28.0, 84.0), size_m: (8.0, 56.0, 8.0), color: "stone_gray", anchorable: false, solid: true, landmark: true),
                (center_m: (140.0, 58.0, 70.0), size_m: (8.0, 4.0, 36.0), color: "sand_brown", anchorable: true, solid: true, landmark: true),
            ],

            // The graybox has no interiors — every box in it is solid, there is nothing to
            // walk into and therefore nothing to light. **The empty list is the statement.**
            // The field carries no `serde(default)` (rule 2), so leaving it out is a load
            // error and not a silently dark room.
            lights: [],

            // F-019 — and the empty list is the statement, exactly like `lights` above. The
            // graybox is the FIXTURE: eight tests in `tests/vector_aiming.rs` and four in
            // `tests/player.rs` reason about `y = 0` on it, and a station is a thing in the
            // world with a trigger circle around it. It gets none. The stations stand in
            // `ashgate`, which is `current` and which is what a sortie is flown in.
            // ---- F-012: where this map ENDS -----------------------------------------
            // The user, 2026-08-27: *„und man kann an der seite einfach runterfallen!"*, and
            // asked what should be there he named both halves:
            // *„unsichtbare wand + wenn man runterfaellt wegen bug teleport man zurueck!"*
            //
            // They are two mechanisms and not one thing twice. The fence is what normal play
            // runs into. The recovery plane is what catches somebody the fence has ALREADY
            // failed to hold — a warp, a seam, a body that got put somewhere by hand. Written
            // as "the wall, and then the wall again" this feature does nothing for the case it
            // was actually asked for.
            //
            // ## fence_thickness_m 10.0 — a tunnelling budget, not a taste
            //
            // At `vector.max_speed_m_s` 75, `simulation_hz` 60 and `game.ron: substeps` 24, a
            // body advances 75 / (60 * 24) = **0.0521 m per substep**. Ten metres is 192 of
            // those, and `MaxLinearSpeed` on the player makes 75 a hard ceiling, so there is no
            // faster case to budget for. `tests/world.rs` does this arithmetic rather than
            // trusting this paragraph.
            //
            // ## fence_top_m 200.0 — and it is NOT a ceiling, because there is no such thing
            //
            // 🔴 It stood here under the sentence *"far above anything the gear reaches on gas
            // alone"*, and that sentence was **false**. Measured 2026-08-28, `W` + `Shift` held
            // from a standing start at (0, 2, 0), looking straight up:
            //
            //   1 s 12.2 · 2 s 49.9 · 3 s 54.6 · 4 s 71.7 · 5 s 114.5 · 6 s 182.5 ·
            //   7 s 259.3 · 8 s 336.3 m — over this fence in **under seven seconds**
            //
            // and the gas for the first six of those seconds was 15000.000 -> 14891.771:
            // **0.72 % of one tank.** Worse, there is no apex to quote: held long enough the
            // body simply sits at `vector.max_speed_m_s` going up. Ten seconds of steady climb
            // measured **748.9 m for 179.88 gas**, i.e. 4.163 m per unit of gas — so one full
            // tank is worth **62 508 m** here (`gear_ceiling_m` below, and
            // `tests/player.rs::f012_the_gear_climbs_higher_than_the_fence_and_the_number_is_pinned`
            // re-flies it every run). The 200 here is beaten by a factor of **313**.
            //
            // ⚠️ **And raising it is not the fix, which is why it did not get raised.** A taller
            // fence still has a top face, and that top face is a solid, invisible, standable
            // ring `fence_thickness_m` wide OUTSIDE the map: a body put on it at 200 m rested
            // there indefinitely, recorded by nothing and recovered by nothing. Every height is
            // a height somebody beats, and each one brings its own ledge.
            //
            // What closes it is `player::recovery::out_of_the_world`: **outside the map's own
            // footprint is out of the world at any height.** That leaves this number free to be
            // what it should have been all along — as tall as normal play needs and no taller,
            // which on a 400 x 400 m graybox whose tallest box is 60 m means five times the skyline and
            // nothing more.
            //
            // It stops where it does for a second reason that is measured and not aesthetic:
            // the fence is a collider, so an aim ray sees it, and
            // `tests/vector_hooks.rs::f028_a_failed_pull_says_which_of_the_four_it_was` fires
            // a level ray from **400 m** up and needs the answer "open sky" and then "out of
            // reach" from a wall 900 m out. A fence to infinity turns both of those into
            // "the surface holds nothing" — the feature would have broken the test that
            // exists to keep the four miss reasons apart.
            //
            // ## recovery_plane_y_m — a DEPTH, and that is the whole discriminator
            //
            // Not a fall distance and not a speed: a player diving off the 120 m wall is not
            // falling out of the world, and the only thing that separates the two honestly is
            // how far down he gets. The plane sits under the deepest block this map has (see
            // the per-map number below), so no surface in the game can be reached from below
            // it, and `tests/world.rs` asserts exactly that against the planned geometry.
            //
            // Graybox is 400 x 400 m: the ground slab ends at +-200 and its underside is at
            // -0.2 m. The plane is 300 m down, ~1500x the deepest thing here.
            bounds: (
                // ## fence_margin_m 0.18 — DERIVED, bracketed by two measurements, and 0.0 was
                // ## a shipped bug for two days
                //
                // 🔴 It was 0.0, i.e. the fence's inner face stood exactly ON the map's edge —
                // and `player::recovery::out_of_the_world` tests `|x| > hx`, STRICTly. The
                // fence's top face is the widest floor in the district and it began at a
                // coordinate the rule called *in the world*: `warp 350 201 0` rested at
                // **200.000 m** after 3 s, after 10 s and after six seconds of held `W`,
                // `record_safe_ground` made it home ("back to Vec3(350.0, 200.49994, 0.0)"),
                // and from then on every recovery of the session delivered the player onto
                // that ledge. From it, one nudge outward warped him **1501 times in 25 s**.
                //
                // Moving the fence out is the fix, but the size of the move is not free: a
                // capsule rests on its bottom sphere, which reaches over the lip. So
                //
                //     fence_rest_reach_m 0.10  <  fence_margin_m 0.18  <  radius_m 0.35
                //
                // and 0.18 is the geometric middle of the two — either bound has to move by a
                // factor of ~1.9 before it bites. Below it a body can park on the fence inside
                // the footprint; above it a body pressed against the fence has his origin
                // outside the map and legitimate play gets teleported.
                // ⚠️ The 0.18 m gap between the ground's edge and the fence is not a hole
                // anybody can fall into: a body is 0.70 m wide.
                fence_margin_m: 0.18,
                // ## fence_rest_reach_m 0.10 — A MEASUREMENT (see maps.ron's sibling comment
                // in the ashgate block and `src/data/mod.rs: Bounds`). Graybox's fence, body
                // and solver are the same as Ashgate's, so the number is the same.
                fence_rest_reach_m: 0.10,
                fence_thickness_m: 10.0,
                fence_bottom_m: -50.0,
                fence_top_m: 200.0,
                gear_ceiling_m: 62508.0,
                recovery_plane_y_m: -300.0,
                recovery_lift_m: 0.5,
            ),
            supply_stations: [],
        ),

        // ================================================================================
        // ASHGATE — the walled district. `assets/data/missions.ron` has named
        // `map: "ashgate"` since the first mission existed; until 2026-08-12 the map did not
        // exist and every run fell back to `current` with a warning out of
        // `src/mission/mod.rs:140`. This entry closes that.
        //
        // The user, 2026-08-12: „die map muss gebaut werden! mit grosser wand. [...] mit
        // wand. haeuser, verschiedene hoehen (nicht alles plain flach) etc! erstelle auch
        // die tuerme. den fluss der durch geht. es sollte moeglichst akkurat sein!"
        //
        // ⚠️ **`current` is deliberately still "graybox".** Switching is ONE line up at the
        // top of this file — but every script under `scripts/` warps into graybox
        // coordinates (`f004-towers.txt` hooks the gate towers at z = 70) and every test
        // that builds an app builds `current`. Flipping it is the main head's call, not a
        // side effect of this map existing. The evidence run for this map sets it:
        // `scripts/f003-ashgate.txt` says so in its first line.
        //
        // ## The layout, and why it is this shape
        //
        // A district that juts OUT through the main wall, not a town sitting behind it:
        //
        //     z = +350 ..  -97.5   the district — dense grid housing, the market square,
        //                          the church, the canal, the gantry lane
        //     z = -120             the MAIN WALL, running the full 700 m across the map
        //     z = -142.5 .. -277.5 the pocket: the part of the district that sticks out
        //                          past the wall, flanked by walls at x = +-120
        //     z = -300             the OUTER WALL with the outer gate
        //     beyond               open field. Titan side.
        //
        // **Two gates on one axis:** outer gate (0, .., -300) and inner gate (0, .., -120),
        // both 28 m wide and 20 m tall, and the straight line between them is the main
        // street — it runs from z = -277.5 through the whole district up to z = +250.
        //
        // **The canal runs through the district and through BOTH walls** at x = -70: a
        // 16 m channel 4 m below the paving, with 8 m quays either side, six bridges, and a
        // water gate 12 m tall where it crosses each wall.
        //
        // ## Where the geometry comes from
        //
        // Everything vertical is `assets/data/scale.ron` and nothing is invented:
        // wall 120 m, battered 45 m at the base to 28 m at the top, one course per 15 m
        // `band_spacing_m` (eight of them), a plinth 0..2 m at exactly 45.0 and a coping
        // 118..120 m at exactly 28.0 so the user's two numbers physically exist at the two
        // heights he named them for. Platform at 60 m. Watchtowers 12 m — `scale.ron` calls
        // them "standing on the wall", and that is where they stand. Church 35 m. Trees
        // 12 m. Grid housing 4.5 .. 11.5 m, street 7 m.
        //
        // **The one height that is NOT from `scale.ron`: the 56 m gantry columns and their
        // 60 m beam.** Same number and same shape as the graybox swing lane, and it carries
        // the same open question — `scale.ron` names no structure above the church.
        // docs/QUESTIONS.md Q-022/Q-023. Rolling it back is the gantry block below.
        //
        // ## THE ARITHMETIC THAT DECIDES WHETHER THIS MAP IS ANY GOOD
        //
        // `docs/FINDINGS.md` FIND-041: a rope swings only while `L < H` — anchor height H,
        // rope length L at the moment of the hook, arc bottom `H - L`, and `L >= d`. So
        //
        //     the horizontal gap to the next anchor must be SMALLER than its height.
        //
        // 200 m of `hook_range_m` does not change that by one metre. And FIND-042: the
        // bottom of a pendulum lies vertically UNDER its anchor, so an anchor over solid
        // ground ends the swing inside the thing you hang from. Every anchor below that is
        // meant to be swung on hangs over open ground. What that buys, route by route:
        //
        //   * **the gantry lane**, 14 stations at 35 m pitch along the main street, beam
        //     top 60 m: level hook L = 35, arc bottom 60 - 35 = **25 m**, i.e. 13.5 m of air
        //     over the 11.5 m roofs, and the descent gives sqrt(2*20*35) = **37.4 m/s**.
        //     Ten of them run unbroken from z = 227.5 to z = -87.5 — **315 m, nine legs.**
        //     Four more stand in the pocket (z = -157.5 .. -262.5, three legs).
        //   * **the wall gallery**, a 700 m anchorable ledge at 60 m that projects 14 m out
        //     over the boulevard: ANY gap under 60 m swings, the player picks his own
        //     spacing, and the arc bottom lands on the cleared strip and not on a roof.
        //   * **gallery <-> lane**: the last gantry (z = -87.5) is 25.5 m from the gallery
        //     edge (z = -87.6) — 25.5 < 60, so the lane joins the wall.
        //   * **the church (35 m)** to the beam of the gantry beside it: d = 20.5, u = 23,
        //     L = 30.8, arc bottom 60 - 30.8 = **29 m**. The church is a perch, not a swing
        //     anchor of its own (FIND-029: a swing that runs its course on a solid tower
        //     ends against its face).
        //   * **the crown corbels at 120 m** project 6 m past the wall face on both sides,
        //     so the one anchor at crown height hangs over open air — and it is the only
        //     one a rope from the district can see past the battered face.
        //   * **NOT swingable, on purpose:** the 12 m watchtowers and the 12 m trees
        //     (d < 12 puts the arc bottom on the pavement) and the whole residential stock.
        //     They are perches and hook targets, not lanes.
        //   * **The wall is a barrier and it is meant to be.** From the last inner gantry to
        //     the first pocket one is 70 m > 60, so the two lanes do not join over the wall:
        //     you take the gate at street level, or you climb — ground -> gallery (60 m) ->
        //     crown corbel (120 m), two moves, both legs well inside the 200 m range.
        //
        // ## The river, in a game that has no water
        //
        // Graybox: a lowered channel, its own colour, `anchorable: false` — a hook into the
        // water would be the one thing worse than no river. The **bridges are anchorable**,
        // which makes the crossings the only hook targets over the channel and turns the
        // canal into what it is in the reference: a gap in the roof network that costs you
        // something to cross.
        //
        // ## How a hole gets into a box world
        //
        // There is no subtraction here, so the channel is the GAP BETWEEN two ground slabs,
        // and everything that has to stay free of grid housing is an **apron**: a 0.3 m slab
        // whose top edge sits 0.05 m above the ground. `world/map.rs` drops a generated lot
        // whole as soon as a placed block overlaps it, and 0.05 m of overlap is enough. That
        // is what keeps the field outside the wall empty, the main street open, the market
        // square a square and the boulevard along the wall clear — and it is why the quays
        // are 0.4 m high: a 21 m lot cannot fit into the 16 m gap between them, so no house
        // is ever rolled over the water.
        //
        // ⚠️ UNTUNED, like every other footprint in this file. What is NOT untuned: every
        // height listed above, `street_m`, `min_height_m`, `max_height_m` — those come out
        // of `scale.ron` and thus from the user, and `tests/data.rs` falls over if they
        // leave the window.
        // ================================================================================
        "ashgate": (
            name: "Ashgate",
            // 700 x 700 m. The guard is `half_extent_m >= longest_edge/2 + hook_range_m`
            // (tests/data.rs): 350 + 200 = 550 against 600. 800 would fit exactly and leave
            // nothing over; the 50 m of margin are worth more than 100 m of empty field.
            size_m: (700.0, 700.0),
            seed: 3405691582,

            layout: (
                // ## The proportion, and it is the only thing about this quarter that is
                // ## measured rather than chosen.
                //
                // Survey of the real walled town the district is modelled on (1 344
                // buildings, 4 100 street samples): street width facade to facade **8.1 m**
                // pooled median (7.7 residential), ridge height **11-13 m** for the two
                // storeys that are 68 % of the stock, **13.1 m** median longest wall,
                // **39 %** ground coverage, **~24** buildings per hectare, and buildings
                // that **touch** — party walls, closed block perimeters, courtyards inside.
                // Street : ridge is therefore **0.62 : 1**, and the inverse is the rule:
                // **a house is about 1.6x as tall as the street is wide.**
                //
                // Until 2026-08-12 this map built a 21 m box in the middle of a 28 m cell,
                // so the gap from facade to facade was 7 m in the best case and 35 m as soon
                // as one lot in three stayed empty — a suburb, and the reason the gantries
                // had to be invented (FIND-058).
                //
                //   lot_m 36 = the OUTER edge of a closed block, not a house
                //   + street_m 7 = block pitch **43 m** (survey 60, build target 40-45)
                //   courtyard 36 - 2*11 = **14 m**
                //   street 7 m against a 8..11.5 m ridge = **0.61 .. 0.88 : 1**
                lot_m: 36.0,
                // 7.0 and not 8.0: `scale.ron: reference.min_street_m/max_street_m` is
                // 6..8 and the survey's residential median is 7.7. 7 m against the 11.5 m
                // ridge is 0.61 : 1 — the measured proportion, to two digits.
                street_m: 6.0,
                // 4.5 -> 8.0. The survey counts storeys: 2 storeys 167 buildings,
                // 3 storeys 65, **1 storey 9**. A one-storey house is 4 % of the stock, and
                // in a 7 m street a 4.5 m house is a 1.6 : 1 clearing, not a canyon. So the
                // band is `house_town` (8.0) .. `house_large` (11.5) out of scale.ron — both
                // the user's numbers, neither invented, and 3.5 m of spread is a real old
                // town's roofline rather than a sawtooth.
                // ## 8.0 -> 6.5, and this is the reversal the user ordered
                //
                // 2026-08-12, after seeing the rebuilt district: *„häuser sind alle
                // ineinander! keine unterschiedliche höhen! es sieht überhaupt nicht aus wie
                // eine attack on titan map! viel zu kompakt!"*
                //
                // The survey was not wrong — 2 storeys are 68 % of the stock — but a band of
                // 8.0..11.5 is **3.5 m of spread on a 700 m district**, and from twenty metres
                // up that is one flat top. The band is now 5.0 m wide and it is spent twice:
                // `house_spread_m` inside one block, the rest as the block's own level. Two
                // quarters next to each other therefore sit at visibly different heights,
                // which is what a skyline is made of, while two neighbours still differ.
                //
                // 6.5 is the floor and not 4.5, because the ratio is still the rule: a 4.5 m
                // house across a 7 m street is a 1.6 : 1 clearing and the rope has no arc in
                // it (FIND-041). Below the band, height comes from the roof and not from the
                // wall.
                min_height_m: 6.5,
                // The **ridge**, not the eaves: `scale.ron: architecture.heights_m
                // house_large` is the upper limit of normal building and the roof is cut out
                // of the house downward, not added on top of it. Nothing in this district got
                // taller than the user's own number when the roofs came back.
                max_height_m: 11.5,
                // 0.78 -> 0.80. The ring now has alleys in it, so a built cell no longer
                // covers its whole outline: about 8 % of the footprint is gap. 0.80 puts the
                // built area back where the survey wants it (~39 % over the walled area).
                density: 0.86,
                // 0.85 -> 1.0. The user, 2026-08-12: *„man soll überall seinen haken inmachen
                // können! auch an den boden oder dächer, alles!"*. Every house and every roof
                // of this district holds a hook. F-003 ("no hook on an untagged part") stays
                // falsifiable on the wall, the gatehouses and the gantry legs, which are the
                // 100+ untagged blocks left in `blocks` below.
                anchorable_fraction: 1.0,
                clear_radius_m: 24.0,
                // The closed block — a ring of row houses around a courtyard, and since
                // 2026-08-12 **no two of them the same box**. Everything after
                // `wing_depth_m` is one axis of irregularity; without them the ring was eight
                // identical cuboids with a zero gap, and that is what „alle ineinander" was.
                perimeter: Some((
                    // 12 m of frontage. Survey median longest wall 13.1 m (p25 10.9,
                    // p75 16.7).
                    frontage_m: 12.0,
                    // 11 m deep — survey ordinary house 11 x 13 m. It is also what fixes the
                    // courtyard at 14 m: `d < H` wants the courtyard under the 11.5 m ridge,
                    // and 36 - 2*11 = 14 is the last width that still qualifies.
                    wing_depth_m: 11.0,
                    // The frontage is drawn per RUN out of 9.5..14.5 — the survey's p25..p75
                    // is 10.9..16.7, and the lower half of it is what fits a 36 m run in
                    // whole houses (2, 3 or 4 of them). Two rows facing each other then no
                    // longer have their joints at the same x.
                    frontage_spread_m: 5.0,
                    // Up to 22 % of a slot is alley. Drawn per house, so a run has party
                    // walls (the survey's finding, and it stays the common case) AND gaps you
                    // can see down — which is the half the first version left out.
                    gap_fraction: 0.22,
                    // Up to 1.6 m off the street edge. A ragged frontage line is what the
                    // survey means by "irregular"; ours was a drawn straight line.
                    setback_max_m: 1.6,
                    // And up to 3.2 m off the depth behind it, so the courtyard side is
                    // ragged too. setback_max_m + depth_spread_m = 4.8 < wing_depth_m 11.0 —
                    // `world::map::perimeter_houses` asserts exactly that, because a house
                    // with no depth left is a wall.
                    depth_spread_m: 3.2,
                    // The whole ring moves up to 2 m off its grid cell. **This is the only
                    // tool this world has against a checkerboard** — nothing may be rotated
                    // (`world::map`), so the street has to wobble instead of run. The street
                    // is then 3..11 m wide instead of 7.00 m everywhere, and
                    // 2 * 2.0 < street_m 7.0 keeps two rings from touching.
                    cell_jitter_m: 1.5,
                    // Of the 5.0 m band, 2.4 m are spent inside one block and the remaining
                    // 2.6 m are the block's own level. Both halves are needed: only the first
                    // gives a sawtooth that averages flat over a hundred metres, only the
                    // second gives terraces of identical houses.
                    house_spread_m: 2.4,
                    // The pitched cap. It died in the 2026-08-12 rebuild because an untagged
                    // cap over a tagged wall is FIND-059 — so it is back with the SAME anchor
                    // bit as its house, and `tests/world.rs` measures that instead of
                    // forbidding caps.
                    roof: Some((
                        // A fraction, out of the user's own two eaves figures
                        // (`scale.ron: architecture.eaves_m`): 3.0 m of eaves on a 4.5 m house
                        // is a 1/3 roof, 6.0 m on 8.0 m is a 1/4 roof. 0.22..0.33 is that
                        // pair, widened by one notch at the shallow end. **A number in metres
                        // would put a 1/3 roof on a small house and a 1/8 roof on a large
                        // one.**
                        min_rise_fraction: 0.22,
                        max_rise_fraction: 0.33,
                        // 12 % pulled in per side, so a 12 m house keeps a 1.4 m ledge all
                        // round: the step is what makes the roof read as a roof from above,
                        // and the ledge is what you can still stand on next to the cap.
                        inset_fraction: 0.12,
                        color: "roof_slate",
                    )),
                )),
                colors: ["stone_gray", "brick_red", "sand_brown"],
                // ## The roof, in three steps instead of one lid — 2026-08-13
                //
                // The user: *„lass es wie die echte stadt aussehen! aktuell kann man es noch
                // nicht erkennen!"*. Half of that is the ground (see `terrain` below) and half
                // of it is what you see from the air, which in this game is nothing but roofs.
                // One flat cap per house gives every house the same silhouette; three stacked
                // caps, each pulled in one notch further, give it a ridge line.
                // 3 and not 4: at `inset_fraction` 0.12 the top step of four keeps
                // 1 - 2*0.12*4 = 4 % of the footprint, which on a 12 m house is a 0.5 m sliver
                // that reads as a chimney. Three keeps 28 %.
                roof_steps: 3,
                // ## The tall class — `Q-036`, answered by a number instead of by a gantry
                //
                // 8 % of the houses are built to `scale.ron: architecture.heights_m
                // house_tall` (18 m) instead of out of the 6.5..11.5 band. On a ring of ~10
                // houses that is not quite one, so a quarter has a handful and a street front
                // has one or none — which is what a real town looks like and what a band
                // cannot produce however wide it is made.
                // Not higher: 8 % over 2000 houses is ~160 buildings at 18 m, and every one of
                // them is also an anchor 6.5 m above its neighbours. Above ~12 % the district
                // stops being flat and starts being a skyline, which the design bible
                // deliberately does not want (`scale.ron: architecture`).
                tall_fraction: 0.08,
                tall_height_key: "house_tall",

                // ================================================================================
                // ASHGATE HAS FALLEN — 2026-08-19. The user, 2026-08-18:
                //   *„hast du die map schon überarbeitet? weil aktuell ist das nicht die echte
                //    map!"*
                // ================================================================================
                //
                // He is right and it is checkable in one line. `docs/gameplay/world.md`:
                // *"the war is already lost … **Ashgate has long since fallen**; the Vanguard
                // runs **salvage missions into its own ruins**"* — and what stood here until
                // this round was an intact, inhabited, tidy walled town with 926 houses, a
                // full roofscape and not one collapsed wall. Every good thing the 2026-08-18
                // session added (density, party walls, terrain, gabled roofs) answered the
                // *other* complaint — *„lass es wie die echte stadt aussehen"* — and pushed
                // this one further away.
                //
                // ## Why a gradient and not a rate
                //
                // A fallen ring is not uniformly destroyed. Three terms are added:
                // the **gradient** below, a draw per **block** and a draw per **house**. The
                // middle one is the one that matters most and it is the one a "damage
                // percentage" cannot express: whole streets stand and whole streets are gone,
                // so there are stretches worth salvaging and stretches that block a route.
                // Pepper at one flat rate reads as a *texture* over a market town.
                //
                // ⚠️ **What this does to traversal**, because it is a traversal change and not
                // a decoration change:
                //   * a **ruin** is a 3..7 m stump where a 9..11 m wall stood. The rope still
                //     holds — every remnant is anchorable, „überall! ohne ausnahmen!" — but it
                //     holds *lower*, so a ruined stretch is a dip in the lane and not a wall.
                //     That is the real change, and it is deliberate: the intact rows stay the
                //     canyon the district was tuned for (street : ridge 0.61 : 1), the fallen
                //     ones open the sky over them.
                //   * a **mound** is under 3 m in a 6 m street and it spills `spill_m` past
                //     the frontage. It takes the **ground** away and leaves the air alone: you
                //     cannot run that lane, you can still fly it. A district where rubble
                //     blocked the swing lanes would be a district that punishes the one verb
                //     the game has.
                damage: Some((
                    // The gradient. The Vanguard held the middle longest — the player spawns
                    // at the origin and the hub stands there — and the outer edge is where the
                    // wall went. **0.40 at the core and not 0.10**, and that is the one
                    // figure here that was set twice: at 0.10 the whole inner third came out
                    // at 0 % damaged — the player spawns at the origin, so the first thing he
                    // would see is the intact market town he already complained about. The
                    // core is where the Vanguard held, not where nothing happened.
                    core_severity: 0.45,
                    edge_severity: 0.86,
                    // Per BLOCK. This is the term that makes damage a history: at ±0.22 a
                    // whole closed block sits a fifth of the scale off its neighbours, so a
                    // street front is intact or gone as a piece.
                    block_spread: 0.28,
                    // Per HOUSE, and small on purpose. It is what leaves a gable standing in a
                    // razed row and punches one hole into an intact one; any bigger and it
                    // averages the block draw away again.
                    house_spread: 0.12,
                    // The two cuts, and they were set by measurement and not by taste.
                    // On the shipped seed at exactly these figures
                    // (`tests/world.rs::f003_ashgate_has_fallen_and_it_is_not_a_tidy_market_town`
                    // prints every one of them):
                    //
                    //   946 buildings — 436 standing · 376 ruined · 134 collapsed (54 % gone)
                    //   139 blocks    —  39 wholly intact ·  62 more than half razed
                    //   damaged: 18 % within a third of the map, 71 % beyond three quarters
                    //
                    // ⚠️ **The upper bound is not a matter of taste either.** At
                    // `core_severity: 0.52` the district came out 60 % damaged and only 92
                    // street samples still stood between two intact houses — the canyon the
                    // whole movement is tuned for (street : ridge 0.61 : 1) had thinned to
                    // nothing, and `f003_the_street_is_narrower_than_the_houses_are_tall`
                    // said so. A ruin that eats the town takes the game with it.
                    ruin_at: 0.72,
                    rubble_at: 0.98,
                    // A remnant is CUT OUT of the house it was, never added to it: at most
                    // three quarters of the ridge the intact house would have had. Nothing in
                    // a fallen district is taller than it was standing.
                    ruin_height_fraction: 0.75,
                    // Under 2.5 m it is not a standing wall any more, it is a heap — and a
                    // heap is what the rubble kit is for. A ruin model that cannot reach this
                    // inside the lot is not worn; the house collapses instead.
                    ruin_min_height_m: 2.5,
                    // The mounds. The kit is authored 0.90..3.00 m tall and this is the window
                    // it is scaled into, so a mound is never a bunker.
                    rubble_height_m: (1.2, 2.8),
                    // 1.6 m of it lies in the road — about a quarter of the 6 m street, and
                    // just over half of the narrowest street the jitter can draw
                    // (`street_m 6.0 - 2 * cell_jitter_m 1.5 = 3.0 m`). So even the tightest
                    // lane keeps 1.4 m of daylight beside a mound: **blocked is a decision,
                    // sealed is a bug**, and nothing here may wall a street off completely.
                    spill_m: 1.6,
                    ruin_color: "ash_gray",
                    rubble_color: "ash_dark",
                )),
            ),

            // ================================================================================
            // THE GROUND — until 2026-08-13 there was none. The user, that day:
            //   *„adde verschiedene höhen vom boden her! lass es wie die echte stadt aussehen!
            //    aktuell kann man es noch nicht erkennen!"*
            // ================================================================================
            //
            // ## cell_m 42, and it is the number that was argued longest
            //
            // It has to be a whole multiple of `lot_m + street_m` = 42 (asserted in
            // `world::map`), so the terrace edge falls in the middle of a street and never
            // through a house. 84 was the first design and it is worse **here**, for a reason
            // that is a property of this map and not of terrain in general: every cell that
            // carries something hand-placed is pinned flat, and this district's hand-placed
            // things run in long lines — the canal (x -85..-55), the gantry spine (x ±10..18),
            // the wall (z <= -98). At 84 m each of those pins an 84 m column or row and three
            // of eight columns die; at 42 the same geometry pins 42 m and the district keeps
            // about twice as much terraced ground. Small cells also mean the ground changes
            // every block instead of every second one, which is what "you can see it" means on
            // foot.
            //
            // ## step_m 0.9 over 5 levels = 3.6 m of relief
            //
            // 0.9 m is one deep doorstep — visible from across a street, and three risers of
            // 0.30 m walk it. The ceiling is 4 * 0.9 = 3.6 m, about a third of a house: enough
            // that a quarter reads as higher ground and not so much that the roofscape's own
            // proportions (`d < H`, FIND-041) change.
            //
            // ## The two stair numbers are bounded, not chosen
            //
            //   stair_rise_m 0.30 — `step_m` must be a whole multiple of it (3 risers), and
            //     0.30 is below the player capsule's 0.35 m radius, which is what lets a
            //     dynamic capsule ride up a box step at all instead of stopping at it.
            //   stair_tread_m 0.60 — a flight runs (3-1) * tread into the terrace's own edge,
            //     and a house stands `street_m / 2 - cell_jitter_m` = 3.0 - 1.5 = 1.5 m back
            //     from the boundary. 2 * 0.60 = 1.20 m fits with 0.30 m to spare; 0.90 m of
            //     tread would run 1.80 m and cut the stairs out from under the facade.
            //     `world::map` asserts exactly this instead of clamping it.
            //
            // ## paving_top_m 0.06, and the last digit is deliberate
            //
            // Everything hand-placed whose top is at or below this counts as ground and may be
            // covered by a terrace; everything above it pins its cell flat. The paving of this
            // map has its top edge at exactly 0.05 m, and 0.06 is also where a pad's underside
            // sits — a pad flush at 0.05 would decide `world::map::overlaps` by one ULP, and
            // `tests/world.rs::f003_no_grid_house_stands_inside_a_placed_block` would go red or
            // green depending on the rounding of two different sums.
            terrain: (
                // ## cell_m 5.0, and it is the number the whole feature turns on
                //
                // It was 42 (one block pitch) for the terraces, because a terrace edge had to
                // fall in the middle of a street. A field has no edge to place, so the only
                // thing left deciding the cell is the **grade**: `rise_m / cell_m`. At 0.25
                // over 5.0 that is 5.0 %, against the 3.6 % `FIND-134` measured and the user
                // rejected. Smaller cells buy a steeper world and cost blocks 1:1 — 4.0 m
                // would be 6.2 % for ~9 000 ground blocks against ~6 300 here, and
                // `docs/lessons/performance.md` rule 6 is why 5.0 won.
                //
                // ⚠️ `size_m` must be a whole multiple of it (700 / 5 = 140 cells a side), or
                // the last row of the map has no ground.
                cell_m: 5.0,
                // ## rise_m 0.25 — MEASURED, not chosen
                //
                // The tallest riser the player can walk up at `game.ron: gravity_m_s2 -32`,
                // swept on the shipped binary 2026-08-29 (`docs/FINDINGS.md` FIND-214):
                // 0.27 m climbs, **0.28 m is a wall**, and treads of 1.0/2.0/3.0 m make no
                // difference at all. 0.25 keeps 8 % of margin under the last value that
                // worked. ⚠️ `gravity_m_s2` is PROVISIONAL (`Q-063`) — if it rises again this
                // number has to fall with it, and `scripts/w2-terrain-walk.txt` is the run
                // that says so.
                rise_m: 0.25,
                // ## Two octaves, both far steeper than 5 % on purpose
                //
                // The clamp is what shapes this ground (`world::map::plan_terrain`); the noise
                // decides **where** the high ground and the hollows are, not how fast you get
                // there. 620 m is a landform across the whole district, 240 m breaks it into
                // quarters. Amplitudes below the grade budget would make the field a pure
                // distance cone off the streets — measured, and it reads as a pyramid.
                amplitude_m: [22.0, 7.0],
                wavelength_m: [620.0, 240.0],
                // >= layout.clear_radius_m 24.0. The player spawns at (0, 2, 0) and the hub
                // pads stand around him at y = 0 (`missions.ron`); ground under any of them is
                // a pad inside the earth.
                flat_radius_m: 30.0,
                // The ceiling the field actually reaches, asserted against the field that came
                // out — and the line above which a hand-placed block is sky: `max_rise_m +
                // scale.ron reference.door_height_m`.
                max_rise_m: 14.0,
                // Every ground block runs from here up to its own height. Well above
                // `bounds.fence_bottom_m` (-50) and `recovery_plane_y_m` (-300), and below the
                // lowest cell the field produces — `world::map` asserts that.
                base_m: -20.0,
                // Everything hand-placed whose top is at or below this is paving: the ground
                // may climb over it, and may never sink away underneath and leave it hanging.
                // The paving of this map has its top edge at exactly 0.05 m.
                paving_top_m: 0.06,
                // *„das soll grass sein"* (2026-08-29). Low band to high band.
                colors: ["grass_low", "grass_green", "grass_high"],
            ),

            blocks: [

                // 🔴 **TWO SLABS WERE DELETED HERE ON 2026-08-29, and their absence is the
                // feature.** The two 700 m sand floors (265 x 700 and 405 x 700) were flat
                // coloured lids at y = -0.1 over the whole map. The user:
                // *„und deutlich hoeher und NIEDRIGER als jetzt!"* — a lid at -0.1 makes every
                // valley invisible, and the ground under it unreachable. `terrain` is the
                // floor of this map now, it spans the whole 700 x 700 m, and it is grass.
                // The other 243 blocks below did **not** move by one centimetre: what changed
                // is only what the ground under them may do (`shared::CellRole`).
                // ⚠️ **The three olive_green field patches STAYED, and it cost a measurement to
                // learn why.** They look like colour and they are not: `plan_blocks` vetoes
                // every generated house that touches a placed block, so these three are the
                // aprons that keep the open field outside the wall an open field. Deleted with
                // the sand on 2026-08-29, the district grew by **146 houses** out there
                // (898 -> 1044 facades) — a suburb on the wrong side of the wall.
                // They are `CellRole::Floor` to the ground: it may climb over them, it may not
                // sink away underneath and leave them hanging.
                (center_m: (0.0, -0.1, -336.25), size_m: (700.0, 0.3, 27.5), color: "olive_green", anchorable: true, solid: true, landmark: false),
                (center_m: (-235.0, -0.1, -232.5), size_m: (230.0, 0.3, 180.0), color: "olive_green", anchorable: true, solid: true, landmark: false),
                (center_m: (235.0, -0.1, -232.5), size_m: (230.0, 0.3, 180.0), color: "olive_green", anchorable: true, solid: true, landmark: false),
                // ---- Ground, canal and paving ------------------------------------------
                // ## Every one of these is anchorable since 2026-08-12, and that OVERRULES the
                // ## note the graybox still carries ("not anchorable: otherwise you hook into
                // ## the ground slabs")
                //
                // The user, 2026-08-12: *„man soll überall seinen haken inmachen können! auch
                // an den boden oder dächer, alles!"*.
                //
                // The old reason was real, and it is worth writing down what was accepted
                // rather than pretending it went away: a 700 x 700 m slab is the largest
                // target in the map, so a crosshair that is even slightly below the horizon
                // now hits *ground* where it used to fly past it to a facade behind — and a
                // rope into the ground pulls you down into it instead of over it. Accepted,
                // because the alternative is the thing he actually complained about: a shot
                // that answers NoAnchor for no reason the player can see.
                //
                // the two ground slabs. The gap between them is the channel, and that is the only
                // way to get a hole into a box world: leave it out. **Sand, not green: the ground BETWEEN
                // the channel floor 4 m down — no water in this game, so the river is a lowered lane.
                // ⚠️ 16 -> 10 m of channel, and it is not taste. The quays are what deletes a grid
                (center_m: (-70.0, -4.1, 0.0), size_m: (10.0, 0.2, 700.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                // house standing over the water, and since 2026-08-12 that test runs per HOUSE and not
                (center_m: (-80.0, -1.8, 0.0), size_m: (10.0, 4.4, 700.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                // per cell: a 12 x 11 m row house fits into a 16 m gap and would hang in the air over
                // the channel. It does not fit into 10. The quays are 10 m for the same arithmetic.
                (center_m: (-60.0, -1.8, 0.0), size_m: (10.0, 4.4, 700.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                // the lots IS the street network, and a green one made the district read as houses on a lawn. Green stays outside the wall, where it is a field.
                // the boulevard along the wall: the cleared strip the wall gallery swings over
                (center_m: (0.0, -0.1, -83.75), size_m: (700.0, 0.3, 27.5), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                // the main street — the two-gate axis, and the lane the gantries straddle.
                // ⚠️ 48 -> 30 m, and the number is not free: the apron deletes every grid
                // house that TOUCHES it, so its width decides where the frontage stands. At
                // 48 it killed the middle house of the block as well and the axis measured
                // **55 m** facade to facade; at 30 the middle house survives and the axis is
                // **31 m** — one metre wider than the apron, and wide enough for the 28 m
                // gates it connects. Anything between 31 and 47 buys nothing and costs a row
                // of houses.
                (center_m: (0.0, -0.1, -37.5), size_m: (30.0, 0.3, 575.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                // the market square. **Dead zone 1, on purpose** (and the church tower beside
                // it is the way across): 76 m of open stone against an 11.5 m roofscape is
                // `d < H` failing by a factor of six. Traversal that works everywhere is not
                // a skill.
                (center_m: (62.0, -0.1, -22.0), size_m: (76.0, 0.3, 76.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                // ---- Aprons under the projecting galleries ------------------------------
                // The 60 m gallery and the 120 m crown corbel hang 14 m and 12 m out over
                // the ground. A house under them has something standing on its roof centre,
                // and a roof you cannot hook from above is a lie in the map
                // (`tests/world.rs::f003_no_anchorable_block_has_another_block_sitting_on_its_roof_centre`).
                // Along the main wall the boulevard already keeps that strip clear; the two
                // flanks and the outer wall had nothing, and the hand-placed pocket houses
                // stood under the west gallery. 20.4 m = the union of gallery and corbel.
                (center_m: (-96.0, -0.1, -210.0), size_m: (24.0, 0.3, 225.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (96.0, -0.1, -210.0), size_m: (24.0, 0.3, 225.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (0.0, -0.1, -277.8), size_m: (240.0, 0.3, 20.4), color: "stone_gray", anchorable: true, solid: true, landmark: false),

                // ---- The wall: 120 m, battered 45 m -> 28 m, one course per 15 m band --
                // main wall
                (center_m: (-218.0, 7.5, -120.0), size_m: (264.0, 15.0, 43.94), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-34.0, 7.5, -120.0), size_m: (40.0, 15.0, 43.94), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (182.0, 7.5, -120.0), size_m: (336.0, 15.0, 43.94), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-70.0, 13.5, -120.0), size_m: (32.0, 3.0, 43.09), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-182.0, 22.5, -120.0), size_m: (336.0, 15.0, 41.81), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (182.0, 22.5, -120.0), size_m: (336.0, 15.0, 41.81), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (0.0, 25.0, -120.0), size_m: (28.0, 10.0, 41.46), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (0.0, 37.5, -120.0), size_m: (700.0, 15.0, 39.69), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (0.0, 52.5, -120.0), size_m: (700.0, 15.0, 37.56), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (0.0, 67.5, -120.0), size_m: (700.0, 15.0, 35.44), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (0.0, 82.5, -120.0), size_m: (700.0, 15.0, 33.31), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (0.0, 97.5, -120.0), size_m: (700.0, 15.0, 31.19), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (0.0, 112.5, -120.0), size_m: (700.0, 15.0, 29.06), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                // plinth: base_thickness_m 45.0 exactly
                (center_m: (-218.0, 1.0, -120.0), size_m: (264.0, 2.0, 45.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-34.0, 1.0, -120.0), size_m: (40.0, 2.0, 45.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (182.0, 1.0, -120.0), size_m: (336.0, 2.0, 45.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                // coping: top_thickness_m 28.0 exactly
                (center_m: (0.0, 119.0, -120.0), size_m: (700.0, 2.0, 28.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                // outer wall of the protrusion
                (center_m: (-114.25, 7.5, -300.0), size_m: (56.5, 15.0, 43.94), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-34.0, 7.5, -300.0), size_m: (40.0, 15.0, 43.94), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (78.25, 7.5, -300.0), size_m: (128.5, 15.0, 43.94), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-70.0, 13.5, -300.0), size_m: (32.0, 3.0, 43.09), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-78.25, 22.5, -300.0), size_m: (128.5, 15.0, 41.81), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (78.25, 22.5, -300.0), size_m: (128.5, 15.0, 41.81), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (0.0, 25.0, -300.0), size_m: (28.0, 10.0, 41.46), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (0.0, 37.5, -300.0), size_m: (285.0, 15.0, 39.69), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (0.0, 52.5, -300.0), size_m: (285.0, 15.0, 37.56), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (0.0, 67.5, -300.0), size_m: (285.0, 15.0, 35.44), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (0.0, 82.5, -300.0), size_m: (285.0, 15.0, 33.31), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (0.0, 97.5, -300.0), size_m: (285.0, 15.0, 31.19), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (0.0, 112.5, -300.0), size_m: (285.0, 15.0, 29.06), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                // plinth: base_thickness_m 45.0 exactly
                (center_m: (-114.25, 1.0, -300.0), size_m: (56.5, 2.0, 45.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-34.0, 1.0, -300.0), size_m: (40.0, 2.0, 45.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (78.25, 1.0, -300.0), size_m: (128.5, 2.0, 45.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                // coping: top_thickness_m 28.0 exactly
                (center_m: (0.0, 119.0, -300.0), size_m: (285.0, 2.0, 28.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                // west flank
                (center_m: (-120.0, 7.5, -210.0), size_m: (43.94, 15.0, 225.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-120.0, 22.5, -210.0), size_m: (41.81, 15.0, 225.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-120.0, 37.5, -210.0), size_m: (39.69, 15.0, 225.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-120.0, 52.5, -210.0), size_m: (37.56, 15.0, 225.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-120.0, 67.5, -210.0), size_m: (35.44, 15.0, 225.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-120.0, 82.5, -210.0), size_m: (33.31, 15.0, 225.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-120.0, 97.5, -210.0), size_m: (31.19, 15.0, 225.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-120.0, 112.5, -210.0), size_m: (29.06, 15.0, 225.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                // plinth: base_thickness_m 45.0 exactly
                (center_m: (-120.0, 1.0, -210.0), size_m: (45.0, 2.0, 225.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                // coping: top_thickness_m 28.0 exactly
                (center_m: (-120.0, 119.0, -210.0), size_m: (28.0, 2.0, 225.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
