                (center_m: (120.0, 17.5, 90.0), size_m: (8.0, 35.0, 8.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (230.0, 17.5, -30.0), size_m: (8.0, 35.0, 8.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (60.0, 17.5, 250.0), size_m: (8.0, 35.0, 8.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-110.0, 17.5, 280.0), size_m: (8.0, 35.0, 8.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (280.0, 17.5, 200.0), size_m: (8.0, 35.0, 8.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
