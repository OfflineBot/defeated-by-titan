                (center_m: (-70.0, -0.1, 110.0), size_m: (36.0, 1.0, 8.0), color: "sand_brown", anchorable: true, solid: true, landmark: false),
                (center_m: (-70.0, -0.1, 190.0), size_m: (36.0, 1.0, 8.0), color: "sand_brown", anchorable: true, solid: true, landmark: false),
                // ---- Bell towers — the skyline, and the only legal way to build one ----
                // The user, 2026-08-12: *„keine unterschiedliche höhen!"*. The residential
                // band cannot answer that on its own: `scale.ron: architecture.heights_m`
                // stops at **11.5 m** for a house and the next entry is the **35 m** church —
                // there is nothing in between (docs/QUESTIONS.md Q-036, still the user's to
                // answer). 5 m of spread over 700 m of town is invisible from the air, and
                // widening it downward would break the one proportion that makes the rope
                // swing (`d < H`).
                //
                // So the vertical comes from **landmarks**, which is what `maps.ron` claimed
                // about itself from the beginning — and until today the whole district had
                // exactly one of them inside the wall. Eight bell towers at the church's own
                // 35 m, scattered across the quarters, are what turns a uniform roofscape
                // into a silhouette. Every one of them is a HEIGHT OUT OF scale.ron, not an
                // invented number, and `landmark: true` says so.
                //
                // They also do a second job the roofscape needs: an anchor 35 m up over the
                // middle of a quarter is a lane that no 11 m ridge can give
                // (`d < H` — FIND-041), and it is the answer to the gantries the main street
                // still needs (FIND-060).
                (center_m: (-140.0, 17.5, 40.0), size_m: (8.0, 35.0, 8.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-200.0, 17.5, 180.0), size_m: (8.0, 35.0, 8.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-30.0, 17.5, 150.0), size_m: (8.0, 35.0, 8.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (120.0, 17.5, 90.0), size_m: (8.0, 35.0, 8.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (230.0, 17.5, -30.0), size_m: (8.0, 35.0, 8.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (60.0, 17.5, 250.0), size_m: (8.0, 35.0, 8.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (-110.0, 17.5, 280.0), size_m: (8.0, 35.0, 8.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                (center_m: (280.0, 17.5, 200.0), size_m: (8.0, 35.0, 8.0), color: "stone_gray", anchorable: true, solid: true, landmark: true),
                // market stalls
                (center_m: (32.0, 1.25, -50.0), size_m: (3.0, 2.5, 3.0), color: "brick_red", anchorable: true, solid: true, landmark: false),
                (center_m: (40.0, 1.25, -50.0), size_m: (3.0, 2.5, 3.0), color: "brick_red", anchorable: true, solid: true, landmark: false),
                (center_m: (48.0, 1.25, -50.0), size_m: (3.0, 2.5, 3.0), color: "brick_red", anchorable: true, solid: true, landmark: false),
                (center_m: (32.0, 1.25, 4.0), size_m: (3.0, 2.5, 3.0), color: "brick_red", anchorable: true, solid: true, landmark: false),
                (center_m: (40.0, 1.25, 4.0), size_m: (3.0, 2.5, 3.0), color: "brick_red", anchorable: true, solid: true, landmark: false),
                (center_m: (48.0, 1.25, 4.0), size_m: (3.0, 2.5, 3.0), color: "brick_red", anchorable: true, solid: true, landmark: false),
                (center_m: (88.0, 1.25, -30.0), size_m: (3.0, 2.5, 3.0), color: "brick_red", anchorable: true, solid: true, landmark: false),
                (center_m: (88.0, 1.25, -6.0), size_m: (3.0, 2.5, 3.0), color: "brick_red", anchorable: true, solid: true, landmark: false),

                // ---- The garrison headquarters — the main building, and you walk INTO it
                // The user, 2026-08-12: „auch das main gebäude in dem der gas und schwert
                // nachschub ist muss da sein (in das gebäude muss man rein laufen können.
                // drinnen sind die nachschübe)". Until today the hub was three pads on open
                // ground; this is the place they belong in.
                //
                // ## Where, and why here and not "wherever there is room"
                //
                // A garrison headquarters holds the gate and it holds the supply. This one
                // stands **on the west side of the main street, one block inside the inner
                // gate**, its front door on the two-gate axis and the market square with the
                // church directly opposite: the civic centre of the district, at the point
                // every sortie passes through anyway. Its back is the canal quay (x = -55),
                // which is how a depot took delivery before it took lorries.
                // The player's spawn point (0, 2, 0) stands **15 m in front of the door and
                // looking at it**.
                //
                // ⚠️ The site is bounded on all four sides and the numbers are not free:
                //   x >= -47   the canal quay ends at x = -55, and the bridges reach x = -52
                //   x <= -15   the main street apron runs x = -15..15; the facade is flush
                //              with it, so the door opens straight onto the pavement
                //   |z| <= 13  the gantry columns of the swing spine stand at z = +-13.5..21.5
                //              (x = -18..-10). Half a metre of clearance, and it is the reason
                //              the hall is 26 m deep and not 40.
                //
                // ## THERE IS NO SUBTRACTION — the doorway is a GAP, not a hole
                //
                // `FIND-056` records what this costs when it is forgotten: the wall's decorative
                // plinth was emitted across the full run while the courses above it carried the
                // openings, and the gate measured `height 2.000` — solid. So the east facade is
                // **three blocks and not one**: a south segment, a north segment and a lintel
                // that starts at y = 4.5. Nothing else in this building crosses z = -3..3 at
                // x = -16.5..-15. The one thing that does run through the opening is the base
                // slab, and it is 0.15 m of floor, deliberately (see below).
                //
                // ## The base slab does three jobs and that is why it is one block
                //
                // 1. It is the **floor** — a depot floor a foot above the street, which is what
                //    keeps stores dry and what a threshold is.
                // 2. It is the **apron**: a generated house is dropped as soon as a placed block
                //    overlaps it, and 8 m of row house against a roof at 11.0 m does NOT overlap.
                //    Without the slab the layout builds houses inside the hall.
                // 3. It is the **measurement**: 0.15 m is the only floor height in this map
                //    (ground 0.0, aprons 0.05, quays and bridges 0.4), so `assert height > 0.10`
                //    in `scripts/f019-hq.txt` is a position bracket that only the interior
                //    satisfies. The step at the door is 0.10 m against a 0.35 m capsule radius —
                //    below the radius, so the capsule rides over it instead of catching on it.
                (center_m: (-31.0, 0.0, 0.0), size_m: (32.0, 0.3, 26.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                // the four walls. 10 m to the eaves, so the hall is 10 m in the clear — the
                // roof is the 1.5 m slab on top and the ridge lands on 11.5 m exactly, which is
                // `scale.ron: architecture.heights_m house_large`. **No invented height**: the
                // user has written 4.5 / 8 / 11.5 / 12 / 35 and nothing else, and a landmark
                // height for this building is a question for him (FIND-060 §2), not a number
                // for me. `landmark: false` therefore holds and the guard in tests/data.rs
                // still applies to it.
                //
                // ⚠️ All of them `anchorable: true`, and that is not laziness. The roof stands
                // over the centre of every one of them, and a tagged surface with something on
                // its roof centre is a lie in the map —
                // `tests/world.rs::f003_no_anchorable_block_has_another_block_sitting_on_its_roof_centre`.
                // **The roof is the anchor.**
                //
                // ⚠️ **This used to say "the interior is not tagged either … nothing outside can
                // reach an interior wall". Both halves are false since 2026-08-13.** All 31
                // interior blocks are anchorable now — the user: *"es ist extrem wichtig dass man
                // wirklich überall sein seil festmachen kann. also überall! ohne ausnahmen!"* —
                // and the reachability claim was simply wrong: `tests/world.rs::f019_the_tagged_interior_is_reachable_through_the_door`
                // measures a rope going straight in through the doorway from the street and
                // landing on `block_183` at x = −45.55, i.e. the back wall of the hall.
                // A tagged surface nothing can hook would still be a lie in the map (`FIND-059`);
                // that guard is what now proves this one is not.
                // west (back) wall — the canal side
                (center_m: (-46.25, 5.0, 0.0), size_m: (1.5, 10.0, 26.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                // east facade, south of the door
                (center_m: (-15.75, 5.0, -8.0), size_m: (1.5, 10.0, 10.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                // east facade, north of the door
                (center_m: (-15.75, 5.0, 8.0), size_m: (1.5, 10.0, 10.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                // the lintel over the gate. It starts at y = 4.5, so the opening is **6 m wide
                // and 4.5 m high**: a 1.8 m player with a 0.35 m capsule walks through it
                // without aiming, and so does the cart the depot exists for.
                (center_m: (-15.75, 7.25, 0.0), size_m: (1.5, 5.5, 6.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                // north and south walls, spanning only BETWEEN the two side walls: a corner
                // built twice is a z-fight and a doubled collider.
                (center_m: (-31.0, 5.0, 12.25), size_m: (29.0, 10.0, 1.5), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (-31.0, 5.0, -12.25), size_m: (29.0, 10.0, 1.5), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                // ⭐ the roof, and it is the one tagged surface of the building: 32 x 26 m of
                // sand_brown at 11.5 m, the colour every anchorable slab in this map wears.
                // Arriving by air is the natural way in — from the gantry beam at 60 m over the
                // street it is one shot, and the hall's own door is 15 m from the spawn point.
                (center_m: (-31.0, 10.75, 0.0), size_m: (32.0, 1.5, 26.0), color: "sand_brown", anchorable: true, solid: true, landmark: false),
                // four posts carrying the roof of a 29 x 23 m hall. They stand at z = +-8, so
                // the aisle from the door to the back wall (z = -3..3) is 29 m of clear floor.
                (center_m: (-38.0, 5.0, -8.0), size_m: (2.0, 10.0, 2.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (-24.0, 5.0, -8.0), size_m: (2.0, 10.0, 2.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (-38.0, 5.0, 8.0), size_m: (2.0, 10.0, 2.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (-24.0, 5.0, 8.0), size_m: (2.0, 10.0, 2.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                // ---- The resupply, inside, against the back wall -----------------------
                // ⚠️ **Furniture, not stations.** These racks are what the player walks up
                // to; the `RefuelStation` entities that make them work are wired in
                // `src/mission/hub.rs` out of `missions.ron: hub.refuel_stations`, and that is a
                // separate hand. The coordinates they should take stand in `missions.ron` next
                // to the three that are still out on the pavement.
                //
                // ## ⭐ Two footprints, two SILHOUETTES — and why that is the whole fix
                //
                // Until 2026-08-13 both of them were literally the same line twice:
                // `size_m: (5, 1.2, 9), color: "brick_red"`. `FIND-080` lit the room and then
                // measured what the light could not buy: *"yes for 'those are boxes and they are
                // furniture', still no for 'that one is gas, that one is blades'"* — and the
                // pixels agreed, the two racks came out **identical to the level: 92.8 / 92.8,
                // 0.0 sRGB levels and 0.0 degrees of hue apart** (`f019-hq-racks-before.png`,
                // tick 592, mid-aisle looking west).
                //
                // ⚠️ **Colour is scarce here and shape is free.** The three signal colours
                // (cyan, amber, crimson) are gameplay only — a cyan gas rack is exactly the
                // "no cyan set dressing" rule this file keeps in two blocks so it can be a test
                // — and the palette holds five hues for the whole district. But every object in
                // this world is a cuboid, so a second cuboid costs nothing: **a row of fat
                // drums is not a row of thin plates**, at any distance, in any light, and for a
                // colour-blind player too.
                //
                // ⚠️ **The FOOTPRINTS are unchanged** — x = -44.5 .. -39.5, z = -11..-2 and
                // 2..11, and both bases still cover the whole 5 x 9 m at floor level. That is
                // deliberate: `missions.ron: hub.refuel_stations` puts the two triggers on the
                // AISLE FACES at (-42, 0.15, -+2), and `tests/mission.rs`
                // ::f019_a_supply_station_has_floor_you_can_actually_stand_on_inside_its_reach
                // scans standable 0.25 m cells against these solids. Nothing here moved in x or
                // z and nothing changed what a foot can stand on; only what an eye sees.
                //
                // ⚠️ **The face you build for is the +X face, not the +Z one.** The aisle runs
                // in X and both bays sit at its western end, so a player walking in sees the
                // 9 m long `+X` side of each — that is the two low bands in the "before" shot.
                // The first attempt gave the blades `size_m: (0.16, 1.5, 0.9)`, thin in X, and
                // they came out as six 0.9 m LOCKER DOORS: from the aisle you see the (y, z)
                // face, so **z is the width on screen and x is only the thickness**.
                //
                // ---- GAS, south of the aisle: four bottles on a skid ------------------
                // The Vector Gear's tanks. Fat, upright, repeated, wide-spaced — and each one
                // carries a narrower `stone_gray` collar on top, because a body plus a neck is
                // what makes a cuboid read as a pressure bottle instead of a crate.
                // `olive_green` is the only hue in the palette that is neither the stone of the
                // hall nor the wood of the bench opposite, and it is not a signal colour.
                //
                // The skid carries the floor footprint (0.15 .. 0.45 m); the bottles stand on
                // it and reach 2.60 m, so a 1.75 m eye looks UP at them.
                (center_m: (-42.0, 0.30, -6.5), size_m: (5.0, 0.3, 9.0), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                // 2.4 m pitch, 1.3 m bottle: 1.1 m of air between each pair, and the row runs
                // the full 9 m of the bay. The nearest one stops at z = -2.25, clear of the
                // aisle and of the station trigger that sits on the face at z = -2.
                (center_m: (-42.0, 1.35, -10.1), size_m: (1.3, 1.8, 1.3), color: "olive_green", anchorable: true, solid: true, landmark: false),
                (center_m: (-42.0, 1.35,  -7.7), size_m: (1.3, 1.8, 1.3), color: "olive_green", anchorable: true, solid: true, landmark: false),
                (center_m: (-42.0, 1.35,  -5.3), size_m: (1.3, 1.8, 1.3), color: "olive_green", anchorable: true, solid: true, landmark: false),
                (center_m: (-42.0, 1.35,  -2.9), size_m: (1.3, 1.8, 1.3), color: "olive_green", anchorable: true, solid: true, landmark: false),
                // the collars — 0.5 m on a 1.3 m body, sitting ON it at 2.25 m and not in it.
                (center_m: (-42.0, 2.425, -10.1), size_m: (0.5, 0.35, 0.5), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (-42.0, 2.425,  -7.7), size_m: (0.5, 0.35, 0.5), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (-42.0, 2.425,  -5.3), size_m: (0.5, 0.35, 0.5), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (-42.0, 2.425,  -2.9), size_m: (0.5, 0.35, 0.5), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                //
                // ---- BLADES, north of it: a bench, a back panel, five pairs -----------
                // The opposite reading in every axis: LOW where the gas is tall, MANY and THIN
                // where the gas is four fat bodies, PALE where the gas is dark. A blade is
                // 0.20 m of width and 1.3 m of height seen from the aisle — 1:6.5, which is a blade
                // and not a plank (0.35 x 0.9 was tried and read as a shelf board)
                // nobody mistakes it for a door, and they stand in **pairs**, 0.15 m apart,
                // because a Vector Gear carries two (`gear.ron: blades.start_pairs` is 5, and
                // that is exactly how many pairs hang here).
                (center_m: (-42.0, 0.55, 6.5), size_m: (5.0, 0.8, 9.0), color: "sand_brown", anchorable: true, solid: true, landmark: false),
                // the panel stands ON the bench (0.95 .. 2.55 m), not through it — a coincident
                // face inside another box is a z-fight, and the two share the x = -44.5 plane.
                // Dark, because the blades in front of it are the pale thing.
                (center_m: (-44.2, 1.75, 6.5), size_m: (0.6, 1.6, 9.0), color: "brick_red", anchorable: true, solid: true, landmark: false),
                // ten blades = five pairs. 0.30 m inside a pair, 1.8 m from pair to pair, and
                // 0.125 m of air between the blades and the panel behind them.
                (center_m: (-43.75, 1.60,  2.75), size_m: (0.05, 1.3, 0.20), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (-43.75, 1.60,  3.05), size_m: (0.05, 1.3, 0.20), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (-43.75, 1.60,  4.55), size_m: (0.05, 1.3, 0.20), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (-43.75, 1.60,  4.85), size_m: (0.05, 1.3, 0.20), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (-43.75, 1.60,  6.35), size_m: (0.05, 1.3, 0.20), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (-43.75, 1.60,  6.65), size_m: (0.05, 1.3, 0.20), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (-43.75, 1.60,  8.15), size_m: (0.05, 1.3, 0.20), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (-43.75, 1.60,  8.45), size_m: (0.05, 1.3, 0.20), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (-43.75, 1.60,  9.95), size_m: (0.05, 1.3, 0.20), color: "stone_gray", anchorable: true, solid: true, landmark: false),
                (center_m: (-43.75, 1.60, 10.25), size_m: (0.05, 1.3, 0.20), color: "stone_gray", anchorable: true, solid: true, landmark: false),

                // ================================================================================
                // ⭐ THE MUSTER YARD — 2026-08-26, and the reason it exists is one sentence
                // ================================================================================
                //
                // > „zudem gibt es auch noch keine lobby. mit lobby mein ich auch rumlaufen.
                // > also eher eine art hub." — the user, and it is the SECOND time he has said
                // > the lobby is missing.
                //
                // Both times we solved a different problem. The first time it was read as a
                // routing hole and the title screen's *Play* was pointed at the mission-list
                // SCREEN; this sentence is him saying that made it worse. By *lobby* he means
                // **a place you walk around in**, and the hub is one — it just was not
                // anywhere. Measured before this block existed: of Ashgate's 2871 blocks,
                // **not one** stood within 30 m of the point the player spawns on. Six amber
                // circles, two racks behind a wall 15 m away, and 60 m of empty stone apron in
                // every direction. That is a configuration, not a place, and it is exactly why
                // he can stand in a hub and report that there isn't one.
                //
                // ## What is here, and why each group is where it is
                //
                //   the garrison front  banners flat on the facade, a lantern each side of the
                //                       gate, two sentries at the door — the hall stops being
                //                       a grey slab with a hole in it and reads as a front
                //   the pad row         two signposts BEHIND the three z = 16 doors and two
                //                       lanterns short of them, so the row of circles has a
                //                       silhouette from the spawn point and not only a colour
                //   the yard            a signpost at the spawn (the first thing you see when
                //                       you turn round), lanterns marking the yard's edges
                //   the work corner     two handcarts, five crates, three gas drums — a depot
                //                       that takes deliveries. It is 10..20 m south-east, i.e.
                //                       somewhere you WALK to, which is the whole point
                //   the market corner   three stalls reaching in from the market square at
                //                       x = 24, so the yard has a direction that is not a pad
                //
                // ## ⚠️ FOUR RULES, and three of them are `FIND-162` written out
                //
                // 1. **A clear radius answers the GENERATOR, never the level designer.** That
                //    is what `FIND-162` cost: two pads at (-18, 0, ±8) passed the
                //    `clear_radius_m` check and stood behind the garrison hall's east wall,
                //    which this file places by hand. Nothing said so. So every prop below was
                //    checked against the hall, the gantry frames and every other placed block
                //    for overlap — 0 — and against the straight line from the spawn point to
                //    each of the six pads — the tightest is 2.0 m of daylight to a block EDGE.
                //    ⚠️ It is now a test and not a habit:
                //    `tests/world.rs::f156_every_deployment_pad_can_be_walked_to_from_the_hub_
                //    spawn_in_a_straight_line` measures every pad in `missions.ron` against
                //    every placed block in this file, so a crate put down tomorrow in front of
                //    an old door goes red the same day.
                // 2. **The four scripted walks are geometry, not suggestions.**
                //    `scripts/f070-hub.txt` and `f175-loop.txt` hold `W` from the spawn point
                //    along `x = 0, z = 0..20` and `z = 0, x = 0..-47`; `f072-breach.txt` and
                //    `f185-parcours.txt` walk the diagonals to (-10, 0, ±8). Every prop here
                //    keeps **2.0 m** from all four lanes, measured to its edge.
                // 3. **Nothing goes past 29 m from the origin.** `terrain.flat_radius_m` is 30
                //    and a placed block taller than `paving_top_m` pins its terrain cell flat —
                //    a prop at 35 m would quietly re-cut the terrace ring around the hub.
                // 4. **Every size below is a MODEL's own measured extent**, not a shape
                //    somebody liked: `world::map::PLACED_DRESSING` dresses a placed block by
                //    (palette key, proportion), so a box drawn at the file's own
                //    `hit.min`/`hit.max` extent IS the model — collider, anchor surface and
                //    mesh are one silhouette, and the fit is exact rather than inside the 25 %
                //    tolerance a found match has to live with. `art.ron` carries the file per
                //    row and the numbers are held down by
                //    `f156_the_placed_dressing_catalogue_is_what_the_glb_files_really_measure`.
                //
                // ⚠️ **The sentries STAND.** They are `a-136-npc-vanguard` on a block, which is
                // set dressing; the drop ships zero animation clips and nothing here walks,
                // talks or has a name. Anything that did would be a feature nobody specified.
                //
                // ⚠️ **All of them anchorable**, like everything else in this map — *„überall!
                // ohne ausnahmen!"*. A 4.2 m lantern is the first thing in the hub that is
                // worth hooking, which is not nothing: the yard was previously a place where
                // the Vector Gear had exactly one target, the hall roof at 11.5 m.

                // -- the garrison front: the hall stops being a slab with a hole in it
                (center_m: (-14.2, 2.1, 4.8), size_m: (1.24, 4.2, 0.68), color: "brick_red", anchorable: true, solid: true, landmark: false),
                (center_m: (-14.2, 2.1, -4.8), size_m: (1.24, 4.2, 0.68), color: "brick_red", anchorable: true, solid: true, landmark: false),
                (center_m: (-14.2, 2.1, 8.0), size_m: (0.64, 4.2, 0.64), color: "roof_slate", anchorable: true, solid: true, landmark: false),
                (center_m: (-14.2, 2.1, -8.0), size_m: (0.64, 4.2, 0.64), color: "roof_slate", anchorable: true, solid: true, landmark: false),
                (center_m: (-13.6, 0.905, 2.9), size_m: (0.68, 1.81, 0.62), color: "olive_green", anchorable: true, solid: true, landmark: false),
                (center_m: (-13.6, 0.905, -2.9), size_m: (0.68, 1.81, 0.62), color: "olive_green", anchorable: true, solid: true, landmark: false),

                // -- the pad row at z = 16: signposts BEHIND the doors, lanterns short of them
                (center_m: (4.5, 1.8, 20.5), size_m: (2.26, 3.6, 1.63), color: "sand_brown", anchorable: true, solid: true, landmark: false),
                (center_m: (-4.5, 1.8, 20.5), size_m: (2.26, 3.6, 1.63), color: "sand_brown", anchorable: true, solid: true, landmark: false),
                (center_m: (4.5, 2.1, 13.0), size_m: (0.64, 4.2, 0.64), color: "roof_slate", anchorable: true, solid: true, landmark: false),
                (center_m: (-4.5, 2.1, 13.0), size_m: (0.64, 4.2, 0.64), color: "roof_slate", anchorable: true, solid: true, landmark: false),
                (center_m: (-4.5, 0.905, 18.0), size_m: (0.68, 1.81, 0.62), color: "olive_green", anchorable: true, solid: true, landmark: false),

                // -- the yard itself: the signpost at (3.6, -4.2) is what you see when you
                //    turn round on the spawn point, and the lanterns give the yard an edge
                (center_m: (3.6, 1.8, -4.2), size_m: (2.26, 3.6, 1.63), color: "sand_brown", anchorable: true, solid: true, landmark: false),
                (center_m: (12.0, 2.1, -6.0), size_m: (0.64, 4.2, 0.64), color: "roof_slate", anchorable: true, solid: true, landmark: false),
                (center_m: (3.0, 2.1, -15.0), size_m: (0.64, 4.2, 0.64), color: "roof_slate", anchorable: true, solid: true, landmark: false),
                (center_m: (19.0, 2.1, -14.0), size_m: (0.64, 4.2, 0.64), color: "roof_slate", anchorable: true, solid: true, landmark: false),
                (center_m: (8.6, 0.905, -4.0), size_m: (0.68, 1.81, 0.62), color: "olive_green", anchorable: true, solid: true, landmark: false),
                (center_m: (19.5, 0.905, -1.0), size_m: (0.68, 1.81, 0.62), color: "olive_green", anchorable: true, solid: true, landmark: false),

                // -- the work corner, 10..20 m south-east: a depot that takes deliveries.
                //    ⚠️ It is deliberately NOT next to the door — a prop you stand on top of
                //    from the spawn point is scenery; one you have to walk to is a place.
                (center_m: (9.0, 0.9, -10.0), size_m: (2.4, 1.8, 4.8), color: "sand_brown", anchorable: true, solid: true, landmark: false),
                (center_m: (5.5, 0.9, -11.0), size_m: (2.4, 1.8, 4.8), color: "sand_brown", anchorable: true, solid: true, landmark: false),
                (center_m: (7.4, 0.3, -7.2), size_m: (0.6, 0.6, 0.6), color: "sand_brown", anchorable: true, solid: true, landmark: false),
                (center_m: (8.1, 0.3, -6.5), size_m: (0.6, 0.6, 0.6), color: "sand_brown", anchorable: true, solid: true, landmark: false),
                (center_m: (12.0, 0.3, -12.5), size_m: (0.6, 0.6, 0.6), color: "sand_brown", anchorable: true, solid: true, landmark: false),
                (center_m: (12.8, 0.3, -12.0), size_m: (0.6, 0.6, 0.6), color: "sand_brown", anchorable: true, solid: true, landmark: false),
                (center_m: (13.9, 0.3, -11.3), size_m: (0.6, 0.6, 0.6), color: "sand_brown", anchorable: true, solid: true, landmark: false),
                // 1.4 m pitch on a 1.3 m drum: 0.1 m of air, so the row reads as a row.
                (center_m: (16.5, 0.9, -8.6), size_m: (1.3, 1.8, 1.3), color: "olive_green", anchorable: true, solid: true, landmark: false),
                (center_m: (16.5, 0.9, -10.0), size_m: (1.3, 1.8, 1.3), color: "olive_green", anchorable: true, solid: true, landmark: false),
                (center_m: (16.5, 0.9, -11.4), size_m: (1.3, 1.8, 1.3), color: "olive_green", anchorable: true, solid: true, landmark: false),

                // -- the market corner: the square's own stalls (x = 32..48) reaching in, so
                //    the yard has a direction east that is not a deployment pad
                (center_m: (20.0, 1.25, -5.0), size_m: (3.0, 2.5, 3.0), color: "brick_red", anchorable: true, solid: true, landmark: false),
                (center_m: (20.0, 1.25, -11.0), size_m: (3.0, 2.5, 3.0), color: "brick_red", anchorable: true, solid: true, landmark: false),
                (center_m: (22.0, 1.25, 3.0), size_m: (3.0, 2.5, 3.0), color: "brick_red", anchorable: true, solid: true, landmark: false),

                // ---- Deleted 2026-08-12: the hand-placed row housing and the pocket ----
                // 75 detached boxes stood here — a 20 m pitch along the main street and a
                // 24 m pitch in the pocket, each one an island with an untagged ridge cap on
                // its roof centre. They were the 28 unhookable crowns of `FIND-059` and half
                // of "boxes on a lawn" in the screenshot of `FIND-056`.
                //
                // The closed-block layout builds both quarters now, at a 43 m block pitch
                // with party walls and a 7 m street, and it builds them denser than the hand
                // placement did. Whoever wants a pitched roof back builds it as body + cap
                // **with the cap anchorable and the body not** — a tagged surface with
                // something standing on its centre is a lie in the map, and
                // `tests/world.rs::f003_no_anchorable_block_has_another_block_sitting_on_its_roof_centre`
                // now says so out loud.
            ],

            // ================================================================================
            // THE LAMPS IN THE GARRISON HALL — the one interior in this map, and the reason
            // this list exists at all
            // ================================================================================
            //
            // The user, 2026-08-12: „auch das main gebäude in dem der gas und schwert nachschub
            // ist muss da sein (in das gebäude muss man rein laufen können. drinnen sind die
            // nachschübe)". You can walk in — `scripts/f019-hq.txt` proves it with 13 asserts —
            // and until today you could not SEE what was in there.
            //
            // `docs/FINDINGS.md` FIND-078 measured why, and the answer was not "it is dark":
            // the hall's back wall read 51.9 and an EXTERIOR wall in shadow read 51.5 in the
            // same frame. A roofed room is not darker than a shadow; it has nothing bright to
            // read against. Ambient cannot fix that — 5x the fill buys 5.8 sRGB levels, costs
            // the exterior its shadows 1:1, and at 12000 the racks are still flat rectangles,
            // because a directionless fill gives nothing a lit face and a dark one.
            //
            // ## The geometry these two numbers are derived from
            //
            //   hall interior   x = -45.5 .. -16.5   z = -11.5 .. 11.5   floor 0.15, ceiling 10
            //   gate            x = -16.5 .. -15     z = -3 .. 3         4.5 m to the lintel
            //   the racks       x = -44.5 .. -39.5   z = -11..-2 and 2..11, 1.35 m tall
            //   the aisle       z = -3 .. 3, clear from the door to the back wall
            //
            // Both lamps hang at **y = 8.5** — 1.5 m under the roof slab, over the aisle at
            // z = 0, so each rack is lit from ABOVE AND FROM THE SIDE. That is the whole point:
            // the top face and the aisle flank come up, the outboard flank stays on the fill,
            // and a box with two values is a shape instead of a rectangle.
            //
            // ## ⚠️ Why this does not brighten one pixel of the district
            //
            // A point light without shadows is unoccluded — it reaches every fragment inside
            // `range_m`, wall or no wall. It is **Lambert** that contains it, not the wall: the
            // OUTER face of every wall of this hall points away from a lamp inside it, so
            // `NdotL <= 0` and it takes nothing at any range. The faces that could leak are the
            // ones pointing UP — street, aprons, quays — and `range_m` is what keeps those out,
            // because Bevy's attenuation `(1 - (d/r)^4)^2 / d^2` is a HARD cut-off at d = r.
            //
            // Measured against every one of the 232 placed blocks of this map: the nearest
            // exterior surface that faces either lamp at all is the ground slab's top at y = 0
            // directly beneath it — and that is buried under the hall's own 0.3 m floor. The
            // nearest exterior surface anyone can SEE is the street apron at x = -15:
            //   lamp east  d = 14.68 m  vs range 11.0   (3.7 m of margin)
            //   lamp west  d = 23.6 m   vs range 14.0   (9.6 m of margin)
            //
            // ## ⚠️ `shadows: false`, and that is the measured choice
            //
            // A shadow-casting point light costs a CUBE map: six depth passes over everything
            // in range, per light, per frame (`docs/lessons/performance.md` rule 5 — the switch
            // that is never thrown without a number). The hall holds four posts and two racks
            // and no occluder whose shadow carries information; the racks shade their own far
            // side by Lambert alone, which is the cue that was missing. Two shadowless lamps
            // measured 0.0 ms against the same scene without them.
            lights: [
                // WEST — over the aisle between the two racks. This is the lamp that makes the
                // back of the hall the bright thing the racks read against, and that puts a lit
                // top edge on each of them.
                (center_m: (-37.0, 8.5, 0.0), color: "lamp_warm", intensity_lm: 35000000.0, range_m: 14.0, shadows: false),
                // EAST — over the walk in from the gate, so the floor ahead of a player who
                // steps through the door is lit and the room has depth instead of one far wall.
                // Its range is the tighter of the two only because it stands 12 m from the
                // door: 11.0 keeps the sphere off the street apron with 3.7 m to spare.
                (center_m: (-27.0, 8.5, 0.0), color: "lamp_warm", intensity_lm: 35000000.0, range_m: 11.0, shadows: false),
            ],

            // ================================================================================
            // F-019 — NACHSCHUB-STATIONEN. Four of them, and their placement is the feature.
            // ================================================================================
            // Q-044 measured the hole: at the honest tank a sortie buys ~16.7 s of held boost
            // against a 330 s mission, and until this list existed **there was no refuel
            // anywhere outside the headquarters**. The user's own answer to Q-033 says refills
            // happen away from base; the racks in the hall are base.
            //
            // ⚠️ Placement rule, and it is why these four coordinates and not four others:
            // **a station stands ON THE SWING SPINE, not beside it.** The gantry line runs
            // along x = 0 from z = 227.5 to z = -87.5 (the pillars sit at x = ±14, so x = 0 is
            // 10 m of clear street between them), and that lane is the route a player actually
            // flies. A station off the route is a station nobody visits; a station on it is a
            // decision — dive out of the swing, stand still for 1.5 s, climb back in.
            //
            // The pitch is ~85 m, i.e. **a little under one hook range** (90 m,
            // scale.ron: vector.anchor_range_m). That is deliberate: from any station the next
            // one is inside a single rope, so the supply line is a chain you can fly rather
            // than a set of places you have to remember.
            //
            //   z = 45     the first one out of the gate. This is the one
            //              `scripts/f019-supply.txt` measures against.
            //   z = 105    mid-lane, under the gantry at z = 122.5
            //   z = 190    the far north end, one rope short of the z = 227.5 gantry
            //   the fourth is deliberately OFF the lane, at (-30, 2, -60): the route to the
            //              wall gallery has to have one too, or the whole south of the district
            //              is a place you can only leave.
            //
            // y = 2.0, not 0: the trigger is a 6 m sphere (gear.ron: resupply.station_radius_m)
            // measured in 3D from the centre, so lifting it clear of the ground slab gives a
            // player who arrives 4 m up the same catch as one who lands on it.
            // ---- F-012: where this map ENDS -----------------------------------------
            // The user, 2026-08-27: *„und man kann an der seite einfach runterfallen!"*, and
            // asked what should be there he named both halves:
            // *„unsichtbare wand + wenn man runterfaellt wegen bug teleport man zurueck!"*
            //
            // They are two mechanisms and not one thing twice. The fence is what normal play
            // runs into. The recovery plane is what catches somebody the fence has ALREADY
            // failed to hold — a warp, a seam, a body that got put somewhere by hand. Written
            // as "the wall, and then the wall again" this feature does nothing for the case it
            // was actually asked for.
            //
            // ## fence_thickness_m 10.0 — a tunnelling budget, not a taste
            //
            // At `vector.max_speed_m_s` 75, `simulation_hz` 60 and `game.ron: substeps` 24, a
            // body advances 75 / (60 * 24) = **0.0521 m per substep**. Ten metres is 192 of
            // those, and `MaxLinearSpeed` on the player makes 75 a hard ceiling, so there is no
            // faster case to budget for. `tests/world.rs` does this arithmetic rather than
            // trusting this paragraph.
            //
            // ## fence_top_m 200.0 — and it is NOT a ceiling, because there is no such thing
            //
            // 🔴 It stood here under the sentence *"far above anything the gear reaches on gas
            // alone"*, and that sentence was **false**. Measured 2026-08-28, `W` + `Shift` held
            // from a standing start at (0, 2, 0), looking straight up:
            //
            //   1 s 12.2 · 2 s 49.9 · 3 s 54.6 · 4 s 71.7 · 5 s 114.5 · 6 s 182.5 ·
            //   7 s 259.3 · 8 s 336.3 m — over this fence in **under seven seconds**
            //
            // and the gas for the first six of those seconds was 15000.000 -> 14891.771:
            // **0.72 % of one tank.** Worse, there is no apex to quote: held long enough the
            // body simply sits at `vector.max_speed_m_s` going up. Ten seconds of steady climb
            // measured **748.9 m for 179.88 gas**, i.e. 4.163 m per unit of gas — so one full
            // tank is worth **62 580 m** here (`gear_ceiling_m` below, and
            // `tests/player.rs::f012_the_gear_climbs_higher_than_the_fence_and_the_number_is_pinned`
            // re-flies it every run). The 200 here is beaten by a factor of **313**.
            //
            // ⚠️ **And raising it is not the fix, which is why it did not get raised.** A taller
            // fence still has a top face, and that top face is a solid, invisible, standable
            // ring `fence_thickness_m` wide OUTSIDE the map: a body put on it at 200 m rested
            // there indefinitely, recorded by nothing and recovered by nothing. Every height is
            // a height somebody beats, and each one brings its own ledge.
            //
            // What closes it is `player::recovery::out_of_the_world`: **outside the map's own
            // footprint is out of the world at any height.** That leaves this number free to be
            // what it should have been all along — as tall as normal play needs and no taller,
            // 80 m over the 120 m wall, so that walking and swinging along the coping meet a wall and
            // not a teleport.
            //
            // It stops where it does for a second reason that is measured and not aesthetic:
            // the fence is a collider, so an aim ray sees it, and
            // `tests/vector_hooks.rs::f028_a_failed_pull_says_which_of_the_four_it_was` fires
            // a level ray from **400 m** up and needs the answer "open sky" and then "out of
            // reach" from a wall 900 m out. A fence to infinity turns both of those into
            // "the surface holds nothing" — the feature would have broken the test that
            // exists to keep the four miss reasons apart.
            //
            // ## recovery_plane_y_m — a DEPTH, and that is the whole discriminator
            //
            // Not a fall distance and not a speed: a player diving off the 120 m wall is not
            // falling out of the world, and the only thing that separates the two honestly is
            // how far down he gets. The plane sits under the deepest block this map has (see
            // the per-map number below), so no surface in the game can be reached from below
            // it, and `tests/world.rs` asserts exactly that against the planned geometry.
            //
            // Ashgate is 700 x 700 m: the two ground slabs end at +-350 and the deepest block
            // in the file is the channel floor, underside **-4.2 m**. The plane at -300 is
            // 295.8 m below it. ⚠️ It is also below where `scripts/f030-hitbox.txt` flies:
            // that script warps into the void at z = 600..1200 and falls to about **-153 m**
            // during its longest act, so it clears the plane by 147 m and keeps working. A
            // shallower plane would have recovered the player in the middle of a hitbox
            // measurement (`docs/FINDINGS.md` FIND-199).
            bounds: (
                // ## fence_margin_m 0.18 — DERIVED, bracketed by two measurements, and it is
                // ## the one-character bug of 2026-08-29
                //
                // 🔴 It was 0.0: the fence's inner face stood exactly ON the map's edge, and
                // `player::recovery::out_of_the_world` tests `|x| > hx`, **strictly**. So the
                // line |x| = 350.000 — the inner lip of the widest floor in the district — was
                // a solid invisible standable surface the rule called *in the world*. Measured
                // on the shipped binary: `warp 350 201 0` rested at **200.000** after 3 s and
                // after 10 s, all four sides and a corner the same, 6 s of held `W` did not
                // move him; `warp 349.999 201 0` rested at 199.965, a millimetre inside.
                // `record_safe_ground` then made the ring home — "back to Vec3(350.0,
                // 200.49994, 0.0), the ground he stood on at tick 426" — and every later
                // recovery of the session, from any cause, delivered the player onto the ledge.
                // One nudge outward from it warped him **1501 times, one per tick, 25.0 s**.
                //
                // ## Why the move is 0.18 m and not "any number above zero"
                //
                // Because a capsule does not rest on the point under its origin; it rests on
                // its bottom sphere, and that sphere reaches over the lip. Two measurements
                // bracket the number, both against avian and neither argued:
                //
                //     fence_rest_reach_m 0.10  <  fence_margin_m 0.18  <  radius_m 0.35
                //
                //   * below — `fence_rest_reach_m`, the budget for how far back over the lip a
                //     body may PARK. Measured 0.0000 m today: a body set down or dropped
                //     anywhere inside the lip slides off and falls into the map, because past
                //     the lip the contact normal tilts too far for friction to hold him. The
                //     budget is held at 0.10 because that number is avian's and not ours.
                //   * above — the solver holds a body pressed against the fence's inner face
                //     exactly `radius_m` inside it: **-0.3500 m** relative to the map's edge at
                //     `vector.max_speed_m_s`, to four decimals, at every height below the top
                //     face. A margin at or over 0.35 puts a legitimately fenced-in player
                //     outside the footprint and teleports him for playing.
                //
                // 0.18 is the geometric middle: either bound has to move by ~1.9x before it
                // bites, and both have a test that re-measures rather than a sentence.
                // ⚠️ The 0.18 m gap this opens between the ground's edge and the fence is not
                // a hole anybody can fall into — a body is 0.70 m wide — and it is 250 m deep
                // only in the sense that the fence spans -50 .. 200 m beside it.
                fence_margin_m: 0.18,
                // ## fence_rest_reach_m 0.10 — A MEASUREMENT, pinned the way gear_ceiling_m is
                //
                // How far back over the fence's inner lip a body may PARK — come to rest on
                // the top face and still be there ten seconds later — before `fence_margin_m`
                // stops covering it. **Measured 0.0000 m** on 2026-08-29 over 44 stances: past
                // the lip the contact normal tilts too far for friction and every body slid
                // off into the map. Held at 0.10 as budget, because friction is avian's number
                // and not ours, and because a 0.0892 m reading earlier the same day turned out
                // to be a fixture measuring a corner (`f32::signum(0.0)` is 1.0).
                // `tests/player.rs::f012_nothing_that_can_rest_on_the_fence_rests_inside_the_map`
                // re-measures it against a fence built 50 m INSIDE the map — where the recovery
                // cannot reach the bodies and therefore cannot flatter the number — and goes
                // red if the capsule, the friction or the solver ever move it. Re-measure and
                // write the new number here; that is the whole ritual.
                fence_rest_reach_m: 0.10,
                fence_thickness_m: 10.0,
                fence_bottom_m: -50.0,
                fence_top_m: 200.0,
                gear_ceiling_m: 62580.0,
                recovery_plane_y_m: -300.0,
                recovery_lift_m: 0.5,
            ),
            supply_stations: [
                // 🔴 **z = 45 and NOT z = 20, and a test is why.** The first placement put it
                // at z = 20 — 4.47 m from the `recruit` deployment pad at (0, 0, 16), which is
                // INSIDE the 6 m trigger. `tests/mission.rs::f072_a_station_is_a_hub_thing_and_
                // does_not_follow_you_into_a_sortie` went red with 166.7 gas appearing out of
                // nowhere in a running sortie, and it was right twice over: a field station on
                // the doorstep tops your tank up for free at the start of every mission, which
                // is the exact opposite of *„begrenzte Nachladungen"*.
                //
                // The rule that came out of it: **a station must clear every deployment pad by
                // `station_radius_m` + the pad's own `radius_m`** — 6 + 3 = 9 m here. z = 45 is
                // 29 m from the nearest pad and 45 m from the hub spawn, i.e. half a hook range
                // out of the gate, and the 45 -> 105 -> 190 pitch (60 m, 85 m) is still inside
                // one rope everywhere.
                (center_m: (0.0, 2.0, 45.0), uses: 3),
                (center_m: (0.0, 2.0, 105.0), uses: 3),
                (center_m: (0.0, 2.0, 190.0), uses: 3),
                (center_m: (-30.0, 2.0, -60.0), uses: 3),
            ],
        ),
    },
)
