                (center_m: (32.0, 1.25, -50.0), size_m: (3.0, 2.5, 3.0), color: "brick_red", anchorable: true, solid: true, landmark: false),
                (center_m: (40.0, 1.25, -50.0), size_m: (3.0, 2.5, 3.0), color: "brick_red", anchorable: true, solid: true, landmark: false),
