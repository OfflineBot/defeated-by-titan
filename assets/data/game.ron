// game.ron — tuning: Vector Gear, camera, physics.
//
// All lengths in METERS (1 Bevy unit = 1 meter, docs/conventions.md).
// The backlog counts in studs; the conversion happens HERE, once, at 0.28 m/stud
// (docs/QUESTIONS.md Q-002) — there are no studs in the code.
//
// ⚠️ UNTUNED. These numbers are starting values, not balancing. That is exactly what this
// file is for: changing them costs no rebuild. The P1 gate is a blind test against the
// reference work, and until that is passed nothing here is finished (bible 6.2).
//
// ⚠️ EXCEPTION: whatever comes from assets/data/scale.ron is NOT untuned — it is given by
// the user (2026-08-09) and only mirrored here so the game systems have a number.
// Affected are player.height_m, player.eye_height_m, camera.fov_deg and
// vector.hook_range_m. tests/data.rs falls over the moment one of them drifts away from
// scale.ron. **A direct figure in meters from the user beats any derivation** — including
// the conversion out of the backlog (Q-002).
(
    // 60 Hz fixed simulation. The image interpolates in between; over the network a
    // frame-dependent result is not a comfort problem, it is desync (init.md §6 rule 4).
    simulation_hz: 60.0,
    // Solver substeps per simulation step. avian's own default is 6
    // (avian3d-0.7.0/src/dynamics/solver/schedule.rs:185-191) — and that is measurably too
    // few for this game. 24 is the ONLY measured value that holds both ends at once: the
    // swing loses 4.26 %/s instead of 8.97 %/s at 6, and the worst wall penetration over 18
    // measured cases stays at -0.0043 m of the -0.01 m allowed. It costs 0.72 ms/tick with
    // 20 players in a 401-body city against a 4 ms budget.
    // NOT untuned — this number was measured. Whoever lowers it measures again.
    substeps: 24,
    gravity_m_s2: -20.0,   // harder than 9.81: momentum play, not simulation

    player: (
        // = scale.ron:reference.human_height_m. The user writes "check the capsule exactly!"
        // — so EXACTLY, not roughly: every size comparison in the image hangs on this number.
        height_m: 1.8,
        radius_m: 0.35,
        // P5. ⚠️ UNTUNED. Two ways to lose is the bar (docs/PLAN-GAME.md §1), and one of
        // them is this number reaching zero. 100 against a husk's damage of 34 means
        // **three strikes and you are down** — which is what makes a telegraphed wind-up
        // worth reading instead of tanking. A downed player is a STATE with a timer, not a
        // removed entity (shared::MovementState::Downed).
        health: 100.0,
        run_speed_m_s: 6.0,
        // 6.5 m/s at g = −20 give 6.5²/(2·20) = **1.056 m of apex**. That is enough for
        // neither a door (2.10 m; that would take 9.17 m/s) nor the eaves of the small
        // house (3.00 m). **Without gas you get on top of nothing in this city** — for a
        // Vector Gear game that is right, but it is a decision and not a side effect, and
        // that is why it stands here.
        jump_speed_m_s: 6.5,
        // F-006 air control. ⚠️ UNTUNED. Stood in Rust as `-gravity_m_s2 / 2` until
        // 2026-08-12 (docs/FINDINGS.md FIND-051) — a derivation is still a game value, and §4
        // says a game value lives here. **10.0 is half of -gravity_m_s2, deliberately: WASD
        // alone can never hold you up**, so what keeps a player airborne stays the rope and the
        // gas (docs/NEXT.md §1f, „bis das gas ausgeht"). Two bounds come out of that and both
        // survive the move: strictly **below 20** (= -gravity_m_s2), or gasless hovering is
        // free — tests/data.rs falls over on that one — and well below vector.boost_m_s2: 34,
        // or Shift stops being the strong option (10 is 29 % of it today).
        // ⚠️ Coupled: tests/player.rs::f014_the_input_still_steers_the_carried_momentum asserts
        // > 10° of turn and measures 11.22° — the margin is 1.22°, so anything below ≈10.6
        // takes that test red. That is the guard working, not flake.
        air_accel_m_s2: 10.0,
        air_accel_empty_fraction: 0.5,
        // What is left of it with an empty tank. ⚠️ UNTUNED, and **not a derivation — the
        // user's spec**: „ohne gas kann man immernoch w a d nutzen um etwas movement aufzubauen
        // (aber hälfte ca)" (docs/NEXT.md §1e). So the air control is not gated on gas, it only
        // gets weaker, and an empty tank stops being the dead end behind „seile ohne boost
        // bringen gar nichts". Dimensionless — no unit suffix.

        // ⚠️ THE NEXT THREE ARE NEW ON 2026-08-13 AND NOTHING READS THEM YET. They are the
        // numbers of the mixing rule (docs/NEXT.md §1B), which `W4` builds in
        // src/player/locomotion.rs. They stand here first, alone, so that the keys are frozen
        // before four agents start consuming them — and so that a missing one crashes on load
        // instead of being defaulted (§4: no serde(default) for a game value).
        //
        // The user, 2026-08-12: „wenn ich mit seilen festhake ... und w in die richtung drücke
        // will ich dass man deutlich mehr geboosted wird. also dass man dort richtig
        // hingezogen wird. wenn man aber a oder d drückt wird nach links/rechts geboostet!"
        //
        // ⚠️ UNTUNED. What `W` adds ON TOP of air_accel_m_s2 when a rope is anchored, pulling
        // along the rope direction. **3x the free-air control**, and both bounds are real:
        //   - strictly ABOVE air_accel_m_s2 (10), or „deutlich mehr geboosted" is a lie and
        //     the key buys nothing a rope-less player does not already have;
        //   - at most boost_m_s2 (34), or the free `W` outruns the boost you pay gas for and
        //     Shift stops being the strong option — the same bound air_accel_m_s2 carries,
        //     one rung higher. 30 is 88 % of the boost: unmistakably strong, still second.
        // tests/data.rs holds both ends.
        air_pull_m_s2: 30.0,
        // ⚠️ UNTUNED. What `A`/`D` add on top when a rope is anchored — on the horizontal
        // right vector, NOT the rope tangent (a tangent flips sign when the anchor passes
        // beside you and would invert the strafe mid-swing, docs/NEXT.md §1B).
        //
        // The bound is a SUM and that is the point: air_accel_m_s2 + air_lateral_m_s2 <= 34,
        // i.e. holding `D` alone may never beat one boost. 10 + 18 = 28 leaves 6 m/s² of head
        // room. Below air_accel_m_s2 it would not read as a „boost" at all; the floor is
        // therefore the same 10.
        air_lateral_m_s2: 18.0,
        // ⚠️ UNTUNED. How far above min_rope_m the rope pull has already faded to zero, in
        // metres of rope length. **This key exists because of a measured cliff, not a feeling:**
        // FIND-035 — at min_rope_m the constraint takes 17 m/s out of the player in ONE tick.
        // Thrusting straight at an anchor you are already 3 m from feeds exactly that cliff, so
        // the pull lets go before it: full strength at 15 m of rope, zero at 3 m.
        //
        // Two bounds, both derived and both in tests/data.rs:
        //   - >= 2 * min_rope_m (6 m), or the fade is shorter than the cliff it exists to avoid;
        //   - <= 0.1 * hook_range_m (50 m), or a "near the anchor" special case is running over
        //     a tenth of every rope in the game and the pull is no longer what steers a swing.
        air_pull_fade_m: 12.0,
        // 1.65 -> 1.60: the user gives the camera height directly
        // (scale.ron:camera.height_m). The old 1.65 was estimated from the body height;
        // a stated figure beats an estimate.
        eye_height_m: 1.6,
        // Largest distance per substep of the integrator. At max_speed_m_s = 75 a 60 Hz
        // tick covers 1.25 m — without substeps the player drives through every wall, and
        // only sometimes. Has to be strictly smaller than world.min_wall_m, or
        // tests/data.rs falls over. 0.25 m give 5 substeps at top speed.
        max_substep_m: 0.25,
        // ⚠️ UNTUNED, and INVENTED — no source, no measurement of its own. The reasoning:
        // on the ground the horizontal velocity is written directly (src/player/locomotion.rs),
        // so friction brakes nothing you want braked; what it WOULD brake is a swinging
        // player who grazes a wall, and a measurement puts that at 75 % of the speed per
        // second at a combined 0.65. The player therefore carries 0.0 and the combine rule
        // `Min`, so that no wall can put its own friction on him.
        // The consequence of `Min`: at exactly 0.0 this knob pins the combined value to 0,
        // whatever the wall carries. Above 0.0 it is a real knob again.
        friction: 0.0,
        // ⚠️ UNTUNED, but not invented: 0.0 is avian's own default and means "does not
        // bounce". A player who rebounds off a wall is a bug, not a feature.
        restitution: 0.0,
        // ⚠️ UNTUNED and INVENTED. How steep a surface may be and still count as ground.
        // **Measures nothing today:** every body in this world is an axis-aligned cuboid, so
        // every contact normal is exactly ±X, ±Y or ±Z, and every value strictly between 0
        // and 90 gives the identical result. The number becomes real the day a ramp does.
        max_ground_slope_deg: 50.0,
    ),

    vector: (
        // 112.0 -> 90.0. The 112 came out of 400 studs x 0.28 (Q-002). The user gives the
        // anchor range directly as **90 m** (scale.ron:vector.anchor_range_m), and a direct
        // figure in meters beats any derivation. Consequence for Q-002: 90/400 would be
        // 0.225 m/stud — the factor 0.28 still holds for everything the user has said
        // nothing about, but it has become questionable.
        // 90 -> 200 (scale.ron:vector.anchor_range_m, and tests/data.rs falls over if the two
        // ever drift apart). The user, 2026-08-10, after playing it: *"zudem muss die hook
        // range sehr viel laenger sein!"* — see docs/QUESTIONS.md Q-035 for why 200 and not
        // 400.
        // **200 -> 500 on 2026-08-12, and the number is his, verbatim**: „und das seil muss
        // deutlich deutlich schneller gespannt werden. nicht frame perfekt aber mit ca 500m pro
        // sekunde. mit der range 500 meter!" (docs/NEXT.md §1A). Same precedence rule as the
        // last two times — a direct figure in metres beats every derivation, including his own
        // earlier 90 and 200. It costs world.half_extent_m 600 -> 900, and that price is
        // written out down there rather than re-derived here.
        hook_range_m: 500.0,
        // 90 -> 160. NOT a taste change: it follows from the range. A hook is a projectile,
        // so at the old 90 m/s a shot to the new maximum range would take **2.22 s** to
        // arrive — longer than most of a swing, and long enough that the anchor you aimed at
        // is not where you are any more. 160 m/s holds the worst-case flight at 1.25 s, which
        // is what a 90 m shot cost before (1.0 s) plus a little. ⚠️ UNTUNED.
        //
        // **160 -> 500 on 2026-08-12, and this one is a stated speed, not a consequence**:
        // „mit ca 500m pro sekunde". It happens to be exactly what the range needs — 500/500 =
        // **1.0 s** of worst-case flight, back to what a 90 m shot cost in the very first
        // version — but that is a coincidence worth naming, not the reason. The reason is that
        // he asked for the two halves of one feeling at once: „(was instant sein soll)" and
        // „aber man soll sehen wie es aufspannt". 1 s at full range is fast enough to read as
        // instant at the 20-60 m most shots actually are (0.04-0.12 s) and still slow enough
        // that the line is drawn, not teleported.
        hook_speed_m_s: 500.0,
        // F-001 names „einziehend" as the fourth hook state; game.ron knew only the outward
        // flight so far. Faster than the outward flight, so a missed shot is not punished.
        // ⚠️ Pure starting value, no source (docs/QUESTIONS.md Q-016).
        //
        // **120 -> 500 on 2026-08-12.** The old rule „faster than the outward flight" is dead —
        // the outward flight is 500 now and „faster than instant" is not a number. What
        // replaces it is a bound with a player-visible meaning, and tests/data.rs holds it:
        // **hook_range_m / this <= 1.0 s**, i.e. a miss at maximum range is cleared up inside
        // one second. Above that the punishment for a bad shot is not the miss, it is the wait
        // — and §1A's whole first requirement is that firing again is never blocked.
        // At 500 the retract equals the shot: out and back is 2.0 s worst case, 0.24 s at the
        // 60 m a real miss happens at. ⚠️ UNTUNED.
        hook_retract_speed_m_s: 500.0,
        // ⚠️ THE NEXT FOUR ARE NEW ON 2026-08-13 AND NOTHING READS THEM YET — `W3`
        // (src/vector/aim.rs) and `W2` (the wheel) consume them. Frozen here first so that the
        // key names cannot drift while four agents build against them.
        //
        // The user, 2026-08-12: „und es muss mehr rechts und links spreaden!! (mit mausrad soll
        // man einstellen können wie weit auseinander es gehen darf!)" — so the spread is a
        // number the PLAYER sets at runtime, and these four are the window he sets it in.
        //
        // The value the wheel starts at, and TWO things changed about its meaning on
        // 2026-08-18, both out of one sentence he wrote after playing: „der spread fuer seile
        // ist zu weit auseinander und sollte mehr dynamisch sein!"
        //
        // 1. It is a CEILING and not the angle. His own word from 2026-08-12 decides that —
        //    „wie weit auseinander es gehen DARF" — so the wheel says what the game is ALLOWED
        //    to open to, and the eleven keys below say what it actually opens to.
        // 2. It is the angle BETWEEN the two rays, not the angle off the look direction. That
        //    contradiction between this file and docs/NEXT.md §1B stood open in FINDINGS as
        //    FIND-086 with nothing to decide it on merit; „zu weit auseinander" is that
        //    tiebreaker, and it is worth exactly a factor of two. Under the old reading 28
        //    meant +-28 deg = 56 deg of fan, and the two markers stood 61 % of the screen
        //    apart (the horizontal frustum is 91.5 deg at camera.fov_deg 60 on 16:9). It now
        //    means 28 deg of fan = 31 % of the screen. src/vector/aim.rs::wheel_half_rad is
        //    the ONE place that says so; everything else derives from it. FIND-096.
        //
        // ⚠️ The old comment here did the arithmetic 2 * 100 * sin(28°) = 93.9 m and called
        // that „a whole city block between your two hooks". It was right about the number and
        // that is exactly what he complained about: 93.9 m at 100 m is two anchors in two
        // different parts of town, and 187.8 m at 200 m is four block pitches. A constant
        // angle cannot be right at both ends of a 500 m hook range — see aim_sep_stand_m.
        aim_spread_deg: 28.0,
        // The floor of the wheel's window. **Strictly above 0**: at 0 the two arms share one
        // ray again, which is exactly the state F-023 exists to end (FIND-039) — a player who
        // can wheel the spread back to zero can turn the feature off by accident. 10 deg of
        // fan is +-5 deg: 1.74 m apart at 10 m and 8.7 m at 50 m — narrow, and still visibly
        // two markers rather than one.
        aim_spread_min_deg: 10.0,
        // The ceiling, re-derived on 2026-08-18 rather than merely halved. The old 44 was
        // justified by the frustum — „1.75 deg to spare" against the 45.75 deg half of the
        // 91.5 deg horizontal image — and that argument only ever held for a half-angle. As a
        // TOTAL the frustum would allow 91.5 and the binding constraint is no longer geometry
        // but the complaint: 44 deg of fan is +-22 deg, still comfortably inside the image
        // (23.75 deg to spare), and it is NARROWER THAN THE 56 DEG THE GAME USED TO HAND HIM
        // BY DEFAULT. The widest a player may now dial is tighter than what he called too
        // wide — which is the point, and the reason the number did not move.
        aim_spread_max_deg: 44.0,
        // One notch of the wheel. (max - min) / step = (44 - 10) / 2 = **17 notches**, and
        // tests/data.rs asks for at least 8: fewer than that and the wheel is a three-position
        // switch the player will read as broken rather than as a setting. Fine enough to feel
        // like a dial, coarse enough that one flick crosses the window.
        aim_spread_step_deg: 2.0,
        // ── F-023, 2026-08-18: THE SPREAD IS A SEPARATION IN METRES, NOT AN ANGLE ──────────
        // „der spread fuer seile ist zu weit auseinander und sollte mehr dynamisch sein!"
        // Two claims, and the ten keys below answer both with one model: the two ropes aim a
        // number of METRES OF CITY apart, and what the player is doing decides how many. The
        // angle is then solved every fixed tick out of the centre ray's own hit distance —
        // free, because that ray is already cast eleven lines before the angle is chosen.
        //
        // The metres are the district's own rulers (maps.ron: ashgate.layout), not taste:
        //   frontage_m 12          one house front  -> aim_sep_floor_m
        //   lot_m 36 - 2*wing 11   the courtyard 14 -> aim_sep_tether_m
        //   lot_m 36               the block face   -> aim_sep_stand_m
        //   lot_m 36 + street_m 6  the block PITCH  -> aim_sep_search_m
        // ⚠️ ASSUMPTION (docs/FINDINGS.md FIND-095): Ashgate is the tuning target. The graybox
        // is a different city (lot 28 + street 7 = 35 m pitch, no frontage key at all) and
        // maps.ron has no per-map override for aim tuning. Rollback point: these four keys.
        // ⚠️ And maps.ron:492 says „lot_m 36 + street_m 7 = block pitch 43 m" while :499 sets
        // street_m: 6.0 — the pitch is 42. The comment is stale, the value below is not.
        //
        // Where each clamp binds at the shipped wheel of 28°, so nobody files „the wheel does
        // nothing" as a bug: below aim_sep_full_reach_m (108 m) the RAMP is the answer in every
        // state, and it is a constant angle there — 9.6 deg off centre grounded, 11.2 deg
        // airborne, 3.7 deg tethered. Beyond it the four metre targets take over, and the 2°
        // floor takes over above ~172 m tethered-and-boosted, ~191 m swinging, i.e. past the
        // map. The wheel's own CEILING binds nowhere in the near field at any notch — it is
        // the answer only when the crosshair is on nothing at all (sky), where the world has
        // told the model nothing.
        //
        // The hard floor of the angle the GAME may resolve to, below the floor the PLAYER can
        // dial. Strictly above 0 (at 0 both arms share one ray again, FIND-039) and strictly
        // below aim_spread_min_deg, or the model can never narrow past the wheel and the whole
        // feature is dead. At 2° the two rays are still 1.7 m apart at 25 m and 7.0 m at
        // 100 m: two shoulders, never one ray. ⚠️ UNTUNED.
        aim_spread_floor_deg: 2.0,
        // Outer safety clamp on how fast the effective angle may move. Both ends are derived:
        // (aim_spread_max_deg - aim_spread_floor_deg) / 0.25 s = 42 / 0.25 = **168** is the
        // slowest that still settles inside a human reaction time, and 5° per 60 Hz tick =
        // **300** is the fastest that still reads as a slide rather than a snap. At 180 one
        // tick moves 3.0° and the whole window crosses in 0.23 s. ⚠️ UNTUNED.
        aim_spread_slew_deg_s: 180.0,
        // Time constant of the low-pass on **log2 of the aim distance**. The primary smoother:
        // a crosshair crossing a roof edge changes the depth 12 m -> 300 m in one tick, and
        // filtering the distance in log space is a constant RELATIVE rate, so the same edge
        // feels the same at 12 m and at 300 m. 0.10 s is this file's own „reads as instant"
        // band (the hook flight is 0.04-0.12 s at the distances most shots are), and 3 tau =
        // 0.30 s is the settle window already used further down. ⚠️ UNTUNED.
        aim_spread_settle_s: 0.10,
        // The wheel notch at which the four metre targets apply unscaled: k = wheel / this.
        // A separate key from aim_spread_deg so that neither number has two jobs — that one is
        // where the wheel STARTS, this one is what the wheel is measured against. Same value
        // today, and nothing requires them to stay the same.
        aim_sep_neutral_deg: 28.0,
        // One house frontage (maps.ron ashgate.layout.perimeter.frontage_m). The floor of the
        // FAR field: past aim_sep_full_reach_m the speed term collapses towards this and never
        // past it, so two hooks are never provably on one facade (the FIND-039 collapse F-023
        // exists to end). ⚠️ It is deliberately NOT a floor in the near field — 12 m of
        // separation on a point 8 m away is +-48 deg, which is the defect, not the guard. What
        // keeps the near field apart is aim_spread_floor_deg, an ANGLE.
        aim_sep_floor_m: 12.0,
        // The courtyard: lot_m 36 - 2 * wing_depth_m 11 = 14. Target while a rope holds. The
        // second hook mid-swing is a CHAIN and belongs near your line — the bible's traversal
        // tech is hook switching, not holding two wide anchors (docs/gameplay/references.md
        // §5, „the left/right separation is which shoulder fires and which swerve you can
        // chain, not two previews"). ⚠️ UNTUNED.
        aim_sep_tether_m: 14.0,
        // The block face (lot_m). Target on the ground or on a wall: standing still and
        // picking a route, the two rays land on opposite edges of the block ahead of you.
        // This is the key the user's complaint is measured against — at 100 m it takes the
        // separation 93.9 m -> 36.0 m and at 200 m 187.8 m -> 36.0 m. ⚠️ UNTUNED.
        aim_sep_stand_m: 36.0,
        // The block PITCH (lot_m 36 + street_m 6). Target airborne and untethered: falling
        // with nothing attached is the one state where the two rays may cross a street,
        // because you are searching rather than steering. ⚠️ UNTUNED.
        aim_sep_search_m: 42.0,
        // ── THE NEAR-FIELD GOVERNOR, 2026-08-18 ───────────────────────────────────────────
        // The distance at which the four targets above apply IN FULL. Nearer than this the
        // budget is scaled by d / this, so the near field is a constant angle per state and
        // the separation grows linearly with range.
        //
        // Why it exists: metres are the wrong unit at arm's length. 36 m of separation on a
        // point 10 m away is +-61 deg, off the screen on both sides — so the model asked for
        // it, the wheel's ceiling caught it, and the answer handed back was the wheel. The
        // round that made the fan dynamic was therefore a MEASURED NO-OP where the game is
        // actually played: 4 % narrower standing and 1 % airborne over 10..50 m, while
        // Ashgate's own rulers put most hooks there (street 6 m, houses 6.5..11.5 m, so a
        // roof-to-roof hook across a street is 6..20 m). docs/FINDINGS.md FIND-096.
        //
        // 108 = 3 * lot_m, and it is fixed by the handover, not chosen for the look of it:
        // a GROUNDED player looking at the far edge of his own block (lot_m 36) gets
        // 36 * 36/108 = 12 m between his hooks — exactly one house frontage, exactly
        // aim_sep_floor_m. So the ramp meets the metre floor at the block face and nothing
        // steps. What that buys at the wheel's default, against the game the user played:
        //   10 m   9.39 m -> 3.33 m grounded, 3.89 m airborne   (a house front is 12 m)
        //   25 m  23.47 m -> 8.33 m grounded, 9.72 m airborne   (a block face is 36 m)
        //  100 m  93.90 m -> 33.3 m grounded
        // and the wheel can no longer undo it: at the widest notch (44) the near field is
        // 5.24 m at 10 m, because what governs it is this key and not the ceiling. ⚠️ UNTUNED.
        aim_sep_full_reach_m: 108.0,
        // ──────────────────────────────────────────────────────────────────────────────────
        // Below this HORIZONTAL speed the state's target applies in full. = player.run_speed_m_s
        // (6.0): below running you are not moving in Vector-Gear terms.
        aim_sep_calm_speed_m_s: 6.0,
        // At and above this HORIZONTAL speed the target is pinned to aim_sep_floor_m. NOT
        // invented: 43.0 is the MEASURED peak of the chained-swing run (docs/FINDINGS.md
        // FIND-041, 208 m in 7.23 s on the rope alone). An ordinary pure swing is 17-21 m/s
        // (docs/QUESTIONS.md Q-018) and therefore lands at 30-41 % of the way down: noticeably
        // tighter, not pinned. Horizontal and not total speed, deliberately — a straight 43 m/s
        // drop would otherwise pin the fan at the moment a falling player wants the widest
        // sweep. ⚠️ UNTUNED.
        aim_sep_fast_speed_m_s: 43.0,
        // ──────────────────────────────────────────────────────────────────────────────────
        reel_speed_m_s: 28.0,        // F-005 Reel-In
        min_rope_m: 3.0,          // any closer would drag the camera into the wall
        // Gauss-Seidel iterations over both rope constraints. With one iteration the second
        // constraint violates the first again; two are enough in the normal case (two roofs,
        // angle over 60 degrees) for under 1 % residual error. The degenerate case — both
        // anchors nearly in one line — does not converge with two either (docs/interface.md).
        rope_iterations: 2,
        // ⚠️⚠️ THERE IS NO `gas_regen_per_s` AND NO `gas_regen_delay_s` IN THIS BLOCK, AND
        // THAT IS A DECISION — NOT SOMETHING SOMEBODY FORGOT. DO NOT ADD ONE.
        //
        // The user, 2026-08-12, closing docs/QUESTIONS.md Q-033: "gas refillt nur im main
        // gebaeude an bestimmten stationen/objekten". Gas comes back at a PLACE YOU GO TO,
        // never on a timer. Between 2026-08-10 and 2026-08-12 this file did carry a 10/s
        // regeneration behind a 0.5 s pause; he was asked which of three shapes he wanted and
        // picked none of them. The whole mechanism was removed with those two keys —
        // `refill_tank`, `arm_pause` and `Gas::regen_delay_left_s` went with it.
        //
        // Why he is right: the bible couples gas to RISK, not to a clock — burning it is loud
        // and a Bellower answers the noise (bible line 159). A tank that quietly fills itself
        // while you hang around on a roof is exactly the timer the bible refuses; a tank you
        // have to fly home to fill turns the whole map into a resource decision. The refuel
        // stations are a WORLD feature and they are queued in docs/NEXT.md §1d.
        //
        // If the tank feels tight before those exist, the knob is gas_tank / gas_boost_per_s
        // below, NOT a rate. `deny_unknown_fields` in src/data/mod.rs means either key put
        // back here crashes the game on load rather than being ignored, and
        // tests/vector_gas.rs::f018_an_idle_tank_never_refills_on_its_own goes red the moment
        // anything in the simulation puts a drop back.

        // 100.0 -> 300.0. The user, after playing it on 2026-08-10: "also gas tank sollte
        // sehr viel mehr haben". ⚠️ UNTUNED. At 18/s this is the whole answer to his other
        // sentence, "der boost haelt nicht lang genug": 16.67 s of continuous boost against
        // the 5.6 s he flew. **The length of a boost is gas_tank / gas_boost_per_s and
        // nothing else** — with no refill anywhere, this number IS the flight time, and it is
        // also the whole mission's supply until the stations exist.
        gas_tank: 300.0,
        gas_boost_per_s: 18.0,
        // For scale, the other consumer: reeling a full rope in from 90 m to the 3 m minimum
        // takes (90-3)/28 = 3.1 s and costs 18.6 gas — 6.2 % of the tank.
        gas_reel_per_s: 6.0,
        // ⚠️ NEW ON 2026-08-13, AND NOTHING SPENDS IT YET. What the rope-pull thrust
        // (player.air_pull_m_s2 / air_lateral_m_s2) costs per second once `W4` bills it.
        //
        // **It exists because the thrust would otherwise be free**, and that was the one flaw
        // all nine judges of the §1B plan named independently: a `W` that pulls at 30 m/s²
        // with no meter moving is a stronger boost than the boost, for nothing, and the whole
        // game is „flight costs gas".
        //
        // The number is not chosen, it is SOLVED — from the same ratio that already decides
        // gas_dodge, gas per m/s of speed bought:
        //
        //     held boost   gas_boost_per_s / boost_m_s2    = 18 / 34 = 0.5294 gas per m/s
        //     rope steer   gas_steer_per_s / air_pull_m_s2 = 16 / 30 = 0.5333 gas per m/s
        //                                                   -------------------------------
        //     difference 0.0039 — the two thrusts cost the SAME per metre per second
        //
        // That is deliberate and it is what tests/data.rs pins (|delta| <= 0.15). The dodge is
        // the expensive one (1.875) and it is meant to be; the steer is not a third price
        // point, it is the boost's price on a different button. What a player therefore has to
        // learn is WHICH thrust the situation wants, never which one is cheap.
        //
        // In tank terms: 300 gas is 18.75 s of held steering, a little longer than the 16.67 s
        // of held boost — and on an empty tank the rope term is ZERO (the look term keeps
        // air_accel_empty_fraction, §1e). ⚠️ UNTUNED.
        //
        // Spent since 2026-08-13: GasConsumer::Steer, booked in src/vector/gas.rs and read by
        // player::locomotion::air_control. Wanted whenever a hook is anchored AND a movement key
        // is down — the cost follows the effect, not the button, so a rope with no key held and
        // a key held with no rope both cost nothing.
        gas_steer_per_s: 16.0,
        // F-008, and the ONE gas number in this block that is not a rate: what a single dodge
        // costs, billed once on the tick the double-tap lands. No `_per_s` in the name because
        // there is no per second about it — vector/gas.rs does NOT multiply it by dt.
        //
        // ⚠️ UNTUNED. The user, 2026-08-12 (docs/NEXT.md §1c): "mit doppel leertaste boostet
        // man stark in die lauf richtung (ein weiter dodge) DER VIEL GAS AUFBRAUCHT. das andere
        // boosten VERBRAUCHT SEHR WENIG!" So these two numbers have to be far apart in a way
        // somebody can feel, and the interesting question is: far apart measured how?
        //
        // NOT per second. 45 gas is 2.5 seconds of held boost, and "2.5 seconds" does not sound
        // expensive. The honest comparison is GAS PER m/s OF SPEED BOUGHT, because speed is
        // what both of them sell:
        //
        //     held boost   gas_boost_per_s / boost_m_s2     = 18 / 34 = 0.529 gas per m/s
        //     dodge        gas_dodge / dodge_impulse_m_s    = 45 / 24 = 1.875 gas per m/s
        //                                                    ---------------------------
        //     the dodge costs 3.54x more gas for the same m/s
        //
        // THAT is the ratio, and it is what makes gas_boost_per_s: 18 demonstrably the cheap
        // one (tests/vector_boost.rs::f008_the_dodge_is_the_expensive_boost_per_metre_per_second
        // holds it and names 3.0 as the floor). What the dodge buys for the premium is TIME: it
        // delivers its 24 m/s in ONE TICK, where the boost needs 24/34 = 0.71 s of held button
        // to reach the same speed — 42x faster, for 3.54x the gas. That is a dodge: you pay for
        // the instant, not for the speed.
        //
        // In tank terms: 300 gas is 16.67 s of held boost OR 6.67 dodges. Six dodges per run
        // with no station in the world yet is deliberately tight — this is an emergency move,
        // not a traversal move, and F-008 in the backlog calls it "kurz, hart, mit eigenem
        // Cooldown". The cooldown is NOT built (see the report/FIND-067); the gas price is the
        // whole limiter today, which is exactly what the user's sentence asks for.
        gas_dodge: 45.0,
        // Who pays first when the tank is not enough for both? That is a GAME-VALUE
        // decision and not an `if` in the code (docs/QUESTIONS.md Q-017).
        //
        // Dodge is APPENDED, not inserted, and that is a decision with a number behind it: the
        // order of the first two is the user's answer to Q-017 and nothing about F-008 revisits
        // it. And the position of Dodge in this list is worth almost nothing — a dodge costs 45
        // flat while boost+reel together cost 0.4 per tick, so being served last can cost a
        // dodge at most 0.4 gas, i.e. 0.9 % of its own price. Putting it first would look like a
        // decision and buy nothing.
        // Steer is INSERTED second and that position is a decision, not an append
        // (docs/QUESTIONS.md Q-037, and it is the user's to overturn). Steer and Boost are both
        // rates, both wanted on the very same tick of a swing, so on a nearly empty tank this
        // list decides which of the two the last drop buys. Boost stays first because it is the
        // deliberate press: Shift means "I need speed NOW", while W/A/D on a rope is held almost
        // continuously in flight — putting Steer first would let the ambient input eat the drop
        // the explicit one asked for, and an ignored Shift reads as a broken game.
        gas_priority: [Boost, Steer, ReelIn, Dodge],
        boost_m_s2: 34.0,
        // How much of the boost DIRECTION comes from the rope instead of from the look
        // direction: 0.0 = pure look direction (the behaviour up to 2026-08-10), 1.0 = straight
        // at the anchor. The blend is a direction only — the STRENGTH stays boost_m_s2 at every
        // value (tests/vector_boost.rs).
        //
        // ⚠️ UNTUNED, and the number the user has to feel rather than read. It exists because
        // he asked for it after playing it on 2026-08-10: „wenn man boostet soll man in
        // richtung seil und mauszeiger fliegen!"
        //
        // Why not 1.0, which is what „in richtung seil" says literally: thrust straight at the
        // anchor is RADIAL, and a taut rope eats a radial pull — it adds no tangential speed
        // and so it kills the swing instead of feeding it. Why not 0.0, which is what we had:
        // the rope then steers nothing at all. 0.5 is the middle where looking at your own hook
        // gives you nearly the whole pull while looking away still steers.
        //
        // What the rope half BUYS, and it is the reason this key exists at all: since B-005 the
        // enforced length ratchets down to the true distance every substep, so flying at your
        // anchor permanently SHORTENS the rope — and a shorter rope is what lifts the bottom of
        // the arc off the ground (measured in B-005: 53.3 m of rope -> 20.2 m moved the arc
        // bottom from 18.3 m underground to 14.8 m above it). Look-only boost cannot reach that
        // loop; this is what turns a dead leash into a swing.
        boost_rope_fraction: 0.5,
        // F-008. How much speed ONE dodge adds, in m/s. A VELOCITY CHANGE, not an acceleration:
        // vector/boost.rs divides it by the fixed timestep to get what avian wants, so this
        // number stays the same speed if simulation_hz ever moves, and it is checkable against
        // things a player knows — a pure swing runs 17-21 m/s (Q-018), max_speed_m_s is 75.
        //
        // ⚠️ UNTUNED. 24 m/s is chosen to be unmistakably "stark" and "ein weiter dodge": it is
        // MORE than a whole swing's speed added in one tick, so a dodge out of a 20 m/s swing
        // roughly doubles the speed and crosses a 7 m street in 0.3 s. Below about 12 it would
        // be a nudge and nobody would pay 45 gas for it; above about 40 the max_speed_m_s clamp
        // starts eating it whenever you dodge along your own velocity, which would make the
        // number quietly stop meaning what it says.
        //
        // ⚠️ The one consequence to know: for ONE tick this is 24 * 60 = 1440 m/s² of
        // acceleration, 42x boost_m_s2. That is what an impulse IS, and BoostAccel really does
        // carry that spike for that tick. Nothing reads BoostAccel today except the tests; the
        // day something does (a HUD "thrust" bar, a sound trigger), it has to expect it.
        dodge_impulse_m_s: 24.0,
        // F-008. How many TICKS may lie between the two Space presses for them to be one
        // double-tap. In ticks, because the tick counter is the clock that measures it —
        // Time<Virtual> is what --ticks and the seeded rng are held steady against and must not
        // be read for gameplay, and a window in seconds would only be divided back into ticks
        // with a rounding nobody can see.
        //
        // ⚠️ UNTUNED. 18 ticks = 0.300 s at simulation_hz: 60. Two bounds, and the lower one is
        // measured rather than felt:
        //   - a HUMAN double-tap is ~150-300 ms between presses, so much below ~12 ticks the
        //     move stops being reachable;
        //   - it MUST stay well under one jump, or bunny-hopping on the ground would fire an
        //     expensive dodge by accident. jump_speed_m_s 6.5 against gravity_m_s2 -20 is
        //     2*6.5/20 = 0.65 s of airtime = 39 ticks before Space can produce a second jump.
        //     18 is 46 % of that, so a ground double-jump attempt can NEVER land inside the
        //     window. (In the air the second tap is exactly what this is for.)
        dodge_double_tap_window_ticks: 18,
        // Velocity clamp from day 1, not retrofitted (bible 6.4, risk of fling exploits)
        //
        // ⚠️ Computed against the city of the size table, and the numbers do not fit
        // together (docs/QUESTIONS.md Q-018): pure swinging off an 11.5 m roof gives
        // 17-21 m/s, the windups of the titans stay readable up to 6-20 m/s, and 75 m/s
        // only comes out of a full reel-in along a clear 30 m line of sight. 75 m/s crosses
        // the 400 m graybox in 5.33 s and turns a 7 m street into a curve at 164 g and
        // 1228 degrees/s of yaw rate. The number stays standing anyway: it is a clamp
        // against exploits, not a target speed, and what the factor of x1.5 named by the
        // user refers to is open. It is not changed before there is an answer.
        max_speed_m_s: 75.0,
    ),

    camera: (
        // 90.0 -> 60.0. The user names "FOV ground combat 55-65 degrees" and calls it the
        // "biggest lever". The words GROUND COMBAT are the key: 60 degrees is the BASE on
        // the ground, not the upper limit. A 90-degree image makes every titan small and
        // every meter short — exactly what this game does not want.
        // Window: scale.ron:camera.min_ground_fov_deg/-max_ground_fov_deg, tests/data.rs checks it.
        //
        // ⚠️ The number is read VERTICALLY — src/render/mod.rs puts it into
        // `PerspectiveProjection.fov`, and Bevy documents the field as "the vertical
        // field of view". On 16:9 that is 91.5 degrees horizontal (before: 121.3). Whether
        // the user means his 55-65 degrees vertically or horizontally nobody has decided,
        // and the two readings differ by a factor of 1.7: docs/QUESTIONS.md Q-021.
        fov_deg: 60.0,
        // Field of view at max_speed_m_s. F-017 „Geschwindigkeits-Feedback" will later
        // interpolate between fov_deg and this value — the curve belongs in the code, the
        // two ends belong here.
        // ⚠️ STARTING VALUE, not from the user: 90 degrees is exactly the value that stood
        // here until 2026-08-09. At the top end the image thus stays as it was; only ground
        // combat pulls together. That is the smallest change that satisfies the requirement
        // — not an invented second number. F-017 names „abschaltbar fuer Motion Sickness";
        // whoever wants the effect off sets this value to fov_deg.
        fov_max_speed_deg: 90.0,
        mouse_deg_per_px: 0.08,
        pitch_limit_deg: 89.0,
        smoothing_half_life_s: 0.05,
    ),

    world: (
        // Edge length of one grid cell of the spatial index (T-036a).
        // ⚠️ UNMEASURED. docs/lessons/performance.md says it literally: "§11 says
        // ‚Gitterzellen', not how big. Has to be measured." A 90 m ray at 8 m crosses
        // about 11 cells horizontally and 15 vertically at the wall
        // (docs/QUESTIONS.md **Q-014** — until 2026-08-09 a reference to Q-013 stood here,
        // and Q-013 is the question about the maximum rope length).
        cell_m: 8.0,
        // Half edge length of the grid. Has to cover the map AND a full hook range
        // beyond it.
        // 320.0 -> 300.0: recomputed with the new range. 400/2 + 90 = 290 -> 300
        // (rounded up to a round number). The 320 belonged to 112 m (400/2 + 112 = 312).
        // In HEIGHT the same number covers wall (120 m) + Ashwalker (150 m) = 270 m with
        // 30 m to spare. Whether the grid is three-dimensional at all is decided by Q-014;
        // tests/data.rs pins the 270 down anyway, because a grid smaller than the world
        // would be wrong either way.
        //
        // **300 -> 400 on 2026-08-10**, forced by `hook_range_m` 90 -> 200 (Q-035): the grid
        // has to carry half the map plus one full hook range, and `tests/data.rs` fires the
        // moment it does not — 400/2 + 200 = **400 exactly**, no rounding left over.
        // The cost is real and is written here so nobody has to re-derive it: the grid covers
        // 800 x 800 m instead of 600 x 600 at `cell_m: 8.0`, i.e. **10 000 cells against
        // 5 625 — 1.78x the index memory** for the same city. It buys nothing by itself; it
        // is the price of the longer rope. If the index ever becomes a memory problem, the
        // lever is `cell_m`, not this number, and it is measured in
        // docs/lessons/performance.md before it is touched.
        // **400 -> 600 on 2026-08-12**, to make room for a real district. The guard is
        // `half_extent_m >= longest_map_edge/2 + hook_range_m`, so 600 buys a map of up to
        // **800 x 800 m** at the current 200 m range — the graybox's 400 m cleared it with
        // exactly zero margin and could not have grown by a metre.
        // Cost, stated so nobody re-derives it: the grid covers 1200 x 1200 m instead of
        // 800 x 800 at `cell_m: 8.0`, i.e. **22 500 cells against 10 000 — 2.25x the index
        // memory**. That is the price of a district with a 120 m wall in it, and it buys
        // nothing on its own.
        // **600 -> 900 on 2026-08-13**, and this one is forced by arithmetic, not chosen: the
        // guard is `half_extent_m >= longest_map_edge/2 + hook_range_m`, ashgate is 700 m
        // across and the range is 500 now, so the floor is 350 + 500 = **850**. 900 is that
        // floor plus 50 m — enough that the next block placed at the district's edge does not
        // move this number again, not so much that the grid pays for a map nobody built.
        //
        // The cost, MEASURED and not estimated this time (2026-08-13, machine B, 8 interleaved
        // headless runs of 900 ticks on ashgate, A/B/A/B so that background load hits both
        // sides): the grid covers 1800 x 1800 m instead of 1200 x 1200 at `cell_m: 8.0`, i.e.
        // **50 625 cells against 22 500 — 2.25x again**, and it costs **+0.09 %** of process
        // CPU (6.174 s -> 6.180 s, best run of four each; the means are 6.847 -> 6.612 and
        // that -3.4 % is another agent's render job, not a speed-up).
        //
        // WHY it is free, and this is the part worth keeping: `SpatialIndex::new` allocates
        // `columns²` cells **once at startup and never per tick** (src/shared/spatial.rs says
        // so in the field's own comment), and `maintain_index` touches only bodies that moved.
        // So 2.25x the cells is 1.2 MB of empty `Vec` headers at load and nothing at 60 Hz.
        // What would NOT be free is `cell_m`, because that changes how many cells every ray
        // walks — it stays 8.0, it is unmeasured (docs/QUESTIONS.md Q-014), and it does not
        // get touched on a hunch.
        //
        // ⚠️ Note for whoever measures this next: in `--headless` the frame time is NOT the
        // metric. `ScheduleRunnerPlugin::run_loop(1/240 s)` paces the loop, so DBT_FRAMETIME
        // reads 4.221 ms/frame before AND after — that is the cap, not the work. Process CPU
        // over a fixed tick count is what moves.
        half_extent_m: 900.0,
        // Whoever occupies more cells lands in the linear large-body list instead of in the
        // grid. The ground (400 x 400 m) occupies 2500 cells at 8 m cells; every horizontal
        // ray would otherwise test it once per visited cell.
        large_body_cells: 64,
        // The thinnest wall there may be. Calibrates max_substep_m.
        // ⚠️ In NO source: models.ron A-080 names a 4-stud grid, that is the module width,
        // not the thickness (docs/QUESTIONS.md Q-015).
        min_wall_m: 0.5,
        // Collision margin: the distance at which a body comes to a stop in front of a
        // surface. Without it every contact jitters, and the number lands as 1e-3 in Rust.
        collision_margin_m: 0.01,
    ),
)
