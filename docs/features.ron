// GENERATED by tools/features.py from gameplay/features.xlsx — do NOT edit by hand.
// Hand edits here are lost on the next run. Changing the source means: change the
// .xlsx and run the script again (prompts/init.md §2).
// Source: gameplay/features.xlsx!01_Spielfunktionen + !09_Tech-Backlog
features: [
    (id: "F-001", name: "Doppelhaken-Grundsystem", domain: "vector", system: "Vector Gear", stage: Built, description: "Zwei unabhaengig steuerbare Enterhaken (links/rechts), einzeln abfeuerbar und loesbar. Jeder Haken hat eigenen Zustand: idle, fliegend, verankert, einziehend.", acceptance: "Beide Haken lassen sich unabhaengig setzen und loesen; Zustaende sind im HUD sichtbar.", depends_on: [], prio: 1, effort_pd: 12, source: "features.xlsx!01_Spielfunktionen!R5", evidence: "tests/vector_hooks.rs 10 green · counter-check drove 5 source mutations through the suites [debian]", note: "2026-08-09 [debian] — counter-check verdict: HOLDS PARTLY. State machine, edge detection and the same-tick NoAnchor are real and verified in the running game. But B-001: the hook cannot anchor in the game at all, and the documented rule 'a shot only leaves from Idle' has no guard (FIND-005). Acceptance also demands HUD states that do not exist"),
    (id: "F-002", name: "Freies Zielen per Raycast (Ebene 1)", domain: "vector", system: "Vector Gear", stage: Built, description: "Basisebene des Zielsystems. Raycast aus Kameraposition in Blickrichtung, Reichweite = Range-Stat (Basis 400 studs). Trefferpunkt wird gegen eine gueltige Ankerflaeche geprueft. Der Spieler kann jede getaggte Flaeche frei anvisieren, unabhaengig von gesetzten Ankerpunkten. Diese Ebene bleibt IMMER aktiv und ist niemals durch das Snap-System ersetzbar.", acceptance: "Jede getaggte Flaeche ist per freiem Zielen erreichbar, auch wenn dort kein Ankerpunkt liegt.", depends_on: ["F-001"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R6", evidence: "tests/vector_aiming.rs 8 green · filtered-cast mutation goes red 3 of 8: the ray lands at z = -41 where anything past -34 means it went THROUGH the wall · all 63 tagged surfaces covered [debian]", note: "2026-08-09 [debian] — counter-check verdict: HOLDS, the strongest of the five. Every header claim that was attacked went red as advertised. Stays 🟨 only because it never writes the BodyId its consumer needs (B-001) and no test looks at that field"),
    (id: "F-003", name: "Getaggte Ankerflaechen (Ebene 1)", domain: "vector", system: "Vector Gear", stage: Built, description: "Nur Oberflaechen mit CollectionService-Tag 'AnchorSurface' sind hakbar. Gilt fuer ganze Flaechen, nicht fuer Punkte. Verhindert Physik-Exploits, macht Leveldesign steuerbar und definiert ueber die Flaechendichte die Traversal-Schwierigkeit einer Map.", acceptance: "Kein Haken auf ungetaggten Parts moeglich; Tagging-Werkzeug im Studio vorhanden; Heatmap zeigt Flaechenabdeckung.", depends_on: ["F-002"], prio: 1, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R7", evidence: "79 blocks from maps.ron (9 placed, 70 seeded, 63 taggable) · docs/images/f003-city.png and f003-anchors.png · tests/world.rs, red-checked: half-edge collider reports 'factor 0.50 against the file'", note: "2026-08-09 [cachy] — surfaces are tagged, collidable and visible, but NOT 🟧: the acceptance criterion is 'no hook on untagged parts', and there is no hook yet"),
    (id: "F-004", name: "Pendelphysik bei Zwei-Haken-Zustand", domain: "vector", system: "Vector Gear", stage: Built, description: "Zwei gesetzte Haken erzeugen echte Zentripetalbewegung ueber RopeConstraint statt linearem Ziehen. Basis fuer Momentum-Chaining.", acceptance: "Spieler beschreibt sichtbar eine Bogenbahn; Geschwindigkeit steigt beim Ausschwingen.", depends_on: ["F-001"], prio: 1, effort_pd: 15, source: "features.xlsx!01_Spielfunktionen!R8", evidence: "tests/vector_rope.rs 6 green, all 6 seen red first · swing loss 0.43 %/s over 60 ticks (measurement predicted 4.26) · the rope pulls but does not push: 6.000 m stays 6.000 m under a 12 m rope [debian]", note: "2026-08-09 [debian] — an avian DistanceJoint with limits = (0, L), per docs/measurements/rope-decision.md. NOT 🟧: no picture, and nothing here has been seen moving on a screen. Two ropes at once is unmeasured, and boost against a wall with the rope on was never run"),
    (id: "F-005", name: "Reel-In / Seilverkuerzung", domain: "vector", system: "Vector Gear", stage: Built, description: "Kontrollierte Reduktion der Seillaenge zum Hoehengewinn. Manuell steuerbar, verbraucht Gas.", acceptance: "Spieler kann aus dem Tiefpunkt Hoehe gewinnen; Gasverbrauch ist spuerbar.", depends_on: ["F-004"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R9", evidence: "reel-in from v0 20.00 at L 9.00 to 3.00 m reaches 62.73 m/s (measurement predicted 58.23; the retired clamp gives 18.17) · shortening 0.46667 m per tick = 28.0/60, red-checked against the per-tick bug which moves the rope 9.00 m in one tick · floor holds at 3.00000 m over 300 ticks [debian]", note: "2026-08-09 [debian] — shortening runs in the SubstepSchedule and never in FixedUpdate. NOT 🟧: no picture. The MaxLinearSpeed clamp never fired in these runs (peak 62.73 against 75.0), so one of the two lines the measurement says everything hangs on is present but untested"),
    (id: "F-006", name: "Swerve-Steuerung", domain: "vector", system: "Vector Gear", stage: Unbuilt, description: "Richtungseingabe waehrend des Einzugs moduliert die Flugbahn seitlich, nach oben und unten. Kein binaeres Ziel-Anfliegen.", acceptance: "Vier Swerve-Richtungen aendern die Bahn messbar ohne Haken zu loesen.", depends_on: ["F-004"], prio: 1, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R10", evidence: "", note: ""),
    (id: "F-007", name: "Gas-Boost", domain: "vector", system: "Vector Gear", stage: Built, description: "Impuls in Blickrichtung bei gehaltener Taste, verbraucht Gas kontinuierlich. Deutliches VFX/SFX-Feedback.", acceptance: "Boost erzeugt spuerbare Beschleunigung; Gasleiste sinkt sichtbar.", depends_on: ["F-001"], prio: 1, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R11", evidence: "tests/vector_boost.rs 5 green · the free-boost mutation goes red with left Vec3(-0.0, 0.0, -34.0) against right Vec3(0.0, 0.0, 0.0), so the boost does not fire without gas · f-007-boost.png re-measured independently: 118 px centred on 462.5 against the script prediction of 118 px on 463 [debian]", note: "2026-08-09 [debian] — counter-check verdict: HOLDS PARTLY. Acceleration-not-force and grant-not-button are both guarded and measured; two other documented decisions are not (FIND-007). The acceptance 'Gasleiste sinkt sichtbar' cannot be met: there is no gas bar, 0 cyan pixels of 921600 in the image"),
    (id: "F-008", name: "Boost-Dash", domain: "vector", system: "Vector Gear", stage: Unbuilt, description: "Doppeltipp erzeugt einen kurzen, harten Impuls mit eigenem Cooldown. Anzahl der Dashes ist ein Stat.", acceptance: "Dash ist von Boost unterscheidbar; Anzahl korrekt limitiert und regeneriert.", depends_on: ["F-007"], prio: 1, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R12", evidence: "", note: ""),
    (id: "F-009", name: "Flips (seitlich)", domain: "vector", system: "Vector Gear", stage: Unbuilt, description: "Doppeltipp A/D erzeugt seitlichen Ausweichsprung in der Luft mit kurzen I-Frames.", acceptance: "Flip vermeidet einen Titanengriff, wenn im Fenster ausgeloest.", depends_on: ["F-001"], prio: 1, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R13", evidence: "", note: ""),
    (id: "F-010", name: "Slide-Dodge am Boden", domain: "vector", system: "Vector Gear", stage: Unbuilt, description: "Gleit-Ausweichmanoever am Boden mit I-Frames und Momentum-Erhalt.", acceptance: "Slide vermeidet Stomp-Angriff; geht fliessend in Sprint ueber.", depends_on: [], prio: 1, effort_pd: 3, source: "features.xlsx!01_Spielfunktionen!R14", evidence: "", note: ""),
    (id: "F-011", name: "Hook-Break (Notbremse)", domain: "vector", system: "Vector Gear", stage: Unbuilt, description: "Beide Haken nach hinten abfeuern, harte Verzoegerung. Rettungsmanoever vor Kollision.", acceptance: "Geschwindigkeit sinkt innerhalb von 0,6 s um mindestens 70 Prozent.", depends_on: ["F-001"], prio: 2, effort_pd: 3, source: "features.xlsx!01_Spielfunktionen!R15", evidence: "", note: ""),
    (id: "F-012", name: "Velocity-Clamp gegen Fling", domain: "vector", system: "Vector Gear", stage: Unbuilt, description: "Harte Obergrenze auf AssemblyLinearVelocity bei jedem Heartbeat. Verhindert den klassischen Roblox-Physikfehler.", acceptance: "Kein Testfall erzeugt Geschwindigkeit ueber dem Cap; kein Spieler wird aus der Map geschleudert.", depends_on: ["F-004"], prio: 1, effort_pd: 3, source: "features.xlsx!01_Spielfunktionen!R16", evidence: "", note: ""),
    (id: "F-013", name: "Kollisionsdaempfung", domain: "vector", system: "Vector Gear", stage: Unbuilt, description: "Aufprall auf Geometrie verlangsamt und staggert statt zu toeten. Recovery-Fenster mit Wandkontakt-Animation.", acceptance: "Frontalaufprall bei Hoechstgeschwindigkeit fuehrt nicht zum Tod; Erholung dauert unter 1 s.", depends_on: ["F-004"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R17", evidence: "", note: ""),
    (id: "F-014", name: "Momentum-Chaining", domain: "vector", system: "Vector Gear", stage: Unbuilt, description: "Beim Wechsel von Haken zu Haken bleibt Geschwindigkeit erhalten. Kern-Skillausdruck des gesamten Spiels.", acceptance: "Ein geuebter Spieler kann Geschwindigkeit ueber 5 Hakenwechsel steigern statt zu verlieren.", depends_on: ["F-004"], prio: 1, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R18", evidence: "", note: ""),
    (id: "F-015", name: "Wall-Run und Wall-Kick", domain: "vector", system: "Vector Gear", stage: Unbuilt, description: "Kurzer Lauf an vertikalen Flaechen plus Absprung. Alternative Traversal-Ebene fuer enge Raeume.", acceptance: "Wall-Run ueber mindestens 3 s moeglich; Kick erzeugt nutzbaren Impuls.", depends_on: ["F-013"], prio: 3, effort_pd: 7, source: "features.xlsx!01_Spielfunktionen!R19", evidence: "", note: ""),
    (id: "F-016", name: "Ziel-Assist-Regler", domain: "vector", system: "Vector Gear", stage: Unbuilt, description: "Stufenlos einstellbarer Snap-Fangwinkel von 0 bis 100 Prozent. Steuert, wie weit das Fadenkreuz von einem Ankerpunkt abweichen darf, damit der Snap greift. Bei 0 verhaelt sich das System wie reines freies Zielen. Siehe F-024 fuer die drei Zielmodi.", acceptance: "Regler wirkt messbar auf den Fangwinkel; der verwendete Wert wird bei jedem Bestenlisten-Eintrag mitgespeichert.", depends_on: ["F-024"], prio: 2, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R20", evidence: "", note: ""),
    (id: "F-017", name: "Geschwindigkeits-Feedback", domain: "vector", system: "Vector Gear", stage: Unbuilt, description: "Speedlines, Kamera-FOV-Kurve, Windrauschen und Vignette skalieren mit Velocity. Verkauft Tempo ohne echte Physikaenderung.", acceptance: "FOV und Audio reagieren stufenlos; abschaltbar fuer Motion Sickness.", depends_on: ["F-004"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R21", evidence: "", note: ""),
    (id: "F-018", name: "Gas-Ressource", domain: "vector", system: "Vector Gear", stage: Built, description: "Blaue Leiste, Verbrauch durch Reel-In, Boost und Dash. Bei 0 kein Fliegen mehr, nur noch Bodenbewegung.", acceptance: "Gasverbrauch pro Aktion ist in Config definiert und im HUD ablesbar.", depends_on: ["F-007"], prio: 1, effort_pd: 3, source: "features.xlsx!01_Spielfunktionen!R22", evidence: "tests/vector_gas.rs 11 green · 0 cyan pixels of 921600 in f-018-gas.png [debian]", note: "2026-08-09 [debian] — counter-check verdict: HOLDS PARTLY. Rates and the per-player tank are well measured. But gas_priority is a fall-through attempt order nobody agreed to, and its degenerate case (a tank smaller than one consumer's tick cost) is untested (FIND-006). 'Im HUD ablesbar' cannot be met"),
    (id: "F-019", name: "Nachschub-Stationen", domain: "vector", system: "Vector Gear", stage: Unbuilt, description: "Statische Punkte auf der Map fuellen Gas und Klingen. Begrenzte Nachladungen pro Mission.", acceptance: "Nachladen dauert 1,5 s; Zaehler sichtbar; leere Station wird visuell markiert.", depends_on: ["F-018"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R23", evidence: "", note: ""),
    (id: "F-020", name: "Tragbarer Notvorrat", domain: "vector", system: "Vector Gear", stage: Unbuilt, description: "Verbrauchsgegenstand fuer eine Feldbetankung ohne Station, mit langer Animation als Risikofaktor.", acceptance: "Item funktioniert nur am Boden oder haengend; Animation ist unterbrechbar mit Verlust.", depends_on: ["F-019"], prio: 3, effort_pd: 3, source: "features.xlsx!01_Spielfunktionen!R24", evidence: "", note: ""),
    (id: "F-021", name: "Diskrete Ankerpunkte (Ebene 2)", domain: "world", system: "Ankersystem", stage: Unbuilt, description: "Zweite Ebene ueber den Ankerflaechen: konkrete, einzeln adressierbare Punkte im Level (Dachkanten, Schornsteine, Vorspruenge, Astgabeln, Laternen, Kranausleger, Titanenkoerper). Jeder Punkt traegt Metadaten: Typ, Hoehe, Ausrichtung der Normalen, Guete-Basiswert, ob dynamisch (an bewegtem Objekt) oder statisch.", acceptance: "Jede Map besitzt eine vollstaendige Ankerpunktliste; Punkte sind einzeln inspizierbar und im Editor sichtbar.", depends_on: ["F-003"], prio: 1, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R25", evidence: "", note: ""),
    (id: "F-022", name: "Prozedurale Ankerpunkt-Erzeugung", domain: "world", system: "Ankersystem", stage: Unbuilt, description: "Werkzeug erzeugt Ankerpunkte automatisch aus der Geometrie getaggter Flaechen (Kantenerkennung, Vorsprungerkennung, Mindestabstand zwischen Punkten). Level Designer korrigiert danach nur noch von Hand, statt tausende Punkte einzeln zu setzen.", acceptance: "Eine komplette Stadtmap wird in unter 5 Minuten mit Punkten befuellt; manuelle Nacharbeit unter 10 Prozent der Punkte.", depends_on: ["F-021"], prio: 1, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R26", evidence: "", note: ""),
    (id: "F-023", name: "Kandidatensuche mit Hemisphaeren-Aufteilung", domain: "world", system: "Ankersystem", stage: Unbuilt, description: "Clientseitige Suche aller Ankerpunkte, die gleichzeitig erfuellen: innerhalb der Range-Stat-Reichweite, innerhalb des Sichtkegels (Standard 130 Grad horizontal, 90 Grad vertikal), freie Sichtlinie zum Spieler. Ergebnis wird relativ zur Kameravorwaertsachse in eine LINKE und eine RECHTE Hemisphaere geteilt. Q bedient ausschliesslich die linke Menge, E ausschliesslich die rechte.", acceptance: "Q liefert nie einen Punkt rechts der Kameraachse und umgekehrt; Sichtlinienpruefung verhindert Haken durch Waende.", depends_on: ["F-021"], prio: 1, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R27", evidence: "", note: ""),
    (id: "F-024", name: "Snap auf Q und E", domain: "world", system: "Ankersystem", stage: Unbuilt, description: "Tastendruck verankert direkt am besten Kandidaten der jeweiligen Hemisphaere, ohne dass der Spieler exakt darauf zielen muss. Drei Zielmodi in den Einstellungen: FREI (kein Snap, reines Raycast), ASSISTIERT (Snap greift nur innerhalb des Fangwinkels aus F-016, Standardeinstellung), SNAP (immer bester Kandidat, maximale Zugaenglichkeit). Da das Spiel reine Maussteuerung nutzt, ist ASSISTIERT der Standard und SNAP eine bewusste Komfortoption, keine Notwendigkeit.", acceptance: "Alle drei Modi funktionieren; Moduswechsel ist ohne Neustart wirksam; der aktive Modus wird bei Bestenlisten-Eintraegen mitgespeichert und getrennt gewertet.", depends_on: ["F-023"], prio: 1, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R28", evidence: "", note: ""),
    (id: "F-025", name: "Bewertungsfunktion fuer Kandidaten", domain: "world", system: "Ankersystem", stage: Unbuilt, description: "Gewichtete Auswahl des besten Punktes je Hemisphaere. Faktoren: Winkelabweichung zum Fadenkreuz (Hauptgewicht 45 Prozent), Momentum-Erhalt (25 Prozent, bevorzugt Punkte, die die aktuelle Flugbahn fortsetzen statt sie zu bremsen), Hoehenvorteil relativ zur Bewegungsrichtung (15 Prozent), Distanz im nutzbaren Mittelbereich (10 Prozent), Abwertung des zuletzt genutzten Punktes (5 Prozent, verhindert Pendeln zwischen zwei Punkten). Alle Gewichte liegen in der Config und sind ohne Codeaenderung anpassbar.", acceptance: "Ein geuebter Spieler kann bei aktivem Snap eine Bahn ueber 5 Wechsel beschleunigen; das System waehlt nie einen Punkt hinter dem Spieler, wenn ein brauchbarer vor ihm liegt.", depends_on: ["F-023"], prio: 1, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R29", evidence: "", note: ""),
    (id: "F-026", name: "Highlighting der Ankerpunkte", domain: "world", system: "Ankersystem", stage: Unbuilt, description: "Alle gueltigen Kandidaten werden als schwache Marker im Sichtfeld eingeblendet. Die beiden aktuell besten Punkte (links und rechts) werden hervorgehoben und tragen das jeweilige Tastensymbol. Vier Zustaende, jeweils durch FORM UND Farbe unterschieden (Farbenblindheit): Kandidat (kleiner Ring), Bestes Ziel links (Ring mit Q-Symbol), Bestes Ziel rechts (Ring mit E-Symbol), Bereits verankert (gefuelltes Symbol mit Seilverbindung).", acceptance: "Ein Testspieler kann jederzeit ohne Nachdenken sagen, wohin Q und E ihn bringen wuerden.", depends_on: ["F-023"], prio: 1, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R30", evidence: "", note: ""),
    (id: "F-027", name: "Marker-Dichtebegrenzung", domain: "world", system: "Ankersystem", stage: Unbuilt, description: "Maximal 12 gleichzeitig sichtbare Marker, ausgewaehlt nach Bewertungsfunktion. Marker verblassen mit Distanz und werden bei hoher Punktdichte ausgeduennt, damit das Sichtfeld nicht zugemuellt wird. Deckkraft und Maximalanzahl sind in den Einstellungen regelbar, inklusive vollstaendiger Abschaltung.", acceptance: "In der dichtesten Map ueberdecken Marker nie mehr als 15 Prozent der Bildflaeche; Abschaltung funktioniert vollstaendig.", depends_on: ["F-026"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R31", evidence: "", note: ""),
    (id: "F-028", name: "Fallback ohne Kandidat", domain: "world", system: "Ankersystem", stage: Unbuilt, description: "Existiert in der angeforderten Hemisphaere kein gueltiger Punkt, faellt das System automatisch auf freies Zielen (F-002) zurueck und feuert den Haken in Blickrichtung. Gibt es dort ebenfalls keine gueltige Flaeche, erfolgt ein Fehlversuch mit eigenem Sound und kurzer Seilrueckzugsanimation statt eines stillen Nichtereignisses.", acceptance: "Kein Tastendruck bleibt ohne Rueckmeldung; der Spieler versteht immer, warum kein Haken gesetzt wurde.", depends_on: ["F-024"], prio: 1, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R32", evidence: "", note: ""),
    (id: "F-029", name: "Dynamische Ankerpunkte", domain: "world", system: "Ankersystem", stage: Unbuilt, description: "Ankerpunkte an bewegten Objekten: Titanenkoerper (Schulter, Arm, Nacken), fahrende Eskortkarren, Hafenkraene, Mauerlifte. Werden pro Frame mit dem Traegerobjekt mitgefuehrt und beim Tod oder der Zerstoerung des Traegers sauber entfernt.", acceptance: "Ein Haken an einem Titanen bleibt waehrend dessen Bewegung korrekt verankert und loest sich beim Tod des Titanen mit Feedback.", depends_on: ["F-021"], prio: 2, effort_pd: 7, source: "features.xlsx!01_Spielfunktionen!R33", evidence: "", note: ""),
    (id: "F-030a", name: "Performance der Kandidatensuche", domain: "world", system: "Ankersystem", stage: Unbuilt, description: "Suche laeuft rein clientseitig ohne Server-Roundtrip, mit 10 Hz Aktualisierungsrate und Interpolation der Markerpositionen dazwischen. Raeumliche Vorfilterung ueber ein Gitter statt linearer Iteration ueber alle Punkte der Map.", acceptance: "Die Suche kostet unter 0,8 ms pro Frame auf dem PC-Mindestprofil, auch bei 4000 Ankerpunkten in der Map.", depends_on: ["F-023"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R34", evidence: "", note: ""),
    (id: "F-031a", name: "Ankerpunkt-Validierung im Editor", domain: "world", system: "Ankersystem", stage: Unbuilt, description: "Pruefwerkzeug findet unerreichbare Punkte, Punkte ohne Sichtlinie, zu dichte Cluster, Loecher in der Abdeckung und Punkte mit falscher Normalenausrichtung. Erzeugt einen Bericht pro Map.", acceptance: "Kein Release einer Map ohne fehlerfreien Validierungsbericht.", depends_on: ["F-022"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R35", evidence: "", note: ""),
    (id: "F-032a", name: "Trainingsanzeige fuer Ankerpunkte", domain: "world", system: "Ankersystem", stage: Unbuilt, description: "Im Trainingsgelaende einblendbarer Modus, der ALLE Punkte einer Zone sichtbar macht, samt Bewertungswerten und der Bahn, die das System bei Q oder E waehlen wuerde. Lehrwerkzeug fuer das Verstaendnis der eigenen Traversal.", acceptance: "Ein Spieler kann nachvollziehen, warum das System einen bestimmten Punkt gewaehlt hat.", depends_on: ["F-025"], prio: 2, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R36", evidence: "", note: ""),
    (id: "F-030", name: "Nape-Trefferzone (Cortex)", domain: "combat", system: "Kampf", stage: Proven, description: "Separate Kollisionsgeometrie am Nacken jedes Titanen als einziger Kill-Punkt. Visuell markiert durch dampfende, leicht leuchtende Textur.", acceptance: "Cortex ist aus 100 studs Entfernung erkennbar; Treffer registriert zuverlaessig.", depends_on: [], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R37", evidence: "hits at 8 / 30 / 75 m/s = 3 of 3; at 75 m/s the closest approach at any tick boundary is 0.150 m, so a position sample had nothing to find · 9.0 us per cast over 1000 casts · red-checked three ways: swept cast replaced by a position sample (8 of 8 red), cortex cast placed last (9 of 14 red), one mask for both layers (torso test red) · against a REAL solid husk at 30 m/s: cut on tick 10, 0.484 m of air, 0.00 m/s across the flight line · docs/images/f030-cortex.png sha256 951aff7b twice [debian]", note: "2026-08-09 [debian] — one swept cast_shape per active blade per tick, two filtered casts with the cortex layer first. Risk 2 was measured and does NOT fire: default_speculative_margin is Scalar::MAX, so update_aabb sweeps the full vel*dt. The readability half of the acceptance ('recognisable from 100 studs') is still unanswerable until Q-026"),
    (id: "F-031", name: "Geschwindigkeitsabhaengige Schadensformel", domain: "combat", system: "Kampf", stage: Unbuilt, description: "Schaden skaliert mit relativer Anfluggeschwindigkeit und Schnittwinkel. Bewegung ist Schaden.", acceptance: "Ein Schnitt bei doppelter Geschwindigkeit erzeugt mindestens 60 Prozent mehr Schaden.", depends_on: ["F-030"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R38", evidence: "", note: ""),
    (id: "F-032", name: "Sekundaere Trefferzonen", domain: "combat", system: "Kampf", stage: Unbuilt, description: "Arme, Beine, Augen mit eigenen Hitboxen. Kein Kill, sondern Stagger, Bewegungs-Debuff oder Blendung.", acceptance: "Bein-Treffer laesst Titan stuerzen; Augen-Treffer erzeugt 3 s Orientierungslosigkeit.", depends_on: ["F-030"], prio: 1, effort_pd: 7, source: "features.xlsx!01_Spielfunktionen!R39", evidence: "", note: ""),
    (id: "F-033", name: "Klingenhaltbarkeit", domain: "combat", system: "Kampf", stage: Unbuilt, description: "Rote Leiste, Verbrauch pro Schlag, abhaengig von getroffener Zone. Bruch mit lautem Feedback und Animation.", acceptance: "Klingenbruch entfernt Schadenspotenzial vollstaendig bis zum Nachladen.", depends_on: ["F-030"], prio: 1, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R40", evidence: "", note: ""),
    (id: "F-034", name: "Hit-Stop und Impact-Frames", domain: "combat", system: "Kampf", stage: Proven, description: "Kurzer Zeitstopp bei Nape-Kill mit Kamera-Kick und Sound-Layer. Wichtigstes Belohnungssignal im Spiel.", acceptance: "Kill fuehlt sich in Blindtests messbar befriedigender an als ohne Hit-Stop.", depends_on: ["F-030"], prio: 1, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R41", evidence: "Tick advances 20 over 20 steps while Position is bit-identical for exactly 7 ticks = round(0.12 * 60), and differs on the next · ticks inside the husk cortex at 30 m/s: 3 without the stop, 10 with it · red-checked by dropping RigidBodyDisabled: bit-identical for 1 tick instead of 7 · titan side: 0.1000 m of drift in 2 free ticks against 0.0000 m in 2 frozen ticks · docs/images/f034-hitstop.png, tick 161 of the same run as f030-cortex.png at 155, both showing pos 15.8 7.8 0.8 identical to the digit [debian]", note: "2026-08-09 [debian] — a tick-counted component, never Time<Virtual>. THE BLIND TEST WITH HUMAN TESTERS HAS NOT BEEN RUN — the row's own acceptance is not satisfiable by an agent, and this stage rests on the substitute criteria"),
    (id: "F-035", name: "Lance Charges (Fernwaffe)", domain: "combat", system: "Kampf", stage: Unbuilt, description: "Explosive Wurflanzen mit Haftung, manueller Detonation in Naehe und Auto-Detonation nach Zeit oder Distanz. Eigene Statlinie.", acceptance: "Manuelle und automatische Detonation funktionieren; Blast-Radius als Stat wirksam.", depends_on: ["F-030"], prio: 2, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R42", evidence: "", note: ""),
    (id: "F-036", name: "Lance-Munition und Nachschub", domain: "combat", system: "Kampf", stage: Unbuilt, description: "Begrenzte Anzahl Lanzen pro Mission, Nachschub nur an Stationen. Ammunition ist ein Stat.", acceptance: "Munitionszaehler im HUD; Nachladen an Station funktioniert.", depends_on: ["F-035"], prio: 2, effort_pd: 3, source: "features.xlsx!01_Spielfunktionen!R43", evidence: "", note: ""),
    (id: "F-037", name: "Kein Friendly Fire", domain: "combat", system: "Kampf", stage: Unbuilt, description: "Explosionen und Klingen verursachen keinen Schaden an Mitspielern, wohl aber Knockback als taktisches Element.", acceptance: "Kein Spieler kann einen anderen toeten; Knockback ist einstellbar.", depends_on: ["F-035"], prio: 1, effort_pd: 2, source: "features.xlsx!01_Spielfunktionen!R44", evidence: "", note: ""),
    (id: "F-038", name: "Verletzungssystem", domain: "combat", system: "Kampf", stage: Unbuilt, description: "Treffer durch Titanen koennen gestufte Verletzungen zufuegen (leicht/schwer/kritisch), die Stats senken. Sichtbar im HUD.", acceptance: "Verletzungen sind unterscheidbar, wirken auf Stats und sind im Feld temporaer behandelbar.", depends_on: ["F-032"], prio: 2, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R45", evidence: "", note: ""),
    (id: "F-039", name: "Feldbehandlung und Medic", domain: "combat", system: "Kampf", stage: Unbuilt, description: "Verletzungen im Hub heilbar; im Feld nur temporaer stabilisierbar durch Verbandsitem oder Support-Skill.", acceptance: "Medic-NPC heilt alle Stufen; Feldverband hebt nur eine Stufe fuer begrenzte Zeit.", depends_on: ["F-038"], prio: 2, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R46", evidence: "", note: ""),
    (id: "F-040", name: "Gerichteter Griff-Escape", domain: "combat", system: "Kampf", stage: Unbuilt, description: "Bei Titanengriff zeigt das UI eine Richtung; Spieler muss den Haken in die Gegenrichtung schiessen. Ersetzt Button-Mashing durch eine Koennenspruefung.", acceptance: "Escape gelingt bei korrekter Richtung, scheitert bei falscher; kein Vorteil durch schnelleres Tastenhaemmern messbar.", depends_on: ["F-030"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R47", evidence: "", note: ""),
    (id: "F-041", name: "Combo-System", domain: "combat", system: "Kampf", stage: Unbuilt, description: "Aufeinanderfolgende Treffer ohne Bodenkontakt erhoehen einen Multiplikator, der bei Treffer oder Landung zurueckgesetzt wird.", acceptance: "Multiplikator sichtbar, wirkt auf Gold und Schaden, bricht korrekt ab.", depends_on: ["F-031"], prio: 2, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R48", evidence: "", note: ""),
    (id: "F-042", name: "Finisher-Kamera", domain: "combat", system: "Kampf", stage: Unbuilt, description: "Kurze Zeitlupe beim letzten Titanen einer Welle oder bei einem Multi-Kill. Abschaltbar.", acceptance: "Ausloesebedingungen greifen; Kamera bricht bei Gefahr sofort ab.", depends_on: ["F-034"], prio: 3, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R49", evidence: "", note: ""),
    (id: "F-043", name: "Schadenszahlen und Trefferfeedback", domain: "combat", system: "Kampf", stage: Unbuilt, description: "Schwebende Zahlen, Trefferblitz, unterschiedliche Sounds fuer Normal/Crit/Nape. Vollstaendig abschaltbar.", acceptance: "Drei Trefferarten sind akustisch und visuell unterscheidbar.", depends_on: ["F-031"], prio: 2, effort_pd: 3, source: "features.xlsx!01_Spielfunktionen!R50", evidence: "", note: ""),
    (id: "F-044", name: "Nahkampf am Boden", domain: "combat", system: "Kampf", stage: Unbuilt, description: "Grundlegender Bodenangriff fuer Situationen ohne Gas, deutlich schwaecher als Luftangriff.", acceptance: "Bodenangriff existiert, ist aber niemals die effizientere Wahl.", depends_on: [], prio: 3, effort_pd: 3, source: "features.xlsx!01_Spielfunktionen!R51", evidence: "", note: ""),
    (id: "F-050", name: "Zustandsmaschine", domain: "titan", system: "Titan-KI", stage: Proven, description: "Kern-FSM: Idle, Alerted, Pursue, Attack, Stagger, Recover, Death. Modular erweiterbar pro Typ.", acceptance: "Alle Zustaende sind im Debug-Overlay sichtbar und wechseln korrekt.", depends_on: [], prio: 1, effort_pd: 12, source: "features.xlsx!01_Spielfunktionen!R52", evidence: "ticks per state for a husk at 25 m: Idle 1, Pursue 410, Windup 36, Strike 12, Recover 24, Pursue 18; the 36 is round(windup_s 0.60 * 60) computed from GameData · red-checked with a Pursue->Strike edge: Windup vanishes from the sequence · red-checked a second way after the first draft was fooled by a hardcoded 36 (the husk's windup really is 36): the test now drives on to Strike and demands 5/12, which the constant reads as 5/36 · docs/images/f050-states.png, overlay 'husk#1 Windup 21/36' with the striking arm horizontal in the same frame, sha256 c4d4681c over three runs [debian]", note: "2026-08-09 [debian] — the pose is a pure function of (state, ticks_in_state), proven bitwise independent of the clock. StateClock and TitanKindName live in shared/, so the overlay reads them with NO new allow-list edge - tests/domains.rs green and the block still empty"),
    (id: "F-051", name: "Wahrnehmungsmodell", domain: "titan", system: "Titan-KI", stage: Unbuilt, description: "Sichtkegel mit Reichweite und Winkel plus Hoerradius. Gas-Boost erzeugt Laerm und zieht Aufmerksamkeit.", acceptance: "Ein leise agierender Spieler wird spaeter entdeckt als ein boostender.", depends_on: ["F-050"], prio: 2, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R53", evidence: "", note: ""),
    (id: "F-052", name: "Pathfinding mit Groessenlogik", domain: "titan", system: "Titan-KI", stage: Unbuilt, description: "Navigation um Gebaeude; grosse Titanen laufen durch kleine Hindernisse hindurch statt sie zu umgehen.", acceptance: "15m-Titan zerstoert kleine Props, 3m-Titan umgeht sie.", depends_on: ["F-050"], prio: 1, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R54", evidence: "", note: ""),
    (id: "F-053", name: "Telegraphierte Angriffe", domain: "titan", system: "Titan-KI", stage: Proven, description: "Jede Attacke besitzt eine lesbare Windup-Phase von mindestens 0,4 s mit eindeutiger Silhouette.", acceptance: "Testspieler koennen nach 10 Minuten alle Angriffe vorhersehen.", depends_on: ["F-050"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R55", evidence: "hand travel 8.221 m over 36 ticks = 384 px at 20 m, 192 px at 40 m, 77 px at 100 m, against a criterion of 150 px at 40 m and predictions of 412/206/82 (6.1-6.8 % below, inside the 10 % window) · red-checked with the pose angles set to zero: 0.0000 m, 0.0 px · docs/images/f053-windup.png, two panels at t=420 and t=447, one camera, bit-identical over two runs [debian]", note: "2026-08-09 [debian] — a single screenshot cannot catch a missing telegraph: a still frame of a titan with its arm down is indistinguishable from one with no telegraph. Only the two-sample pixel delta catches it, which is why the picture is two panels"),
    (id: "F-054", name: "KI-Level-of-Detail", domain: "titan", system: "Titan-KI", stage: Unbuilt, description: "Nahe Titanen ticken mit 20 Hz, entfernte mit 5 Hz, sehr entfernte nur als Positionsinterpolation.", acceptance: "60 aktive Titanen erzeugen unter 8 ms Serverlast pro Frame.", depends_on: ["F-050"], prio: 1, effort_pd: 7, source: "features.xlsx!01_Spielfunktionen!R56", evidence: "", note: ""),
    (id: "F-055", name: "Gruppendynamik", domain: "titan", system: "Titan-KI", stage: Unbuilt, description: "Titanen umkreisen den Spieler statt sich zu stapeln; sie beanspruchen Positionsslots um das Ziel.", acceptance: "Bei 6 Titanen auf einen Spieler stehen keine zwei in derselben Position.", depends_on: ["F-052"], prio: 2, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R57", evidence: "", note: ""),
    (id: "F-056", name: "Gegnertyp: Husk (Standard)", domain: "titan", system: "Titan-KI", stage: Built, description: "Basistyp. Langsam, gerade Verfolgung, Standardangriffe. 70 Prozent aller Spawns auf niedrigen Schwierigkeiten.", acceptance: "Spawnt korrekt, greift korrekt an, stirbt bei Cortex-Treffer.", depends_on: ["F-050"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R58", evidence: "nine entities, cortex at 8.900 m against GameData 8.900 and scale.ron 8.9, with its parent asserted to be the head · red-checked by re-parenting the cortex to the pelvis · collider gone on tick one after a cortex hit, TitanId 1 -> 0 after death_s · CustomPositionIntegration measured: 3.000 m in 60 ticks with the marker, 6.000 m without, exactly twice · docs/images/f056-husk.png sha256 ade7a6b7 twice [debian]", note: "2026-08-09 [debian] — 🟨 and not 🟧 because two parts of the picture clause are missing: no PhysicsDebugPlugin wireframe (the plugin is registered nowhere) and no 1.8 m player capsule in frame for scale, which a first-person camera cannot produce"),
    (id: "F-057", name: "Gegnertyp: Errant (Abnormal)", domain: "titan", system: "Titan-KI", stage: Unbuilt, description: "Unberechenbar, deutlich schneller, ignoriert Naherfolgung zugunsten von Distanzsprints. Zusatzangriffe Bellyflop und Kick.", acceptance: "Verhalten ist sichtbar anders als Husk; Zusatzangriffe werden ausgeloest.", depends_on: ["F-056"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R59", evidence: "", note: ""),
    (id: "F-058", name: "Gegnertyp: Scuttler (Crawler)", domain: "titan", system: "Titan-KI", stage: Unbuilt, description: "Bewegt sich vierfuessig, sehr hohe Geschwindigkeit, reduzierte HP, Dive-Attacke im Sprung. Eigenes Rig.", acceptance: "Scuttler ist die schnellste Bodeneinheit; Dive trifft vorhersagbar.", depends_on: ["F-050"], prio: 1, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R60", evidence: "", note: ""),
    (id: "F-059", name: "Gegnertyp: Weaver (Ducker)", domain: "titan", system: "Titan-KI", stage: Unbuilt, description: "Reagiert auf Annaeherung an den Cortex mit Rueckwaertsrolle und I-Frames nach dem Startup. Bestraft mechanisches Spam.", acceptance: "Rolle hat lesbares Startup, danach garantierte Unverwundbarkeit fuer definierte Dauer.", depends_on: ["F-050"], prio: 1, effort_pd: 7, source: "features.xlsx!01_Spielfunktionen!R61", evidence: "", note: ""),
    (id: "F-060", name: "Gegnertyp: Warden", domain: "titan", system: "Titan-KI", stage: Unbuilt, description: "Schuetzt den eigenen Cortex aktiv mit der Hand. Muss von vorne gestaggert oder an den Armen verwundet werden, bevor der Nacken frei liegt.", acceptance: "Frontalangriff auf Arme oeffnet den Cortex fuer ein Zeitfenster.", depends_on: ["F-032"], prio: 2, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R62", evidence: "", note: ""),
    (id: "F-061", name: "Gegnertyp: Lurker", domain: "titan", system: "Titan-KI", stage: Unbuilt, description: "Ambush-Einheit. Kauert bewegungslos, greift erst bei Naehe an, kann Spieler aus der Luft greifen. Erzwingt Hoehenwechsel.", acceptance: "Lurker ist im Ruhezustand schwer von Umgebungsgeometrie zu unterscheiden.", depends_on: ["F-051"], prio: 2, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R63", evidence: "", note: ""),
    (id: "F-062", name: "Gegnertyp: Bellower", domain: "titan", system: "Titan-KI", stage: Unbuilt, description: "Reagiert extrem auf Gas-Geraeusche und ruft andere Titanen herbei. Fuegt eine Stealth-Ebene hinzu.", acceptance: "Ruf zieht alle Titanen im Radius an; leises Spiel vermeidet den Ruf.", depends_on: ["F-051"], prio: 2, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R64", evidence: "", note: ""),
    (id: "F-063", name: "Gegnertyp: Chorus (Paar)", domain: "titan", system: "Titan-KI", stage: Unbuilt, description: "Spawnt immer zu zweit und deckt gegenseitig den Cortex. Erfordert Fokusreihenfolge oder Trennung.", acceptance: "Ein Chorus-Titan blockt Angriffe auf seinen Partner, solange beide leben.", depends_on: ["F-055"], prio: 3, effort_pd: 7, source: "features.xlsx!01_Spielfunktionen!R65", evidence: "", note: ""),
    (id: "F-064", name: "Groessenklassen", domain: "titan", system: "Titan-KI", stage: Unbuilt, description: "Drei Groessenstufen (3m, 7m, 15m) mit angepassten Hitboxen, Reichweiten, HP und Attacken.", acceptance: "Alle drei Klassen erfordern unterschiedliche Anflugwinkel.", depends_on: ["F-050"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R66", evidence: "", note: ""),
    (id: "F-065", name: "Spawn-Budget-System", domain: "titan", system: "Titan-KI", stage: Unbuilt, description: "Direktor-System begrenzt gleichzeitige Titanen nach Serverlast und Spielerzahl und waehlt Typen nach Gewichtung pro Schwierigkeit.", acceptance: "Kein Server ueberschreitet das Budget; Typenverteilung entspricht der Config.", depends_on: ["F-054"], prio: 1, effort_pd: 7, source: "features.xlsx!01_Spielfunktionen!R67", evidence: "", note: ""),
    (id: "F-066", name: "Object Pooling", domain: "titan", system: "Titan-KI", stage: Unbuilt, description: "Titanen werden wiederverwendet statt neu erzeugt. Gilt auch fuer Projektile und VFX.", acceptance: "Kein messbarer Frame-Spike beim Spawn einer Welle.", depends_on: ["F-065"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R68", evidence: "", note: ""),
    (id: "F-070", name: "Missions-Zustandsmaschine", domain: "mission", system: "Missionen", stage: Proven, description: "Generischer Ablauf: Briefing, Deployment, aktive Phase, Zielabschluss, Extraktion, Ergebnis.", acceptance: "Alle Modi nutzen dieselbe Basismaschine; neue Modi sind reine Config.", depends_on: [], prio: 1, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R69", evidence: "Lost decided at tick 19800 exactly, red-checked against a Time::delta_secs() accumulator which lands on 19804 - four ticks late from f32 drift alone, in a harness fed exactly one fixed step per frame · red-checked again with the duration as a Rust literal: left 19800, right 600 · docs/images/f070-lost.png sha256 68aa8dc1 over three runs of one binary [debian]", note: "2026-08-09 [debian] — the timer counts fixed ticks and never a clock. The second loss path (every player down) is live as of P5 and fires at tick 220 in its own test"),
    (id: "F-071", name: "Modus: Skirmish", domain: "mission", system: "Missionen", stage: Built, description: "Offene Feldschlacht. Toete eine Zielanzahl Titanen innerhalb eines Zeitlimits, ohne dass zu viele NPC-Zivilisten sterben.", acceptance: "Ziel- und Fehlbedingungen greifen; Fortschritt ist im HUD sichtbar.", depends_on: ["F-070"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R70", evidence: "MISSION WON at tick 898 from a real flight and three real cortex cuts at 30.33 m/s closing speed - no injected message, the script vocabulary has no verb for one · 3/3 kills, 23 asserts held, exit 0, identical over three headless runs · red-checked: counting every TitanHit makes a torso hit win (left 1, right 0); checking titans == 0 wins at tick 0 before anything spawns (left Won, right Active) · 4 non-cortex TitanHit in the same run, so the cortex filter was provably exercised · docs/images/f071-won.png [debian]", note: "2026-08-09 [debian] — CEILING 🟨 ON PURPOSE, as the plan pre-registered: the description's civilian clause ('without too many NPC civilians dying') is dropped, because there are no NPCs and no F-ID for them. All three legs of 🟧 exist otherwise. Kept at 🟨 so the row can move down later without an argument"),
    (id: "F-072", name: "Modus: Breach (Verteidigung)", domain: "mission", system: "Missionen", stage: Unbuilt, description: "Halte eine Position gegen anrollende Wellen, waehrend eine Struktur Schaden nimmt. Verlust der Struktur = Fehlschlag.", acceptance: "Struktur-HP sichtbar; Wellen eskalieren nach Kurve.", depends_on: ["F-070"], prio: 1, effort_pd: 7, source: "features.xlsx!01_Spielfunktionen!R71", evidence: "", note: ""),
    (id: "F-073", name: "Modus: Escort", domain: "mission", system: "Missionen", stage: Unbuilt, description: "Begleite bewegliche Karren entlang einer Route zum Sicherheitspunkt. Karren sind zerstoerbar.", acceptance: "Karren bewegen sich auf Pfad; Verlust aller Karren beendet die Mission.", depends_on: ["F-070"], prio: 1, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R72", evidence: "", note: ""),
    (id: "F-074", name: "Modus: Stall (Ueberleben)", domain: "mission", system: "Missionen", stage: Unbuilt, description: "Ueberlebe eine feste Dauer gegen eskalierende Uebermacht. Kein Kill-Ziel, reine Ausweichpruefung.", acceptance: "Timer laeuft, Spawnrate steigt, Fehlschlag kostet Streak.", depends_on: ["F-070"], prio: 2, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R73", evidence: "", note: ""),
    (id: "F-075", name: "Modus: Protect", domain: "mission", system: "Missionen", stage: Unbuilt, description: "Schuetze ein bewegliches, nicht steuerbares NPC-Ziel, das eine Aufgabe erledigt. Ziel hat eigene HP-Leiste.", acceptance: "Ziel-HP sichtbar; Titanen priorisieren das Ziel ueber Spieler.", depends_on: ["F-070"], prio: 2, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R74", evidence: "", note: ""),
    (id: "F-076", name: "Modus: Reclaim (neu)", domain: "mission", system: "Missionen", stage: Unbuilt, description: "Erobere und halte drei Kontrollpunkte nacheinander. Punkte erfordern Anwesenheit und Titanfreiheit im Radius.", acceptance: "Eroberung laeuft nur bei geraeumtem Radius; Rueckeroberung durch Titanen moeglich.", depends_on: ["F-070"], prio: 2, effort_pd: 7, source: "features.xlsx!01_Spielfunktionen!R75", evidence: "", note: ""),
    (id: "F-077", name: "Modus: Traversal Trial (neu)", domain: "mission", system: "Missionen", stage: Unbuilt, description: "Reiner Bewegungsmodus. Zeitrennen ueber Checkpoints ohne Kampf, mit Geister-Replay und Bestenliste.", acceptance: "Zeiten werden persistiert; Geist eines besseren Laufs ist abspielbar.", depends_on: ["F-014"], prio: 2, effort_pd: 9, source: "features.xlsx!01_Spielfunktionen!R76", evidence: "", note: ""),
    (id: "F-078", name: "Randomizer", domain: "mission", system: "Missionen", stage: Unbuilt, description: "Zufaellig kombinierte Zielsets aus dem Pool aller Modi. Hoehere Belohnung durch Unvorhersehbarkeit.", acceptance: "Kombinationen sind valide und niemals unmoeglich.", depends_on: ["F-070"], prio: 2, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R77", evidence: "", note: ""),
    (id: "F-079", name: "Sekundaerziele", domain: "mission", system: "Missionen", stage: Unbuilt, description: "Zufaellig zugewiesenes optionales Zusatzziel pro Einsatz. Bonusbelohnung bei Abschluss.", acceptance: "Mindestens 8 verschiedene Sekundaerziele; Chance skaliert mit Schwierigkeit.", depends_on: ["F-070"], prio: 2, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R78", evidence: "", note: ""),
    (id: "F-080", name: "Schwierigkeitsgrade", domain: "mission", system: "Missionen", stage: Unbuilt, description: "Fuenf Stufen mit skalierenden Titanenzahlen, HP, Typenverteilung und Belohnungen. Gating ueber Ausruestungsrang.", acceptance: "Jede Stufe ist als Config-Datei definiert; Sprung zwischen Stufen ist spuerbar.", depends_on: ["F-070"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R79", evidence: "", note: ""),
    (id: "F-081", name: "Modifikatoren (Mutatoren)", domain: "mission", system: "Missionen", stage: Unbuilt, description: "Optional zuschaltbare Erschwernisse fuer erhoehte Belohnung: Nebel, kein Nachschub, doppelte Scuttler, Nacht, Regen mit reduzierter Haftung.", acceptance: "Mindestens 10 Modifikatoren, stapelbar, Belohnungsmultiplikator korrekt berechnet.", depends_on: ["F-080"], prio: 2, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R80", evidence: "", note: ""),
    (id: "F-082", name: "Spielerzahl-Skalierung", domain: "mission", system: "Missionen", stage: Unbuilt, description: "Titananzahl, Boss-HP und Zielwerte skalieren mit der Spielerzahl im Server. Solo ist vollstaendig spielbar.", acceptance: "Solo-Clear-Zeit weicht um weniger als 25 Prozent von Gruppen-Clear-Zeit ab.", depends_on: ["F-080"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R81", evidence: "", note: ""),
    (id: "F-083", name: "Killstreak-System", domain: "mission", system: "Missionen", stage: Unbuilt, description: "Aufeinanderfolgende erfolgreiche Missionen erhoehen einen Belohnungsmultiplikator, der bei Fehlschlag zurueckgesetzt wird.", acceptance: "Streak persistiert ueber Sessions; Verlustbedingung ist vor Missionsstart klar kommuniziert.", depends_on: ["F-070"], prio: 3, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R82", evidence: "", note: ""),
    (id: "F-084", name: "Extraktionsphase", domain: "mission", system: "Missionen", stage: Unbuilt, description: "Nach Zielabschluss muss der Spieler zu einem Extraktionspunkt zurueck. Optional, gibt Bonus, erzeugt Spannungsbogen.", acceptance: "Extraktion ist ueberspringbar mit Belohnungsabschlag.", depends_on: ["F-070"], prio: 3, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R83", evidence: "", note: ""),
    (id: "F-085", name: "Post-Match-Auswertung", domain: "mission", system: "Missionen", stage: Unbuilt, description: "Detaillierte Aufschluesselung: Kills nach Typ, Genauigkeit, Durchschnittsgeschwindigkeit, hoechste Combo, Beitragsanteil, Belohnungen.", acceptance: "Alle Werte werden serverseitig getrackt und korrekt angezeigt.", depends_on: ["F-070"], prio: 2, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R84", evidence: "", note: ""),
    (id: "F-090", name: "Raid-Framework", domain: "mission", system: "Raids", stage: Unbuilt, description: "Mehrphasige Bosskaempfe mit HP-Gates, Phasenuebergaengen, Cutscene-Slots und Wipe-Recovery.", acceptance: "Phasenwechsel funktionieren; Wipe setzt auf Phasenanfang zurueck statt auf Missionsanfang.", depends_on: ["F-070"], prio: 2, effort_pd: 14, source: "features.xlsx!01_Spielfunktionen!R85", evidence: "", note: ""),
    (id: "F-091", name: "Boss: The Bound One", domain: "mission", system: "Raids", stage: Unbuilt, description: "Erster Raid. Phase 1 Schutzauftrag, Phase 2 direkter Kampf, Phase 3 Raserei mit HP-Wiederherstellung und erhoehtem Tempo.", acceptance: "Alle drei Phasen sind mechanisch unterschiedlich, nicht nur statistisch.", depends_on: ["F-090"], prio: 2, effort_pd: 12, source: "features.xlsx!01_Spielfunktionen!R86", evidence: "", note: ""),
    (id: "F-092", name: "Boss: The Dancer", domain: "mission", system: "Raids", stage: Unbuilt, description: "Beweglicher Boss mit Schwachstellen am gesamten Koerper statt nur am Cortex. Belohnt Praezision statt Rohschaden.", acceptance: "Mindestens 4 rotierende Schwachpunkte; Fokus auf einen einzigen ist ineffizient.", depends_on: ["F-090"], prio: 2, effort_pd: 12, source: "features.xlsx!01_Spielfunktionen!R87", evidence: "", note: ""),
    (id: "F-093", name: "Boss: The Bulwark", domain: "mission", system: "Raids", stage: Unbuilt, description: "Gepanzerter Boss. Panzerung muss durch Lance Charges oder Umgebungsobjekte gebrochen werden, bevor Klingen wirken.", acceptance: "Klingenschaden ist vor Panzerbruch nahezu null; Bruch ist visuell eindeutig.", depends_on: ["F-035"], prio: 2, effort_pd: 12, source: "features.xlsx!01_Spielfunktionen!R88", evidence: "", note: ""),
    (id: "F-094", name: "Boss: The Ashwalker", domain: "mission", system: "Raids", stage: Unbuilt, description: "Riesenboss. Phase 1 nur durch Umgebungswaffen (Mauerkanonen) bekaempfbar bei gleichzeitigem Schutzauftrag. Phase 2 klassischer Kampf.", acceptance: "Phase 1 ist ohne Kanonen nicht gewinnbar; Phase 2 wechselt vollstaendig die Anforderung.", depends_on: ["F-090"], prio: 2, effort_pd: 16, source: "features.xlsx!01_Spielfunktionen!R89", evidence: "", note: ""),
    (id: "F-095", name: "Umgebungswaffen", domain: "mission", system: "Raids", stage: Unbuilt, description: "Bedienbare Kanonen, Ballisten und Fallen auf Raid-Maps. Erfordern Positionierung und Nachladen.", acceptance: "Waffen sind von mehreren Spielern gleichzeitig nutzbar; Zielen ist manuell.", depends_on: ["F-094"], prio: 2, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R90", evidence: "", note: ""),
    (id: "F-096", name: "Beitragsschwelle (Credit)", domain: "mission", system: "Raids", stage: Unbuilt, description: "Spieler muessen einen Mindestanteil am Kampf leisten, um Beute zu erhalten. Fortschritt sichtbar waehrend des Kampfes.", acceptance: "Untaetige Spieler erhalten keine Beute; Schwelle ist im HUD ablesbar.", depends_on: ["F-090"], prio: 2, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R91", evidence: "", note: ""),
    (id: "F-097", name: "Raid-Matchmaking", domain: "mission", system: "Raids", stage: Unbuilt, description: "Warteschlange fuer 8 bis 10 Spieler mit Rang-Anforderung, plus Privatgruppen-Option.", acceptance: "Queue fuellt sich serveruebergreifend ueber MemoryStoreService.", depends_on: ["F-090"], prio: 2, effort_pd: 9, source: "features.xlsx!01_Spielfunktionen!R92", evidence: "", note: ""),
    (id: "F-098", name: "Beutetruhen mit Schluesselstufen", domain: "mission", system: "Raids", stage: Unbuilt, description: "Basistruhe frei, Premiumtruhe mit Schluessel und verdoppelten Raten. Schluessel aus Wochenzielen, nicht aus dem Shop.", acceptance: "Schluessel sind ausschliesslich durch Spielen erhaeltlich.", depends_on: ["F-096"], prio: 2, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R93", evidence: "", note: ""),
    (id: "F-099", name: "Aufstiegs-Modus (Ascension)", domain: "mission", system: "Raids", stage: Unbuilt, description: "Wochentlich rotierende Raid-Variante mit fixen Modifikatoren und eigener Bestenliste.", acceptance: "Rotation laeuft automatisch; Bestenliste wird woechentlich zurueckgesetzt und archiviert.", depends_on: ["F-090"], prio: 3, effort_pd: 7, source: "features.xlsx!01_Spielfunktionen!R94", evidence: "", note: ""),
    (id: "F-105", name: "Bonding-System", domain: "player", system: "Vessel Form", stage: Unbuilt, description: "Ausgeruestetes Ichor-Vial plus freigeschaltete Faehigkeit erlaubt die Verwandlung. Ladeleiste fuellt sich durch Kampfleistung.", acceptance: "Leiste laedt nachvollziehbar; Verwandlung nur bei voller Leiste moeglich.", depends_on: ["F-030"], prio: 2, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R95", evidence: "", note: ""),
    (id: "F-106", name: "Zeitlimit und Eject", domain: "player", system: "Vessel Form", stage: Unbuilt, description: "Verwandlung ist zeitlich begrenzt; vorzeitiges Ausklinken gibt einen Teil der Ladung zurueck.", acceptance: "Timer sichtbar; Eject funktioniert jederzeit und positioniert den Spieler sicher.", depends_on: ["F-105"], prio: 2, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R96", evidence: "", note: ""),
    (id: "F-107", name: "Eigenstaendiges Moveset", domain: "player", system: "Vessel Form", stage: Unbuilt, description: "Kein vergroesserter Spieler: eigene Nahkampfcombos, Griff, Wurf, Bruell-Fertigkeit, Sprint mit Rammschaden.", acceptance: "Mindestens 8 einzigartige Aktionen pro Form; Vector Gear ist waehrenddessen deaktiviert.", depends_on: ["F-105"], prio: 2, effort_pd: 14, source: "features.xlsx!01_Spielfunktionen!R97", evidence: "", note: ""),
    (id: "F-108", name: "Form: Warbound (Angriff)", domain: "player", system: "Vessel Form", stage: Unbuilt, description: "Ausgewogene Kampfform mit hohem Schaden, Regeneration und einer Raserei-Faehigkeit bei niedriger HP.", acceptance: "Form ist spielbar und unterscheidet sich klar von allen anderen.", depends_on: ["F-107"], prio: 2, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R98", evidence: "", note: ""),
    (id: "F-109", name: "Form: Bladewright (Technik)", domain: "player", system: "Vessel Form", stage: Unbuilt, description: "Schnelle, praezise Form mit Konterfenstern und Kombo-Zustand, der bei perfekter Kette Bonusschaden gibt.", acceptance: "Kombozustand ist erreichbar und sichtbar; Konter funktioniert gegen definierte Angriffe.", depends_on: ["F-107"], prio: 3, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R99", evidence: "", note: ""),
    (id: "F-110", name: "Form: Bulwark (Panzer)", domain: "player", system: "Vessel Form", stage: Unbuilt, description: "Langsame, gepanzerte Form mit Schadensreduktion, Ansturm und Flaechen-Erschuetterung.", acceptance: "Form haelt messbar mehr aus und ist deutlich langsamer.", depends_on: ["F-107"], prio: 3, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R100", evidence: "", note: ""),
    (id: "F-111", name: "Form: Colossus (Belagerung)", domain: "player", system: "Vessel Form", stage: Unbuilt, description: "Extrem grosse, unbewegliche Form mit Flaechenschaden und Umgebungszerstoerung, sehr kurze Dauer.", acceptance: "Form kann Geometrie beschaedigen; Dauer unter 30 s.", depends_on: ["F-107"], prio: 3, effort_pd: 12, source: "features.xlsx!01_Spielfunktionen!R101", evidence: "", note: ""),
    (id: "F-112", name: "Form-Progression", domain: "player", system: "Vessel Form", stage: Unbuilt, description: "Pro Form eigener Faehigkeitenbaum mit Stufen 0 bis 10, gesteigert durch Nutzung statt durch Waehrung.", acceptance: "Nutzung erzeugt Fortschritt; kein Kauf noetig.", depends_on: ["F-107"], prio: 3, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R102", evidence: "", note: ""),
    (id: "F-113", name: "Gegner-Anpassung", domain: "player", system: "Vessel Form", stage: Unbuilt, description: "Titanen wechseln gegen eine Vessel Form ihr Verhalten: Gruppenangriffe, Klettern, Cortex-Angriffe.", acceptance: "KI reagiert sichtbar anders auf verwandelte Spieler.", depends_on: ["F-107"], prio: 2, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R103", evidence: "", note: ""),
    (id: "F-120", name: "Level und Erfahrungskurve", domain: "progress", system: "Progression", stage: Unbuilt, description: "Level 1 bis 100 mit definierter XP-Kurve. Jedes Level gibt Faehigkeitspunkte.", acceptance: "Kurve ist in Config definiert und ohne Codeaenderung anpassbar.", depends_on: [], prio: 1, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R104", evidence: "", note: ""),
    (id: "F-121", name: "Ausruestungsrang", domain: "progress", system: "Progression", stage: Unbuilt, description: "Rangstufen E bis S als Gate fuer Schwierigkeiten und Raids. Steigt durch Ausruestungsverbesserung.", acceptance: "Rang wird korrekt berechnet und gated korrekt.", depends_on: ["F-122"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R105", evidence: "", note: ""),
    (id: "F-122", name: "Ausruestungs-Upgrades mit Budget", domain: "progress", system: "Progression", stage: Unbuilt, description: "Statt 8 unabhaengiger Statleitern ein gemeinsames Punktebudget mit Zielkonflikten: Tempo kostet Kontrolle, Schaden kostet Haltbarkeit.", acceptance: "Es existiert kein dominanter Build; mindestens 4 Builds sind innerhalb 10 Prozent gleich stark.", depends_on: ["F-120"], prio: 1, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R106", evidence: "", note: ""),
    (id: "F-123", name: "Faehigkeitenbaum", domain: "progress", system: "Progression", stage: Unbuilt, description: "Vier Aeste (Offensive, Defensive, Unterstuetzung, Traversal) mit exklusiven Knoten, die echte Entscheidungen erzwingen.", acceptance: "Mindestens 12 Knoten sind gegenseitig exklusiv; nicht alles ist gleichzeitig freischaltbar.", depends_on: ["F-120"], prio: 1, effort_pd: 12, source: "features.xlsx!01_Spielfunktionen!R107", evidence: "", note: ""),
    (id: "F-124", name: "Kostenloser Respec", domain: "progress", system: "Progression", stage: Unbuilt, description: "Faehigkeitspunkte lassen sich mindestens einmal taeglich kostenlos neu verteilen.", acceptance: "Respec ist ohne Waehrung nutzbar und im UI prominent.", depends_on: ["F-123"], prio: 1, effort_pd: 3, source: "features.xlsx!01_Spielfunktionen!R108", evidence: "", note: ""),
    (id: "F-125", name: "Loadout-Speicher", domain: "progress", system: "Progression", stage: Unbuilt, description: "Mindestens fuenf frei benennbare Ausruestungs-Profile, kostenlos fuer alle Spieler.", acceptance: "Wechsel zwischen Profilen dauert unter 1 s und ist im Hub jederzeit moeglich.", depends_on: ["F-123"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R109", evidence: "", note: ""),
    (id: "F-126", name: "Perk-System", domain: "progress", system: "Progression", stage: Unbuilt, description: "Vier gleichzeitig ausruestbare Perks in drei Kategorien. Fokus auf Synergien und Verhaltensaenderungen statt reiner Prozentwerte.", acceptance: "Mindestens 40 Perks zu Release; mindestens 15 aendern Spielverhalten statt nur Zahlen.", depends_on: ["F-123"], prio: 1, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R110", evidence: "", note: ""),
    (id: "F-127", name: "Lineage-System (Familien)", domain: "progress", system: "Progression", stage: Unbuilt, description: "Herkunftslinien mit aktiven Faehigkeiten. Jede Linie hat mindestens eine aktive Faehigkeit; es gibt keine leeren Linien.", acceptance: "Kein Spieler kann eine Linie ohne Faehigkeit erhalten.", depends_on: ["F-126"], prio: 2, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R111", evidence: "", note: ""),
    (id: "F-128", name: "Pity-System fuer Lineages", domain: "progress", system: "Progression", stage: Unbuilt, description: "Garantierte Seltenheitsstufen nach definierter Anzahl Ziehungen. Zaehler ist jederzeit sichtbar.", acceptance: "Garantie greift exakt; Zaehler wird persistent gespeichert.", depends_on: ["F-127"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R112", evidence: "", note: ""),
    (id: "F-129", name: "Deterministischer Ichor-Pfad", domain: "progress", system: "Progression", stage: Unbuilt, description: "Vessel-Vials sind zusaetzlich ueber eine Raid-Waehrung garantiert erwerbbar. Zufallsdrop bleibt als Abkuerzung.", acceptance: "Ein Spieler erreicht das Ziel nach definierter Anzahl Clears garantiert.", depends_on: ["F-105"], prio: 2, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R113", evidence: "", note: ""),
    (id: "F-130", name: "Artefakte mit Substats", domain: "progress", system: "Progression", stage: Unbuilt, description: "Permanente Ausruestungsstuecke aus Raids und Erfolgen mit rerollbaren Nebenwerten und Sperrfunktion.", acceptance: "Reroll und Sperre funktionieren; Kosten sind transparent.", depends_on: ["F-126"], prio: 3, effort_pd: 9, source: "features.xlsx!01_Spielfunktionen!R114", evidence: "", note: ""),
    (id: "F-131", name: "Ascension (Prestige-Ersatz)", domain: "progress", system: "Progression", stage: Unbuilt, description: "Zuruecksetzung nur der Build-Entscheidungen bei erweitertem Punktebudget. Mechanische Faehigkeiten und Ausruestungsraenge bleiben erhalten.", acceptance: "Spieler wird nach Ascension nicht schwaecher, sondern flexibler.", depends_on: ["F-122"], prio: 2, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R115", evidence: "", note: ""),
    (id: "F-132", name: "Memories (Ascension-Talente)", domain: "progress", system: "Progression", stage: Unbuilt, description: "Pro Ascension ein permanentes Talent aus drei Vorschlaegen. Neuwurf ueber Spielwaehrung, nicht ueber Echtgeld.", acceptance: "Talente sind persistent; Auswahl ist rueckgaengig machbar bis zur Bestaetigung.", depends_on: ["F-131"], prio: 3, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R116", evidence: "", note: ""),
    (id: "F-133", name: "Erfolge und Meilensteine", domain: "progress", system: "Progression", stage: Unbuilt, description: "Strukturierte Erfolgsliste mit Kategorien, Fortschrittsanzeige und Belohnungen (Waehrung, Kosmetik, Titel).", acceptance: "Mindestens 120 Erfolge; alle mit sichtbarem Fortschritt.", depends_on: [], prio: 2, effort_pd: 7, source: "features.xlsx!01_Spielfunktionen!R117", evidence: "", note: ""),
    (id: "F-134", name: "Kompendium", domain: "progress", system: "Progression", stage: Unbuilt, description: "Im Spiel einsehbare Datenbank: alle Formeln, Drop-Raten, Pity-Zaehler, Gegnerverhalten, Statwirkungen.", acceptance: "Kein Spieler muss ein externes Wiki oeffnen, um eine Zahl zu erfahren.", depends_on: ["F-126"], prio: 2, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R118", evidence: "", note: ""),
    (id: "F-135", name: "Build-Simulator im Hub", domain: "progress", system: "Progression", stage: Unbuilt, description: "Rechnerische Vorschau auf Schaden, Time-to-Kill und Traversal-Werte, ohne Ressourcen auszugeben.", acceptance: "Vorschauwerte stimmen mit der Praxis auf 5 Prozent genau ueberein.", depends_on: ["F-134"], prio: 2, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R119", evidence: "", note: ""),
    (id: "F-140", name: "Zwei Waehrungen", domain: "progress", system: "Oekonomie", stage: Unbuilt, description: "Weiche Waehrung (Mark) aus Missionen, harte Waehrung (Sigil) aus Erfolgen und Wochenzielen. Keine dritte Waehrung.", acceptance: "Nur zwei Waehrungen existieren im gesamten Spiel.", depends_on: [], prio: 1, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R120", evidence: "", note: ""),
    (id: "F-141", name: "Serverseitige Beutetabellen", domain: "progress", system: "Oekonomie", stage: Unbuilt, description: "Alle Drops werden ausschliesslich auf dem Server bestimmt. Client erfaehrt nur das Ergebnis.", acceptance: "Kein Client-Eingriff kann Drops beeinflussen.", depends_on: ["F-140"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R121", evidence: "", note: ""),
    (id: "F-142", name: "Pity-Zaehler fuer alle Seltenheiten", domain: "progress", system: "Oekonomie", stage: Unbuilt, description: "Garantien ab Seltenheitsstufe Episch aufwaerts, pro Quelle getrennt gefuehrt und sichtbar.", acceptance: "Zaehler werden persistiert und im Kompendium angezeigt.", depends_on: ["F-141"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R122", evidence: "", note: ""),
    (id: "F-143", name: "Transparente Drop-Raten", domain: "progress", system: "Oekonomie", stage: Unbuilt, description: "Alle Wahrscheinlichkeiten sind im Spiel einsehbar, inklusive Wirkung des Glueckswerts.", acceptance: "Angezeigte Rate stimmt mit der tatsaechlichen Rate ueberein (Testabgleich ueber 10000 Rolls).", depends_on: ["F-134"], prio: 2, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R123", evidence: "", note: ""),
    (id: "F-144", name: "Glueckswert (Luck)", domain: "progress", system: "Oekonomie", stage: Unbuilt, description: "Modifikator auf Drop-Raten mit dokumentierter, linearer Formel. Keine versteckten Multiplikatoren.", acceptance: "Formel ist im Kompendium einsehbar und im Code identisch.", depends_on: ["F-143"], prio: 2, effort_pd: 3, source: "features.xlsx!01_Spielfunktionen!R124", evidence: "", note: ""),
    (id: "F-145", name: "Automatischer Verkauf und Filter", domain: "progress", system: "Oekonomie", stage: Unbuilt, description: "Regelbasierter Auto-Verkauf nach Seltenheit und Typ, kostenlos fuer alle.", acceptance: "Filter funktioniert; kein Gamepass erforderlich.", depends_on: ["F-140"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R125", evidence: "", note: ""),
    (id: "F-146", name: "Waehrungssenken", domain: "progress", system: "Oekonomie", stage: Unbuilt, description: "Kosmetik, Neuwuerfe, Reparatur, Wochenkontingente. Keine Sackgasse, in der Waehrung wertlos wird.", acceptance: "Auch ein Maximalspieler hat sinnvolle Ausgabemoeglichkeiten.", depends_on: ["F-140"], prio: 2, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R126", evidence: "", note: ""),
    (id: "F-147", name: "Handelssystem", domain: "progress", system: "Oekonomie", stage: Unbuilt, description: "Spielerhandel mit Steuer, Bestaetigungs-Countdown, vollstaendigem Handelsprotokoll und Rueckverfolgbarkeit.", acceptance: "Kein Handel ist ohne beidseitige Bestaetigung abschliessbar; jeder Handel ist geloggt.", depends_on: ["F-141"], prio: 3, effort_pd: 12, source: "features.xlsx!01_Spielfunktionen!R127", evidence: "", note: ""),
    (id: "F-148", name: "Wochenkontingente statt AFK", domain: "progress", system: "Oekonomie", stage: Unbuilt, description: "Belohnungen ueber taegliche und woechentliche Ziele statt ueber passives Herumstehen.", acceptance: "Kein Vorteil durch Inaktivitaet im Spiel messbar.", depends_on: ["F-140"], prio: 2, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R128", evidence: "", note: ""),
    (id: "F-150", name: "Sitzungsmodell", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Jede Mission und jeder Raid laeuft in einer eigenen reservierten Serverinstanz. Der Hub ist ein persistenter Treffpunkt, die Einsatzinstanz ist kurzlebig und wird nach Abschluss aufgeloest.", acceptance: "Eine Instanz startet, laeuft und wird sauber abgebaut, ohne Spieler in einem toten Server zuruecklassen.", depends_on: ["F-070"], prio: 1, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R129", evidence: "", note: ""),
    (id: "F-151", name: "Serverkapazitaet", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Zielwerte: 20 Spieler pro Missionsinstanz, 10 pro Raidinstanz, 40 im Hub. Kapazitaet ist per Config je Modus einstellbar.", acceptance: "Alle drei Kapazitaeten laufen im Lasttest bei 60 FPS auf dem PC-Mindestprofil.", depends_on: ["F-150"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R130", evidence: "", note: ""),
    (id: "F-152", name: "Schnellsuche (Quick Play)", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Ein-Klick-Einstieg: das System sucht eine passende laufende oder startende Instanz nach Modus, Schwierigkeit und Ausruestungsrang.", acceptance: "Ein Alleinspieler landet in unter 20 Sekunden in einer passenden Instanz.", depends_on: ["F-150"], prio: 1, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R131", evidence: "", note: ""),
    (id: "F-153", name: "Instanz-Browser", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Manuelle Auswahl laufender Instanzen mit Filter nach Map, Modus, Schwierigkeit, Modifikatoren, Spielerzahl und Freundesbeteiligung. Fuer Spieler, die nicht dem Automatismus folgen wollen.", acceptance: "Filter kombinierbar; Liste aktualisiert sich alle 5 Sekunden ohne Ruckler.", depends_on: ["F-152"], prio: 2, effort_pd: 9, source: "features.xlsx!01_Spielfunktionen!R132", evidence: "", note: ""),
    (id: "F-154", name: "Beitritt waehrend des Einsatzes", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Spieler koennen laufenden Missionen beitreten, solange das Hauptziel nicht in der Endphase ist. Raids sind nach Phasenbeginn geschlossen.", acceptance: "Beitritt setzt Ziele und Wellenzaehler korrekt fuer den neuen Spieler; keine Doppelbelohnung.", depends_on: ["F-150"], prio: 2, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R133", evidence: "", note: ""),
    (id: "F-155", name: "Gruppensystem", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Gruppen bis 10 Spieler, persistent ueber Place-Wechsel hinweg. Einladung ueber Freundesliste, Namenssuche oder Beitrittscode.", acceptance: "Gruppe bleibt beim Teleport zwischen Maps vollstaendig zusammen; kein Mitglied landet in einer fremden Instanz.", depends_on: ["F-150"], prio: 1, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R134", evidence: "", note: ""),
    (id: "F-156a", name: "Gruppenleiter-Rechte", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Der Leiter waehlt Map, Modus, Schwierigkeit und Modifikatoren; Mitglieder sehen die Auswahl live. Leitung ist uebertragbar und faellt bei Verlassen automatisch weiter.", acceptance: "Wechsel der Leitung funktioniert im laufenden Betrieb ohne Gruppenaufloesung.", depends_on: ["F-155"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R135", evidence: "", note: ""),
    (id: "F-157a", name: "Bereitschaftspruefung", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Vor dem Start bestaetigt jedes Mitglied die Bereitschaft. Zeitueberschreitung setzt den Spieler auf nicht bereit statt die Gruppe zu blockieren.", acceptance: "Kein Einsatz startet mit einem unbestaetigten Mitglied; Zeitueberschreitung blockiert nie dauerhaft.", depends_on: ["F-155"], prio: 2, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R136", evidence: "", note: ""),
    (id: "F-158a", name: "Wiederverbindung", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Verbindungsabbruch fuehrt zu einem Platzhalter, der 120 Sekunden reserviert bleibt. Kehrt der Spieler zurueck, erhaelt er Position, Ressourcen und Beitragswert zurueck.", acceptance: "Ein Spieler mit erzwungenem Abbruch kehrt in dieselbe Instanz mit demselben Fortschritt zurueck.", depends_on: ["F-150"], prio: 1, effort_pd: 9, source: "features.xlsx!01_Spielfunktionen!R137", evidence: "", note: ""),
    (id: "F-159a", name: "Kampfunfaehigkeit und Wiederbelebung", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Statt sofortigem Tod ein Zustand der Kampfunfaehigkeit mit ablaufendem Timer. Mitspieler koennen wiederbeleben; die Wiederbelebung dauert lange genug, um selbst riskant zu sein.", acceptance: "Wiederbelebung ist im Titanenfeuer eine echte Entscheidung, kein Automatismus; Solo-Spieler haben eine begrenzte Selbstaufrichtung.", depends_on: ["F-038"], prio: 1, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R138", evidence: "", note: ""),
    (id: "F-160a", name: "Getrennte Beute pro Spieler", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Jeder Spieler wuerfelt seine eigene Beute. Es gibt keinen Wettlauf um Gegenstaende und keinen Anreiz, Mitspieler zu benachteiligen.", acceptance: "Zwei Spieler in derselben Instanz erhalten unabhaengige Ergebnisse; kein Aufsammeln vor anderen moeglich.", depends_on: ["F-141"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R139", evidence: "", note: ""),
    (id: "F-161a", name: "Beitragswertung", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Serverseitige Erfassung des Anteils jedes Spielers (Schaden, Ziele, Wiederbelebungen, Unterstuetzung). Grundlage fuer Truhenzugang in Raids und fuer die Auswertung.", acceptance: "Beitrag ist waehrend des Einsatzes einsehbar und nicht manipulierbar.", depends_on: ["F-096"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R140", evidence: "", note: ""),
    (id: "F-162a", name: "Kein Schaden unter Spielern", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Klingen, Lanzen und Faehigkeiten fuegen Mitspielern keinen Schaden zu. Knockback bleibt als taktisches Element erhalten und ist per Config abschaltbar.", acceptance: "Kein Spieler kann einen anderen toeten oder dessen Fortschritt zerstoeren.", depends_on: ["F-037"], prio: 1, effort_pd: 3, source: "features.xlsx!01_Spielfunktionen!R141", evidence: "", note: ""),
    (id: "F-163a", name: "Kollisionsmodell zwischen Spielern", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Spieler kollidieren nicht miteinander. In einem Spiel mit dieser Bewegungsgeschwindigkeit ist Spielerkollision die groesste Frustquelle ueberhaupt.", acceptance: "Zwei Spieler koennen sich in voller Fahrt durchdringen, ohne dass Bahnen gestoert werden.", depends_on: ["F-004"], prio: 1, effort_pd: 3, source: "features.xlsx!01_Spielfunktionen!R142", evidence: "", note: ""),
    (id: "F-164a", name: "Namensschilder und Zustandsanzeige", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Ueber jedem Mitspieler: Name, Lebensleiste, Gaszustand, Verletzungsstatus, Kampfunfaehigkeit. Sichtbarkeit faellt mit Distanz und ist regelbar.", acceptance: "Ein Spieler erkennt aus 150 studs, ob ein Mitspieler Hilfe braucht.", depends_on: ["F-170"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R143", evidence: "", note: ""),
    (id: "F-165a", name: "Markierungssystem", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Nonverbale Kommunikation per Tastendruck: Ziel markieren, Gefahr, Sammelpunkt, Nachschub, Hilfe benoetigt. Radialmenue auf einer Taste.", acceptance: "Markierungen erscheinen bei allen Mitspielern innerhalb von 200 Millisekunden und verfallen automatisch.", depends_on: ["F-155"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R144", evidence: "", note: ""),
    (id: "F-166a", name: "Unterstuetzungsauren", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Passive Gruppeneffekte fuer Support-Builds: Gasregeneration, Schadensbonus, Verletzungsschutz im Radius. Sichtbar als Bodenmarkierung.", acceptance: "Auren sind erkennbar, stapeln nach dokumentierten Regeln und machen einen Support-Build spielbar.", depends_on: ["F-126"], prio: 2, effort_pd: 7, source: "features.xlsx!01_Spielfunktionen!R145", evidence: "", note: ""),
    (id: "F-167a", name: "Gemeinsame Zielanzeige", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Alle Spieler sehen denselben Zielfortschritt, Wellenzaehler und Timer. Kritische Ereignisse werden allen gleichzeitig gemeldet.", acceptance: "Kein Spieler sieht einen abweichenden Zielstand.", depends_on: ["F-070"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R146", evidence: "", note: ""),
    (id: "F-168a", name: "Skalierung nach Spielerzahl", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Titanenanzahl, Boss-Lebenspunkte und Zielwerte skalieren live mit der aktuellen Spielerzahl, auch bei Beitritt oder Verlassen waehrend des Einsatzes.", acceptance: "Verlaesst ein Spieler die Instanz, sinkt die Boss-HP im selben Verhaeltnis; kein unspielbarer Rest.", depends_on: ["F-082"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R147", evidence: "", note: ""),
    (id: "F-169a", name: "Abstimmungen", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Gruppenabstimmung ueber Neustart, Abbruch und Schwierigkeitswechsel. Einfache Mehrheit, mit Zeitlimit.", acceptance: "Abstimmung laeuft ohne Spielunterbrechung fuer die anderen; Ergebnis wird allen angezeigt.", depends_on: ["F-150"], prio: 2, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R148", evidence: "", note: ""),
    (id: "F-170a", name: "Ausschluss und Meldung", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Gruppenleiter kann in Privatgruppen ausschliessen. In oeffentlichen Instanzen kein Ausschluss, sondern Meldung plus lokale Stummschaltung, um Missbrauch zu verhindern.", acceptance: "Kein Spieler kann in einer oeffentlichen Instanz per Mehrheit hinausgeworfen werden.", depends_on: ["F-155"], prio: 2, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R149", evidence: "", note: ""),
    (id: "F-171a", name: "Anwesenheit und Freundesliste", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Sichtbar, welche Freunde online sind, in welchem Modus sie stecken und ob ein Beitritt moeglich ist. Beitritt direkt aus der Liste.", acceptance: "Beitritt zu einem Freund funktioniert serveruebergreifend in unter 15 Sekunden.", depends_on: ["F-155"], prio: 2, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R150", evidence: "", note: ""),
    (id: "F-172a", name: "Zuschauermodus", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Nach dauerhaftem Ausscheiden Beobachtung lebender Mitspieler mit freier Kamerawahl. Haelt Spieler in der Sitzung statt sie zum Verlassen zu zwingen.", acceptance: "Zuschauer kann zwischen allen lebenden Spielern wechseln und das HUD ein- und ausblenden.", depends_on: ["F-090"], prio: 3, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R151", evidence: "", note: ""),
    (id: "F-173a", name: "Privatinstanzen", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Eigene Instanz mit einstellbaren Modifikatoren fuer Uebung und Absprachen. Kein Fortschritt, damit Ausnutzung ausgeschlossen ist.", acceptance: "Privatinstanz vergibt keinerlei Waehrung, Erfahrung oder Beute.", depends_on: ["F-150"], prio: 2, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R152", evidence: "", note: ""),
    (id: "F-174a", name: "Sitzungspersistenz", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Zwischenstand einer laufenden Instanz wird regelmaessig gesichert, damit ein Serverfehler nicht den gesamten Einsatzfortschritt vernichtet.", acceptance: "Nach einem simulierten Serverfehler ist hoechstens eine Welle Fortschritt verloren.", depends_on: ["F-200"], prio: 2, effort_pd: 7, source: "features.xlsx!01_Spielfunktionen!R153", evidence: "", note: ""),
    (id: "F-175a", name: "Latenz- und Verbindungsanzeige", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Ping und Paketverlust je Spieler im Gruppenmenue, plus Warnhinweis bei kritischer Verbindung.", acceptance: "Anzeige entspricht den tatsaechlichen Messwerten und aktualisiert sich jede Sekunde.", depends_on: ["F-164a"], prio: 2, effort_pd: 3, source: "features.xlsx!01_Spielfunktionen!R154", evidence: "", note: ""),
    (id: "F-176a", name: "Grief-Schutz", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Kein Spieler kann Zielobjekte, Eskortkarren, Nachschubstationen oder Mitspieler beschaedigen. Umgebungswaffen haben Nutzungssperren gegen Blockieren.", acceptance: "Ein boeswilliger Spieler kann eine oeffentliche Mission nicht zum Scheitern bringen.", depends_on: ["F-162a"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R155", evidence: "", note: ""),
    (id: "F-177a", name: "Gemeinsame Auswertung", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Nach dem Einsatz sehen alle dieselbe Rangliste mit Kills, Genauigkeit, Durchschnittsgeschwindigkeit, Wiederbelebungen und Beitragsanteil. Keine Verlierer-Darstellung, sondern Kategoriebestleistungen.", acceptance: "Jeder Spieler erhaelt mindestens eine hervorgehobene Kategorie.", depends_on: ["F-085"], prio: 2, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R156", evidence: "", note: ""),
    (id: "F-178a", name: "Netzwerk-Autoritaetsmodell", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Bewegung des eigenen Charakters liegt beim Client mit Server-Plausibilisierung; Titanen, Ziele, Schaden und Beute liegen vollstaendig beim Server. Diese Trennung ist die Grundlage jeder Mehrspielerfunktion.", acceptance: "Kein Client kann fremde Charaktere, Titanen oder Beute beeinflussen.", depends_on: ["F-215"], prio: 1, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R157", evidence: "", note: ""),
    (id: "F-179a", name: "Interpolation fremder Spieler", domain: "squad", system: "Mehrspieler", stage: Unbuilt, description: "Andere Spieler werden clientseitig geglaettet, damit Bewegung bei 100 bis 250 Millisekunden Latenz fluessig aussieht statt zu springen.", acceptance: "Bei 250 Millisekunden simulierter Latenz sind keine Positionsspruenge sichtbar.", depends_on: ["F-178a"], prio: 1, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R158", evidence: "", note: ""),
    (id: "F-156", name: "Hub: The Rookery", domain: "squad", system: "Sozial", stage: Unbuilt, description: "Zentraler sozialer Ort mit Ausruestung, Haendlern, Trainingsgelaende, Bestenlisten und Missionsauswahl.", acceptance: "Hub laedt in unter 8 s und traegt 40 Spieler bei 60 FPS.", depends_on: ["F-070"], prio: 1, effort_pd: 15, source: "features.xlsx!01_Spielfunktionen!R159", evidence: "", note: ""),
    (id: "F-158", name: "Regiments (Gilden)", domain: "squad", system: "Sozial", stage: Unbuilt, description: "Spielergruppen mit gemeinsamen Wochenzielen, Rangliste, gemeinsamer Fortschrittsleiste und Emblem.", acceptance: "Regimentsziele aktualisieren sich serveruebergreifend.", depends_on: ["F-155"], prio: 3, effort_pd: 14, source: "features.xlsx!01_Spielfunktionen!R160", evidence: "", note: ""),
    (id: "F-160", name: "Bestenlisten", domain: "squad", system: "Sozial", stage: Unbuilt, description: "Traversal-Zeiten pro Map, Raid-Clear-Zeiten, Saisonwertung. Getrennt nach Eingabegeraet.", acceptance: "Listen sind serveruebergreifend und werden saisonal archiviert.", depends_on: ["F-077"], prio: 2, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R161", evidence: "", note: ""),
    (id: "F-170", name: "HUD-Grundlayout", domain: "hud", system: "UI", stage: Proven, description: "Gas links, Klingen rechts, HP unten mittig, Ladeleiste, Nachladezaehler, Verletzungsanzeige, Zielfortschritt.", acceptance: "Alle Werte sind ohne Menuewechsel ablesbar; HUD verdeckt nie die Bildmitte.", depends_on: [], prio: 1, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R162", evidence: "all five elements in one frame, docs/images/f071-won.png: gas bar cyan left (227 px of a 277.6 px track = 81.8 % against the overlay's gas 82/100 in an earlier shot), five blade pips right, crimson health bar bottom centre, four-tick crosshair, amber objective top centre · decoded against a control run with the element hidden: 1633 px differ in the top band, 668 exactly the amber of maps.ron, control 0 · between 0/3 and 1/3 exactly 9x13 px change - one glyph cell, the leading digit - and the /3 is bit-identical · red-checked four ways: bar wired to a constant, objective widened over the middle, a literal colour, an invented string · sha256 22d5db57 twice [debian]", note: "2026-08-09 [debian] — nothing is hidden any more: the two elements that had no producer (health, objective) got one this session. The objective reads MissionPhase::label() and KillTally, never an invented string, and a source-level test forbids any phase's word as a literal in the HUD"),
    (id: "F-171", name: "Dynamisches Fadenkreuz", domain: "hud", system: "UI", stage: Proven, description: "Zeigt gueltigen Ankerpunkt, Reichweitenueberschreitung und Cortex-in-Reichweite durch Formaenderung, nicht nur Farbe.", acceptance: "Zustaende sind auch bei Farbenblindheit unterscheidbar.", depends_on: ["F-002"], prio: 1, effort_pd: 5, source: "features.xlsx!01_Spielfunktionen!R163", evidence: "three states as (nodes, w, h): (4, 302x178), (4, 326x202), (8, 356x212), and the PNG's bounding boxes agree exactly · red-checked with all BackgroundColors forced to white: Free and Anchor collapse to the same shape · signal pixels 80 / 264 cyan / 840 amber · docs/images/f171-crosshair.png, three crops, each source shot bit-identical twice [debian]", note: "2026-08-09 [debian] — the three states differ in geometry, not only in colour; forcing the colours equal in the test is what makes the colour-blindness clause falsifiable at all"),
    (id: "F-172", name: "Vollstaendige Tastenbelegung", domain: "hud", system: "UI", stage: Unbuilt, description: "Jede Aktion frei zuweisbar, mit Presets und Konflikterkennung. Reines Tastatur- und Maus-Spiel; kein Gamepad, kein Touch. Dadurch koennen Steuerung und Zielsystem kompromisslos auf Praezision ausgelegt werden.", acceptance: "Keine Aktion ist fest verdrahtet; Presets fuer Standard, Linkshaender und Kompakt; alle Aktionen sind mit Tastatur und Maus erreichbar.", depends_on: ["F-170"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R164", evidence: "", note: ""),
    (id: "F-175", name: "Menuestruktur", domain: "hud", system: "UI", stage: Unbuilt, description: "Maximal zwei Verschachtelungsebenen. Ausruestung, Faehigkeiten, Kosmetik, Kompendium, Einstellungen als Hauptbereiche.", acceptance: "Jeder Bildschirm ist in maximal zwei Klicks erreichbar.", depends_on: ["F-170"], prio: 1, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R165", evidence: "", note: ""),
    (id: "F-176", name: "Barrierefreiheit", domain: "hud", system: "UI", stage: Unbuilt, description: "Farbenblindmodi, Schriftgroessenregler, Untertitel fuer Audiohinweise, Screenshake-Regler, Bewegungsreduktion.", acceptance: "Alle Statusfarben bleiben in allen drei Farbenblindmodi unterscheidbar.", depends_on: ["F-170"], prio: 2, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R166", evidence: "", note: ""),
    (id: "F-177", name: "Grafikeinstellungen", domain: "hud", system: "UI", stage: Unbuilt, description: "Qualitaetsstufen mit automatischer Erkennung plus Einzelregler fuer Partikel, Schatten, Sichtweite. Zielprofile: PC-Mindestprofil (Einsteiger-Laptop) und PC-Vollprofil.", acceptance: "Mindestprofil erreicht 60 FPS bei voller Serverbesetzung; Vollprofil bleibt bei 1 Prozent Low ueber 45 FPS.", depends_on: ["F-170"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R167", evidence: "", note: ""),
    (id: "F-178", name: "Ladebildschirme mit Tipps", domain: "hud", system: "UI", stage: Unbuilt, description: "Kontextabhaengige Hinweise waehrend des Ladens, basierend auf erkannten Schwaechen des Spielers.", acceptance: "Tipps rotieren und wiederholen sich nicht innerhalb einer Session.", depends_on: ["F-175"], prio: 3, effort_pd: 4, source: "features.xlsx!01_Spielfunktionen!R168", evidence: "", note: ""),
    (id: "F-185", name: "Stufe 1: Bewegungsparcours", domain: "mission", system: "Onboarding", stage: Unbuilt, description: "Zwei Minuten ohne Gegner. Gefuehrter Parcours lehrt Haken, Pendeln, Swerve und Boost mit visuellen Hilfslinien.", acceptance: "95 Prozent der Testspieler schaffen den Parcours beim ersten Versuch.", depends_on: ["F-006"], prio: 1, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R169", evidence: "", note: ""),
    (id: "F-186", name: "Stufe 2: Erste Kills", domain: "mission", system: "Onboarding", stage: Unbuilt, description: "Stehende Trainingsziele mit markiertem Cortex. Lehrt Anflugwinkel und Geschwindigkeitsbonus.", acceptance: "Testspieler erzielt drei saubere Cortex-Treffer in unter drei Minuten.", depends_on: ["F-185"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R170", evidence: "", note: ""),
    (id: "F-187", name: "Stufe 3: Gefuehrte Erstmission", domain: "mission", system: "Onboarding", stage: Unbuilt, description: "Scriptete Mission mit NPC-Trupp und laufender Anleitung. Fuehrt Nachschub, Ausweichen und Zielsystem ein.", acceptance: "Abschlussquote der Erstmission liegt ueber 80 Prozent.", depends_on: ["F-186"], prio: 1, effort_pd: 12, source: "features.xlsx!01_Spielfunktionen!R171", evidence: "", note: ""),
    (id: "F-188", name: "Stufe 4: Trainingsgelaende", domain: "mission", system: "Onboarding", stage: Unbuilt, description: "Dauerhaft zugaenglicher Bereich im Hub mit Uebungen, Zeitmessung und Bestwerten. Unendliches Gas.", acceptance: "Gelaende ist jederzeit betretbar und verlassbar ohne Ladezeit ueber 3 s.", depends_on: ["F-156"], prio: 1, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R172", evidence: "", note: ""),
    (id: "F-189", name: "Adaptive Hinweise", domain: "mission", system: "Onboarding", stage: Unbuilt, description: "System erkennt Problemmuster (haeufige Abstuerze, verfehlte Cortex-Treffer, Gasmangel) und bietet gezielte Tipps an.", acceptance: "Hinweis erscheint nach definierter Fehlerhaeufung und ist dauerhaft abschaltbar.", depends_on: ["F-188"], prio: 2, effort_pd: 7, source: "features.xlsx!01_Spielfunktionen!R173", evidence: "", note: ""),
    (id: "F-190", name: "Uebungsmodus", domain: "mission", system: "Onboarding", stage: Unbuilt, description: "Freier Sandkasten mit waehlbaren Gegnertypen, unendlichen Ressourcen und Zeitlupenoption.", acceptance: "Alle Gegnertypen sind einzeln beschwoerbar.", depends_on: ["F-188"], prio: 2, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R174", evidence: "", note: ""),
    (id: "F-200", name: "Datenpersistenz mit Session-Lock", domain: "save", system: "Backend", stage: Unbuilt, description: "ProfileStore-Muster mit Session-Locking gegen Duplikation und Datenverlust bei Serverwechsel.", acceptance: "Kein Duplikationsfall in 1000 simulierten Serverwechseln.", depends_on: [], prio: 1, effort_pd: 10, source: "features.xlsx!01_Spielfunktionen!R175", evidence: "", note: ""),
    (id: "F-201", name: "Versionierte Datenschemata", domain: "save", system: "Backend", stage: Unbuilt, description: "Jedes Profil traegt eine Schemaversion mit automatischem Migrationspfad.", acceptance: "Ein Profil aus Version 1 laedt korrekt unter Version 5.", depends_on: ["F-200"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R176", evidence: "", note: ""),
    (id: "F-202", name: "Transaktionsprotokoll", domain: "save", system: "Backend", stage: Unbuilt, description: "Alle Handels-, Kauf- und Beutevorgaenge werden protokolliert und sind rueckverfolgbar.", acceptance: "Jede Aenderung am Inventar ist im Log auffindbar.", depends_on: ["F-200"], prio: 1, effort_pd: 6, source: "features.xlsx!01_Spielfunktionen!R177", evidence: "", note: ""),
    (id: "F-203", name: "Cross-Server-Zustand", domain: "save", system: "Backend", stage: Unbuilt, description: "MemoryStoreService fuer Warteschlangen, Bestenlisten und Regimentsziele.", acceptance: "Warteschlange funktioniert ueber mindestens 20 Server hinweg.", depends_on: ["F-097"], prio: 2, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R178", evidence: "", note: ""),
    (id: "F-204", name: "Place-Routing", domain: "save", system: "Backend", stage: Unbuilt, description: "Multi-Place-Architektur mit TeleportService, ReservedServers fuer Missionen und Raids, Hub als Anker.", acceptance: "Teleport dauert unter 8 s und behaelt Gruppen zusammen.", depends_on: ["F-155"], prio: 1, effort_pd: 8, source: "features.xlsx!01_Spielfunktionen!R179", evidence: "", note: ""),
