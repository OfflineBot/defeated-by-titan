// GENERATED by tools/features.py from gameplay/features.xlsx — do NOT edit by hand.
// Hand edits here are lost on the next run. Changing the source means: change the
// .xlsx and run the script again (prompts/init.md §2).
// Source: gameplay/features.xlsx!09_Tech-Backlog (51 records from 53 rows)
entries: [
    (id: "T-001", module: "Projekt", name: "Rojo- und Git-Aufsetzung", description: "Externes Dateisystem mit Versionierung. Bei dieser Projektgroesse zwingend; Arbeiten allein in Studio ist ausgeschlossen.", role: "Tech Lead", prio: "Must", effort_pd: "3", status: "Offen"),
    (id: "T-002", module: "Projekt", name: "Branch- und Review-Prozess", description: "Feature-Branches, Pull Requests, verpflichtende Code-Reviews, Namenskonventionen.", role: "Tech Lead", prio: "Must", effort_pd: "2", status: "Offen"),
    (id: "T-003", module: "Projekt", name: "Service-Framework", description: "Schlankes eigenes Framework oder Knit. Einheitliche Lebenszyklen fuer alle Dienste.", role: "Tech Lead", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "T-004", module: "Projekt", name: "Luau strict mode", description: "Durchgaengige Typannotationen in allen Modulen, Linting in der Pipeline.", role: "Tech Lead", prio: "Must", effort_pd: "4", status: "Offen"),
    (id: "T-005", module: "Projekt", name: "Konfigurationsschicht", description: "Alle Balancing-Werte in reinen Datenmodulen ohne Logik, von Designern editierbar.", role: "Engineering", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "T-006", module: "Projekt", name: "Testumgebung", description: "Separates Universe fuer Tests mit eigenem Datastore-Scope und Testkonten.", role: "Tech Lead", prio: "Must", effort_pd: "4", status: "Offen"),
    (id: "T-007", module: "Projekt", name: "Automatisierte Smoke-Tests", description: "Skriptgesteuerter Start jeder Map mit Pruefung auf Fehler in der Ausgabe.", role: "Engineering", prio: "Should", effort_pd: "6", status: "Offen"),
    (id: "T-010", module: "Netzwerk", name: "Remote-Bundling", description: "Alle RemoteEvents ueber eine zentrale, typisierte Schicht mit Rate-Limiting und Validierung.", role: "Engineering", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "T-011", module: "Netzwerk", name: "Client-Prediction", description: "Lokale Vorhersage der eigenen Bewegung mit Server-Abgleich und weicher Korrektur.", role: "Engineering", prio: "Must", effort_pd: "12", status: "Offen"),
    (id: "T-012", module: "Netzwerk", name: "Replikationsdrosselung", description: "Titanenzustaende nur an Clients in Relevanzradius senden; Interpolation clientseitig.", role: "Engineering", prio: "Must", effort_pd: "8", status: "Offen"),
    (id: "T-013", module: "Netzwerk", name: "Latenzkompensation", description: "Trefferpruefung mit Ruecksicht auf die Latenz des Angreifers, mit Obergrenze.", role: "Engineering", prio: "Should", effort_pd: "8", status: "Offen"),
    (id: "T-014", module: "Netzwerk", name: "Instanzverwaltung", description: "Reservierte Server pro Einsatz, Lebenszyklus vom Start bis zum sauberen Abbau, Wiederverwendung leerer Instanzen.", role: "Engineering", prio: "Must", effort_pd: "10", status: "Offen"),
    (id: "T-015", module: "Netzwerk", name: "Matchmaking-Dienst", description: "Serveruebergreifende Warteschlange und Instanzsuche ueber MemoryStoreService, mit Filterkriterien und Wartezeitausgleich.", role: "Engineering", prio: "Must", effort_pd: "12", status: "Offen"),
    (id: "T-016", module: "Netzwerk", name: "Gruppen-Teleport", description: "Geschlossener Transfer ganzer Gruppen zwischen Places ohne Aufsplittung, mit Wiederholungslogik bei Fehlschlag.", role: "Engineering", prio: "Must", effort_pd: "8", status: "Offen"),
    (id: "T-017", module: "Netzwerk", name: "Wiederverbindungslogik", description: "Platzhalterreservierung, Zustandswiederherstellung und Zeitablauf bei Verbindungsabbruch.", role: "Engineering", prio: "Must", effort_pd: "8", status: "Offen"),
    (id: "T-018", module: "Netzwerk", name: "Interpolationspuffer", description: "Geglaettete Darstellung fremder Spieler und Titanen mit konfigurierbarem Puffer gegen Jitter.", role: "Engineering", prio: "Must", effort_pd: "8", status: "Offen"),
    (id: "T-019", module: "Netzwerk", name: "Latenzsimulation im Test", description: "Werkzeug zum kuenstlichen Erzeugen von Latenz und Paketverlust fuer reproduzierbare Mehrspielertests.", role: "Engineering / QA", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "T-020", module: "Performance", name: "Streaming-Konfiguration", description: "Streaming Enabled mit Radien groesser als die maximale Hakenreichweite.", role: "Engineering", prio: "Must", effort_pd: "4", status: "Offen"),
    (id: "T-021", module: "Performance", name: "Object Pooling", description: "Wiederverwendungssystem fuer Titanen, Projektile, Partikel und UI-Elemente.", role: "Engineering", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "T-022", module: "Performance", name: "LOD-Pipeline", description: "Automatisierte Erzeugung und Zuordnung der drei Detailstufen fuer alle Meshes.", role: "Tech Art", prio: "Must", effort_pd: "8", status: "Offen"),
    (id: "T-023", module: "Performance", name: "Materialkonsolidierung", description: "Umgebung nutzt genau ein Material und einen Atlas. Pruefwerkzeug gegen Verstoesse.", role: "Tech Art", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "T-024", module: "Performance", name: "Profiling-Werkzeuge", description: "Eingebautes Overlay fuer FPS, Speicher, Drawcalls, Serverlast und KI-Budget.", role: "Engineering", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "T-025", module: "Performance", name: "PC-Qualitaetsprofile", description: "Zwei Zielprofile: Mindestprofil (Einsteiger-Laptop, integrierte Grafik) und Vollprofil. Getrennte Budgets fuer Partikel, Schatten und Sichtweite.", role: "Engineering", prio: "Should", effort_pd: "6", status: "Offen"),
    (id: "T-030", module: "Pipeline", name: "Blender-Exportvorgabe", description: "Verbindliche Vorgaben fuer Skalierung, Achsen, Namensgebung, Ursprungspunkte und UV-Kanaele.", role: "Tech Art", prio: "Must", effort_pd: "4", status: "Offen"),
    (id: "T-031", module: "Pipeline", name: "Asset-Namenskonvention", description: "Einheitliches Schema fuer alle Assets, Instanzen und Ordner.", role: "Tech Art", prio: "Must", effort_pd: "2", status: "Offen"),
    (id: "T-032", module: "Pipeline", name: "Asset-Import-Automatisierung", description: "Skriptgestuetzter Import mit automatischer Kollisions- und LOD-Zuweisung.", role: "Tech Art", prio: "Should", effort_pd: "8", status: "Offen"),
    (id: "T-033", module: "Pipeline", name: "Ankerflaechen-Werkzeug", description: "Studio-Plugin zum Markieren getaggter Flaechen mit Heatmap-Visualisierung der Abdeckung. Ebene 1 des Ankersystems.", role: "Tech Art", prio: "Must", effort_pd: "8", status: "Offen"),
    (id: "T-034a", module: "Pipeline", name: "Ankerpunkt-Generator", description: "Studio-Plugin, das aus getaggten Flaechen automatisch diskrete Ankerpunkte erzeugt: Kantenerkennung, Vorsprungerkennung, Mindestabstand, Normalenausrichtung. Manuelles Setzen von tausenden Punkten ist keine Option.", role: "Tech Art", prio: "Must", effort_pd: "10", status: "Offen"),
    (id: "T-035a", module: "Pipeline", name: "Ankerpunkt-Validierer", description: "Pruefwerkzeug fuer unerreichbare Punkte, fehlende Sichtlinien, zu dichte Cluster, Abdeckungsloecher und falsch ausgerichtete Normalen. Erzeugt Freigabebericht pro Map.", role: "Tech Art / QA", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "T-036a", module: "Performance", name: "Raeumliches Gitter fuer Ankerpunkte", description: "Vorfilterung der Kandidatensuche ueber ein Gitter statt linearer Iteration. Ohne dies skaliert die Suche nicht auf Mapgroessen mit mehreren tausend Punkten.", role: "Engineering", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "T-034", module: "Pipeline", name: "Animations-Exportvorgabe", description: "Einheitliche Framerate, Rootmotion-Regeln und Namensschema.", role: "Tech Art", prio: "Must", effort_pd: "3", status: "Offen"),
    (id: "T-035", module: "Pipeline", name: "Audio-Bibliothek", description: "Zentrale Verwaltung aller Sound-IDs mit Kategorien, Lautstaerkegruppen und Mischpult.", role: "Engineering / Audio", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "T-040", module: "Daten", name: "ProfileStore-Integration", description: "Session-Locking, automatische Wiederholungsversuche, sauberes Freigeben beim Verlassen.", role: "Engineering", prio: "Must", effort_pd: "8", status: "Offen"),
    (id: "T-041", module: "Daten", name: "Schema-Migration", description: "Versionierte Profile mit Migrationsketten und Rueckfallpfad.", role: "Engineering", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "T-042", module: "Daten", name: "Backup-Strategie", description: "Regelmaessige Snapshots mit Wiederherstellungsprozess und dokumentiertem Ablauf.", role: "Engineering", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "T-043", module: "Daten", name: "Transaktionsprotokoll", description: "Vollstaendiges, abfragbares Protokoll aller Inventaraenderungen.", role: "Engineering", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "T-044", module: "Daten", name: "MemoryStore-Schicht", description: "Cross-Server-Warteschlangen, Bestenlisten und Regimentsdaten.", role: "Engineering", prio: "Should", effort_pd: "8", status: "Offen"),
    (id: "T-050", module: "Tooling", name: "Balancing-Dashboard", description: "Externes Werkzeug zur Auswertung von Telemetrie und Simulation von Balancing-Aenderungen.", role: "Data / Engineering", prio: "Should", effort_pd: "12", status: "Offen"),
    (id: "T-051", module: "Tooling", name: "Level-Design-Werkzeuge", description: "Studio-Plugins fuer modulares Bauen, Rasterausrichtung und Spawnpunkt-Verwaltung.", role: "Tech Art", prio: "Should", effort_pd: "10", status: "Offen"),
    (id: "T-052", module: "Tooling", name: "Debug-Konsole", description: "Ingame-Befehle fuer Testzwecke, nur in der Testumgebung aktiv.", role: "Engineering", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "T-053", module: "Tooling", name: "Replay-System", description: "Aufzeichnung und Wiedergabe von Laeufen fuer Geister und Fehleranalyse.", role: "Engineering", prio: "Could", effort_pd: "12", status: "Offen"),
    (id: "T-060", module: "Betrieb", name: "Fehlerueberwachung", description: "Zentrale Sammlung aller Laufzeitfehler mit Haeufigkeitsauswertung.", role: "Engineering", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "T-061", module: "Betrieb", name: "Telemetrie-Pipeline", description: "Ereignisstrom zu einem externen Endpunkt mit Datenschutzpruefung.", role: "Engineering / Data", prio: "Should", effort_pd: "10", status: "Offen"),
    (id: "T-062", module: "Betrieb", name: "Feature-Flag-Dienst", description: "Serverseitige Schalter fuer schrittweise Ausrollung.", role: "Engineering", prio: "Should", effort_pd: "5", status: "Offen"),
    (id: "T-063", module: "Betrieb", name: "Wartungsmodus", description: "Kontrolliertes Herunterfahren mit Spielerbenachrichtigung und Datensicherung.", role: "Engineering", prio: "Should", effort_pd: "4", status: "Offen"),
    (id: "T-064", module: "Betrieb", name: "Lasttest", description: "Simulierte Volllast auf allen Maps mit maximaler Spielerzahl und Titanenanzahl.", role: "Engineering / QA", prio: "Must", effort_pd: "8", status: "Offen"),
    (id: "T-070", module: "QA", name: "Testplan Bewegung", description: "Systematische Pruefliste fuer alle Vector-Gear-Zustaende und Grenzfaelle.", role: "QA", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "T-071", module: "QA", name: "Testplan Kampf", description: "Pruefliste fuer Trefferzonen, Schadensformeln und Gegnerverhalten.", role: "QA", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "T-072", module: "QA", name: "Testplan Progression", description: "Pruefliste fuer Fortschritt, Persistenz, Migration und Grenzwerte.", role: "QA", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "T-073", module: "QA", name: "Exploit-Testplan", description: "Gezielte Angriffsversuche auf alle Remotes, Werte und Physikgrenzen.", role: "QA / Security", prio: "Must", effort_pd: "8", status: "Offen"),
    (id: "T-074", module: "QA", name: "Playtest-Protokoll", description: "Standardisierter Ablauf fuer Blindtests inklusive Fragebogen und Metriken.", role: "QA / Design", prio: "Must", effort_pd: "4", status: "Offen"),
]
