// GENERIERT von tools/features.py aus gameplay/features.xlsx — NICHT von Hand aendern.
// Handarbeit hier ist beim naechsten Lauf verloren. Quelle aendern heisst: die .xlsx
// aendern und das Skript erneut laufen lassen (prompts/init.md §2).
// Quelle: gameplay/features.xlsx!09_Tech-Backlog (51 Datensaetze aus 53 Zeilen)
eintraege: [
    (id: "T-001", modul: "Projekt", name: "Rojo- und Git-Aufsetzung", beschreibung: "Externes Dateisystem mit Versionierung. Bei dieser Projektgroesse zwingend; Arbeiten allein in Studio ist ausgeschlossen.", rolle: "Tech Lead", prio: "Must", aufwand_pt: "3", status: "Offen"),
    (id: "T-002", modul: "Projekt", name: "Branch- und Review-Prozess", beschreibung: "Feature-Branches, Pull Requests, verpflichtende Code-Reviews, Namenskonventionen.", rolle: "Tech Lead", prio: "Must", aufwand_pt: "2", status: "Offen"),
    (id: "T-003", modul: "Projekt", name: "Service-Framework", beschreibung: "Schlankes eigenes Framework oder Knit. Einheitliche Lebenszyklen fuer alle Dienste.", rolle: "Tech Lead", prio: "Must", aufwand_pt: "6", status: "Offen"),
    (id: "T-004", modul: "Projekt", name: "Luau strict mode", beschreibung: "Durchgaengige Typannotationen in allen Modulen, Linting in der Pipeline.", rolle: "Tech Lead", prio: "Must", aufwand_pt: "4", status: "Offen"),
    (id: "T-005", modul: "Projekt", name: "Konfigurationsschicht", beschreibung: "Alle Balancing-Werte in reinen Datenmodulen ohne Logik, von Designern editierbar.", rolle: "Engineering", prio: "Must", aufwand_pt: "5", status: "Offen"),
    (id: "T-006", modul: "Projekt", name: "Testumgebung", beschreibung: "Separates Universe fuer Tests mit eigenem Datastore-Scope und Testkonten.", rolle: "Tech Lead", prio: "Must", aufwand_pt: "4", status: "Offen"),
    (id: "T-007", modul: "Projekt", name: "Automatisierte Smoke-Tests", beschreibung: "Skriptgesteuerter Start jeder Map mit Pruefung auf Fehler in der Ausgabe.", rolle: "Engineering", prio: "Should", aufwand_pt: "6", status: "Offen"),
    (id: "T-010", modul: "Netzwerk", name: "Remote-Bundling", beschreibung: "Alle RemoteEvents ueber eine zentrale, typisierte Schicht mit Rate-Limiting und Validierung.", rolle: "Engineering", prio: "Must", aufwand_pt: "6", status: "Offen"),
    (id: "T-011", modul: "Netzwerk", name: "Client-Prediction", beschreibung: "Lokale Vorhersage der eigenen Bewegung mit Server-Abgleich und weicher Korrektur.", rolle: "Engineering", prio: "Must", aufwand_pt: "12", status: "Offen"),
    (id: "T-012", modul: "Netzwerk", name: "Replikationsdrosselung", beschreibung: "Titanenzustaende nur an Clients in Relevanzradius senden; Interpolation clientseitig.", rolle: "Engineering", prio: "Must", aufwand_pt: "8", status: "Offen"),
    (id: "T-013", modul: "Netzwerk", name: "Latenzkompensation", beschreibung: "Trefferpruefung mit Ruecksicht auf die Latenz des Angreifers, mit Obergrenze.", rolle: "Engineering", prio: "Should", aufwand_pt: "8", status: "Offen"),
    (id: "T-014", modul: "Netzwerk", name: "Instanzverwaltung", beschreibung: "Reservierte Server pro Einsatz, Lebenszyklus vom Start bis zum sauberen Abbau, Wiederverwendung leerer Instanzen.", rolle: "Engineering", prio: "Must", aufwand_pt: "10", status: "Offen"),
    (id: "T-015", modul: "Netzwerk", name: "Matchmaking-Dienst", beschreibung: "Serveruebergreifende Warteschlange und Instanzsuche ueber MemoryStoreService, mit Filterkriterien und Wartezeitausgleich.", rolle: "Engineering", prio: "Must", aufwand_pt: "12", status: "Offen"),
    (id: "T-016", modul: "Netzwerk", name: "Gruppen-Teleport", beschreibung: "Geschlossener Transfer ganzer Gruppen zwischen Places ohne Aufsplittung, mit Wiederholungslogik bei Fehlschlag.", rolle: "Engineering", prio: "Must", aufwand_pt: "8", status: "Offen"),
    (id: "T-017", modul: "Netzwerk", name: "Wiederverbindungslogik", beschreibung: "Platzhalterreservierung, Zustandswiederherstellung und Zeitablauf bei Verbindungsabbruch.", rolle: "Engineering", prio: "Must", aufwand_pt: "8", status: "Offen"),
    (id: "T-018", modul: "Netzwerk", name: "Interpolationspuffer", beschreibung: "Geglaettete Darstellung fremder Spieler und Titanen mit konfigurierbarem Puffer gegen Jitter.", rolle: "Engineering", prio: "Must", aufwand_pt: "8", status: "Offen"),
    (id: "T-019", modul: "Netzwerk", name: "Latenzsimulation im Test", beschreibung: "Werkzeug zum kuenstlichen Erzeugen von Latenz und Paketverlust fuer reproduzierbare Mehrspielertests.", rolle: "Engineering / QA", prio: "Must", aufwand_pt: "5", status: "Offen"),
    (id: "T-020", modul: "Performance", name: "Streaming-Konfiguration", beschreibung: "Streaming Enabled mit Radien groesser als die maximale Hakenreichweite.", rolle: "Engineering", prio: "Must", aufwand_pt: "4", status: "Offen"),
    (id: "T-021", modul: "Performance", name: "Object Pooling", beschreibung: "Wiederverwendungssystem fuer Titanen, Projektile, Partikel und UI-Elemente.", rolle: "Engineering", prio: "Must", aufwand_pt: "6", status: "Offen"),
    (id: "T-022", modul: "Performance", name: "LOD-Pipeline", beschreibung: "Automatisierte Erzeugung und Zuordnung der drei Detailstufen fuer alle Meshes.", rolle: "Tech Art", prio: "Must", aufwand_pt: "8", status: "Offen"),
    (id: "T-023", modul: "Performance", name: "Materialkonsolidierung", beschreibung: "Umgebung nutzt genau ein Material und einen Atlas. Pruefwerkzeug gegen Verstoesse.", rolle: "Tech Art", prio: "Must", aufwand_pt: "5", status: "Offen"),
    (id: "T-024", modul: "Performance", name: "Profiling-Werkzeuge", beschreibung: "Eingebautes Overlay fuer FPS, Speicher, Drawcalls, Serverlast und KI-Budget.", rolle: "Engineering", prio: "Must", aufwand_pt: "6", status: "Offen"),
    (id: "T-025", modul: "Performance", name: "PC-Qualitaetsprofile", beschreibung: "Zwei Zielprofile: Mindestprofil (Einsteiger-Laptop, integrierte Grafik) und Vollprofil. Getrennte Budgets fuer Partikel, Schatten und Sichtweite.", rolle: "Engineering", prio: "Should", aufwand_pt: "6", status: "Offen"),
    (id: "T-030", modul: "Pipeline", name: "Blender-Exportvorgabe", beschreibung: "Verbindliche Vorgaben fuer Skalierung, Achsen, Namensgebung, Ursprungspunkte und UV-Kanaele.", rolle: "Tech Art", prio: "Must", aufwand_pt: "4", status: "Offen"),
    (id: "T-031", modul: "Pipeline", name: "Asset-Namenskonvention", beschreibung: "Einheitliches Schema fuer alle Assets, Instanzen und Ordner.", rolle: "Tech Art", prio: "Must", aufwand_pt: "2", status: "Offen"),
    (id: "T-032", modul: "Pipeline", name: "Asset-Import-Automatisierung", beschreibung: "Skriptgestuetzter Import mit automatischer Kollisions- und LOD-Zuweisung.", rolle: "Tech Art", prio: "Should", aufwand_pt: "8", status: "Offen"),
    (id: "T-033", modul: "Pipeline", name: "Ankerflaechen-Werkzeug", beschreibung: "Studio-Plugin zum Markieren getaggter Flaechen mit Heatmap-Visualisierung der Abdeckung. Ebene 1 des Ankersystems.", rolle: "Tech Art", prio: "Must", aufwand_pt: "8", status: "Offen"),
    (id: "T-034a", modul: "Pipeline", name: "Ankerpunkt-Generator", beschreibung: "Studio-Plugin, das aus getaggten Flaechen automatisch diskrete Ankerpunkte erzeugt: Kantenerkennung, Vorsprungerkennung, Mindestabstand, Normalenausrichtung. Manuelles Setzen von tausenden Punkten ist keine Option.", rolle: "Tech Art", prio: "Must", aufwand_pt: "10", status: "Offen"),
    (id: "T-035a", modul: "Pipeline", name: "Ankerpunkt-Validierer", beschreibung: "Pruefwerkzeug fuer unerreichbare Punkte, fehlende Sichtlinien, zu dichte Cluster, Abdeckungsloecher und falsch ausgerichtete Normalen. Erzeugt Freigabebericht pro Map.", rolle: "Tech Art / QA", prio: "Must", aufwand_pt: "6", status: "Offen"),
    (id: "T-036a", modul: "Performance", name: "Raeumliches Gitter fuer Ankerpunkte", beschreibung: "Vorfilterung der Kandidatensuche ueber ein Gitter statt linearer Iteration. Ohne dies skaliert die Suche nicht auf Mapgroessen mit mehreren tausend Punkten.", rolle: "Engineering", prio: "Must", aufwand_pt: "5", status: "Offen"),
    (id: "T-034", modul: "Pipeline", name: "Animations-Exportvorgabe", beschreibung: "Einheitliche Framerate, Rootmotion-Regeln und Namensschema.", rolle: "Tech Art", prio: "Must", aufwand_pt: "3", status: "Offen"),
    (id: "T-035", modul: "Pipeline", name: "Audio-Bibliothek", beschreibung: "Zentrale Verwaltung aller Sound-IDs mit Kategorien, Lautstaerkegruppen und Mischpult.", rolle: "Engineering / Audio", prio: "Must", aufwand_pt: "6", status: "Offen"),
    (id: "T-040", modul: "Daten", name: "ProfileStore-Integration", beschreibung: "Session-Locking, automatische Wiederholungsversuche, sauberes Freigeben beim Verlassen.", rolle: "Engineering", prio: "Must", aufwand_pt: "8", status: "Offen"),
    (id: "T-041", modul: "Daten", name: "Schema-Migration", beschreibung: "Versionierte Profile mit Migrationsketten und Rueckfallpfad.", rolle: "Engineering", prio: "Must", aufwand_pt: "6", status: "Offen"),
    (id: "T-042", modul: "Daten", name: "Backup-Strategie", beschreibung: "Regelmaessige Snapshots mit Wiederherstellungsprozess und dokumentiertem Ablauf.", rolle: "Engineering", prio: "Must", aufwand_pt: "5", status: "Offen"),
    (id: "T-043", modul: "Daten", name: "Transaktionsprotokoll", beschreibung: "Vollstaendiges, abfragbares Protokoll aller Inventaraenderungen.", rolle: "Engineering", prio: "Must", aufwand_pt: "6", status: "Offen"),
    (id: "T-044", modul: "Daten", name: "MemoryStore-Schicht", beschreibung: "Cross-Server-Warteschlangen, Bestenlisten und Regimentsdaten.", rolle: "Engineering", prio: "Should", aufwand_pt: "8", status: "Offen"),
    (id: "T-050", modul: "Tooling", name: "Balancing-Dashboard", beschreibung: "Externes Werkzeug zur Auswertung von Telemetrie und Simulation von Balancing-Aenderungen.", rolle: "Data / Engineering", prio: "Should", aufwand_pt: "12", status: "Offen"),
    (id: "T-051", modul: "Tooling", name: "Level-Design-Werkzeuge", beschreibung: "Studio-Plugins fuer modulares Bauen, Rasterausrichtung und Spawnpunkt-Verwaltung.", rolle: "Tech Art", prio: "Should", aufwand_pt: "10", status: "Offen"),
    (id: "T-052", modul: "Tooling", name: "Debug-Konsole", beschreibung: "Ingame-Befehle fuer Testzwecke, nur in der Testumgebung aktiv.", rolle: "Engineering", prio: "Must", aufwand_pt: "5", status: "Offen"),
    (id: "T-053", modul: "Tooling", name: "Replay-System", beschreibung: "Aufzeichnung und Wiedergabe von Laeufen fuer Geister und Fehleranalyse.", rolle: "Engineering", prio: "Could", aufwand_pt: "12", status: "Offen"),
    (id: "T-060", modul: "Betrieb", name: "Fehlerueberwachung", beschreibung: "Zentrale Sammlung aller Laufzeitfehler mit Haeufigkeitsauswertung.", rolle: "Engineering", prio: "Must", aufwand_pt: "5", status: "Offen"),
    (id: "T-061", modul: "Betrieb", name: "Telemetrie-Pipeline", beschreibung: "Ereignisstrom zu einem externen Endpunkt mit Datenschutzpruefung.", rolle: "Engineering / Data", prio: "Should", aufwand_pt: "10", status: "Offen"),
    (id: "T-062", modul: "Betrieb", name: "Feature-Flag-Dienst", beschreibung: "Serverseitige Schalter fuer schrittweise Ausrollung.", rolle: "Engineering", prio: "Should", aufwand_pt: "5", status: "Offen"),
    (id: "T-063", modul: "Betrieb", name: "Wartungsmodus", beschreibung: "Kontrolliertes Herunterfahren mit Spielerbenachrichtigung und Datensicherung.", rolle: "Engineering", prio: "Should", aufwand_pt: "4", status: "Offen"),
    (id: "T-064", modul: "Betrieb", name: "Lasttest", beschreibung: "Simulierte Volllast auf allen Maps mit maximaler Spielerzahl und Titanenanzahl.", rolle: "Engineering / QA", prio: "Must", aufwand_pt: "8", status: "Offen"),
    (id: "T-070", modul: "QA", name: "Testplan Bewegung", beschreibung: "Systematische Pruefliste fuer alle Vector-Gear-Zustaende und Grenzfaelle.", rolle: "QA", prio: "Must", aufwand_pt: "5", status: "Offen"),
    (id: "T-071", modul: "QA", name: "Testplan Kampf", beschreibung: "Pruefliste fuer Trefferzonen, Schadensformeln und Gegnerverhalten.", rolle: "QA", prio: "Must", aufwand_pt: "5", status: "Offen"),
    (id: "T-072", modul: "QA", name: "Testplan Progression", beschreibung: "Pruefliste fuer Fortschritt, Persistenz, Migration und Grenzwerte.", rolle: "QA", prio: "Must", aufwand_pt: "5", status: "Offen"),
    (id: "T-073", modul: "QA", name: "Exploit-Testplan", beschreibung: "Gezielte Angriffsversuche auf alle Remotes, Werte und Physikgrenzen.", rolle: "QA / Security", prio: "Must", aufwand_pt: "8", status: "Offen"),
    (id: "T-074", modul: "QA", name: "Playtest-Protokoll", beschreibung: "Standardisierter Ablauf fuer Blindtests inklusive Fragebogen und Metriken.", rolle: "QA / Design", prio: "Must", aufwand_pt: "4", status: "Offen"),
]
