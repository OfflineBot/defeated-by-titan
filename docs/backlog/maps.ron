entries: [
    (id: "M-001", name: "The Rookery (Hub)", description: "Zentrale Basis im Inneren der Bastionsmauer. Innenhof, Werkstatt, Lineage-Halle, Haendler, Medic, Einsatzkarte, Bestenlisten, Trainingsgelaende. Keine Gegner.", modes: "Hub", size_studs: "1200x1200", anchor_density: "Hoch", prio: "Must", effort_pd: "25", status: "Offen"),
    (id: "M-002", name: "Ashgate District", description: "Enge Altstadt mit Fachwerk, Kanaelen und schmalen Gassen. Hoechste Ankerdichte, belohnt praezises Manoevrieren. Einsteigermap.", modes: "Skirmish, Breach, Randomizer, Traversal", size_studs: "2000x2000", anchor_density: "Sehr hoch", prio: "Must", effort_pd: "30", status: "Offen"),
    (id: "M-003", name: "Brackwall", description: "Weitraeumige Neustadt mit breiten Boulevards und Plaetzen. Weniger Anker, mehr Boost-Bedarf. Lehrt Gasmanagement.", modes: "Skirmish, Protect, Randomizer, Traversal", size_studs: "2400x2400", anchor_density: "Mittel", prio: "Must", effort_pd: "28", status: "Offen"),
    (id: "M-004", name: "The Fallow", description: "Offenes Feld mit Baumgruppen, Ruinen und einer Handelsstrasse. Gefaehrlichste Map fuer Anfaenger wegen fehlender Anker.", modes: "Escort, Skirmish, Randomizer", size_studs: "3000x3000", anchor_density: "Niedrig", prio: "Must", effort_pd: "26", status: "Offen"),
    (id: "M-005", name: "Titanwood", description: "Wald mit Riesenbaeumen. Vertikale Kampffuehrung, dichte Deckung, eingeschraenkte Sicht. Beliebteste Maparchitektur des Genres.", modes: "Skirmish, Protect, Reclaim, Traversal", size_studs: "2600x2600", anchor_density: "Sehr hoch", prio: "Must", effort_pd: "30", status: "Offen"),
    (id: "M-006", name: "Hollowkeep", description: "Isolierte Festung im Oedland, umgeben von Freiflaeche. Verteidigungsszenario mit begrenztem Rueckzugsraum.", modes: "Breach, Stall, Reclaim", size_studs: "1800x1800", anchor_density: "Mittel", prio: "Should", effort_pd: "24", status: "Offen"),
    (id: "M-007", name: "Saltpier", description: "Hafenanlage mit Lagerhaeusern, Kraenen und Kaimauern. Mehrgeschossige Innenraeume, ungewoehnliche Ankerhoehen.", modes: "Stall, Skirmish, Reclaim", size_studs: "2200x2200", anchor_density: "Hoch", prio: "Should", effort_pd: "26", status: "Offen"),
    (id: "M-008", name: "Highspire", description: "Wohlhabender Oberstadtbezirk mit hohen Steinbauten und Saeulenhallen. Vertikalste Stadtmap.", modes: "Skirmish, Protect, Randomizer, Traversal", size_studs: "2000x2400", anchor_density: "Hoch", prio: "Should", effort_pd: "26", status: "Offen"),
    (id: "M-009", name: "The Breach (Raid)", description: "Mauerabschnitt mit Bresche und Kanonenplattformen. Speziell fuer den Ashwalker-Raid gebaut.", modes: "Raid", size_studs: "1600x1600", anchor_density: "Mittel", prio: "Should", effort_pd: "22", status: "Offen"),
    (id: "M-010", name: "The Hollow (Raid)", description: "Amphitheaterartige Senke fuer Bosskaempfe mit klaren Sichtlinien und Ankerpfeilern.", modes: "Raid", size_studs: "1200x1200", anchor_density: "Hoch", prio: "Should", effort_pd: "20", status: "Offen"),
    (id: "M-011", name: "Trainingsgelaende", description: "Teil des Hubs. Parcoursringe, bewegliche Ziele, Zeitmessung, Uebungstitanen aller Typen.", modes: "Tutorial, Uebung", size_studs: "800x800", anchor_density: "Sehr hoch", prio: "Must", effort_pd: "14", status: "Offen"),
    (id: "M-012", name: "Trade Hall", description: "Separater Handelsraum mit Handelsplaetzen und Marktbrett.", modes: "Handel", size_studs: "400x400", anchor_density: "Niedrig", prio: "Could", effort_pd: "8", status: "Offen"),
]
