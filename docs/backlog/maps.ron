eintraege: [
    (id: "M-001", name: "The Rookery (Hub)", beschreibung: "Zentrale Basis im Inneren der Bastionsmauer. Innenhof, Werkstatt, Lineage-Halle, Haendler, Medic, Einsatzkarte, Bestenlisten, Trainingsgelaende. Keine Gegner.", modi: "Hub", groesse_studs: "1200x1200", ankerdichte: "Hoch", prio: "Must", aufwand_pt: "25", status: "Offen"),
    (id: "M-002", name: "Ashgate District", beschreibung: "Enge Altstadt mit Fachwerk, Kanaelen und schmalen Gassen. Hoechste Ankerdichte, belohnt praezises Manoevrieren. Einsteigermap.", modi: "Skirmish, Breach, Randomizer, Traversal", groesse_studs: "2000x2000", ankerdichte: "Sehr hoch", prio: "Must", aufwand_pt: "30", status: "Offen"),
    (id: "M-003", name: "Brackwall", beschreibung: "Weitraeumige Neustadt mit breiten Boulevards und Plaetzen. Weniger Anker, mehr Boost-Bedarf. Lehrt Gasmanagement.", modi: "Skirmish, Protect, Randomizer, Traversal", groesse_studs: "2400x2400", ankerdichte: "Mittel", prio: "Must", aufwand_pt: "28", status: "Offen"),
    (id: "M-004", name: "The Fallow", beschreibung: "Offenes Feld mit Baumgruppen, Ruinen und einer Handelsstrasse. Gefaehrlichste Map fuer Anfaenger wegen fehlender Anker.", modi: "Escort, Skirmish, Randomizer", groesse_studs: "3000x3000", ankerdichte: "Niedrig", prio: "Must", aufwand_pt: "26", status: "Offen"),
    (id: "M-005", name: "Titanwood", beschreibung: "Wald mit Riesenbaeumen. Vertikale Kampffuehrung, dichte Deckung, eingeschraenkte Sicht. Beliebteste Maparchitektur des Genres.", modi: "Skirmish, Protect, Reclaim, Traversal", groesse_studs: "2600x2600", ankerdichte: "Sehr hoch", prio: "Must", aufwand_pt: "30", status: "Offen"),
    (id: "M-006", name: "Hollowkeep", beschreibung: "Isolierte Festung im Oedland, umgeben von Freiflaeche. Verteidigungsszenario mit begrenztem Rueckzugsraum.", modi: "Breach, Stall, Reclaim", groesse_studs: "1800x1800", ankerdichte: "Mittel", prio: "Should", aufwand_pt: "24", status: "Offen"),
    (id: "M-007", name: "Saltpier", beschreibung: "Hafenanlage mit Lagerhaeusern, Kraenen und Kaimauern. Mehrgeschossige Innenraeume, ungewoehnliche Ankerhoehen.", modi: "Stall, Skirmish, Reclaim", groesse_studs: "2200x2200", ankerdichte: "Hoch", prio: "Should", aufwand_pt: "26", status: "Offen"),
    (id: "M-008", name: "Highspire", beschreibung: "Wohlhabender Oberstadtbezirk mit hohen Steinbauten und Saeulenhallen. Vertikalste Stadtmap.", modi: "Skirmish, Protect, Randomizer, Traversal", groesse_studs: "2000x2400", ankerdichte: "Hoch", prio: "Should", aufwand_pt: "26", status: "Offen"),
    (id: "M-009", name: "The Breach (Raid)", beschreibung: "Mauerabschnitt mit Bresche und Kanonenplattformen. Speziell fuer den Ashwalker-Raid gebaut.", modi: "Raid", groesse_studs: "1600x1600", ankerdichte: "Mittel", prio: "Should", aufwand_pt: "22", status: "Offen"),
