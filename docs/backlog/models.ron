entries: [
    (id: "A-001", category: "Charakter", name: "Basis-Rig Vanguard", description: "Humanoides R15-kompatibles Grundskelett fuer alle Spielerfiguren. Zusaetzliche Knochen: 6 fuer Umhang, 2 pro Gurtriemen, 4 fuer Vector-Gear-Seile.", tris_lod0: "0", tris_lod1: "0", tris_lod2: "0", variants: "1", texture_slot: "-", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "A-002", category: "Charakter", name: "Koerper maennlich schlank", description: "Low-Poly-Grundkoerper, kantige Silhouette, klare Schulterlinie fuer gute Lesbarkeit aus der Distanz.", tris_lod0: "1400", tris_lod1: "700", tris_lod2: "300", variants: "1", texture_slot: "TEX-CHAR-01", prio: "Must", effort_pd: "3", status: "Offen"),
    (id: "A-003", category: "Charakter", name: "Koerper weiblich schlank", description: "Gleiches Polybudget, abweichende Proportionen, identische Rig-Kompatibilitaet.", tris_lod0: "1400", tris_lod1: "700", tris_lod2: "300", variants: "1", texture_slot: "TEX-CHAR-01", prio: "Must", effort_pd: "3", status: "Offen"),
    (id: "A-004", category: "Charakter", name: "Koerper kraeftig", description: "Dritte Statur-Variante fuer Kundenvielfalt in der Charaktererstellung.", tris_lod0: "1500", tris_lod1: "750", tris_lod2: "300", variants: "1", texture_slot: "TEX-CHAR-01", prio: "Should", effort_pd: "3", status: "Offen"),
    (id: "A-005", category: "Charakter", name: "Kopf-Basis", description: "Vier Kopfformen (kantig, rund, schmal, breit) als austauschbare Meshes.", tris_lod0: "400", tris_lod1: "200", tris_lod2: "80", variants: "4", texture_slot: "TEX-CHAR-01", prio: "Must", effort_pd: "4", status: "Offen"),
    (id: "A-006", category: "Charakter", name: "Frisuren", description: "Zwoelf Low-Poly-Frisuren als Kappengeometrie, farbkanalfaehig. Keine Alphakanten.", tris_lod0: "250", tris_lod1: "120", tris_lod2: "50", variants: "12", texture_slot: "TEX-CHAR-01", prio: "Must", effort_pd: "8", status: "Offen"),
    (id: "A-007", category: "Charakter", name: "Gesichtszuege", description: "Als Textur-Varianten auf dem Kopf-Atlas: 10 Augenformen, 6 Mundformen, 8 Narben/Marken.", tris_lod0: "0", tris_lod1: "0", tris_lod2: "0", variants: "24", texture_slot: "TEX-CHAR-01", prio: "Should", effort_pd: "4", status: "Offen"),
    (id: "A-008", category: "Charakter", name: "Uniform Rekrut", description: "Einfache Feldkleidung ohne Abzeichen, gedeckte Farben. Startausruestung.", tris_lod0: "900", tris_lod1: "450", tris_lod2: "180", variants: "1", texture_slot: "TEX-CHAR-02", prio: "Must", effort_pd: "4", status: "Offen"),
    (id: "A-009", category: "Charakter", name: "Uniform Vanguard", description: "Standarduniform mit Gurtwerk, Taschen und Rangabzeichen. Drei Farbkanaele.", tris_lod0: "1200", tris_lod1: "600", tris_lod2: "240", variants: "1", texture_slot: "TEX-CHAR-02", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "A-010", category: "Charakter", name: "Uniform Elite", description: "Endgame-Uniform mit zusaetzlichem Schulterschutz und Verstaerkungen.", tris_lod0: "1400", tris_lod1: "700", tris_lod2: "280", variants: "1", texture_slot: "TEX-CHAR-02", prio: "Should", effort_pd: "5", status: "Offen"),
    (id: "A-011", category: "Charakter", name: "Umhang Standard", description: "Umhang mit Knochenkette fuer prozedurale Bewegung. Musterflaeche als Kosmetik-Slot.", tris_lod0: "600", tris_lod1: "300", tris_lod2: "100", variants: "1", texture_slot: "TEX-CHAR-03", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "A-012", category: "Charakter", name: "Umhang-Varianten", description: "Acht Schnittvarianten (kurz, lang, zerrissen, Kapuze, geteilt, Schulterumhang, Wintervariante, zeremoniell).", tris_lod0: "600", tris_lod1: "300", tris_lod2: "100", variants: "8", texture_slot: "TEX-CHAR-03", prio: "Could", effort_pd: "6", status: "Offen"),
    (id: "A-013", category: "Charakter", name: "Stiefel und Handschuhe", description: "Vier Sets, an Uniformen anbindbar.", tris_lod0: "300", tris_lod1: "150", tris_lod2: "60", variants: "4", texture_slot: "TEX-CHAR-02", prio: "Should", effort_pd: "3", status: "Offen"),
    (id: "A-014", category: "Charakter", name: "Gurtwerk (Harness)", description: "Riemensystem am Koerper, Traeger fuer das Vector Gear. Sichtbar unter allen Uniformen.", tris_lod0: "500", tris_lod1: "250", tris_lod2: "100", variants: "1", texture_slot: "TEX-CHAR-02", prio: "Must", effort_pd: "3", status: "Offen"),
    (id: "A-020", category: "Ausruestung", name: "Vector Gear Stufe 1", description: "Grundgeraet: zwei Huelsen an der Huefte, Gastanks, Ankerwerfer. Bewegliche Teile fuer Animation getrennt modelliert.", tris_lod0: "900", tris_lod1: "450", tris_lod2: "180", variants: "1", texture_slot: "TEX-GEAR-01", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "A-021", category: "Ausruestung", name: "Vector Gear Stufe 2", description: "Verbessertes Modell mit groesseren Tanks und zusaetzlichen Duesen. Optischer Fortschrittsindikator.", tris_lod0: "1000", tris_lod1: "500", tris_lod2: "200", variants: "1", texture_slot: "TEX-GEAR-01", prio: "Should", effort_pd: "4", status: "Offen"),
    (id: "A-022", category: "Ausruestung", name: "Vector Gear Stufe 3", description: "Endgame-Modell mit vier Duesen und Verstaerkungsrahmen.", tris_lod0: "1100", tris_lod1: "550", tris_lod2: "220", variants: "1", texture_slot: "TEX-GEAR-01", prio: "Should", effort_pd: "4", status: "Offen"),
    (id: "A-023", category: "Ausruestung", name: "Klingengriffe", description: "Handgriffe mit Auslesemechanik. Immer sichtbar, auch ohne eingesetzte Klinge.", tris_lod0: "180", tris_lod1: "90", tris_lod2: "40", variants: "1", texture_slot: "TEX-GEAR-01", prio: "Must", effort_pd: "2", status: "Offen"),
    (id: "A-024", category: "Ausruestung", name: "Klingen (Paar)", description: "Austauschbare Schneidblaetter. Bruchzustand als zweites Mesh (abgebrochene Spitze).", tris_lod0: "120", tris_lod1: "60", tris_lod2: "0", variants: "2", texture_slot: "TEX-GEAR-01", prio: "Must", effort_pd: "3", status: "Offen"),
    (id: "A-025", category: "Ausruestung", name: "Klingen-Kosmetikvarianten", description: "Zwoelf Klingenformen fuer den Kosmetikshop, identische Hitbox.", tris_lod0: "140", tris_lod1: "70", tris_lod2: "0", variants: "12", texture_slot: "TEX-GEAR-02", prio: "Could", effort_pd: "6", status: "Offen"),
    (id: "A-026", category: "Ausruestung", name: "Ankerhaken", description: "Projektilkopf mit Widerhaken, sichtbar am Seilende.", tris_lod0: "90", tris_lod1: "40", tris_lod2: "0", variants: "1", texture_slot: "TEX-GEAR-01", prio: "Must", effort_pd: "1", status: "Offen"),
    (id: "A-027", category: "Ausruestung", name: "Gaskanister", description: "Wechselbarer Tank, sichtbar am Guertel, Fuellstand ueber Farbkanal.", tris_lod0: "160", tris_lod1: "80", tris_lod2: "0", variants: "1", texture_slot: "TEX-GEAR-01", prio: "Must", effort_pd: "2", status: "Offen"),
    (id: "A-028", category: "Ausruestung", name: "Lance Charge", description: "Wurflanze mit Sprengkopf, Leitwerk und Zuendmechanik. Gesteckte Variante im Titanenkoerper.", tris_lod0: "280", tris_lod1: "140", tris_lod2: "0", variants: "2", texture_slot: "TEX-GEAR-01", prio: "Should", effort_pd: "3", status: "Offen"),
    (id: "A-029", category: "Ausruestung", name: "Lance-Halterung", description: "Rueckentragegestell fuer bis zu vier Lanzen, Fuellstand sichtbar.", tris_lod0: "320", tris_lod1: "160", tris_lod2: "0", variants: "1", texture_slot: "TEX-GEAR-01", prio: "Should", effort_pd: "2", status: "Offen"),
    (id: "A-030", category: "Ausruestung", name: "Verbandsset", description: "Kleines Feldbesteck am Guertel, sichtbar bei Verletzungsheilung.", tris_lod0: "80", tris_lod1: "0", tris_lod2: "0", variants: "1", texture_slot: "TEX-GEAR-01", prio: "Could", effort_pd: "1", status: "Offen"),
    (id: "A-040", category: "Titan", name: "Titan-Basis-Rig", description: "Gemeinsames Skelett fuer alle aufrecht gehenden Titanen. Cortex als separates Knochen-Objekt.", tris_lod0: "0", tris_lod1: "0", tris_lod2: "0", variants: "1", texture_slot: "-", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "A-041", category: "Titan", name: "Scuttler-Rig", description: "Vierfuessiges Skelett fuer kriechende Titanen, abweichende Gelenkgrenzen.", tris_lod0: "0", tris_lod1: "0", tris_lod2: "0", variants: "1", texture_slot: "-", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "A-042", category: "Titan", name: "Koerpertyp A: hager", description: "Duenne, langgliedrige Silhouette. Grosse Reichweite, wenig Masse.", tris_lod0: "2600", tris_lod1: "1300", tris_lod2: "450", variants: "3 Groessen", texture_slot: "TEX-TITAN-01", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "A-043", category: "Titan", name: "Koerpertyp B: gedrungen", description: "Breite, schwere Silhouette. Kurze Arme, hohe Masse, langsamer.", tris_lod0: "2800", tris_lod1: "1400", tris_lod2: "480", variants: "3 Groessen", texture_slot: "TEX-TITAN-01", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "A-044", category: "Titan", name: "Koerpertyp C: verzerrt", description: "Asymmetrische, unheimliche Proportionen. Fuer Errant und Weaver.", tris_lod0: "3000", tris_lod1: "1500", tris_lod2: "500", variants: "3 Groessen", texture_slot: "TEX-TITAN-01", prio: "Must", effort_pd: "7", status: "Offen"),
    (id: "A-045", category: "Titan", name: "Kopfvarianten Titan", description: "Zehn austauschbare Koepfe mit unterschiedlichen Gesichtsausdruecken. Traegt einen Grossteil der visuellen Vielfalt.", tris_lod0: "500", tris_lod1: "250", tris_lod2: "100", variants: "10", texture_slot: "TEX-TITAN-01", prio: "Must", effort_pd: "8", status: "Offen"),
    (id: "A-046", category: "Titan", name: "Cortex-Mesh", description: "Separates, leicht erhabenes Nackenstueck mit dampfender Oberflaeche. Muss aus 100 studs erkennbar sein.", tris_lod0: "180", tris_lod1: "90", tris_lod2: "60", variants: "1", texture_slot: "TEX-TITAN-02", prio: "Must", effort_pd: "3", status: "Offen"),
    (id: "A-047", category: "Titan", name: "Scuttler-Koerper", description: "Vierfuessiger Titanenkoerper mit verlaengerten Armen und flacher Haltung.", tris_lod0: "2900", tris_lod1: "1450", tris_lod2: "500", variants: "2 Groessen", texture_slot: "TEX-TITAN-01", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "A-048", category: "Titan", name: "Warden-Zusatzteile", description: "Verstaerkte Unterarme und Handflaechen fuer den nackenschuetzenden Typ.", tris_lod0: "600", tris_lod1: "300", tris_lod2: "120", variants: "1", texture_slot: "TEX-TITAN-01", prio: "Should", effort_pd: "3", status: "Offen"),
    (id: "A-049", category: "Titan", name: "Lurker-Koerper", description: "Hockende, gedrungene Silhouette, die im Ruhezustand wie Geroell wirkt.", tris_lod0: "2700", tris_lod1: "1350", tris_lod2: "450", variants: "1", texture_slot: "TEX-TITAN-01", prio: "Should", effort_pd: "5", status: "Offen"),
    (id: "A-050", category: "Titan", name: "Bellower-Zusatzteile", description: "Aufgeblaehter Brustkorb und weit aufreissbarer Kiefer fuer den Ruf.", tris_lod0: "700", tris_lod1: "350", tris_lod2: "140", variants: "1", texture_slot: "TEX-TITAN-01", prio: "Should", effort_pd: "3", status: "Offen"),
    (id: "A-051", category: "Titan", name: "Schadenszustaende", description: "Abgetrennte Arme, Beine, verletzte Augen als Austausch-Meshes und Schnittflaechen mit Dampfemitter.", tris_lod0: "400", tris_lod1: "200", tris_lod2: "0", variants: "8", texture_slot: "TEX-TITAN-02", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "A-052", category: "Titan", name: "Aufloesungs-Mesh", description: "Skelettartige Restform waehrend des Verdampfens nach dem Tod.", tris_lod0: "800", tris_lod1: "400", tris_lod2: "0", variants: "1", texture_slot: "TEX-TITAN-02", prio: "Must", effort_pd: "3", status: "Offen"),
    (id: "A-060", category: "Boss", name: "The Bound One", description: "Erster Raid-Boss. Muskuloese, gebundene Silhouette mit sichtbaren Ketten- und Narbenmotiven. In zwei Meshes geteilt.", tris_lod0: "11000", tris_lod1: "5000", tris_lod2: "1500", variants: "1", texture_slot: "TEX-BOSS-01", prio: "Should", effort_pd: "14", status: "Offen"),
    (id: "A-061", category: "Boss", name: "The Dancer", description: "Beweglicher, schlanker Boss mit vier sichtbaren Schwachstellen an Schultern und Huefte.", tris_lod0: "10000", tris_lod1: "4500", tris_lod2: "1400", variants: "1", texture_slot: "TEX-BOSS-02", prio: "Should", effort_pd: "14", status: "Offen"),
    (id: "A-062", category: "Boss", name: "The Bulwark", description: "Gepanzerter Boss mit segmentierten Plattenteilen, die einzeln abgesprengt werden koennen.", tris_lod0: "12000", tris_lod1: "5500", tris_lod2: "1600", variants: "1", texture_slot: "TEX-BOSS-03", prio: "Should", effort_pd: "16", status: "Offen"),
    (id: "A-063", category: "Boss", name: "The Ashwalker", description: "Riesenboss, nur Oberkoerper und Kopf detailliert modelliert (wird nie ganz gesehen). Dampf- und Glutmotiv.", tris_lod0: "12000", tris_lod1: "6000", tris_lod2: "2000", variants: "1", texture_slot: "TEX-BOSS-04", prio: "Should", effort_pd: "18", status: "Offen"),
    (id: "A-064", category: "Boss", name: "Boss-Schwachstellenmarker", description: "Leuchtende, pulsierende Zonen als eigene Meshes fuer alle Bosse.", tris_lod0: "120", tris_lod1: "60", tris_lod2: "0", variants: "6", texture_slot: "TEX-BOSS-01", prio: "Should", effort_pd: "3", status: "Offen"),
    (id: "A-070", category: "Vessel", name: "Warbound", description: "Spielbare Verwandlungsform, Angriffsarchetyp. Muskuloes, dampfend, mittelgross.", tris_lod0: "9000", tris_lod1: "4000", tris_lod2: "1200", variants: "1", texture_slot: "TEX-VESSEL-01", prio: "Should", effort_pd: "12", status: "Offen"),
    (id: "A-071", category: "Vessel", name: "Bladewright", description: "Schlanke, schnelle Form mit klingenartigen Unterarmen.", tris_lod0: "8500", tris_lod1: "3800", tris_lod2: "1100", variants: "1", texture_slot: "TEX-VESSEL-02", prio: "Could", effort_pd: "12", status: "Offen"),
    (id: "A-072", category: "Vessel", name: "Bulwark Form", description: "Gepanzerte, schwere Spielerform mit Plattenmotiv.", tris_lod0: "10000", tris_lod1: "4500", tris_lod2: "1300", variants: "1", texture_slot: "TEX-VESSEL-03", prio: "Could", effort_pd: "12", status: "Offen"),
    (id: "A-073", category: "Vessel", name: "Colossus Form", description: "Riesige Belagerungsform, nur Oberkoerper detailliert.", tris_lod0: "11000", tris_lod1: "5000", tris_lod2: "1500", variants: "1", texture_slot: "TEX-VESSEL-04", prio: "Could", effort_pd: "14", status: "Offen"),
    (id: "A-080", category: "Umgebung", name: "Hauswand-Modul", description: "Sechs Wandsegmente in drei Breiten, mit und ohne Fenster. Rasterbasiert (4 studs).", tris_lod0: "180", tris_lod1: "0", tris_lod2: "0", variants: "6", texture_slot: "TEX-ENV-ATLAS", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "A-081", category: "Umgebung", name: "Dach-Modul", description: "Satteldach, Walmdach, Flachdach, Pultdach in je zwei Groessen. Alle hakbar.", tris_lod0: "220", tris_lod1: "110", tris_lod2: "0", variants: "8", texture_slot: "TEX-ENV-ATLAS", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "A-082", category: "Umgebung", name: "Schornstein und Dachaufbauten", description: "Vier Schornsteinvarianten, zwei Dachluken, Wetterfahne. Wichtige Ankerpunkte auf freien Dachflaechen.", tris_lod0: "120", tris_lod1: "0", tris_lod2: "0", variants: "7", texture_slot: "TEX-ENV-ATLAS", prio: "Must", effort_pd: "3", status: "Offen"),
    (id: "A-083", category: "Umgebung", name: "Fachwerkhaus komplett", description: "Drei vorgebaute Komplettgebaeude fuer schnelles Blocking, aus Modulen zusammengesetzt.", tris_lod0: "1400", tris_lod1: "700", tris_lod2: "250", variants: "3", texture_slot: "TEX-ENV-ATLAS", prio: "Should", effort_pd: "4", status: "Offen"),
    (id: "A-084", category: "Umgebung", name: "Stadttor", description: "Grosses Doppeltor mit Rahmen und Mechanik. Zerstoerbare Variante.", tris_lod0: "900", tris_lod1: "450", tris_lod2: "150", variants: "2", texture_slot: "TEX-ENV-ATLAS", prio: "Must", effort_pd: "4", status: "Offen"),
    (id: "A-085", category: "Umgebung", name: "Strassenmodule", description: "Pflasterplatten, Kreuzung, Kurve, Treppe, Rampe, Gasse.", tris_lod0: "90", tris_lod1: "0", tris_lod2: "0", variants: "6", texture_slot: "TEX-ENV-ATLAS", prio: "Must", effort_pd: "3", status: "Offen"),
    (id: "A-086", category: "Umgebung", name: "Kanal- und Bruecken-Module", description: "Kanalsegment, Steinbruecke, Holzsteg, Gelaender.", tris_lod0: "250", tris_lod1: "120", tris_lod2: "0", variants: "4", texture_slot: "TEX-ENV-ATLAS", prio: "Should", effort_pd: "3", status: "Offen"),
    (id: "A-087", category: "Umgebung", name: "Marktstaende", description: "Vier Standtypen mit Planen. Planen sind hakbar und geben Federung.", tris_lod0: "320", tris_lod1: "160", tris_lod2: "0", variants: "4", texture_slot: "TEX-ENV-ATLAS", prio: "Should", effort_pd: "3", status: "Offen"),
    (id: "A-088", category: "Umgebung", name: "Laternen und Strassenschilder", description: "Vertikale Ankerpunkte in Bodennaehe, wichtig fuer Tiefenmanoever.", tris_lod0: "100", tris_lod1: "0", tris_lod2: "0", variants: "5", texture_slot: "TEX-ENV-ATLAS", prio: "Should", effort_pd: "2", status: "Offen"),
    (id: "A-089", category: "Umgebung", name: "Zerstoerte Gebaeudeteile", description: "Ruinierte Varianten von Wand, Dach und Ecke fuer Breach-Szenarien.", tris_lod0: "300", tris_lod1: "150", tris_lod2: "0", variants: "8", texture_slot: "TEX-ENV-ATLAS", prio: "Should", effort_pd: "5", status: "Offen"),
    (id: "A-090", category: "Umgebung", name: "Trueammer und Schutt", description: "Sechs Schutthaufen, hakbar, dienen als Deckung.", tris_lod0: "180", tris_lod1: "90", tris_lod2: "0", variants: "6", texture_slot: "TEX-ENV-ATLAS", prio: "Should", effort_pd: "3", status: "Offen"),
    (id: "A-095", category: "Umgebung", name: "Mauersegment", description: "Grundsegment der Bastionsmauer, 40 studs breit, modular fortsetzbar.", tris_lod0: "400", tris_lod1: "200", tris_lod2: "80", variants: "3", texture_slot: "TEX-ENV-ATLAS", prio: "Must", effort_pd: "4", status: "Offen"),
    (id: "A-096", category: "Umgebung", name: "Mauerzinnen und Bruestung", description: "Oberkante mit Deckung, Ankerpunkten und Kanonenplaetzen.", tris_lod0: "280", tris_lod1: "140", tris_lod2: "0", variants: "2", texture_slot: "TEX-ENV-ATLAS", prio: "Must", effort_pd: "3", status: "Offen"),
    (id: "A-097", category: "Umgebung", name: "Mauerkanone", description: "Bedienbare Verteidigungswaffe mit Rohr, Lafette und Nachladehebel. Bewegliche Teile getrennt.", tris_lod0: "850", tris_lod1: "420", tris_lod2: "150", variants: "1", texture_slot: "TEX-ENV-ATLAS", prio: "Should", effort_pd: "5", status: "Offen"),
    (id: "A-098", category: "Umgebung", name: "Balliste", description: "Zweite Umgebungswaffe mit Bolzenmagazin, praeziser aber langsamer.", tris_lod0: "700", tris_lod1: "350", tris_lod2: "120", variants: "1", texture_slot: "TEX-ENV-ATLAS", prio: "Could", effort_pd: "4", status: "Offen"),
    (id: "A-099", category: "Umgebung", name: "Mauerlift", description: "Vertikale Transportplattform mit Seilzug fuer die Mauerinnenseite.", tris_lod0: "500", tris_lod1: "250", tris_lod2: "0", variants: "1", texture_slot: "TEX-ENV-ATLAS", prio: "Should", effort_pd: "3", status: "Offen"),
    (id: "A-100", category: "Umgebung", name: "Mauertreppen und Steige", description: "Verbindungswege zwischen Mauerkrone und Boden.", tris_lod0: "320", tris_lod1: "160", tris_lod2: "0", variants: "3", texture_slot: "TEX-ENV-ATLAS", prio: "Should", effort_pd: "2", status: "Offen"),
