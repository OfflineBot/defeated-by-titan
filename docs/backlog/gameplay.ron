// GENERATED by tools/features.py from gameplay/features.xlsx — do NOT edit by hand.
// Hand edits here are lost on the next run. Changing the source means: change the
// .xlsx and run the script again (prompts/init.md §2).
// Source: gameplay/features.xlsx!01_Spielfunktionen (194 records from 197 rows)
entries: [
    (id: "F-001", system: "Vector Gear", name: "Doppelhaken-Grundsystem", description: "Zwei unabhaengig steuerbare Enterhaken (links/rechts), einzeln abfeuerbar und loesbar. Jeder Haken hat eigenen Zustand: idle, fliegend, verankert, einziehend.", acceptance: "Beide Haken lassen sich unabhaengig setzen und loesen; Zustaende sind im HUD sichtbar.", prio: "Must", effort_pd: "12", discipline: "Engineering", status: "Offen"),
    (id: "F-002", system: "Vector Gear", name: "Freies Zielen per Raycast (Ebene 1)", description: "Basisebene des Zielsystems. Raycast aus Kameraposition in Blickrichtung, Reichweite = Range-Stat (Basis 400 studs). Trefferpunkt wird gegen eine gueltige Ankerflaeche geprueft. Der Spieler kann jede getaggte Flaeche frei anvisieren, unabhaengig von gesetzten Ankerpunkten. Diese Ebene bleibt IMMER aktiv und ist niemals durch das Snap-System ersetzbar.", acceptance: "Jede getaggte Flaeche ist per freiem Zielen erreichbar, auch wenn dort kein Ankerpunkt liegt.", prio: "Must", effort_pd: "5", discipline: "Engineering", depends_on: "F-001", status: "Offen"),
    (id: "F-003", system: "Vector Gear", name: "Getaggte Ankerflaechen (Ebene 1)", description: "Nur Oberflaechen mit CollectionService-Tag 'AnchorSurface' sind hakbar. Gilt fuer ganze Flaechen, nicht fuer Punkte. Verhindert Physik-Exploits, macht Leveldesign steuerbar und definiert ueber die Flaechendichte die Traversal-Schwierigkeit einer Map.", acceptance: "Kein Haken auf ungetaggten Parts moeglich; Tagging-Werkzeug im Studio vorhanden; Heatmap zeigt Flaechenabdeckung.", prio: "Must", effort_pd: "4", discipline: "Engineering / LD", depends_on: "F-002", status: "Offen"),
    (id: "F-004", system: "Vector Gear", name: "Pendelphysik bei Zwei-Haken-Zustand", description: "Zwei gesetzte Haken erzeugen echte Zentripetalbewegung ueber RopeConstraint statt linearem Ziehen. Basis fuer Momentum-Chaining.", acceptance: "Spieler beschreibt sichtbar eine Bogenbahn; Geschwindigkeit steigt beim Ausschwingen.", prio: "Must", effort_pd: "15", discipline: "Engineering", depends_on: "F-001", status: "Offen"),
    (id: "F-005", system: "Vector Gear", name: "Reel-In / Seilverkuerzung", description: "Kontrollierte Reduktion der Seillaenge zum Hoehengewinn. Manuell steuerbar, verbraucht Gas.", acceptance: "Spieler kann aus dem Tiefpunkt Hoehe gewinnen; Gasverbrauch ist spuerbar.", prio: "Must", effort_pd: "5", discipline: "Engineering", depends_on: "F-004", status: "Offen"),
    (id: "F-006", system: "Vector Gear", name: "Swerve-Steuerung", description: "Richtungseingabe waehrend des Einzugs moduliert die Flugbahn seitlich, nach oben und unten. Kein binaeres Ziel-Anfliegen.", acceptance: "Vier Swerve-Richtungen aendern die Bahn messbar ohne Haken zu loesen.", prio: "Must", effort_pd: "8", discipline: "Engineering", depends_on: "F-004", status: "Offen"),
    (id: "F-007", system: "Vector Gear", name: "Gas-Boost", description: "Impuls in Blickrichtung bei gehaltener Taste, verbraucht Gas kontinuierlich. Deutliches VFX/SFX-Feedback.", acceptance: "Boost erzeugt spuerbare Beschleunigung; Gasleiste sinkt sichtbar.", prio: "Must", effort_pd: "4", discipline: "Engineering", depends_on: "F-001", status: "Offen"),
    (id: "F-008", system: "Vector Gear", name: "Boost-Dash", description: "Doppeltipp erzeugt einen kurzen, harten Impuls mit eigenem Cooldown. Anzahl der Dashes ist ein Stat.", acceptance: "Dash ist von Boost unterscheidbar; Anzahl korrekt limitiert und regeneriert.", prio: "Must", effort_pd: "4", discipline: "Engineering", depends_on: "F-007", status: "Offen"),
    (id: "F-009", system: "Vector Gear", name: "Flips (seitlich)", description: "Doppeltipp A/D erzeugt seitlichen Ausweichsprung in der Luft mit kurzen I-Frames.", acceptance: "Flip vermeidet einen Titanengriff, wenn im Fenster ausgeloest.", prio: "Must", effort_pd: "4", discipline: "Engineering", depends_on: "F-001", status: "Offen"),
    (id: "F-010", system: "Vector Gear", name: "Slide-Dodge am Boden", description: "Gleit-Ausweichmanoever am Boden mit I-Frames und Momentum-Erhalt.", acceptance: "Slide vermeidet Stomp-Angriff; geht fliessend in Sprint ueber.", prio: "Must", effort_pd: "3", discipline: "Engineering", status: "Offen"),
    (id: "F-011", system: "Vector Gear", name: "Hook-Break (Notbremse)", description: "Beide Haken nach hinten abfeuern, harte Verzoegerung. Rettungsmanoever vor Kollision.", acceptance: "Geschwindigkeit sinkt innerhalb von 0,6 s um mindestens 70 Prozent.", prio: "Should", effort_pd: "3", discipline: "Engineering", depends_on: "F-001", status: "Offen"),
    (id: "F-012", system: "Vector Gear", name: "Velocity-Clamp gegen Fling", description: "Harte Obergrenze auf AssemblyLinearVelocity bei jedem Heartbeat. Verhindert den klassischen Roblox-Physikfehler.", acceptance: "Kein Testfall erzeugt Geschwindigkeit ueber dem Cap; kein Spieler wird aus der Map geschleudert.", prio: "Must", effort_pd: "3", discipline: "Engineering", depends_on: "F-004", status: "Offen"),
    (id: "F-013", system: "Vector Gear", name: "Kollisionsdaempfung", description: "Aufprall auf Geometrie verlangsamt und staggert statt zu toeten. Recovery-Fenster mit Wandkontakt-Animation.", acceptance: "Frontalaufprall bei Hoechstgeschwindigkeit fuehrt nicht zum Tod; Erholung dauert unter 1 s.", prio: "Must", effort_pd: "6", discipline: "Engineering", depends_on: "F-004", status: "Offen"),
    (id: "F-014", system: "Vector Gear", name: "Momentum-Chaining", description: "Beim Wechsel von Haken zu Haken bleibt Geschwindigkeit erhalten. Kern-Skillausdruck des gesamten Spiels.", acceptance: "Ein geuebter Spieler kann Geschwindigkeit ueber 5 Hakenwechsel steigern statt zu verlieren.", prio: "Must", effort_pd: "10", discipline: "Engineering", depends_on: "F-004", status: "Offen"),
    (id: "F-015", system: "Vector Gear", name: "Wall-Run und Wall-Kick", description: "Kurzer Lauf an vertikalen Flaechen plus Absprung. Alternative Traversal-Ebene fuer enge Raeume.", acceptance: "Wall-Run ueber mindestens 3 s moeglich; Kick erzeugt nutzbaren Impuls.", prio: "Could", effort_pd: "7", discipline: "Engineering", depends_on: "F-013", status: "Offen"),
    (id: "F-016", system: "Vector Gear", name: "Ziel-Assist-Regler", description: "Stufenlos einstellbarer Snap-Fangwinkel von 0 bis 100 Prozent. Steuert, wie weit das Fadenkreuz von einem Ankerpunkt abweichen darf, damit der Snap greift. Bei 0 verhaelt sich das System wie reines freies Zielen. Siehe F-024 fuer die drei Zielmodi.", acceptance: "Regler wirkt messbar auf den Fangwinkel; der verwendete Wert wird bei jedem Bestenlisten-Eintrag mitgespeichert.", prio: "Should", effort_pd: "4", discipline: "Engineering / UX", depends_on: "F-024", status: "Offen"),
    (id: "F-017", system: "Vector Gear", name: "Geschwindigkeits-Feedback", description: "Speedlines, Kamera-FOV-Kurve, Windrauschen und Vignette skalieren mit Velocity. Verkauft Tempo ohne echte Physikaenderung.", acceptance: "FOV und Audio reagieren stufenlos; abschaltbar fuer Motion Sickness.", prio: "Must", effort_pd: "5", discipline: "Engineering / VFX", depends_on: "F-004", status: "Offen"),
    (id: "F-018", system: "Vector Gear", name: "Gas-Ressource", description: "Blaue Leiste, Verbrauch durch Reel-In, Boost und Dash. Bei 0 kein Fliegen mehr, nur noch Bodenbewegung.", acceptance: "Gasverbrauch pro Aktion ist in Config definiert und im HUD ablesbar.", prio: "Must", effort_pd: "3", discipline: "Engineering", depends_on: "F-007", status: "Offen"),
    (id: "F-019", system: "Vector Gear", name: "Nachschub-Stationen", description: "Statische Punkte auf der Map fuellen Gas und Klingen. Begrenzte Nachladungen pro Mission.", acceptance: "Nachladen dauert 1,5 s; Zaehler sichtbar; leere Station wird visuell markiert.", prio: "Must", effort_pd: "5", discipline: "Engineering / LD", depends_on: "F-018", status: "Offen"),
    (id: "F-020", system: "Vector Gear", name: "Tragbarer Notvorrat", description: "Verbrauchsgegenstand fuer eine Feldbetankung ohne Station, mit langer Animation als Risikofaktor.", acceptance: "Item funktioniert nur am Boden oder haengend; Animation ist unterbrechbar mit Verlust.", prio: "Could", effort_pd: "3", discipline: "Engineering", depends_on: "F-019", status: "Offen"),
    (id: "F-021", system: "Ankersystem", name: "Diskrete Ankerpunkte (Ebene 2)", description: "Zweite Ebene ueber den Ankerflaechen: konkrete, einzeln adressierbare Punkte im Level (Dachkanten, Schornsteine, Vorspruenge, Astgabeln, Laternen, Kranausleger, Titanenkoerper). Jeder Punkt traegt Metadaten: Typ, Hoehe, Ausrichtung der Normalen, Guete-Basiswert, ob dynamisch (an bewegtem Objekt) oder statisch.", acceptance: "Jede Map besitzt eine vollstaendige Ankerpunktliste; Punkte sind einzeln inspizierbar und im Editor sichtbar.", prio: "Must", effort_pd: "8", discipline: "Engineering / LD", depends_on: "F-003", status: "Offen"),
    (id: "F-022", system: "Ankersystem", name: "Prozedurale Ankerpunkt-Erzeugung", description: "Werkzeug erzeugt Ankerpunkte automatisch aus der Geometrie getaggter Flaechen (Kantenerkennung, Vorsprungerkennung, Mindestabstand zwischen Punkten). Level Designer korrigiert danach nur noch von Hand, statt tausende Punkte einzeln zu setzen.", acceptance: "Eine komplette Stadtmap wird in unter 5 Minuten mit Punkten befuellt; manuelle Nacharbeit unter 10 Prozent der Punkte.", prio: "Must", effort_pd: "10", discipline: "Tech Art / LD", depends_on: "F-021", status: "Offen"),
    (id: "F-023", system: "Ankersystem", name: "Kandidatensuche mit Hemisphaeren-Aufteilung", description: "Clientseitige Suche aller Ankerpunkte, die gleichzeitig erfuellen: innerhalb der Range-Stat-Reichweite, innerhalb des Sichtkegels (Standard 130 Grad horizontal, 90 Grad vertikal), freie Sichtlinie zum Spieler. Ergebnis wird relativ zur Kameravorwaertsachse in eine LINKE und eine RECHTE Hemisphaere geteilt. Q bedient ausschliesslich die linke Menge, E ausschliesslich die rechte.", acceptance: "Q liefert nie einen Punkt rechts der Kameraachse und umgekehrt; Sichtlinienpruefung verhindert Haken durch Waende.", prio: "Must", effort_pd: "10", discipline: "Engineering", depends_on: "F-021", status: "Offen"),
    (id: "F-024", system: "Ankersystem", name: "Snap auf Q und E", description: "Tastendruck verankert direkt am besten Kandidaten der jeweiligen Hemisphaere, ohne dass der Spieler exakt darauf zielen muss. Drei Zielmodi in den Einstellungen: FREI (kein Snap, reines Raycast), ASSISTIERT (Snap greift nur innerhalb des Fangwinkels aus F-016, Standardeinstellung), SNAP (immer bester Kandidat, maximale Zugaenglichkeit). Da das Spiel reine Maussteuerung nutzt, ist ASSISTIERT der Standard und SNAP eine bewusste Komfortoption, keine Notwendigkeit.", acceptance: "Alle drei Modi funktionieren; Moduswechsel ist ohne Neustart wirksam; der aktive Modus wird bei Bestenlisten-Eintraegen mitgespeichert und getrennt gewertet.", prio: "Must", effort_pd: "8", discipline: "Engineering / Design", depends_on: "F-023", status: "Offen"),
    (id: "F-025", system: "Ankersystem", name: "Bewertungsfunktion fuer Kandidaten", description: "Gewichtete Auswahl des besten Punktes je Hemisphaere. Faktoren: Winkelabweichung zum Fadenkreuz (Hauptgewicht 45 Prozent), Momentum-Erhalt (25 Prozent, bevorzugt Punkte, die die aktuelle Flugbahn fortsetzen statt sie zu bremsen), Hoehenvorteil relativ zur Bewegungsrichtung (15 Prozent), Distanz im nutzbaren Mittelbereich (10 Prozent), Abwertung des zuletzt genutzten Punktes (5 Prozent, verhindert Pendeln zwischen zwei Punkten). Alle Gewichte liegen in der Config und sind ohne Codeaenderung anpassbar.", acceptance: "Ein geuebter Spieler kann bei aktivem Snap eine Bahn ueber 5 Wechsel beschleunigen; das System waehlt nie einen Punkt hinter dem Spieler, wenn ein brauchbarer vor ihm liegt.", prio: "Must", effort_pd: "8", discipline: "Engineering / Design", depends_on: "F-023", status: "Offen"),
    (id: "F-026", system: "Ankersystem", name: "Highlighting der Ankerpunkte", description: "Alle gueltigen Kandidaten werden als schwache Marker im Sichtfeld eingeblendet. Die beiden aktuell besten Punkte (links und rechts) werden hervorgehoben und tragen das jeweilige Tastensymbol. Vier Zustaende, jeweils durch FORM UND Farbe unterschieden (Farbenblindheit): Kandidat (kleiner Ring), Bestes Ziel links (Ring mit Q-Symbol), Bestes Ziel rechts (Ring mit E-Symbol), Bereits verankert (gefuelltes Symbol mit Seilverbindung).", acceptance: "Ein Testspieler kann jederzeit ohne Nachdenken sagen, wohin Q und E ihn bringen wuerden.", prio: "Must", effort_pd: "8", discipline: "UI / Engineering", depends_on: "F-023", status: "Offen"),
    (id: "F-027", system: "Ankersystem", name: "Marker-Dichtebegrenzung", description: "Maximal 12 gleichzeitig sichtbare Marker, ausgewaehlt nach Bewertungsfunktion. Marker verblassen mit Distanz und werden bei hoher Punktdichte ausgeduennt, damit das Sichtfeld nicht zugemuellt wird. Deckkraft und Maximalanzahl sind in den Einstellungen regelbar, inklusive vollstaendiger Abschaltung.", acceptance: "In der dichtesten Map ueberdecken Marker nie mehr als 15 Prozent der Bildflaeche; Abschaltung funktioniert vollstaendig.", prio: "Must", effort_pd: "5", discipline: "UI / Engineering", depends_on: "F-026", status: "Offen"),
    (id: "F-028", system: "Ankersystem", name: "Fallback ohne Kandidat", description: "Existiert in der angeforderten Hemisphaere kein gueltiger Punkt, faellt das System automatisch auf freies Zielen (F-002) zurueck und feuert den Haken in Blickrichtung. Gibt es dort ebenfalls keine gueltige Flaeche, erfolgt ein Fehlversuch mit eigenem Sound und kurzer Seilrueckzugsanimation statt eines stillen Nichtereignisses.", acceptance: "Kein Tastendruck bleibt ohne Rueckmeldung; der Spieler versteht immer, warum kein Haken gesetzt wurde.", prio: "Must", effort_pd: "4", discipline: "Engineering", depends_on: "F-024", status: "Offen"),
    (id: "F-029", system: "Ankersystem", name: "Dynamische Ankerpunkte", description: "Ankerpunkte an bewegten Objekten: Titanenkoerper (Schulter, Arm, Nacken), fahrende Eskortkarren, Hafenkraene, Mauerlifte. Werden pro Frame mit dem Traegerobjekt mitgefuehrt und beim Tod oder der Zerstoerung des Traegers sauber entfernt.", acceptance: "Ein Haken an einem Titanen bleibt waehrend dessen Bewegung korrekt verankert und loest sich beim Tod des Titanen mit Feedback.", prio: "Should", effort_pd: "7", discipline: "Engineering", depends_on: "F-021", status: "Offen"),
    (id: "F-030a", system: "Ankersystem", name: "Performance der Kandidatensuche", description: "Suche laeuft rein clientseitig ohne Server-Roundtrip, mit 10 Hz Aktualisierungsrate und Interpolation der Markerpositionen dazwischen. Raeumliche Vorfilterung ueber ein Gitter statt linearer Iteration ueber alle Punkte der Map.", acceptance: "Die Suche kostet unter 0,8 ms pro Frame auf dem PC-Mindestprofil, auch bei 4000 Ankerpunkten in der Map.", prio: "Must", effort_pd: "6", discipline: "Engineering", depends_on: "F-023", status: "Offen"),
    (id: "F-031a", system: "Ankersystem", name: "Ankerpunkt-Validierung im Editor", description: "Pruefwerkzeug findet unerreichbare Punkte, Punkte ohne Sichtlinie, zu dichte Cluster, Loecher in der Abdeckung und Punkte mit falscher Normalenausrichtung. Erzeugt einen Bericht pro Map.", acceptance: "Kein Release einer Map ohne fehlerfreien Validierungsbericht.", prio: "Must", effort_pd: "6", discipline: "Tech Art / LD", depends_on: "F-022", status: "Offen"),
    (id: "F-032a", system: "Ankersystem", name: "Trainingsanzeige fuer Ankerpunkte", description: "Im Trainingsgelaende einblendbarer Modus, der ALLE Punkte einer Zone sichtbar macht, samt Bewertungswerten und der Bahn, die das System bei Q oder E waehlen wuerde. Lehrwerkzeug fuer das Verstaendnis der eigenen Traversal.", acceptance: "Ein Spieler kann nachvollziehen, warum das System einen bestimmten Punkt gewaehlt hat.", prio: "Should", effort_pd: "5", discipline: "Design / UI", depends_on: "F-025", status: "Offen"),
    (id: "F-030", system: "Kampf", name: "Nape-Trefferzone (Cortex)", description: "Separate Kollisionsgeometrie am Nacken jedes Titanen als einziger Kill-Punkt. Visuell markiert durch dampfende, leicht leuchtende Textur.", acceptance: "Cortex ist aus 100 studs Entfernung erkennbar; Treffer registriert zuverlaessig.", prio: "Must", effort_pd: "6", discipline: "Engineering / Art", status: "Offen"),
    (id: "F-031", system: "Kampf", name: "Geschwindigkeitsabhaengige Schadensformel", description: "Schaden skaliert mit relativer Anfluggeschwindigkeit und Schnittwinkel. Bewegung ist Schaden.", acceptance: "Ein Schnitt bei doppelter Geschwindigkeit erzeugt mindestens 60 Prozent mehr Schaden.", prio: "Must", effort_pd: "5", discipline: "Engineering / Design", depends_on: "F-030", status: "Offen"),
    (id: "F-032", system: "Kampf", name: "Sekundaere Trefferzonen", description: "Arme, Beine, Augen mit eigenen Hitboxen. Kein Kill, sondern Stagger, Bewegungs-Debuff oder Blendung.", acceptance: "Bein-Treffer laesst Titan stuerzen; Augen-Treffer erzeugt 3 s Orientierungslosigkeit.", prio: "Must", effort_pd: "7", discipline: "Engineering", depends_on: "F-030", status: "Offen"),
    (id: "F-033", system: "Kampf", name: "Klingenhaltbarkeit", description: "Rote Leiste, Verbrauch pro Schlag, abhaengig von getroffener Zone. Bruch mit lautem Feedback und Animation.", acceptance: "Klingenbruch entfernt Schadenspotenzial vollstaendig bis zum Nachladen.", prio: "Must", effort_pd: "4", discipline: "Engineering", depends_on: "F-030", status: "Offen"),
    (id: "F-034", system: "Kampf", name: "Hit-Stop und Impact-Frames", description: "Kurzer Zeitstopp bei Nape-Kill mit Kamera-Kick und Sound-Layer. Wichtigstes Belohnungssignal im Spiel.", acceptance: "Kill fuehlt sich in Blindtests messbar befriedigender an als ohne Hit-Stop.", prio: "Must", effort_pd: "4", discipline: "Engineering / VFX", depends_on: "F-030", status: "Offen"),
    (id: "F-035", system: "Kampf", name: "Lance Charges (Fernwaffe)", description: "Explosive Wurflanzen mit Haftung, manueller Detonation in Naehe und Auto-Detonation nach Zeit oder Distanz. Eigene Statlinie.", acceptance: "Manuelle und automatische Detonation funktionieren; Blast-Radius als Stat wirksam.", prio: "Should", effort_pd: "10", discipline: "Engineering", depends_on: "F-030", status: "Offen"),
    (id: "F-036", system: "Kampf", name: "Lance-Munition und Nachschub", description: "Begrenzte Anzahl Lanzen pro Mission, Nachschub nur an Stationen. Ammunition ist ein Stat.", acceptance: "Munitionszaehler im HUD; Nachladen an Station funktioniert.", prio: "Should", effort_pd: "3", discipline: "Engineering", depends_on: "F-035", status: "Offen"),
    (id: "F-037", system: "Kampf", name: "Kein Friendly Fire", description: "Explosionen und Klingen verursachen keinen Schaden an Mitspielern, wohl aber Knockback als taktisches Element.", acceptance: "Kein Spieler kann einen anderen toeten; Knockback ist einstellbar.", prio: "Must", effort_pd: "2", discipline: "Engineering", depends_on: "F-035", status: "Offen"),
    (id: "F-038", system: "Kampf", name: "Verletzungssystem", description: "Treffer durch Titanen koennen gestufte Verletzungen zufuegen (leicht/schwer/kritisch), die Stats senken. Sichtbar im HUD.", acceptance: "Verletzungen sind unterscheidbar, wirken auf Stats und sind im Feld temporaer behandelbar.", prio: "Should", effort_pd: "8", discipline: "Engineering / Design", depends_on: "F-032", status: "Offen"),
    (id: "F-039", system: "Kampf", name: "Feldbehandlung und Medic", description: "Verletzungen im Hub heilbar; im Feld nur temporaer stabilisierbar durch Verbandsitem oder Support-Skill.", acceptance: "Medic-NPC heilt alle Stufen; Feldverband hebt nur eine Stufe fuer begrenzte Zeit.", prio: "Should", effort_pd: "4", discipline: "Engineering", depends_on: "F-038", status: "Offen"),
    (id: "F-040", system: "Kampf", name: "Gerichteter Griff-Escape", description: "Bei Titanengriff zeigt das UI eine Richtung; Spieler muss den Haken in die Gegenrichtung schiessen. Ersetzt Button-Mashing durch eine Koennenspruefung.", acceptance: "Escape gelingt bei korrekter Richtung, scheitert bei falscher; kein Vorteil durch schnelleres Tastenhaemmern messbar.", prio: "Must", effort_pd: "6", discipline: "Engineering / UX", depends_on: "F-030", status: "Offen"),
    (id: "F-041", system: "Kampf", name: "Combo-System", description: "Aufeinanderfolgende Treffer ohne Bodenkontakt erhoehen einen Multiplikator, der bei Treffer oder Landung zurueckgesetzt wird.", acceptance: "Multiplikator sichtbar, wirkt auf Gold und Schaden, bricht korrekt ab.", prio: "Should", effort_pd: "5", discipline: "Engineering / Design", depends_on: "F-031", status: "Offen"),
    (id: "F-042", system: "Kampf", name: "Finisher-Kamera", description: "Kurze Zeitlupe beim letzten Titanen einer Welle oder bei einem Multi-Kill. Abschaltbar.", acceptance: "Ausloesebedingungen greifen; Kamera bricht bei Gefahr sofort ab.", prio: "Could", effort_pd: "5", discipline: "Engineering / VFX", depends_on: "F-034", status: "Offen"),
    (id: "F-043", system: "Kampf", name: "Schadenszahlen und Trefferfeedback", description: "Schwebende Zahlen, Trefferblitz, unterschiedliche Sounds fuer Normal/Crit/Nape. Vollstaendig abschaltbar.", acceptance: "Drei Trefferarten sind akustisch und visuell unterscheidbar.", prio: "Should", effort_pd: "3", discipline: "Engineering / UI", depends_on: "F-031", status: "Offen"),
    (id: "F-044", system: "Kampf", name: "Nahkampf am Boden", description: "Grundlegender Bodenangriff fuer Situationen ohne Gas, deutlich schwaecher als Luftangriff.", acceptance: "Bodenangriff existiert, ist aber niemals die effizientere Wahl.", prio: "Could", effort_pd: "3", discipline: "Engineering", status: "Offen"),
    (id: "F-050", system: "Titan-KI", name: "Zustandsmaschine", description: "Kern-FSM: Idle, Alerted, Pursue, Attack, Stagger, Recover, Death. Modular erweiterbar pro Typ.", acceptance: "Alle Zustaende sind im Debug-Overlay sichtbar und wechseln korrekt.", prio: "Must", effort_pd: "12", discipline: "Engineering", status: "Offen"),
    (id: "F-051", system: "Titan-KI", name: "Wahrnehmungsmodell", description: "Sichtkegel mit Reichweite und Winkel plus Hoerradius. Gas-Boost erzeugt Laerm und zieht Aufmerksamkeit.", acceptance: "Ein leise agierender Spieler wird spaeter entdeckt als ein boostender.", prio: "Should", effort_pd: "6", discipline: "Engineering", depends_on: "F-050", status: "Offen"),
    (id: "F-052", system: "Titan-KI", name: "Pathfinding mit Groessenlogik", description: "Navigation um Gebaeude; grosse Titanen laufen durch kleine Hindernisse hindurch statt sie zu umgehen.", acceptance: "15m-Titan zerstoert kleine Props, 3m-Titan umgeht sie.", prio: "Must", effort_pd: "8", discipline: "Engineering", depends_on: "F-050", status: "Offen"),
    (id: "F-053", system: "Titan-KI", name: "Telegraphierte Angriffe", description: "Jede Attacke besitzt eine lesbare Windup-Phase von mindestens 0,4 s mit eindeutiger Silhouette.", acceptance: "Testspieler koennen nach 10 Minuten alle Angriffe vorhersehen.", prio: "Must", effort_pd: "6", discipline: "Engineering / Animation", depends_on: "F-050", status: "Offen"),
    (id: "F-054", system: "Titan-KI", name: "KI-Level-of-Detail", description: "Nahe Titanen ticken mit 20 Hz, entfernte mit 5 Hz, sehr entfernte nur als Positionsinterpolation.", acceptance: "60 aktive Titanen erzeugen unter 8 ms Serverlast pro Frame.", prio: "Must", effort_pd: "7", discipline: "Engineering", depends_on: "F-050", status: "Offen"),
    (id: "F-055", system: "Titan-KI", name: "Gruppendynamik", description: "Titanen umkreisen den Spieler statt sich zu stapeln; sie beanspruchen Positionsslots um das Ziel.", acceptance: "Bei 6 Titanen auf einen Spieler stehen keine zwei in derselben Position.", prio: "Should", effort_pd: "6", discipline: "Engineering", depends_on: "F-052", status: "Offen"),
    (id: "F-056", system: "Titan-KI", name: "Gegnertyp: Husk (Standard)", description: "Basistyp. Langsam, gerade Verfolgung, Standardangriffe. 70 Prozent aller Spawns auf niedrigen Schwierigkeiten.", acceptance: "Spawnt korrekt, greift korrekt an, stirbt bei Cortex-Treffer.", prio: "Must", effort_pd: "5", discipline: "Design / Engineering", depends_on: "F-050", status: "Offen"),
    (id: "F-057", system: "Titan-KI", name: "Gegnertyp: Errant (Abnormal)", description: "Unberechenbar, deutlich schneller, ignoriert Naherfolgung zugunsten von Distanzsprints. Zusatzangriffe Bellyflop und Kick.", acceptance: "Verhalten ist sichtbar anders als Husk; Zusatzangriffe werden ausgeloest.", prio: "Must", effort_pd: "6", discipline: "Design / Engineering", depends_on: "F-056", status: "Offen"),
    (id: "F-058", system: "Titan-KI", name: "Gegnertyp: Scuttler (Crawler)", description: "Bewegt sich vierfuessig, sehr hohe Geschwindigkeit, reduzierte HP, Dive-Attacke im Sprung. Eigenes Rig.", acceptance: "Scuttler ist die schnellste Bodeneinheit; Dive trifft vorhersagbar.", prio: "Must", effort_pd: "8", discipline: "Design / Engineering", depends_on: "F-050", status: "Offen"),
    (id: "F-059", system: "Titan-KI", name: "Gegnertyp: Weaver (Ducker)", description: "Reagiert auf Annaeherung an den Cortex mit Rueckwaertsrolle und I-Frames nach dem Startup. Bestraft mechanisches Spam.", acceptance: "Rolle hat lesbares Startup, danach garantierte Unverwundbarkeit fuer definierte Dauer.", prio: "Must", effort_pd: "7", discipline: "Design / Engineering", depends_on: "F-050", status: "Offen"),
    (id: "F-060", system: "Titan-KI", name: "Gegnertyp: Warden", description: "Schuetzt den eigenen Cortex aktiv mit der Hand. Muss von vorne gestaggert oder an den Armen verwundet werden, bevor der Nacken frei liegt.", acceptance: "Frontalangriff auf Arme oeffnet den Cortex fuer ein Zeitfenster.", prio: "Should", effort_pd: "8", discipline: "Design / Engineering", depends_on: "F-032", status: "Offen"),
    (id: "F-061", system: "Titan-KI", name: "Gegnertyp: Lurker", description: "Ambush-Einheit. Kauert bewegungslos, greift erst bei Naehe an, kann Spieler aus der Luft greifen. Erzwingt Hoehenwechsel.", acceptance: "Lurker ist im Ruhezustand schwer von Umgebungsgeometrie zu unterscheiden.", prio: "Should", effort_pd: "8", discipline: "Design / Engineering", depends_on: "F-051", status: "Offen"),
    (id: "F-062", system: "Titan-KI", name: "Gegnertyp: Bellower", description: "Reagiert extrem auf Gas-Geraeusche und ruft andere Titanen herbei. Fuegt eine Stealth-Ebene hinzu.", acceptance: "Ruf zieht alle Titanen im Radius an; leises Spiel vermeidet den Ruf.", prio: "Should", effort_pd: "6", discipline: "Design / Engineering", depends_on: "F-051", status: "Offen"),
    (id: "F-063", system: "Titan-KI", name: "Gegnertyp: Chorus (Paar)", description: "Spawnt immer zu zweit und deckt gegenseitig den Cortex. Erfordert Fokusreihenfolge oder Trennung.", acceptance: "Ein Chorus-Titan blockt Angriffe auf seinen Partner, solange beide leben.", prio: "Could", effort_pd: "7", discipline: "Design / Engineering", depends_on: "F-055", status: "Offen"),
    (id: "F-064", system: "Titan-KI", name: "Groessenklassen", description: "Drei Groessenstufen (3m, 7m, 15m) mit angepassten Hitboxen, Reichweiten, HP und Attacken.", acceptance: "Alle drei Klassen erfordern unterschiedliche Anflugwinkel.", prio: "Must", effort_pd: "6", discipline: "Design / Engineering", depends_on: "F-050", status: "Offen"),
    (id: "F-065", system: "Titan-KI", name: "Spawn-Budget-System", description: "Direktor-System begrenzt gleichzeitige Titanen nach Serverlast und Spielerzahl und waehlt Typen nach Gewichtung pro Schwierigkeit.", acceptance: "Kein Server ueberschreitet das Budget; Typenverteilung entspricht der Config.", prio: "Must", effort_pd: "7", discipline: "Engineering", depends_on: "F-054", status: "Offen"),
    (id: "F-066", system: "Titan-KI", name: "Object Pooling", description: "Titanen werden wiederverwendet statt neu erzeugt. Gilt auch fuer Projektile und VFX.", acceptance: "Kein messbarer Frame-Spike beim Spawn einer Welle.", prio: "Must", effort_pd: "5", discipline: "Engineering", depends_on: "F-065", status: "Offen"),
    (id: "F-070", system: "Missionen", name: "Missions-Zustandsmaschine", description: "Generischer Ablauf: Briefing, Deployment, aktive Phase, Zielabschluss, Extraktion, Ergebnis.", acceptance: "Alle Modi nutzen dieselbe Basismaschine; neue Modi sind reine Config.", prio: "Must", effort_pd: "10", discipline: "Engineering", status: "Offen"),
    (id: "F-071", system: "Missionen", name: "Modus: Skirmish", description: "Offene Feldschlacht. Toete eine Zielanzahl Titanen innerhalb eines Zeitlimits, ohne dass zu viele NPC-Zivilisten sterben.", acceptance: "Ziel- und Fehlbedingungen greifen; Fortschritt ist im HUD sichtbar.", prio: "Must", effort_pd: "6", discipline: "Design / Engineering", depends_on: "F-070", status: "Offen"),
    (id: "F-072", system: "Missionen", name: "Modus: Breach (Verteidigung)", description: "Halte eine Position gegen anrollende Wellen, waehrend eine Struktur Schaden nimmt. Verlust der Struktur = Fehlschlag.", acceptance: "Struktur-HP sichtbar; Wellen eskalieren nach Kurve.", prio: "Must", effort_pd: "7", discipline: "Design / Engineering", depends_on: "F-070", status: "Offen"),
    (id: "F-073", system: "Missionen", name: "Modus: Escort", description: "Begleite bewegliche Karren entlang einer Route zum Sicherheitspunkt. Karren sind zerstoerbar.", acceptance: "Karren bewegen sich auf Pfad; Verlust aller Karren beendet die Mission.", prio: "Must", effort_pd: "8", discipline: "Design / Engineering", depends_on: "F-070", status: "Offen"),
    (id: "F-074", system: "Missionen", name: "Modus: Stall (Ueberleben)", description: "Ueberlebe eine feste Dauer gegen eskalierende Uebermacht. Kein Kill-Ziel, reine Ausweichpruefung.", acceptance: "Timer laeuft, Spawnrate steigt, Fehlschlag kostet Streak.", prio: "Should", effort_pd: "5", discipline: "Design / Engineering", depends_on: "F-070", status: "Offen"),
    (id: "F-075", system: "Missionen", name: "Modus: Protect", description: "Schuetze ein bewegliches, nicht steuerbares NPC-Ziel, das eine Aufgabe erledigt. Ziel hat eigene HP-Leiste.", acceptance: "Ziel-HP sichtbar; Titanen priorisieren das Ziel ueber Spieler.", prio: "Should", effort_pd: "6", discipline: "Design / Engineering", depends_on: "F-070", status: "Offen"),
    (id: "F-076", system: "Missionen", name: "Modus: Reclaim (neu)", description: "Erobere und halte drei Kontrollpunkte nacheinander. Punkte erfordern Anwesenheit und Titanfreiheit im Radius.", acceptance: "Eroberung laeuft nur bei geraeumtem Radius; Rueckeroberung durch Titanen moeglich.", prio: "Should", effort_pd: "7", discipline: "Design / Engineering", depends_on: "F-070", status: "Offen"),
    (id: "F-077", system: "Missionen", name: "Modus: Traversal Trial (neu)", description: "Reiner Bewegungsmodus. Zeitrennen ueber Checkpoints ohne Kampf, mit Geister-Replay und Bestenliste.", acceptance: "Zeiten werden persistiert; Geist eines besseren Laufs ist abspielbar.", prio: "Should", effort_pd: "9", discipline: "Design / Engineering", depends_on: "F-014", status: "Offen"),
    (id: "F-078", system: "Missionen", name: "Randomizer", description: "Zufaellig kombinierte Zielsets aus dem Pool aller Modi. Hoehere Belohnung durch Unvorhersehbarkeit.", acceptance: "Kombinationen sind valide und niemals unmoeglich.", prio: "Should", effort_pd: "5", discipline: "Design / Engineering", depends_on: "F-070", status: "Offen"),
    (id: "F-079", system: "Missionen", name: "Sekundaerziele", description: "Zufaellig zugewiesenes optionales Zusatzziel pro Einsatz. Bonusbelohnung bei Abschluss.", acceptance: "Mindestens 8 verschiedene Sekundaerziele; Chance skaliert mit Schwierigkeit.", prio: "Should", effort_pd: "6", discipline: "Design / Engineering", depends_on: "F-070", status: "Offen"),
    (id: "F-080", system: "Missionen", name: "Schwierigkeitsgrade", description: "Fuenf Stufen mit skalierenden Titanenzahlen, HP, Typenverteilung und Belohnungen. Gating ueber Ausruestungsrang.", acceptance: "Jede Stufe ist als Config-Datei definiert; Sprung zwischen Stufen ist spuerbar.", prio: "Must", effort_pd: "5", discipline: "Design", depends_on: "F-070", status: "Offen"),
    (id: "F-081", system: "Missionen", name: "Modifikatoren (Mutatoren)", description: "Optional zuschaltbare Erschwernisse fuer erhoehte Belohnung: Nebel, kein Nachschub, doppelte Scuttler, Nacht, Regen mit reduzierter Haftung.", acceptance: "Mindestens 10 Modifikatoren, stapelbar, Belohnungsmultiplikator korrekt berechnet.", prio: "Should", effort_pd: "8", discipline: "Design / Engineering", depends_on: "F-080", status: "Offen"),
    (id: "F-082", system: "Missionen", name: "Spielerzahl-Skalierung", description: "Titananzahl, Boss-HP und Zielwerte skalieren mit der Spielerzahl im Server. Solo ist vollstaendig spielbar.", acceptance: "Solo-Clear-Zeit weicht um weniger als 25 Prozent von Gruppen-Clear-Zeit ab.", prio: "Must", effort_pd: "5", discipline: "Design / Engineering", depends_on: "F-080", status: "Offen"),
    (id: "F-083", system: "Missionen", name: "Killstreak-System", description: "Aufeinanderfolgende erfolgreiche Missionen erhoehen einen Belohnungsmultiplikator, der bei Fehlschlag zurueckgesetzt wird.", acceptance: "Streak persistiert ueber Sessions; Verlustbedingung ist vor Missionsstart klar kommuniziert.", prio: "Could", effort_pd: "4", discipline: "Design / Engineering", depends_on: "F-070", status: "Offen"),
    (id: "F-084", system: "Missionen", name: "Extraktionsphase", description: "Nach Zielabschluss muss der Spieler zu einem Extraktionspunkt zurueck. Optional, gibt Bonus, erzeugt Spannungsbogen.", acceptance: "Extraktion ist ueberspringbar mit Belohnungsabschlag.", prio: "Could", effort_pd: "4", discipline: "Design / Engineering", depends_on: "F-070", status: "Offen"),
    (id: "F-085", system: "Missionen", name: "Post-Match-Auswertung", description: "Detaillierte Aufschluesselung: Kills nach Typ, Genauigkeit, Durchschnittsgeschwindigkeit, hoechste Combo, Beitragsanteil, Belohnungen.", acceptance: "Alle Werte werden serverseitig getrackt und korrekt angezeigt.", prio: "Should", effort_pd: "6", discipline: "Engineering / UI", depends_on: "F-070", status: "Offen"),
    (id: "F-090", system: "Raids", name: "Raid-Framework", description: "Mehrphasige Bosskaempfe mit HP-Gates, Phasenuebergaengen, Cutscene-Slots und Wipe-Recovery.", acceptance: "Phasenwechsel funktionieren; Wipe setzt auf Phasenanfang zurueck statt auf Missionsanfang.", prio: "Should", effort_pd: "14", discipline: "Engineering", depends_on: "F-070", status: "Offen"),
    (id: "F-091", system: "Raids", name: "Boss: The Bound One", description: "Erster Raid. Phase 1 Schutzauftrag, Phase 2 direkter Kampf, Phase 3 Raserei mit HP-Wiederherstellung und erhoehtem Tempo.", acceptance: "Alle drei Phasen sind mechanisch unterschiedlich, nicht nur statistisch.", prio: "Should", effort_pd: "12", discipline: "Design / Engineering", depends_on: "F-090", status: "Offen"),
    (id: "F-092", system: "Raids", name: "Boss: The Dancer", description: "Beweglicher Boss mit Schwachstellen am gesamten Koerper statt nur am Cortex. Belohnt Praezision statt Rohschaden.", acceptance: "Mindestens 4 rotierende Schwachpunkte; Fokus auf einen einzigen ist ineffizient.", prio: "Should", effort_pd: "12", discipline: "Design / Engineering", depends_on: "F-090", status: "Offen"),
    (id: "F-093", system: "Raids", name: "Boss: The Bulwark", description: "Gepanzerter Boss. Panzerung muss durch Lance Charges oder Umgebungsobjekte gebrochen werden, bevor Klingen wirken.", acceptance: "Klingenschaden ist vor Panzerbruch nahezu null; Bruch ist visuell eindeutig.", prio: "Should", effort_pd: "12", discipline: "Design / Engineering", depends_on: "F-035", status: "Offen"),
    (id: "F-094", system: "Raids", name: "Boss: The Ashwalker", description: "Riesenboss. Phase 1 nur durch Umgebungswaffen (Mauerkanonen) bekaempfbar bei gleichzeitigem Schutzauftrag. Phase 2 klassischer Kampf.", acceptance: "Phase 1 ist ohne Kanonen nicht gewinnbar; Phase 2 wechselt vollstaendig die Anforderung.", prio: "Should", effort_pd: "16", discipline: "Design / Engineering", depends_on: "F-090", status: "Offen"),
    (id: "F-095", system: "Raids", name: "Umgebungswaffen", description: "Bedienbare Kanonen, Ballisten und Fallen auf Raid-Maps. Erfordern Positionierung und Nachladen.", acceptance: "Waffen sind von mehreren Spielern gleichzeitig nutzbar; Zielen ist manuell.", prio: "Should", effort_pd: "8", discipline: "Engineering / LD", depends_on: "F-094", status: "Offen"),
    (id: "F-096", system: "Raids", name: "Beitragsschwelle (Credit)", description: "Spieler muessen einen Mindestanteil am Kampf leisten, um Beute zu erhalten. Fortschritt sichtbar waehrend des Kampfes.", acceptance: "Untaetige Spieler erhalten keine Beute; Schwelle ist im HUD ablesbar.", prio: "Should", effort_pd: "4", discipline: "Engineering", depends_on: "F-090", status: "Offen"),
    (id: "F-097", system: "Raids", name: "Raid-Matchmaking", description: "Warteschlange fuer 8 bis 10 Spieler mit Rang-Anforderung, plus Privatgruppen-Option.", acceptance: "Queue fuellt sich serveruebergreifend ueber MemoryStoreService.", prio: "Should", effort_pd: "9", discipline: "Engineering", depends_on: "F-090", status: "Offen"),
    (id: "F-098", system: "Raids", name: "Beutetruhen mit Schluesselstufen", description: "Basistruhe frei, Premiumtruhe mit Schluessel und verdoppelten Raten. Schluessel aus Wochenzielen, nicht aus dem Shop.", acceptance: "Schluessel sind ausschliesslich durch Spielen erhaeltlich.", prio: "Should", effort_pd: "5", discipline: "Design / Engineering", depends_on: "F-096", status: "Offen"),
    (id: "F-099", system: "Raids", name: "Aufstiegs-Modus (Ascension)", description: "Wochentlich rotierende Raid-Variante mit fixen Modifikatoren und eigener Bestenliste.", acceptance: "Rotation laeuft automatisch; Bestenliste wird woechentlich zurueckgesetzt und archiviert.", prio: "Could", effort_pd: "7", discipline: "Design / Engineering", depends_on: "F-090", status: "Offen"),
    (id: "F-105", system: "Vessel Form", name: "Bonding-System", description: "Ausgeruestetes Ichor-Vial plus freigeschaltete Faehigkeit erlaubt die Verwandlung. Ladeleiste fuellt sich durch Kampfleistung.", acceptance: "Leiste laedt nachvollziehbar; Verwandlung nur bei voller Leiste moeglich.", prio: "Should", effort_pd: "10", discipline: "Engineering / Design", depends_on: "F-030", status: "Offen"),
    (id: "F-106", system: "Vessel Form", name: "Zeitlimit und Eject", description: "Verwandlung ist zeitlich begrenzt; vorzeitiges Ausklinken gibt einen Teil der Ladung zurueck.", acceptance: "Timer sichtbar; Eject funktioniert jederzeit und positioniert den Spieler sicher.", prio: "Should", effort_pd: "5", discipline: "Engineering", depends_on: "F-105", status: "Offen"),
    (id: "F-107", system: "Vessel Form", name: "Eigenstaendiges Moveset", description: "Kein vergroesserter Spieler: eigene Nahkampfcombos, Griff, Wurf, Bruell-Fertigkeit, Sprint mit Rammschaden.", acceptance: "Mindestens 8 einzigartige Aktionen pro Form; Vector Gear ist waehrenddessen deaktiviert.", prio: "Should", effort_pd: "14", discipline: "Design / Engineering", depends_on: "F-105", status: "Offen"),
    (id: "F-108", system: "Vessel Form", name: "Form: Warbound (Angriff)", description: "Ausgewogene Kampfform mit hohem Schaden, Regeneration und einer Raserei-Faehigkeit bei niedriger HP.", acceptance: "Form ist spielbar und unterscheidet sich klar von allen anderen.", prio: "Should", effort_pd: "10", discipline: "Design / Engineering", depends_on: "F-107", status: "Offen"),
    (id: "F-109", system: "Vessel Form", name: "Form: Bladewright (Technik)", description: "Schnelle, praezise Form mit Konterfenstern und Kombo-Zustand, der bei perfekter Kette Bonusschaden gibt.", acceptance: "Kombozustand ist erreichbar und sichtbar; Konter funktioniert gegen definierte Angriffe.", prio: "Could", effort_pd: "10", discipline: "Design / Engineering", depends_on: "F-107", status: "Offen"),
    (id: "F-110", system: "Vessel Form", name: "Form: Bulwark (Panzer)", description: "Langsame, gepanzerte Form mit Schadensreduktion, Ansturm und Flaechen-Erschuetterung.", acceptance: "Form haelt messbar mehr aus und ist deutlich langsamer.", prio: "Could", effort_pd: "10", discipline: "Design / Engineering", depends_on: "F-107", status: "Offen"),
    (id: "F-111", system: "Vessel Form", name: "Form: Colossus (Belagerung)", description: "Extrem grosse, unbewegliche Form mit Flaechenschaden und Umgebungszerstoerung, sehr kurze Dauer.", acceptance: "Form kann Geometrie beschaedigen; Dauer unter 30 s.", prio: "Could", effort_pd: "12", discipline: "Design / Engineering", depends_on: "F-107", status: "Offen"),
    (id: "F-112", system: "Vessel Form", name: "Form-Progression", description: "Pro Form eigener Faehigkeitenbaum mit Stufen 0 bis 10, gesteigert durch Nutzung statt durch Waehrung.", acceptance: "Nutzung erzeugt Fortschritt; kein Kauf noetig.", prio: "Could", effort_pd: "8", discipline: "Design / Engineering", depends_on: "F-107", status: "Offen"),
    (id: "F-113", system: "Vessel Form", name: "Gegner-Anpassung", description: "Titanen wechseln gegen eine Vessel Form ihr Verhalten: Gruppenangriffe, Klettern, Cortex-Angriffe.", acceptance: "KI reagiert sichtbar anders auf verwandelte Spieler.", prio: "Should", effort_pd: "6", discipline: "Engineering", depends_on: "F-107", status: "Offen"),
    (id: "F-120", system: "Progression", name: "Level und Erfahrungskurve", description: "Level 1 bis 100 mit definierter XP-Kurve. Jedes Level gibt Faehigkeitspunkte.", acceptance: "Kurve ist in Config definiert und ohne Codeaenderung anpassbar.", prio: "Must", effort_pd: "4", discipline: "Design / Engineering", status: "Offen"),
    (id: "F-121", system: "Progression", name: "Ausruestungsrang", description: "Rangstufen E bis S als Gate fuer Schwierigkeiten und Raids. Steigt durch Ausruestungsverbesserung.", acceptance: "Rang wird korrekt berechnet und gated korrekt.", prio: "Must", effort_pd: "5", discipline: "Design / Engineering", depends_on: "F-122", status: "Offen"),
    (id: "F-122", system: "Progression", name: "Ausruestungs-Upgrades mit Budget", description: "Statt 8 unabhaengiger Statleitern ein gemeinsames Punktebudget mit Zielkonflikten: Tempo kostet Kontrolle, Schaden kostet Haltbarkeit.", acceptance: "Es existiert kein dominanter Build; mindestens 4 Builds sind innerhalb 10 Prozent gleich stark.", prio: "Must", effort_pd: "10", discipline: "Design / Engineering", depends_on: "F-120", status: "Offen"),
    (id: "F-123", system: "Progression", name: "Faehigkeitenbaum", description: "Vier Aeste (Offensive, Defensive, Unterstuetzung, Traversal) mit exklusiven Knoten, die echte Entscheidungen erzwingen.", acceptance: "Mindestens 12 Knoten sind gegenseitig exklusiv; nicht alles ist gleichzeitig freischaltbar.", prio: "Must", effort_pd: "12", discipline: "Design / Engineering", depends_on: "F-120", status: "Offen"),
    (id: "F-124", system: "Progression", name: "Kostenloser Respec", description: "Faehigkeitspunkte lassen sich mindestens einmal taeglich kostenlos neu verteilen.", acceptance: "Respec ist ohne Waehrung nutzbar und im UI prominent.", prio: "Must", effort_pd: "3", discipline: "Engineering", depends_on: "F-123", status: "Offen"),
    (id: "F-125", system: "Progression", name: "Loadout-Speicher", description: "Mindestens fuenf frei benennbare Ausruestungs-Profile, kostenlos fuer alle Spieler.", acceptance: "Wechsel zwischen Profilen dauert unter 1 s und ist im Hub jederzeit moeglich.", prio: "Must", effort_pd: "5", discipline: "Engineering / UI", depends_on: "F-123", status: "Offen"),
    (id: "F-126", system: "Progression", name: "Perk-System", description: "Vier gleichzeitig ausruestbare Perks in drei Kategorien. Fokus auf Synergien und Verhaltensaenderungen statt reiner Prozentwerte.", acceptance: "Mindestens 40 Perks zu Release; mindestens 15 aendern Spielverhalten statt nur Zahlen.", prio: "Must", effort_pd: "10", discipline: "Design / Engineering", depends_on: "F-123", status: "Offen"),
    (id: "F-127", system: "Progression", name: "Lineage-System (Familien)", description: "Herkunftslinien mit aktiven Faehigkeiten. Jede Linie hat mindestens eine aktive Faehigkeit; es gibt keine leeren Linien.", acceptance: "Kein Spieler kann eine Linie ohne Faehigkeit erhalten.", prio: "Should", effort_pd: "10", discipline: "Design / Engineering", depends_on: "F-126", status: "Offen"),
    (id: "F-128", system: "Progression", name: "Pity-System fuer Lineages", description: "Garantierte Seltenheitsstufen nach definierter Anzahl Ziehungen. Zaehler ist jederzeit sichtbar.", acceptance: "Garantie greift exakt; Zaehler wird persistent gespeichert.", prio: "Must", effort_pd: "5", discipline: "Design / Engineering", depends_on: "F-127", status: "Offen"),
    (id: "F-129", system: "Progression", name: "Deterministischer Ichor-Pfad", description: "Vessel-Vials sind zusaetzlich ueber eine Raid-Waehrung garantiert erwerbbar. Zufallsdrop bleibt als Abkuerzung.", acceptance: "Ein Spieler erreicht das Ziel nach definierter Anzahl Clears garantiert.", prio: "Should", effort_pd: "6", discipline: "Design / Engineering", depends_on: "F-105", status: "Offen"),
    (id: "F-130", system: "Progression", name: "Artefakte mit Substats", description: "Permanente Ausruestungsstuecke aus Raids und Erfolgen mit rerollbaren Nebenwerten und Sperrfunktion.", acceptance: "Reroll und Sperre funktionieren; Kosten sind transparent.", prio: "Could", effort_pd: "9", discipline: "Design / Engineering", depends_on: "F-126", status: "Offen"),
    (id: "F-131", system: "Progression", name: "Ascension (Prestige-Ersatz)", description: "Zuruecksetzung nur der Build-Entscheidungen bei erweitertem Punktebudget. Mechanische Faehigkeiten und Ausruestungsraenge bleiben erhalten.", acceptance: "Spieler wird nach Ascension nicht schwaecher, sondern flexibler.", prio: "Should", effort_pd: "8", discipline: "Design / Engineering", depends_on: "F-122", status: "Offen"),
    (id: "F-132", system: "Progression", name: "Memories (Ascension-Talente)", description: "Pro Ascension ein permanentes Talent aus drei Vorschlaegen. Neuwurf ueber Spielwaehrung, nicht ueber Echtgeld.", acceptance: "Talente sind persistent; Auswahl ist rueckgaengig machbar bis zur Bestaetigung.", prio: "Could", effort_pd: "6", discipline: "Design / Engineering", depends_on: "F-131", status: "Offen"),
    (id: "F-133", system: "Progression", name: "Erfolge und Meilensteine", description: "Strukturierte Erfolgsliste mit Kategorien, Fortschrittsanzeige und Belohnungen (Waehrung, Kosmetik, Titel).", acceptance: "Mindestens 120 Erfolge; alle mit sichtbarem Fortschritt.", prio: "Should", effort_pd: "7", discipline: "Design / Engineering", status: "Offen"),
    (id: "F-134", system: "Progression", name: "Kompendium", description: "Im Spiel einsehbare Datenbank: alle Formeln, Drop-Raten, Pity-Zaehler, Gegnerverhalten, Statwirkungen.", acceptance: "Kein Spieler muss ein externes Wiki oeffnen, um eine Zahl zu erfahren.", prio: "Should", effort_pd: "8", discipline: "Design / UI", depends_on: "F-126", status: "Offen"),
    (id: "F-135", system: "Progression", name: "Build-Simulator im Hub", description: "Rechnerische Vorschau auf Schaden, Time-to-Kill und Traversal-Werte, ohne Ressourcen auszugeben.", acceptance: "Vorschauwerte stimmen mit der Praxis auf 5 Prozent genau ueberein.", prio: "Should", effort_pd: "8", discipline: "Engineering / UI", depends_on: "F-134", status: "Offen"),
    (id: "F-140", system: "Oekonomie", name: "Zwei Waehrungen", description: "Weiche Waehrung (Mark) aus Missionen, harte Waehrung (Sigil) aus Erfolgen und Wochenzielen. Keine dritte Waehrung.", acceptance: "Nur zwei Waehrungen existieren im gesamten Spiel.", prio: "Must", effort_pd: "4", discipline: "Design / Engineering", status: "Offen"),
    (id: "F-141", system: "Oekonomie", name: "Serverseitige Beutetabellen", description: "Alle Drops werden ausschliesslich auf dem Server bestimmt. Client erfaehrt nur das Ergebnis.", acceptance: "Kein Client-Eingriff kann Drops beeinflussen.", prio: "Must", effort_pd: "6", discipline: "Engineering", depends_on: "F-140", status: "Offen"),
    (id: "F-142", system: "Oekonomie", name: "Pity-Zaehler fuer alle Seltenheiten", description: "Garantien ab Seltenheitsstufe Episch aufwaerts, pro Quelle getrennt gefuehrt und sichtbar.", acceptance: "Zaehler werden persistiert und im Kompendium angezeigt.", prio: "Must", effort_pd: "5", discipline: "Design / Engineering", depends_on: "F-141", status: "Offen"),
    (id: "F-143", system: "Oekonomie", name: "Transparente Drop-Raten", description: "Alle Wahrscheinlichkeiten sind im Spiel einsehbar, inklusive Wirkung des Glueckswerts.", acceptance: "Angezeigte Rate stimmt mit der tatsaechlichen Rate ueberein (Testabgleich ueber 10000 Rolls).", prio: "Should", effort_pd: "4", discipline: "Design / Engineering", depends_on: "F-134", status: "Offen"),
    (id: "F-144", system: "Oekonomie", name: "Glueckswert (Luck)", description: "Modifikator auf Drop-Raten mit dokumentierter, linearer Formel. Keine versteckten Multiplikatoren.", acceptance: "Formel ist im Kompendium einsehbar und im Code identisch.", prio: "Should", effort_pd: "3", discipline: "Design / Engineering", depends_on: "F-143", status: "Offen"),
    (id: "F-145", system: "Oekonomie", name: "Automatischer Verkauf und Filter", description: "Regelbasierter Auto-Verkauf nach Seltenheit und Typ, kostenlos fuer alle.", acceptance: "Filter funktioniert; kein Gamepass erforderlich.", prio: "Must", effort_pd: "5", discipline: "Engineering / UI", depends_on: "F-140", status: "Offen"),
    (id: "F-146", system: "Oekonomie", name: "Waehrungssenken", description: "Kosmetik, Neuwuerfe, Reparatur, Wochenkontingente. Keine Sackgasse, in der Waehrung wertlos wird.", acceptance: "Auch ein Maximalspieler hat sinnvolle Ausgabemoeglichkeiten.", prio: "Should", effort_pd: "5", discipline: "Design", depends_on: "F-140", status: "Offen"),
    (id: "F-147", system: "Oekonomie", name: "Handelssystem", description: "Spielerhandel mit Steuer, Bestaetigungs-Countdown, vollstaendigem Handelsprotokoll und Rueckverfolgbarkeit.", acceptance: "Kein Handel ist ohne beidseitige Bestaetigung abschliessbar; jeder Handel ist geloggt.", prio: "Could", effort_pd: "12", discipline: "Engineering", depends_on: "F-141", status: "Offen"),
    (id: "F-148", system: "Oekonomie", name: "Wochenkontingente statt AFK", description: "Belohnungen ueber taegliche und woechentliche Ziele statt ueber passives Herumstehen.", acceptance: "Kein Vorteil durch Inaktivitaet im Spiel messbar.", prio: "Should", effort_pd: "5", discipline: "Design / Engineering", depends_on: "F-140", status: "Offen"),
    (id: "F-150", system: "Mehrspieler", name: "Sitzungsmodell", description: "Jede Mission und jeder Raid laeuft in einer eigenen reservierten Serverinstanz. Der Hub ist ein persistenter Treffpunkt, die Einsatzinstanz ist kurzlebig und wird nach Abschluss aufgeloest.", acceptance: "Eine Instanz startet, laeuft und wird sauber abgebaut, ohne Spieler in einem toten Server zuruecklassen.", prio: "Must", effort_pd: "8", discipline: "Engineering", depends_on: "F-070", status: "Offen"),
    (id: "F-151", system: "Mehrspieler", name: "Serverkapazitaet", description: "Zielwerte: 20 Spieler pro Missionsinstanz, 10 pro Raidinstanz, 40 im Hub. Kapazitaet ist per Config je Modus einstellbar.", acceptance: "Alle drei Kapazitaeten laufen im Lasttest bei 60 FPS auf dem PC-Mindestprofil.", prio: "Must", effort_pd: "5", discipline: "Engineering", depends_on: "F-150", status: "Offen"),
    (id: "F-152", system: "Mehrspieler", name: "Schnellsuche (Quick Play)", description: "Ein-Klick-Einstieg: das System sucht eine passende laufende oder startende Instanz nach Modus, Schwierigkeit und Ausruestungsrang.", acceptance: "Ein Alleinspieler landet in unter 20 Sekunden in einer passenden Instanz.", prio: "Must", effort_pd: "8", discipline: "Engineering", depends_on: "F-150", status: "Offen"),
    (id: "F-153", system: "Mehrspieler", name: "Instanz-Browser", description: "Manuelle Auswahl laufender Instanzen mit Filter nach Map, Modus, Schwierigkeit, Modifikatoren, Spielerzahl und Freundesbeteiligung. Fuer Spieler, die nicht dem Automatismus folgen wollen.", acceptance: "Filter kombinierbar; Liste aktualisiert sich alle 5 Sekunden ohne Ruckler.", prio: "Should", effort_pd: "9", discipline: "Engineering / UI", depends_on: "F-152", status: "Offen"),
    (id: "F-154", system: "Mehrspieler", name: "Beitritt waehrend des Einsatzes", description: "Spieler koennen laufenden Missionen beitreten, solange das Hauptziel nicht in der Endphase ist. Raids sind nach Phasenbeginn geschlossen.", acceptance: "Beitritt setzt Ziele und Wellenzaehler korrekt fuer den neuen Spieler; keine Doppelbelohnung.", prio: "Should", effort_pd: "8", discipline: "Engineering", depends_on: "F-150", status: "Offen"),
    (id: "F-155", system: "Mehrspieler", name: "Gruppensystem", description: "Gruppen bis 10 Spieler, persistent ueber Place-Wechsel hinweg. Einladung ueber Freundesliste, Namenssuche oder Beitrittscode.", acceptance: "Gruppe bleibt beim Teleport zwischen Maps vollstaendig zusammen; kein Mitglied landet in einer fremden Instanz.", prio: "Must", effort_pd: "10", discipline: "Engineering", depends_on: "F-150", status: "Offen"),
    (id: "F-156a", system: "Mehrspieler", name: "Gruppenleiter-Rechte", description: "Der Leiter waehlt Map, Modus, Schwierigkeit und Modifikatoren; Mitglieder sehen die Auswahl live. Leitung ist uebertragbar und faellt bei Verlassen automatisch weiter.", acceptance: "Wechsel der Leitung funktioniert im laufenden Betrieb ohne Gruppenaufloesung.", prio: "Must", effort_pd: "5", discipline: "Engineering / UI", depends_on: "F-155", status: "Offen"),
    (id: "F-157a", system: "Mehrspieler", name: "Bereitschaftspruefung", description: "Vor dem Start bestaetigt jedes Mitglied die Bereitschaft. Zeitueberschreitung setzt den Spieler auf nicht bereit statt die Gruppe zu blockieren.", acceptance: "Kein Einsatz startet mit einem unbestaetigten Mitglied; Zeitueberschreitung blockiert nie dauerhaft.", prio: "Should", effort_pd: "4", discipline: "Engineering / UI", depends_on: "F-155", status: "Offen"),
    (id: "F-158a", system: "Mehrspieler", name: "Wiederverbindung", description: "Verbindungsabbruch fuehrt zu einem Platzhalter, der 120 Sekunden reserviert bleibt. Kehrt der Spieler zurueck, erhaelt er Position, Ressourcen und Beitragswert zurueck.", acceptance: "Ein Spieler mit erzwungenem Abbruch kehrt in dieselbe Instanz mit demselben Fortschritt zurueck.", prio: "Must", effort_pd: "9", discipline: "Engineering", depends_on: "F-150", status: "Offen"),
    (id: "F-159a", system: "Mehrspieler", name: "Kampfunfaehigkeit und Wiederbelebung", description: "Statt sofortigem Tod ein Zustand der Kampfunfaehigkeit mit ablaufendem Timer. Mitspieler koennen wiederbeleben; die Wiederbelebung dauert lange genug, um selbst riskant zu sein.", acceptance: "Wiederbelebung ist im Titanenfeuer eine echte Entscheidung, kein Automatismus; Solo-Spieler haben eine begrenzte Selbstaufrichtung.", prio: "Must", effort_pd: "8", discipline: "Design / Engineering", depends_on: "F-038", status: "Offen"),
    (id: "F-160a", system: "Mehrspieler", name: "Getrennte Beute pro Spieler", description: "Jeder Spieler wuerfelt seine eigene Beute. Es gibt keinen Wettlauf um Gegenstaende und keinen Anreiz, Mitspieler zu benachteiligen.", acceptance: "Zwei Spieler in derselben Instanz erhalten unabhaengige Ergebnisse; kein Aufsammeln vor anderen moeglich.", prio: "Must", effort_pd: "5", discipline: "Design / Engineering", depends_on: "F-141", status: "Offen"),
    (id: "F-161a", system: "Mehrspieler", name: "Beitragswertung", description: "Serverseitige Erfassung des Anteils jedes Spielers (Schaden, Ziele, Wiederbelebungen, Unterstuetzung). Grundlage fuer Truhenzugang in Raids und fuer die Auswertung.", acceptance: "Beitrag ist waehrend des Einsatzes einsehbar und nicht manipulierbar.", prio: "Must", effort_pd: "6", discipline: "Engineering", depends_on: "F-096", status: "Offen"),
    (id: "F-162a", system: "Mehrspieler", name: "Kein Schaden unter Spielern", description: "Klingen, Lanzen und Faehigkeiten fuegen Mitspielern keinen Schaden zu. Knockback bleibt als taktisches Element erhalten und ist per Config abschaltbar.", acceptance: "Kein Spieler kann einen anderen toeten oder dessen Fortschritt zerstoeren.", prio: "Must", effort_pd: "3", discipline: "Engineering", depends_on: "F-037", status: "Offen"),
    (id: "F-163a", system: "Mehrspieler", name: "Kollisionsmodell zwischen Spielern", description: "Spieler kollidieren nicht miteinander. In einem Spiel mit dieser Bewegungsgeschwindigkeit ist Spielerkollision die groesste Frustquelle ueberhaupt.", acceptance: "Zwei Spieler koennen sich in voller Fahrt durchdringen, ohne dass Bahnen gestoert werden.", prio: "Must", effort_pd: "3", discipline: "Engineering", depends_on: "F-004", status: "Offen"),
    (id: "F-164a", system: "Mehrspieler", name: "Namensschilder und Zustandsanzeige", description: "Ueber jedem Mitspieler: Name, Lebensleiste, Gaszustand, Verletzungsstatus, Kampfunfaehigkeit. Sichtbarkeit faellt mit Distanz und ist regelbar.", acceptance: "Ein Spieler erkennt aus 150 studs, ob ein Mitspieler Hilfe braucht.", prio: "Must", effort_pd: "6", discipline: "UI / Engineering", depends_on: "F-170", status: "Offen"),
    (id: "F-165a", system: "Mehrspieler", name: "Markierungssystem", description: "Nonverbale Kommunikation per Tastendruck: Ziel markieren, Gefahr, Sammelpunkt, Nachschub, Hilfe benoetigt. Radialmenue auf einer Taste.", acceptance: "Markierungen erscheinen bei allen Mitspielern innerhalb von 200 Millisekunden und verfallen automatisch.", prio: "Must", effort_pd: "6", discipline: "Engineering / UI", depends_on: "F-155", status: "Offen"),
    (id: "F-166a", system: "Mehrspieler", name: "Unterstuetzungsauren", description: "Passive Gruppeneffekte fuer Support-Builds: Gasregeneration, Schadensbonus, Verletzungsschutz im Radius. Sichtbar als Bodenmarkierung.", acceptance: "Auren sind erkennbar, stapeln nach dokumentierten Regeln und machen einen Support-Build spielbar.", prio: "Should", effort_pd: "7", discipline: "Design / Engineering", depends_on: "F-126", status: "Offen"),
    (id: "F-167a", system: "Mehrspieler", name: "Gemeinsame Zielanzeige", description: "Alle Spieler sehen denselben Zielfortschritt, Wellenzaehler und Timer. Kritische Ereignisse werden allen gleichzeitig gemeldet.", acceptance: "Kein Spieler sieht einen abweichenden Zielstand.", prio: "Must", effort_pd: "5", discipline: "Engineering / UI", depends_on: "F-070", status: "Offen"),
    (id: "F-168a", system: "Mehrspieler", name: "Skalierung nach Spielerzahl", description: "Titanenanzahl, Boss-Lebenspunkte und Zielwerte skalieren live mit der aktuellen Spielerzahl, auch bei Beitritt oder Verlassen waehrend des Einsatzes.", acceptance: "Verlaesst ein Spieler die Instanz, sinkt die Boss-HP im selben Verhaeltnis; kein unspielbarer Rest.", prio: "Must", effort_pd: "6", discipline: "Design / Engineering", depends_on: "F-082", status: "Offen"),
    (id: "F-169a", system: "Mehrspieler", name: "Abstimmungen", description: "Gruppenabstimmung ueber Neustart, Abbruch und Schwierigkeitswechsel. Einfache Mehrheit, mit Zeitlimit.", acceptance: "Abstimmung laeuft ohne Spielunterbrechung fuer die anderen; Ergebnis wird allen angezeigt.", prio: "Should", effort_pd: "5", discipline: "Engineering / UI", depends_on: "F-150", status: "Offen"),
    (id: "F-170a", system: "Mehrspieler", name: "Ausschluss und Meldung", description: "Gruppenleiter kann in Privatgruppen ausschliessen. In oeffentlichen Instanzen kein Ausschluss, sondern Meldung plus lokale Stummschaltung, um Missbrauch zu verhindern.", acceptance: "Kein Spieler kann in einer oeffentlichen Instanz per Mehrheit hinausgeworfen werden.", prio: "Should", effort_pd: "6", discipline: "Engineering / UI", depends_on: "F-155", status: "Offen"),
    (id: "F-171a", system: "Mehrspieler", name: "Anwesenheit und Freundesliste", description: "Sichtbar, welche Freunde online sind, in welchem Modus sie stecken und ob ein Beitritt moeglich ist. Beitritt direkt aus der Liste.", acceptance: "Beitritt zu einem Freund funktioniert serveruebergreifend in unter 15 Sekunden.", prio: "Should", effort_pd: "8", discipline: "Engineering", depends_on: "F-155", status: "Offen"),
    (id: "F-172a", system: "Mehrspieler", name: "Zuschauermodus", description: "Nach dauerhaftem Ausscheiden Beobachtung lebender Mitspieler mit freier Kamerawahl. Haelt Spieler in der Sitzung statt sie zum Verlassen zu zwingen.", acceptance: "Zuschauer kann zwischen allen lebenden Spielern wechseln und das HUD ein- und ausblenden.", prio: "Could", effort_pd: "6", discipline: "Engineering / UI", depends_on: "F-090", status: "Offen"),
    (id: "F-173a", system: "Mehrspieler", name: "Privatinstanzen", description: "Eigene Instanz mit einstellbaren Modifikatoren fuer Uebung und Absprachen. Kein Fortschritt, damit Ausnutzung ausgeschlossen ist.", acceptance: "Privatinstanz vergibt keinerlei Waehrung, Erfahrung oder Beute.", prio: "Should", effort_pd: "5", discipline: "Engineering", depends_on: "F-150", status: "Offen"),
    (id: "F-174a", system: "Mehrspieler", name: "Sitzungspersistenz", description: "Zwischenstand einer laufenden Instanz wird regelmaessig gesichert, damit ein Serverfehler nicht den gesamten Einsatzfortschritt vernichtet.", acceptance: "Nach einem simulierten Serverfehler ist hoechstens eine Welle Fortschritt verloren.", prio: "Should", effort_pd: "7", discipline: "Engineering", depends_on: "F-200", status: "Offen"),
    (id: "F-175a", system: "Mehrspieler", name: "Latenz- und Verbindungsanzeige", description: "Ping und Paketverlust je Spieler im Gruppenmenue, plus Warnhinweis bei kritischer Verbindung.", acceptance: "Anzeige entspricht den tatsaechlichen Messwerten und aktualisiert sich jede Sekunde.", prio: "Should", effort_pd: "3", discipline: "UI / Engineering", depends_on: "F-164a", status: "Offen"),
    (id: "F-176a", system: "Mehrspieler", name: "Grief-Schutz", description: "Kein Spieler kann Zielobjekte, Eskortkarren, Nachschubstationen oder Mitspieler beschaedigen. Umgebungswaffen haben Nutzungssperren gegen Blockieren.", acceptance: "Ein boeswilliger Spieler kann eine oeffentliche Mission nicht zum Scheitern bringen.", prio: "Must", effort_pd: "6", discipline: "Design / Engineering", depends_on: "F-162a", status: "Offen"),
    (id: "F-177a", system: "Mehrspieler", name: "Gemeinsame Auswertung", description: "Nach dem Einsatz sehen alle dieselbe Rangliste mit Kills, Genauigkeit, Durchschnittsgeschwindigkeit, Wiederbelebungen und Beitragsanteil. Keine Verlierer-Darstellung, sondern Kategoriebestleistungen.", acceptance: "Jeder Spieler erhaelt mindestens eine hervorgehobene Kategorie.", prio: "Should", effort_pd: "5", discipline: "UI / Design", depends_on: "F-085", status: "Offen"),
    (id: "F-178a", system: "Mehrspieler", name: "Netzwerk-Autoritaetsmodell", description: "Bewegung des eigenen Charakters liegt beim Client mit Server-Plausibilisierung; Titanen, Ziele, Schaden und Beute liegen vollstaendig beim Server. Diese Trennung ist die Grundlage jeder Mehrspielerfunktion.", acceptance: "Kein Client kann fremde Charaktere, Titanen oder Beute beeinflussen.", prio: "Must", effort_pd: "10", discipline: "Engineering", depends_on: "F-215", status: "Offen"),
    (id: "F-179a", system: "Mehrspieler", name: "Interpolation fremder Spieler", description: "Andere Spieler werden clientseitig geglaettet, damit Bewegung bei 100 bis 250 Millisekunden Latenz fluessig aussieht statt zu springen.", acceptance: "Bei 250 Millisekunden simulierter Latenz sind keine Positionsspruenge sichtbar.", prio: "Must", effort_pd: "8", discipline: "Engineering", depends_on: "F-178a", status: "Offen"),
    (id: "F-156", system: "Sozial", name: "Hub: The Rookery", description: "Zentraler sozialer Ort mit Ausruestung, Haendlern, Trainingsgelaende, Bestenlisten und Missionsauswahl.", acceptance: "Hub laedt in unter 8 s und traegt 40 Spieler bei 60 FPS.", prio: "Must", effort_pd: "15", discipline: "LD / Engineering", depends_on: "F-070", status: "Offen"),
    (id: "F-158", system: "Sozial", name: "Regiments (Gilden)", description: "Spielergruppen mit gemeinsamen Wochenzielen, Rangliste, gemeinsamer Fortschrittsleiste und Emblem.", acceptance: "Regimentsziele aktualisieren sich serveruebergreifend.", prio: "Could", effort_pd: "14", discipline: "Engineering", depends_on: "F-155", status: "Offen"),
    (id: "F-160", system: "Sozial", name: "Bestenlisten", description: "Traversal-Zeiten pro Map, Raid-Clear-Zeiten, Saisonwertung. Getrennt nach Eingabegeraet.", acceptance: "Listen sind serveruebergreifend und werden saisonal archiviert.", prio: "Should", effort_pd: "8", discipline: "Engineering", depends_on: "F-077", status: "Offen"),
    (id: "F-170", system: "UI", name: "HUD-Grundlayout", description: "Gas links, Klingen rechts, HP unten mittig, Ladeleiste, Nachladezaehler, Verletzungsanzeige, Zielfortschritt.", acceptance: "Alle Werte sind ohne Menuewechsel ablesbar; HUD verdeckt nie die Bildmitte.", prio: "Must", effort_pd: "8", discipline: "UI / Engineering", status: "Offen"),
    (id: "F-171", system: "UI", name: "Dynamisches Fadenkreuz", description: "Zeigt gueltigen Ankerpunkt, Reichweitenueberschreitung und Cortex-in-Reichweite durch Formaenderung, nicht nur Farbe.", acceptance: "Zustaende sind auch bei Farbenblindheit unterscheidbar.", prio: "Must", effort_pd: "5", discipline: "UI / Engineering", depends_on: "F-002", status: "Offen"),
    (id: "F-172", system: "UI", name: "Vollstaendige Tastenbelegung", description: "Jede Aktion frei zuweisbar, mit Presets und Konflikterkennung. Reines Tastatur- und Maus-Spiel; kein Gamepad, kein Touch. Dadurch koennen Steuerung und Zielsystem kompromisslos auf Praezision ausgelegt werden.", acceptance: "Keine Aktion ist fest verdrahtet; Presets fuer Standard, Linkshaender und Kompakt; alle Aktionen sind mit Tastatur und Maus erreichbar.", prio: "Must", effort_pd: "6", discipline: "UI / Engineering", depends_on: "F-170", status: "Offen"),
    (id: "F-175", system: "UI", name: "Menuestruktur", description: "Maximal zwei Verschachtelungsebenen. Ausruestung, Faehigkeiten, Kosmetik, Kompendium, Einstellungen als Hauptbereiche.", acceptance: "Jeder Bildschirm ist in maximal zwei Klicks erreichbar.", prio: "Must", effort_pd: "10", discipline: "UI / UX", depends_on: "F-170", status: "Offen"),
    (id: "F-176", system: "UI", name: "Barrierefreiheit", description: "Farbenblindmodi, Schriftgroessenregler, Untertitel fuer Audiohinweise, Screenshake-Regler, Bewegungsreduktion.", acceptance: "Alle Statusfarben bleiben in allen drei Farbenblindmodi unterscheidbar.", prio: "Should", effort_pd: "8", discipline: "UI / UX", depends_on: "F-170", status: "Offen"),
    (id: "F-177", system: "UI", name: "Grafikeinstellungen", description: "Qualitaetsstufen mit automatischer Erkennung plus Einzelregler fuer Partikel, Schatten, Sichtweite. Zielprofile: PC-Mindestprofil (Einsteiger-Laptop) und PC-Vollprofil.", acceptance: "Mindestprofil erreicht 60 FPS bei voller Serverbesetzung; Vollprofil bleibt bei 1 Prozent Low ueber 45 FPS.", prio: "Must", effort_pd: "6", discipline: "Engineering / UI", depends_on: "F-170", status: "Offen"),
    (id: "F-178", system: "UI", name: "Ladebildschirme mit Tipps", description: "Kontextabhaengige Hinweise waehrend des Ladens, basierend auf erkannten Schwaechen des Spielers.", acceptance: "Tipps rotieren und wiederholen sich nicht innerhalb einer Session.", prio: "Could", effort_pd: "4", discipline: "UI", depends_on: "F-175", status: "Offen"),
    (id: "F-185", system: "Onboarding", name: "Stufe 1: Bewegungsparcours", description: "Zwei Minuten ohne Gegner. Gefuehrter Parcours lehrt Haken, Pendeln, Swerve und Boost mit visuellen Hilfslinien.", acceptance: "95 Prozent der Testspieler schaffen den Parcours beim ersten Versuch.", prio: "Must", effort_pd: "10", discipline: "Design / LD", depends_on: "F-006", status: "Offen"),
    (id: "F-186", system: "Onboarding", name: "Stufe 2: Erste Kills", description: "Stehende Trainingsziele mit markiertem Cortex. Lehrt Anflugwinkel und Geschwindigkeitsbonus.", acceptance: "Testspieler erzielt drei saubere Cortex-Treffer in unter drei Minuten.", prio: "Must", effort_pd: "6", discipline: "Design / LD", depends_on: "F-185", status: "Offen"),
    (id: "F-187", system: "Onboarding", name: "Stufe 3: Gefuehrte Erstmission", description: "Scriptete Mission mit NPC-Trupp und laufender Anleitung. Fuehrt Nachschub, Ausweichen und Zielsystem ein.", acceptance: "Abschlussquote der Erstmission liegt ueber 80 Prozent.", prio: "Must", effort_pd: "12", discipline: "Design / LD", depends_on: "F-186", status: "Offen"),
    (id: "F-188", system: "Onboarding", name: "Stufe 4: Trainingsgelaende", description: "Dauerhaft zugaenglicher Bereich im Hub mit Uebungen, Zeitmessung und Bestwerten. Unendliches Gas.", acceptance: "Gelaende ist jederzeit betretbar und verlassbar ohne Ladezeit ueber 3 s.", prio: "Must", effort_pd: "10", discipline: "Design / LD", depends_on: "F-156", status: "Offen"),
    (id: "F-189", system: "Onboarding", name: "Adaptive Hinweise", description: "System erkennt Problemmuster (haeufige Abstuerze, verfehlte Cortex-Treffer, Gasmangel) und bietet gezielte Tipps an.", acceptance: "Hinweis erscheint nach definierter Fehlerhaeufung und ist dauerhaft abschaltbar.", prio: "Should", effort_pd: "7", discipline: "Design / Engineering", depends_on: "F-188", status: "Offen"),
    (id: "F-190", system: "Onboarding", name: "Uebungsmodus", description: "Freier Sandkasten mit waehlbaren Gegnertypen, unendlichen Ressourcen und Zeitlupenoption.", acceptance: "Alle Gegnertypen sind einzeln beschwoerbar.", prio: "Should", effort_pd: "6", discipline: "Design / Engineering", depends_on: "F-188", status: "Offen"),
    (id: "F-200", system: "Backend", name: "Datenpersistenz mit Session-Lock", description: "ProfileStore-Muster mit Session-Locking gegen Duplikation und Datenverlust bei Serverwechsel.", acceptance: "Kein Duplikationsfall in 1000 simulierten Serverwechseln.", prio: "Must", effort_pd: "10", discipline: "Engineering", status: "Offen"),
    (id: "F-201", system: "Backend", name: "Versionierte Datenschemata", description: "Jedes Profil traegt eine Schemaversion mit automatischem Migrationspfad.", acceptance: "Ein Profil aus Version 1 laedt korrekt unter Version 5.", prio: "Must", effort_pd: "6", discipline: "Engineering", depends_on: "F-200", status: "Offen"),
    (id: "F-202", system: "Backend", name: "Transaktionsprotokoll", description: "Alle Handels-, Kauf- und Beutevorgaenge werden protokolliert und sind rueckverfolgbar.", acceptance: "Jede Aenderung am Inventar ist im Log auffindbar.", prio: "Must", effort_pd: "6", discipline: "Engineering", depends_on: "F-200", status: "Offen"),
    (id: "F-203", system: "Backend", name: "Cross-Server-Zustand", description: "MemoryStoreService fuer Warteschlangen, Bestenlisten und Regimentsziele.", acceptance: "Warteschlange funktioniert ueber mindestens 20 Server hinweg.", prio: "Should", effort_pd: "8", discipline: "Engineering", depends_on: "F-097", status: "Offen"),
    (id: "F-204", system: "Backend", name: "Place-Routing", description: "Multi-Place-Architektur mit TeleportService, ReservedServers fuer Missionen und Raids, Hub als Anker.", acceptance: "Teleport dauert unter 8 s und behaelt Gruppen zusammen.", prio: "Must", effort_pd: "8", discipline: "Engineering", depends_on: "F-155", status: "Offen"),
    (id: "F-205", system: "Backend", name: "Telemetrie", description: "Erfassung von Sessiondauer, Abbruchpunkten, Todesursachen, Build-Verteilung, Traversal-Geschwindigkeit.", acceptance: "Dashboard mit mindestens 15 Kennzahlen ist verfuegbar.", prio: "Should", effort_pd: "10", discipline: "Engineering / Data", depends_on: "F-200", status: "Offen"),
    (id: "F-206", system: "Backend", name: "Feature-Flags", description: "Serverseitig schaltbare Funktionen fuer schrittweise Ausrollung und schnelles Zurueckdrehen.", acceptance: "Ein Feature laesst sich ohne Deployment deaktivieren.", prio: "Should", effort_pd: "5", discipline: "Engineering", depends_on: "F-200", status: "Offen"),
    (id: "F-207", system: "Backend", name: "Config-getriebenes Balancing", description: "Alle Zahlenwerte in Data-Only-Modulen, ohne Codeaenderung anpassbar.", acceptance: "Ein Designer kann Balancing aendern, ohne eine Zeile Logik anzufassen.", prio: "Must", effort_pd: "6", discipline: "Engineering / Design", status: "Offen"),
    (id: "F-215", system: "Sicherheit", name: "Server-Autoritaet fuer Werte", description: "Waehrung, Erfahrung, Kills, Beute und Fortschritt werden ausschliesslich serverseitig berechnet.", acceptance: "Kein Client-Wert wird jemals uebernommen.", prio: "Must", effort_pd: "8", discipline: "Engineering", depends_on: "F-200", status: "Offen"),
    (id: "F-216", system: "Sicherheit", name: "Positionsplausibilisierung", description: "Server prueft Spielerposition gegen maximal moegliche Geschwindigkeit, Gasverbrauch und Teleportdistanz.", acceptance: "Unplausible Bewegung erzeugt Korrektur und Telemetrie-Eintrag.", prio: "Must", effort_pd: "9", discipline: "Engineering", depends_on: "F-012", status: "Offen"),
    (id: "F-217", system: "Sicherheit", name: "Rate-Limiting", description: "Alle RemoteEvents mit Aufruffrequenz-Begrenzung und Warteschlange.", acceptance: "Kein Remote laesst sich haeufiger als konfiguriert aufrufen.", prio: "Must", effort_pd: "5", discipline: "Engineering", depends_on: "F-215", status: "Offen"),
    (id: "F-218", system: "Sicherheit", name: "Schadensvalidierung", description: "Jeder gemeldete Schaden wird gegen das theoretische Maximum des Spieler-Builds geprueft.", acceptance: "Schaden ueber dem Maximum wird verworfen und geloggt.", prio: "Must", effort_pd: "6", discipline: "Engineering", depends_on: "F-215", status: "Offen"),
    (id: "F-219", system: "Sicherheit", name: "Anomalieerkennung", description: "Statistische Ausreisser bei Kills pro Minute, Waehrung pro Minute und Genauigkeit werden markiert.", acceptance: "System markiert bekannte Testfaelle zuverlaessig.", prio: "Should", effort_pd: "8", discipline: "Engineering / Data", depends_on: "F-205", status: "Offen"),
    (id: "F-220", system: "Sicherheit", name: "Meldesystem", description: "In-Game-Meldung von Spielern mit automatischer Anhaengung der letzten Telemetriewerte.", acceptance: "Meldung erzeugt vollstaendigen Kontextbericht.", prio: "Could", effort_pd: "5", discipline: "Engineering", depends_on: "F-219", status: "Offen"),
    (id: "F-225", system: "Monetarisierung", name: "Kosmetik-System", description: "Umhangmuster, Farbkanaele, Klingen-Trails, Gasfarben, Emotes, Titel. Keinerlei Statwirkung.", acceptance: "Kein kosmetischer Gegenstand veraendert Werte.", prio: "Should", effort_pd: "10", discipline: "Design / Art", status: "Offen"),
    (id: "F-226", system: "Monetarisierung", name: "Saisonpass", description: "Zwei Belohnungsspuren mit substanzieller kostenloser Spur. Ausschliesslich Kosmetik und Waehrung.", acceptance: "Kostenlose Spur enthaelt mindestens 40 Prozent des Gesamtwerts.", prio: "Should", effort_pd: "10", discipline: "Design / Engineering", depends_on: "F-225", status: "Offen"),
    (id: "F-227", system: "Monetarisierung", name: "Privatserver", description: "Gamepass fuer eigene Server mit Konfigurationsoptionen fuer Uebungszwecke.", acceptance: "Privatserver erlaubt Modifikator-Tests ohne Belohnung.", prio: "Could", effort_pd: "4", discipline: "Engineering", depends_on: "F-204", status: "Offen"),
    (id: "F-228", system: "Monetarisierung", name: "Verzicht auf Progressionsverkauf", description: "Keine Inventarplaetze, Drop-Raten, Loadout-Slots oder Neuwuerfe gegen Echtgeld.", acceptance: "Store-Audit bestaetigt: kein Artikel beeinflusst Fortschritt.", prio: "Should", effort_pd: "2", discipline: "Design", status: "Offen"),
    (id: "F-229", system: "Monetarisierung", name: "Transparenter Shop", description: "Vollstaendige Vorschau aller Inhalte vor dem Kauf, inklusive 3D-Ansicht.", acceptance: "Jeder Artikel ist vor Kauf drehbar betrachtbar.", prio: "Should", effort_pd: "6", discipline: "UI / Engineering", depends_on: "F-225", status: "Offen"),
    (id: "F-235", system: "Live Ops", name: "Wochenziele", description: "Rotierende Aufgabenliste mit Waehrungs- und Schluesselbelohnungen.", acceptance: "Rotation erfolgt automatisch zum definierten Zeitpunkt.", prio: "Should", effort_pd: "6", discipline: "Design / Engineering", depends_on: "F-148", status: "Offen"),
    (id: "F-236", system: "Live Ops", name: "Saisonstruktur", description: "Achtwoechige Saisons mit eigener Bestenliste, Modifikatorrotation und Kosmetikthema.", acceptance: "Saisonwechsel laeuft ohne Serverneustart.", prio: "Could", effort_pd: "8", discipline: "Design / Engineering", depends_on: "F-226", status: "Offen"),
    (id: "F-237", system: "Live Ops", name: "Event-Framework", description: "Zeitlich begrenzte Ereignisse mit eigenen Zielen, Gegnern und Belohnungen, per Config schaltbar.", acceptance: "Ein Event laesst sich ohne Code-Deployment starten und beenden.", prio: "Could", effort_pd: "9", discipline: "Engineering / Design", depends_on: "F-206", status: "Offen"),
    (id: "F-238", system: "Live Ops", name: "Codes-System", description: "Einloesbare Codes mit Ablaufdatum, Nutzungslimit und Belohnungspaket.", acceptance: "Code kann nur einmal pro Konto eingeloest werden.", prio: "Could", effort_pd: "4", discipline: "Engineering", depends_on: "F-200", status: "Offen"),
    (id: "F-239", system: "Live Ops", name: "Serverseitige Nachrichten", description: "Ankuendigungen und Wartungshinweise ohne Update, live an alle Server.", acceptance: "Nachricht erscheint innerhalb von 60 s auf allen Servern.", prio: "Could", effort_pd: "3", discipline: "Engineering", depends_on: "F-206", status: "Offen"),
]
