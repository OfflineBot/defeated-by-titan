eintraege: [
    (id: "TEX-ENV-ATLAS", name: "Umgebungs-Palettenatlas", aufloesung: "512x512", typ: "Albedo", beschreibung: "Zentraler Farbatlas fuer saemtliche Umgebungs-Assets. Alle Kits mappen ausschliesslich hierauf. Ergebnis: ein Material, minimale Drawcalls, garantierte Farbkonsistenz.", prio: "Must", status: "Offen"),
    (id: "TEX-ENV-ATLAS-N", name: "Umgebungs-Normalmap", aufloesung: "512x512", typ: "Normal", beschreibung: "Optionale, sehr flache Normalmap fuer Steinstruktur. Nur auf hoher Qualitaetsstufe geladen.", prio: "Could", status: "Offen"),
    (id: "TEX-CHAR-01", name: "Charakter-Haut und Haar", aufloesung: "512x512", typ: "Albedo", beschreibung: "Hauttoene, Haarfarben, Gesichtszuege als Atlasfelder. Farbmodulation ersetzt zusaetzliche Texturen.", prio: "Must", status: "Offen"),
    (id: "TEX-CHAR-02", name: "Uniform-Atlas", aufloesung: "512x512", typ: "Albedo", beschreibung: "Alle drei Uniformsets, Stiefel, Handschuhe, Gurtwerk. Drei tintbare Kanaele ueber Graustufenmasken.", prio: "Must", status: "Offen"),
    (id: "TEX-CHAR-03", name: "Umhang-Atlas", aufloesung: "512x512", typ: "Albedo", beschreibung: "Umhangstoffe und Emblemflaechen. Emblembereich ist ein eigener UV-Bereich fuer Kosmetik.", prio: "Must", status: "Offen"),
    (id: "TEX-GEAR-01", name: "Vector-Gear-Atlas", aufloesung: "512x512", typ: "Albedo", beschreibung: "Alle drei Geraetestufen, Klingen, Kanister, Haken, Lanzen. Metall ueber Farbwert, nicht ueber PBR.", prio: "Must", status: "Offen"),
    (id: "TEX-GEAR-02", name: "Kosmetik-Klingen", aufloesung: "512x512", typ: "Albedo", beschreibung: "Zwoelf Klingenvarianten fuer den Shop.", prio: "Could", status: "Offen"),
    (id: "TEX-TITAN-01", name: "Titan-Haut", aufloesung: "512x512", typ: "Albedo", beschreibung: "Hauttoene und Muskelzeichnung fuer alle Pure-Titan-Typen. Varianz ueber Farbmodulation statt neuer Texturen.", prio: "Must", status: "Offen"),
    (id: "TEX-TITAN-02", name: "Titan-Wunden", aufloesung: "512x512", typ: "Albedo + Emissiv", beschreibung: "Schnittflaechen, Dampfzonen und der leuchtende Cortex. Emissiver Kanal fuer Sichtbarkeit auf Distanz.", prio: "Must", status: "Offen"),
    (id: "TEX-BOSS-01", name: "The Bound One", aufloesung: "1024x1024", typ: "Albedo", beschreibung: "Eigene Textur, da Boss im Nahbild praesentiert wird.", prio: "Should", status: "Offen"),
    (id: "TEX-BOSS-02", name: "The Dancer", aufloesung: "1024x1024", typ: "Albedo", beschreibung: "Inklusive markierter Schwachstellenzonen.", prio: "Should", status: "Offen"),
    (id: "TEX-BOSS-03", name: "The Bulwark", aufloesung: "1024x1024", typ: "Albedo", beschreibung: "Panzerplatten mit separaten Bruchzustaenden.", prio: "Should", status: "Offen"),
    (id: "TEX-BOSS-04", name: "The Ashwalker", aufloesung: "1024x1024", typ: "Albedo + Emissiv", beschreibung: "Glut- und Dampfmotiv mit starkem Emissivanteil.", prio: "Should", status: "Offen"),
    (id: "TEX-VESSEL-01", name: "Warbound", aufloesung: "1024x1024", typ: "Albedo", beschreibung: "Spielerform, im Nahbild sichtbar.", prio: "Should", status: "Offen"),
    (id: "TEX-VESSEL-02", name: "Bladewright", aufloesung: "1024x1024", typ: "Albedo", prio: "Could", status: "Offen"),
    (id: "TEX-VESSEL-03", name: "Bulwark Form", aufloesung: "1024x1024", typ: "Albedo", prio: "Could", status: "Offen"),
    (id: "TEX-VESSEL-04", name: "Colossus Form", aufloesung: "1024x1024", typ: "Albedo + Emissiv", prio: "Could", status: "Offen"),
    (id: "TEX-PROP-01", name: "Prop-Atlas", aufloesung: "512x512", typ: "Albedo", beschreibung: "Alle Requisiten, Nachschubstationen, Karren, Truhen.", prio: "Must", status: "Offen"),
    (id: "TEX-VFX-01", name: "Rauch- und Dampf-Flipbook", aufloesung: "1024x1024", typ: "Flipbook 8x8", beschreibung: "Rauch, Dampf, Titanenaufloesung. Ein Sheet fuer alle weichen Partikel.", prio: "Must", status: "Offen"),
    (id: "TEX-VFX-02", name: "Funken und Explosion", aufloesung: "1024x1024", typ: "Flipbook 8x8", beschreibung: "Explosionen, Funken, Aufprallblitze.", prio: "Should", status: "Offen"),
    (id: "TEX-VFX-03", name: "Trails und Streifen", aufloesung: "256x256", typ: "Albedo", beschreibung: "Klingen-Trails, Speedlines, Seiltextur mit Scroll-Offset.", prio: "Must", status: "Offen"),
    (id: "TEX-UI-01", name: "UI-Atlas Kern", aufloesung: "1024x1024", typ: "Albedo", beschreibung: "HUD-Elemente, Leisten, Rahmen und saemtliche Ankermarker-Sprites in ihren vier Zustaenden. Marker sind formverschieden, nicht nur farbverschieden.", prio: "Must", status: "Offen"),
    (id: "TEX-UI-02", name: "UI-Atlas Icons", aufloesung: "1024x1024", typ: "Albedo", beschreibung: "Perk-, Skill-, Item- und Waehrungs-Icons. Mindestens 200 Symbole.", prio: "Must", status: "Offen"),
    (id: "TEX-UI-03", name: "UI-Atlas Menue", aufloesung: "1024x1024", typ: "Albedo", beschreibung: "Menuehintergruende, Kartenmaterial, Zierelemente.", prio: "Should", status: "Offen"),
    (id: "TEX-SKY-01", name: "Himmel Tag", aufloesung: "Cubemap", typ: "Skybox", beschreibung: "Klarer Tageshimmel mit hohen Wolken.", prio: "Must", status: "Offen"),
    (id: "TEX-SKY-02", name: "Himmel Daemmerung", aufloesung: "Cubemap", typ: "Skybox", beschreibung: "Warme Abendstimmung, Standard fuer die Stadtmaps.", prio: "Must", status: "Offen"),
    (id: "TEX-SKY-03", name: "Himmel Nacht", aufloesung: "Cubemap", typ: "Skybox", beschreibung: "Fuer Nacht-Modifikator.", prio: "Should", status: "Offen"),
    (id: "TEX-SKY-04", name: "Himmel Sturm", aufloesung: "Cubemap", typ: "Skybox", beschreibung: "Fuer Regen-Modifikator mit reduzierter Sicht.", prio: "Should", status: "Offen"),
