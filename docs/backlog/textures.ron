// Source: gameplay/features.xlsx!04_Texturen (28 records from 31 rows)
entries: [
    (id: "TEX-ENV-ATLAS", name: "Umgebungs-Palettenatlas", resolution: "512x512", kind: "Albedo", description: "Zentraler Farbatlas fuer saemtliche Umgebungs-Assets. Alle Kits mappen ausschliesslich hierauf. Ergebnis: ein Material, minimale Drawcalls, garantierte Farbkonsistenz.", prio: "Must", status: "Offen"),
    (id: "TEX-ENV-ATLAS-N", name: "Umgebungs-Normalmap", resolution: "512x512", kind: "Normal", description: "Optionale, sehr flache Normalmap fuer Steinstruktur. Nur auf hoher Qualitaetsstufe geladen.", prio: "Could", status: "Offen"),
    (id: "TEX-CHAR-01", name: "Charakter-Haut und Haar", resolution: "512x512", kind: "Albedo", description: "Hauttoene, Haarfarben, Gesichtszuege als Atlasfelder. Farbmodulation ersetzt zusaetzliche Texturen.", prio: "Must", status: "Offen"),
    (id: "TEX-CHAR-02", name: "Uniform-Atlas", resolution: "512x512", kind: "Albedo", description: "Alle drei Uniformsets, Stiefel, Handschuhe, Gurtwerk. Drei tintbare Kanaele ueber Graustufenmasken.", prio: "Must", status: "Offen"),
    (id: "TEX-CHAR-03", name: "Umhang-Atlas", resolution: "512x512", kind: "Albedo", description: "Umhangstoffe und Emblemflaechen. Emblembereich ist ein eigener UV-Bereich fuer Kosmetik.", prio: "Must", status: "Offen"),
    (id: "TEX-GEAR-01", name: "Vector-Gear-Atlas", resolution: "512x512", kind: "Albedo", description: "Alle drei Geraetestufen, Klingen, Kanister, Haken, Lanzen. Metall ueber Farbwert, nicht ueber PBR.", prio: "Must", status: "Offen"),
    (id: "TEX-GEAR-02", name: "Kosmetik-Klingen", resolution: "512x512", kind: "Albedo", description: "Zwoelf Klingenvarianten fuer den Shop.", prio: "Could", status: "Offen"),
    (id: "TEX-TITAN-01", name: "Titan-Haut", resolution: "512x512", kind: "Albedo", description: "Hauttoene und Muskelzeichnung fuer alle Pure-Titan-Typen. Varianz ueber Farbmodulation statt neuer Texturen.", prio: "Must", status: "Offen"),
    (id: "TEX-TITAN-02", name: "Titan-Wunden", resolution: "512x512", kind: "Albedo + Emissiv", description: "Schnittflaechen, Dampfzonen und der leuchtende Cortex. Emissiver Kanal fuer Sichtbarkeit auf Distanz.", prio: "Must", status: "Offen"),
    (id: "TEX-BOSS-01", name: "The Bound One", resolution: "1024x1024", kind: "Albedo", description: "Eigene Textur, da Boss im Nahbild praesentiert wird.", prio: "Should", status: "Offen"),
    (id: "TEX-BOSS-02", name: "The Dancer", resolution: "1024x1024", kind: "Albedo", description: "Inklusive markierter Schwachstellenzonen.", prio: "Should", status: "Offen"),
    (id: "TEX-BOSS-03", name: "The Bulwark", resolution: "1024x1024", kind: "Albedo", description: "Panzerplatten mit separaten Bruchzustaenden.", prio: "Should", status: "Offen"),
    (id: "TEX-BOSS-04", name: "The Ashwalker", resolution: "1024x1024", kind: "Albedo + Emissiv", description: "Glut- und Dampfmotiv mit starkem Emissivanteil.", prio: "Should", status: "Offen"),
    (id: "TEX-VESSEL-01", name: "Warbound", resolution: "1024x1024", kind: "Albedo", description: "Spielerform, im Nahbild sichtbar.", prio: "Should", status: "Offen"),
    (id: "TEX-VESSEL-02", name: "Bladewright", resolution: "1024x1024", kind: "Albedo", prio: "Could", status: "Offen"),
    (id: "TEX-VESSEL-03", name: "Bulwark Form", resolution: "1024x1024", kind: "Albedo", prio: "Could", status: "Offen"),
    (id: "TEX-VESSEL-04", name: "Colossus Form", resolution: "1024x1024", kind: "Albedo + Emissiv", prio: "Could", status: "Offen"),
    (id: "TEX-PROP-01", name: "Prop-Atlas", resolution: "512x512", kind: "Albedo", description: "Alle Requisiten, Nachschubstationen, Karren, Truhen.", prio: "Must", status: "Offen"),
    (id: "TEX-VFX-01", name: "Rauch- und Dampf-Flipbook", resolution: "1024x1024", kind: "Flipbook 8x8", description: "Rauch, Dampf, Titanenaufloesung. Ein Sheet fuer alle weichen Partikel.", prio: "Must", status: "Offen"),
    (id: "TEX-VFX-02", name: "Funken und Explosion", resolution: "1024x1024", kind: "Flipbook 8x8", description: "Explosionen, Funken, Aufprallblitze.", prio: "Should", status: "Offen"),
    (id: "TEX-VFX-03", name: "Trails und Streifen", resolution: "256x256", kind: "Albedo", description: "Klingen-Trails, Speedlines, Seiltextur mit Scroll-Offset.", prio: "Must", status: "Offen"),
    (id: "TEX-UI-01", name: "UI-Atlas Kern", resolution: "1024x1024", kind: "Albedo", description: "HUD-Elemente, Leisten, Rahmen und saemtliche Ankermarker-Sprites in ihren vier Zustaenden. Marker sind formverschieden, nicht nur farbverschieden.", prio: "Must", status: "Offen"),
    (id: "TEX-UI-02", name: "UI-Atlas Icons", resolution: "1024x1024", kind: "Albedo", description: "Perk-, Skill-, Item- und Waehrungs-Icons. Mindestens 200 Symbole.", prio: "Must", status: "Offen"),
    (id: "TEX-UI-03", name: "UI-Atlas Menue", resolution: "1024x1024", kind: "Albedo", description: "Menuehintergruende, Kartenmaterial, Zierelemente.", prio: "Should", status: "Offen"),
    (id: "TEX-SKY-01", name: "Himmel Tag", resolution: "Cubemap", kind: "Skybox", description: "Klarer Tageshimmel mit hohen Wolken.", prio: "Must", status: "Offen"),
    (id: "TEX-SKY-02", name: "Himmel Daemmerung", resolution: "Cubemap", kind: "Skybox", description: "Warme Abendstimmung, Standard fuer die Stadtmaps.", prio: "Must", status: "Offen"),
    (id: "TEX-SKY-03", name: "Himmel Nacht", resolution: "Cubemap", kind: "Skybox", description: "Fuer Nacht-Modifikator.", prio: "Should", status: "Offen"),
    (id: "TEX-SKY-04", name: "Himmel Sturm", resolution: "Cubemap", kind: "Skybox", description: "Fuer Regen-Modifikator mit reduzierter Sicht.", prio: "Should", status: "Offen"),
]
