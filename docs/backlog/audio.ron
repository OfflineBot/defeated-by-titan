    (id: "S-070", category: "Titan", name: "Sturz", description: "Schwerer Koerperaufprall mit Staubgeraeusch.", length: "1.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-071", category: "Titan", name: "Aufloesung", description: "Zischendes Verdampfen, ausklingend ueber 3 Sekunden.", length: "3.0s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-072", category: "Titan", name: "Scuttler Bewegung", description: "Schnelles, klapperndes Kriechen mit unregelmaessigem Rhythmus.", length: "1.0s", loop: "Ja", prio: "Must", status: "Offen"),
