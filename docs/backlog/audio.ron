    (id: "S-055", kategorie: "Kampf", name: "Combo-Anstieg", beschreibung: "Aufsteigende Tonfolge, Tonhoehe steigt mit dem Multiplikator.", laenge: "0.3s", loop: "Nein", prio: "Should", status: "Offen"),
