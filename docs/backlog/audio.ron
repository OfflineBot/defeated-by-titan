entries: [
    (id: "S-001", category: "Vector Gear", name: "Hook Fire", description: "Druckluftartiger Abschussknall des Ankerwerfers, kurz und trocken. Zwei Varianten fuer links und rechts.", length: "0.4s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-002", category: "Vector Gear", name: "Hook Impact Stein", description: "Metallischer Einschlag in Mauerwerk mit kurzem Nachhall.", length: "0.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-003", category: "Vector Gear", name: "Hook Impact Holz", description: "Dumpferer, hoelzerner Einschlag.", length: "0.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-004", category: "Vector Gear", name: "Hook Impact Fleisch", description: "Feuchter, unangenehmer Einschlag in Titanenkoerper.", length: "0.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-005", category: "Vector Gear", name: "Hook Miss", description: "Ins Leere gehender Haken, Seilrasseln und Rueckzug.", length: "0.8s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-006", category: "Vector Gear", name: "Seileinzug", description: "Ratterndes Aufrollen der Winde, Tonhoehe skaliert mit Einzuggeschwindigkeit.", length: "2.0s", loop: "Ja", prio: "Must", status: "Offen"),
    (id: "S-007", category: "Vector Gear", name: "Gas-Zischen", description: "Der Signature-Sound des Genres. Kontinuierlicher Druckluftstrom, Lautstaerke und Tonhoehe an Boost gekoppelt.", length: "3.0s", loop: "Ja", prio: "Must", status: "Offen"),
    (id: "S-008", category: "Vector Gear", name: "Gas-Dash", description: "Kurzer, harter Druckstoss mit Bassanteil.", length: "0.4s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-009", category: "Vector Gear", name: "Gas leer Warnung", description: "Stotterndes Zischen plus subtiler Warnton, nicht aufdringlich.", length: "1.0s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-010", category: "Vector Gear", name: "Hook Release", description: "Metallisches Klacken beim Loesen.", length: "0.2s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-011", category: "Vector Gear", name: "Hook Break", description: "Doppelter Abschuss nach hinten mit abruptem Spannungsgeraeusch.", length: "0.7s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-012", category: "Vector Gear", name: "Reload Klingen", description: "Klickmechanik des Klingenwechsels, drei Schichten.", length: "1.2s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-013", category: "Vector Gear", name: "Reload Gas", description: "Zischendes Befuellen des Tanks mit Ventilklacken.", length: "1.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-014", category: "Vector Gear", name: "Seilspannung", description: "Knarzen bei starker Belastung im Pendel.", length: "1.5s", loop: "Ja", prio: "Should", status: "Offen"),
    (id: "S-015", category: "Vector Gear", name: "Snap-Zielwechsel", description: "Sehr leiser, kurzer Tick, wenn die Bewertungsfunktion das beste Ankerziel wechselt. Muss unaufdringlich sein, da er sehr haeufig ausgeloest wird.", length: "0.05s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-016", category: "Vector Gear", name: "Kein gueltiges Ziel", description: "Trockenes Klacken des Werfers ohne Abschuss, wenn weder Ankerpunkt noch Flaeche erreichbar ist. Verhindert stille Fehlversuche.", length: "0.3s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-020", category: "Bewegung", name: "Schritte Stein", description: "Vier Variationen fuer Pflaster und Mauerwerk.", length: "0.3s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-021", category: "Bewegung", name: "Schritte Holz", description: "Vier Variationen fuer Dielen, Stege und Daecher.", length: "0.3s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-022", category: "Bewegung", name: "Schritte Erde", description: "Vier Variationen fuer Feld und Waldboden.", length: "0.3s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-023", category: "Bewegung", name: "Schritte Metall", description: "Vier Variationen fuer Kraene und Plattformen.", length: "0.3s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-024", category: "Bewegung", name: "Schritte Wasser", description: "Vier Variationen fuer Kanaele und Pfuetzen.", length: "0.3s", loop: "Nein", prio: "Could", status: "Offen"),
    (id: "S-025", category: "Bewegung", name: "Landung weich", description: "Leichtes Aufsetzen mit Stoffrascheln.", length: "0.4s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-026", category: "Bewegung", name: "Landung hart", description: "Wuchtiger Aufprall mit Abrollen und Schmerzlaut.", length: "0.9s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-027", category: "Bewegung", name: "Windrauschen", description: "Fluggeraeusch, dessen Lautstaerke und Filterfrequenz an die Geschwindigkeit gekoppelt sind. Zentral fuer das Tempoempfinden.", length: "4.0s", loop: "Ja", prio: "Must", status: "Offen"),
    (id: "S-028", category: "Bewegung", name: "Umhangflattern", description: "Stoffgeraeusch bei hoher Geschwindigkeit und Richtungswechsel.", length: "2.0s", loop: "Ja", prio: "Should", status: "Offen"),
    (id: "S-029", category: "Bewegung", name: "Ausruestungsklappern", description: "Gurtwerk und Kanister bei Bewegung am Boden.", length: "1.5s", loop: "Ja", prio: "Should", status: "Offen"),
    (id: "S-030", category: "Bewegung", name: "Kollision Wand", description: "Dumpfer Aufprall mit Schmerzlaut und kurzem Tinnitus-Filter.", length: "1.0s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-031", category: "Bewegung", name: "Slide", description: "Reibgeraeusch beim Bodengleiten, materialabhaengig.", length: "0.8s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-040", category: "Kampf", name: "Klinge ziehen", description: "Metallisches Herausgleiten aus der Halterung.", length: "0.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-041", category: "Kampf", name: "Schnitt leicht", description: "Zischender Klingenhieb ohne Treffer, drei Varianten.", length: "0.3s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-042", category: "Kampf", name: "Treffer Gliedmasse", description: "Fleischiger Schnitt mit Dampfzischen.", length: "0.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-043", category: "Kampf", name: "Cortex-Kill", description: "Der wichtigste Sound des Spiels. Sauberer Durchschnitt mit tiefem Bass-Impact und ausklingendem Dampfstoss. Muss maximal befriedigend sein.", length: "1.2s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-044", category: "Kampf", name: "Kritischer Treffer", description: "Zusaetzliche Metallschicht und heller Akzent ueber dem Basistreffer.", length: "0.6s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-045", category: "Kampf", name: "Klingenbruch", description: "Splitterndes Metall mit scharfem Nachhall.", length: "0.7s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-046", category: "Kampf", name: "Lanze Wurf", description: "Zischender Abwurf mit Leitwerkgeraeusch.", length: "0.6s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-047", category: "Kampf", name: "Lanze Haftung", description: "Metallisches Einschlagen und Zuendersurren.", length: "0.5s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-048", category: "Kampf", name: "Lanze Explosion", description: "Tiefe Detonation mit Druckwelle und Truemmerregen.", length: "2.0s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-049", category: "Kampf", name: "Spieler getroffen", description: "Schmerzlaut plus dumpfer Aufprall, drei Intensitaeten.", length: "0.8s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-050", category: "Kampf", name: "Spieler gegriffen", description: "Erstickter Aufschrei und Griffgeraeusch.", length: "1.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-051", category: "Kampf", name: "Griff-Befreiung", description: "Erleichterter Ausruf plus Hakenschuss.", length: "0.8s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-052", category: "Kampf", name: "Spieler Tod", description: "Drei Varianten je nach Todesursache.", length: "2.0s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-053", category: "Kampf", name: "Verletzung erhalten", description: "Knacken plus gedaempfter Schmerzlaut, signalisiert Statusverlust.", length: "1.0s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-054", category: "Kampf", name: "Verband anlegen", description: "Stoffreissen und Atemgeraeusch.", length: "2.0s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-055", category: "Kampf", name: "Combo-Anstieg", description: "Aufsteigende Tonfolge, Tonhoehe steigt mit dem Multiplikator.", length: "0.3s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-056", category: "Kampf", name: "Combo-Verlust", description: "Absteigender, gedaempfter Ton.", length: "0.5s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-060", category: "Titan", name: "Schritt klein", description: "Dumpfer Aufprall des 3m-Titanen.", length: "0.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-061", category: "Titan", name: "Schritt mittel", description: "Schwerer Aufprall mit Erdbeben-Anteil.", length: "0.7s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-062", category: "Titan", name: "Schritt gross", description: "Sehr tiefer Sub-Bass-Impact, spuerbar auf Distanz. Wichtigster Bedrohungsindikator.", length: "1.0s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-063", category: "Titan", name: "Atmen", description: "Schweres, unregelmaessiges Atmen als Naeherungswarnung.", length: "3.0s", loop: "Ja", prio: "Must", status: "Offen"),
    (id: "S-064", category: "Titan", name: "Bruellen A", description: "Standardruf, mittlere Tonlage.", length: "2.0s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-065", category: "Titan", name: "Bruellen B", description: "Hoeherer, kreischender Ruf fuer Errant-Typen.", length: "2.0s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-066", category: "Titan", name: "Bruellen C", description: "Tiefer, langgezogener Ruf fuer grosse Titanen.", length: "3.0s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-067", category: "Titan", name: "Bellower-Ruf", description: "Extrem lauter Sammelruf mit weitreichendem Hall.", length: "3.5s", loop: "Nein", prio: "Should", status: "Offen"),
