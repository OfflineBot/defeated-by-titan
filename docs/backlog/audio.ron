    (id: "S-094", category: "Vessel", name: "Zeitwarnung", description: "Pulsierender Ton bei ablaufender Verwandlungsdauer.", length: "1.0s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-100", category: "Umgebung", name: "Kanonenschuss", description: "Tiefer Abschussknall mit langem Nachhall.", length: "2.5s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-101", category: "Umgebung", name: "Kanone nachladen", description: "Mechanisches Laden mit Metallgeraeuschen.", length: "2.0s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-102", category: "Umgebung", name: "Balliste", description: "Gespanntes Loesen mit Zischen.", length: "1.2s", loop: "Nein", prio: "Could", status: "Offen"),
    (id: "S-103", category: "Umgebung", name: "Nachschubstation", description: "Zischendes Befuellen plus Bestaetigungston.", length: "1.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-104", category: "Umgebung", name: "Karren rollen", description: "Holzraeder auf Pflaster, Tempo-abhaengig.", length: "2.0s", loop: "Ja", prio: "Should", status: "Offen"),
    (id: "S-105", category: "Umgebung", name: "Gebaeude einstuerzen", description: "Splitterndes Mauerwerk mit Staubwolke.", length: "2.5s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-106", category: "Umgebung", name: "Tor zerbricht", description: "Berstendes Holz und Metall.", length: "2.0s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-107", category: "Umgebung", name: "Truhe oeffnen", description: "Knarrendes Oeffnen plus Belohnungsakkord, Variante pro Seltenheit.", length: "1.5s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-115", category: "Ambience", name: "Stadt Tag", description: "Entfernte Stimmen, Karren, Voegel. Ruhige Grundatmosphaere.", length: "120s", loop: "Ja", prio: "Should", status: "Offen"),
    (id: "S-116", category: "Ambience", name: "Stadt Belagerung", description: "Schreie, Feuer, entfernte Einstuerze. Ersetzt die Ruhevariante bei aktivem Kampf.", length: "120s", loop: "Ja", prio: "Should", status: "Offen"),
    (id: "S-117", category: "Ambience", name: "Wald", description: "Blaetterrauschen, Voegel, knarrende Staemme.", length: "120s", loop: "Ja", prio: "Should", status: "Offen"),
    (id: "S-118", category: "Ambience", name: "Freifeld", description: "Wind ueber offenem Gelaende, Grillen.", length: "120s", loop: "Ja", prio: "Should", status: "Offen"),
    (id: "S-119", category: "Ambience", name: "Hafen", description: "Wasser, Moewen, knarrende Taue.", length: "120s", loop: "Ja", prio: "Should", status: "Offen"),
    (id: "S-120", category: "Ambience", name: "Mauerkrone", description: "Hoehenwind mit leichtem Pfeifen.", length: "120s", loop: "Ja", prio: "Should", status: "Offen"),
    (id: "S-121", category: "Ambience", name: "Hub", description: "Ruhiger Innenhof mit Schmiedegeraeuschen und Gespraechsfetzen.", length: "180s", loop: "Ja", prio: "Must", status: "Offen"),
    (id: "S-122", category: "Ambience", name: "Regen", description: "Regen auf verschiedenen Oberflaechen.", length: "120s", loop: "Ja", prio: "Should", status: "Offen"),
    (id: "S-123", category: "Ambience", name: "Nacht", description: "Naechtliche Stille mit Insekten und fernen Titanenlauten.", length: "120s", loop: "Ja", prio: "Should", status: "Offen"),
    (id: "S-130", category: "UI", name: "Hover", description: "Dezenter Ton beim Ueberfahren eines Elements.", length: "0.1s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-131", category: "UI", name: "Klick", description: "Bestaetigungsklick.", length: "0.15s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-132", category: "UI", name: "Zurueck", description: "Abweichender Ton fuer Abbruch und Zurueck.", length: "0.15s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-133", category: "UI", name: "Kauf erfolgreich", description: "Positiver Akkord mit Muenzanteil.", length: "0.8s", loop: "Nein", prio: "Must", status: "Offen"),
