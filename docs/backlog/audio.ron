    (id: "S-062", kategorie: "Titan", name: "Schritt gross", beschreibung: "Sehr tiefer Sub-Bass-Impact, spuerbar auf Distanz. Wichtigster Bedrohungsindikator.", laenge: "1.0s", loop: "Nein", prio: "Must", status: "Offen"),
