    (id: "S-074", category: "Titan", name: "Warden Block", description: "Dumpfes Abfangen des Klingenhiebs.", length: "0.5s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-075", category: "Titan", name: "Lurker Ambush", description: "Ploetzliches Aufspringen mit scharfem Luftzug.", length: "0.9s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-080", category: "Boss", name: "The Bound One Themenlaute", description: "Sechs bossspezifische Laute inklusive Phasenwechsel-Ruf.", length: "-", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-081", category: "Boss", name: "The Dancer Themenlaute", description: "Sechs Laute mit hoeherer, agilerer Klangfarbe.", length: "-", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-082", category: "Boss", name: "The Bulwark Themenlaute", description: "Sechs Laute plus metallische Panzerbruch-Geraeusche.", length: "-", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-083", category: "Boss", name: "The Ashwalker Themenlaute", description: "Sechs Laute mit extremem Sub-Bass und Dampfausstoss.", length: "-", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-084", category: "Boss", name: "Phasenwechsel-Stinger", description: "Musikalischer Akzent bei jedem Phasenuebergang.", length: "2.0s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-090", category: "Vessel", name: "Transformation", description: "Elektrische Entladung, gefolgt von massivem Dampfausstoss und Fleischgeraeusch.", length: "3.0s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-091", category: "Vessel", name: "Eject", description: "Reissendes Loesen aus dem Nacken.", length: "1.5s", loop: "Nein", prio: "Should", status: "Offen"),
