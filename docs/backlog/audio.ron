eintraege: [
    (id: "S-001", kategorie: "Vector Gear", name: "Hook Fire", beschreibung: "Druckluftartiger Abschussknall des Ankerwerfers, kurz und trocken. Zwei Varianten fuer links und rechts.", laenge: "0.4s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-002", kategorie: "Vector Gear", name: "Hook Impact Stein", beschreibung: "Metallischer Einschlag in Mauerwerk mit kurzem Nachhall.", laenge: "0.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-003", kategorie: "Vector Gear", name: "Hook Impact Holz", beschreibung: "Dumpferer, hoelzerner Einschlag.", laenge: "0.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-004", kategorie: "Vector Gear", name: "Hook Impact Fleisch", beschreibung: "Feuchter, unangenehmer Einschlag in Titanenkoerper.", laenge: "0.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-005", kategorie: "Vector Gear", name: "Hook Miss", beschreibung: "Ins Leere gehender Haken, Seilrasseln und Rueckzug.", laenge: "0.8s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-006", kategorie: "Vector Gear", name: "Seileinzug", beschreibung: "Ratterndes Aufrollen der Winde, Tonhoehe skaliert mit Einzuggeschwindigkeit.", laenge: "2.0s", loop: "Ja", prio: "Must", status: "Offen"),
    (id: "S-007", kategorie: "Vector Gear", name: "Gas-Zischen", beschreibung: "Der Signature-Sound des Genres. Kontinuierlicher Druckluftstrom, Lautstaerke und Tonhoehe an Boost gekoppelt.", laenge: "3.0s", loop: "Ja", prio: "Must", status: "Offen"),
    (id: "S-008", kategorie: "Vector Gear", name: "Gas-Dash", beschreibung: "Kurzer, harter Druckstoss mit Bassanteil.", laenge: "0.4s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-009", kategorie: "Vector Gear", name: "Gas leer Warnung", beschreibung: "Stotterndes Zischen plus subtiler Warnton, nicht aufdringlich.", laenge: "1.0s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-010", kategorie: "Vector Gear", name: "Hook Release", beschreibung: "Metallisches Klacken beim Loesen.", laenge: "0.2s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-011", kategorie: "Vector Gear", name: "Hook Break", beschreibung: "Doppelter Abschuss nach hinten mit abruptem Spannungsgeraeusch.", laenge: "0.7s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-012", kategorie: "Vector Gear", name: "Reload Klingen", beschreibung: "Klickmechanik des Klingenwechsels, drei Schichten.", laenge: "1.2s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-013", kategorie: "Vector Gear", name: "Reload Gas", beschreibung: "Zischendes Befuellen des Tanks mit Ventilklacken.", laenge: "1.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-014", kategorie: "Vector Gear", name: "Seilspannung", beschreibung: "Knarzen bei starker Belastung im Pendel.", laenge: "1.5s", loop: "Ja", prio: "Should", status: "Offen"),
    (id: "S-015", kategorie: "Vector Gear", name: "Snap-Zielwechsel", beschreibung: "Sehr leiser, kurzer Tick, wenn die Bewertungsfunktion das beste Ankerziel wechselt. Muss unaufdringlich sein, da er sehr haeufig ausgeloest wird.", laenge: "0.05s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-016", kategorie: "Vector Gear", name: "Kein gueltiges Ziel", beschreibung: "Trockenes Klacken des Werfers ohne Abschuss, wenn weder Ankerpunkt noch Flaeche erreichbar ist. Verhindert stille Fehlversuche.", laenge: "0.3s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-020", kategorie: "Bewegung", name: "Schritte Stein", beschreibung: "Vier Variationen fuer Pflaster und Mauerwerk.", laenge: "0.3s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-021", kategorie: "Bewegung", name: "Schritte Holz", beschreibung: "Vier Variationen fuer Dielen, Stege und Daecher.", laenge: "0.3s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-022", kategorie: "Bewegung", name: "Schritte Erde", beschreibung: "Vier Variationen fuer Feld und Waldboden.", laenge: "0.3s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-023", kategorie: "Bewegung", name: "Schritte Metall", beschreibung: "Vier Variationen fuer Kraene und Plattformen.", laenge: "0.3s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-024", kategorie: "Bewegung", name: "Schritte Wasser", beschreibung: "Vier Variationen fuer Kanaele und Pfuetzen.", laenge: "0.3s", loop: "Nein", prio: "Could", status: "Offen"),
    (id: "S-025", kategorie: "Bewegung", name: "Landung weich", beschreibung: "Leichtes Aufsetzen mit Stoffrascheln.", laenge: "0.4s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-026", kategorie: "Bewegung", name: "Landung hart", beschreibung: "Wuchtiger Aufprall mit Abrollen und Schmerzlaut.", laenge: "0.9s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-027", kategorie: "Bewegung", name: "Windrauschen", beschreibung: "Fluggeraeusch, dessen Lautstaerke und Filterfrequenz an die Geschwindigkeit gekoppelt sind. Zentral fuer das Tempoempfinden.", laenge: "4.0s", loop: "Ja", prio: "Must", status: "Offen"),
    (id: "S-028", kategorie: "Bewegung", name: "Umhangflattern", beschreibung: "Stoffgeraeusch bei hoher Geschwindigkeit und Richtungswechsel.", laenge: "2.0s", loop: "Ja", prio: "Should", status: "Offen"),
    (id: "S-029", kategorie: "Bewegung", name: "Ausruestungsklappern", beschreibung: "Gurtwerk und Kanister bei Bewegung am Boden.", laenge: "1.5s", loop: "Ja", prio: "Should", status: "Offen"),
    (id: "S-030", kategorie: "Bewegung", name: "Kollision Wand", beschreibung: "Dumpfer Aufprall mit Schmerzlaut und kurzem Tinnitus-Filter.", laenge: "1.0s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-031", kategorie: "Bewegung", name: "Slide", beschreibung: "Reibgeraeusch beim Bodengleiten, materialabhaengig.", laenge: "0.8s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-040", kategorie: "Kampf", name: "Klinge ziehen", beschreibung: "Metallisches Herausgleiten aus der Halterung.", laenge: "0.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-041", kategorie: "Kampf", name: "Schnitt leicht", beschreibung: "Zischender Klingenhieb ohne Treffer, drei Varianten.", laenge: "0.3s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-042", kategorie: "Kampf", name: "Treffer Gliedmasse", beschreibung: "Fleischiger Schnitt mit Dampfzischen.", laenge: "0.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-043", kategorie: "Kampf", name: "Cortex-Kill", beschreibung: "Der wichtigste Sound des Spiels. Sauberer Durchschnitt mit tiefem Bass-Impact und ausklingendem Dampfstoss. Muss maximal befriedigend sein.", laenge: "1.2s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-044", kategorie: "Kampf", name: "Kritischer Treffer", beschreibung: "Zusaetzliche Metallschicht und heller Akzent ueber dem Basistreffer.", laenge: "0.6s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-045", kategorie: "Kampf", name: "Klingenbruch", beschreibung: "Splitterndes Metall mit scharfem Nachhall.", laenge: "0.7s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-046", kategorie: "Kampf", name: "Lanze Wurf", beschreibung: "Zischender Abwurf mit Leitwerkgeraeusch.", laenge: "0.6s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-047", kategorie: "Kampf", name: "Lanze Haftung", beschreibung: "Metallisches Einschlagen und Zuendersurren.", laenge: "0.5s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-048", kategorie: "Kampf", name: "Lanze Explosion", beschreibung: "Tiefe Detonation mit Druckwelle und Truemmerregen.", laenge: "2.0s", loop: "Nein", prio: "Should", status: "Offen"),
    (id: "S-049", kategorie: "Kampf", name: "Spieler getroffen", beschreibung: "Schmerzlaut plus dumpfer Aufprall, drei Intensitaeten.", laenge: "0.8s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-050", kategorie: "Kampf", name: "Spieler gegriffen", beschreibung: "Erstickter Aufschrei und Griffgeraeusch.", laenge: "1.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-051", kategorie: "Kampf", name: "Griff-Befreiung", beschreibung: "Erleichterter Ausruf plus Hakenschuss.", laenge: "0.8s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-052", kategorie: "Kampf", name: "Spieler Tod", beschreibung: "Drei Varianten je nach Todesursache.", laenge: "2.0s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-053", kategorie: "Kampf", name: "Verletzung erhalten", beschreibung: "Knacken plus gedaempfter Schmerzlaut, signalisiert Statusverlust.", laenge: "1.0s", loop: "Nein", prio: "Should", status: "Offen"),
