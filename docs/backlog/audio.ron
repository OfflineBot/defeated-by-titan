    (id: "S-140", category: "UI", name: "Drop Mythisch", description: "Einzigartiger, unverwechselbarer Klang. Spieler sollen ihn sofort erkennen.", length: "2.5s", loop: "Nein", prio: "Must", status: "Offen"),
    (id: "S-141", category: "UI", name: "Missionsstart", description: "Signalhorn und Trommelakzent.", length: "2.0s", loop: "Nein", prio: "Must", status: "Offen"),
