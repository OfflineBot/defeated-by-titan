    (id: "MU-002", category: "Musik", name: "Kampf Schicht 1 (Ruhe)", description: "Perkussive Grundschicht, laeuft waehrend der Erkundung.", length: "120s", loop: "Ja", prio: "Must", status: "Offen"),
