    (id: "A-007", kategorie: "Charakter", name: "Gesichtszuege", beschreibung: "Als Textur-Varianten auf dem Kopf-Atlas: 10 Augenformen, 6 Mundformen, 8 Narben/Marken.", tris_lod0: "0", tris_lod1: "0", tris_lod2: "0", varianten: "24", textur_slot: "TEX-CHAR-01", prio: "Should", aufwand_pt: "4", status: "Offen"),
    (id: "A-008", kategorie: "Charakter", name: "Uniform Rekrut", beschreibung: "Einfache Feldkleidung ohne Abzeichen, gedeckte Farben. Startausruestung.", tris_lod0: "900", tris_lod1: "450", tris_lod2: "180", varianten: "1", textur_slot: "TEX-CHAR-02", prio: "Must", aufwand_pt: "4", status: "Offen"),
