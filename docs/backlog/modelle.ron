    (id: "A-020", kategorie: "Ausruestung", name: "Vector Gear Stufe 1", beschreibung: "Grundgeraet: zwei Huelsen an der Huefte, Gastanks, Ankerwerfer. Bewegliche Teile fuer Animation getrennt modelliert.", tris_lod0: "900", tris_lod1: "450", tris_lod2: "180", varianten: "1", textur_slot: "TEX-GEAR-01", prio: "Must", aufwand_pt: "6", status: "Offen"),
    (id: "A-021", kategorie: "Ausruestung", name: "Vector Gear Stufe 2", beschreibung: "Verbessertes Modell mit groesseren Tanks und zusaetzlichen Duesen. Optischer Fortschrittsindikator.", tris_lod0: "1000", tris_lod1: "500", tris_lod2: "200", varianten: "1", textur_slot: "TEX-GEAR-01", prio: "Should", aufwand_pt: "4", status: "Offen"),
