eintraege: [
    (id: "A-001", kategorie: "Charakter", name: "Basis-Rig Vanguard", beschreibung: "Humanoides R15-kompatibles Grundskelett fuer alle Spielerfiguren. Zusaetzliche Knochen: 6 fuer Umhang, 2 pro Gurtriemen, 4 fuer Vector-Gear-Seile.", tris_lod0: "0", tris_lod1: "0", tris_lod2: "0", varianten: "1", textur_slot: "-", prio: "Must", aufwand_pt: "5", status: "Offen"),
    (id: "A-002", kategorie: "Charakter", name: "Koerper maennlich schlank", beschreibung: "Low-Poly-Grundkoerper, kantige Silhouette, klare Schulterlinie fuer gute Lesbarkeit aus der Distanz.", tris_lod0: "1400", tris_lod1: "700", tris_lod2: "300", varianten: "1", textur_slot: "TEX-CHAR-01", prio: "Must", aufwand_pt: "3", status: "Offen"),
