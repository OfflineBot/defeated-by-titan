    (id: "A-005", kategorie: "Charakter", name: "Kopf-Basis", beschreibung: "Vier Kopfformen (kantig, rund, schmal, breit) als austauschbare Meshes.", tris_lod0: "400", tris_lod1: "200", tris_lod2: "80", varianten: "4", textur_slot: "TEX-CHAR-01", prio: "Must", aufwand_pt: "4", status: "Offen"),
