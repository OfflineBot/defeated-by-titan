    (id: "UI-039", name: "Schnellsuche", beschreibung: "Ein-Klick-Einstieg in eine passende Instanz mit Fortschrittsanzeige der Suche.", elemente: "Modusfilter, Schwierigkeitsfilter, Suchstatus, Abbrechen, geschaetzte Wartezeit", plattform: "PC", prio: "Must", aufwand_pt: "5", status: "Offen"),
