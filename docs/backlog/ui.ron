    (id: "UI-041", name: "Bereitschaftspruefung", beschreibung: "Bestaetigungsfenster vor dem Einsatzstart.", elemente: "Mitgliederliste mit Status, Countdown, Bereit/Nicht bereit, Einsatzuebersicht", plattform: "PC", prio: "Should", aufwand_pt: "3", status: "Offen"),
    (id: "UI-042", name: "Spielerliste im Einsatz", beschreibung: "Uebersicht aller Spieler in der laufenden Instanz.", elemente: "Name, Lebensleiste, Gas, Verletzungen, Beitragsanteil, Ping, Stummschaltung, Melden", plattform: "PC", prio: "Must", aufwand_pt: "5", status: "Offen"),
