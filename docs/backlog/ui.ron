    (id: "UI-014", name: "Inventar", beschreibung: "Gegenstandsverwaltung mit Filter und Auto-Verkauf-Regeln.", elemente: "Raster, Filter, Sortierung, Verkaufsregeln, Massenaktionen", plattform: "PC", prio: "Must", aufwand_pt: "8", status: "Offen"),
