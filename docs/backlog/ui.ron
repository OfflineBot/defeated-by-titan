eintraege: [
    (id: "UI-001", name: "Startbildschirm", beschreibung: "Erster Bildschirm nach dem Laden. Spielemblem, Neuigkeiten, Einstieg.", elemente: "Play, Neuigkeiten, Einstellungen, Sozial-Links", plattform: "PC", prio: "Must", aufwand_pt: "3", status: "Offen"),
    (id: "UI-002", name: "Charaktererstellung", beschreibung: "Aufbau der Spielfigur mit Vorschau in Echtzeit.", elemente: "Statur, Kopf, Frisur, Gesicht, Farben, Name", plattform: "PC", prio: "Must", aufwand_pt: "10", status: "Offen"),
    (id: "UI-003", name: "Profil-Slots", beschreibung: "Verwaltung mehrerer Charaktere.", elemente: "Slot-Liste, Erstellen, Loeschen, Vorschau", plattform: "PC", prio: "Should", aufwand_pt: "4", status: "Offen"),
    (id: "UI-004", name: "Haupt-HUD", beschreibung: "Kern-Overlay im Einsatz.", elemente: "Gas, Klingen, HP, Ladeleiste, Nachladezaehler, Verletzungen, Zielfortschritt, Minikarte", plattform: "PC", prio: "Must", aufwand_pt: "12", status: "Offen"),
    (id: "UI-005", name: "Fadenkreuz und Ankermarker", beschreibung: "Dynamische Zielanzeige plus die eingeblendeten Ankermarker im Sichtfeld. Kern der Traversal-Lesbarkeit: der Spieler muss jederzeit ohne Nachdenken wissen, wohin Q und E ihn bringen.", elemente: "Fadenkreuz-Zustaende, Ankermarker in 4 Zustaenden, Q/E-Tastensymbole, Reichweitenanzeige, Cortex-Erkennung, Dichtebegrenzung", plattform: "PC", prio: "Must", aufwand_pt: "9", status: "Offen"),
    (id: "UI-038", name: "Ankermarker-Einstellungen", beschreibung: "Konfiguration der Traversal-Hilfen. Getrennt von den allgemeinen Einstellungen, weil hier die Balance zwischen Zugaenglichkeit und Meisterschaft geregelt wird.", elemente: "Zielmodus (Frei/Assistiert/Snap), Fangwinkel-Regler, Marker-Deckkraft, maximale Markeranzahl, Vollabschaltung, Vorschaufenster", plattform: "PC", prio: "Must", aufwand_pt: "6", status: "Offen"),
    (id: "UI-006", name: "Einsatzkarte", beschreibung: "Missionsauswahl mit Map, Modus, Schwierigkeit und Modifikatoren.", elemente: "Kartenansicht, Modusfilter, Schwierigkeitswahl, Modifikatorliste, Belohnungsvorschau", plattform: "PC", prio: "Must", aufwand_pt: "12", status: "Offen"),
    (id: "UI-007", name: "Ausruestung", beschreibung: "Verwaltung von Vector Gear, Klingen und Lanzen.", elemente: "Upgrade-Budget, Statvorschau, Zielkonfliktanzeige", plattform: "PC", prio: "Must", aufwand_pt: "10", status: "Offen"),
    (id: "UI-008", name: "Faehigkeitenbaum", beschreibung: "Interaktiver Baum mit vier Aesten.", elemente: "Knoten, Verbindungen, exklusive Pfade, Respec-Button, Punktezaehler", plattform: "PC", prio: "Must", aufwand_pt: "14", status: "Offen"),
    (id: "UI-009", name: "Perk-Verwaltung", beschreibung: "Ausruesten und Vergleichen von Perks.", elemente: "Vier Slots, Perk-Inventar, Filter, Vergleichsansicht", plattform: "PC", prio: "Must", aufwand_pt: "8", status: "Offen"),
    (id: "UI-010", name: "Lineage-Halle", beschreibung: "Herkunftslinien, Ziehungen und Pity-Anzeige.", elemente: "Aktuelle Linie, Ziehung, Pity-Zaehler, Sammlungsuebersicht", plattform: "PC", prio: "Should", aufwand_pt: "8", status: "Offen"),
    (id: "UI-011", name: "Loadout-Verwaltung", beschreibung: "Speichern und Wechseln von Build-Profilen.", elemente: "Fuenf Slots, Benennung, Schnellwechsel", plattform: "PC", prio: "Must", aufwand_pt: "5", status: "Offen"),
    (id: "UI-012", name: "Build-Simulator", beschreibung: "Rechnerische Vorschau auf Kampfwerte.", elemente: "DPS, Time-to-Kill, Gasreichweite, Vergleich zweier Builds", plattform: "PC", prio: "Should", aufwand_pt: "10", status: "Offen"),
