// Source: gameplay/features.xlsx!07_UI-Screens (45 records from 47 rows)
entries: [
    (id: "UI-001", name: "Startbildschirm", description: "Erster Bildschirm nach dem Laden. Spielemblem, Neuigkeiten, Einstieg.", elements: "Play, Neuigkeiten, Einstellungen, Sozial-Links", platform: "PC", prio: "Must", effort_pd: "3", status: "Offen"),
    (id: "UI-002", name: "Charaktererstellung", description: "Aufbau der Spielfigur mit Vorschau in Echtzeit.", elements: "Statur, Kopf, Frisur, Gesicht, Farben, Name", platform: "PC", prio: "Must", effort_pd: "10", status: "Offen"),
    (id: "UI-003", name: "Profil-Slots", description: "Verwaltung mehrerer Charaktere.", elements: "Slot-Liste, Erstellen, Loeschen, Vorschau", platform: "PC", prio: "Should", effort_pd: "4", status: "Offen"),
    (id: "UI-004", name: "Haupt-HUD", description: "Kern-Overlay im Einsatz.", elements: "Gas, Klingen, HP, Ladeleiste, Nachladezaehler, Verletzungen, Zielfortschritt, Minikarte", platform: "PC", prio: "Must", effort_pd: "12", status: "Offen"),
    (id: "UI-005", name: "Fadenkreuz und Ankermarker", description: "Dynamische Zielanzeige plus die eingeblendeten Ankermarker im Sichtfeld. Kern der Traversal-Lesbarkeit: der Spieler muss jederzeit ohne Nachdenken wissen, wohin Q und E ihn bringen.", elements: "Fadenkreuz-Zustaende, Ankermarker in 4 Zustaenden, Q/E-Tastensymbole, Reichweitenanzeige, Cortex-Erkennung, Dichtebegrenzung", platform: "PC", prio: "Must", effort_pd: "9", status: "Offen"),
    (id: "UI-038", name: "Ankermarker-Einstellungen", description: "Konfiguration der Traversal-Hilfen. Getrennt von den allgemeinen Einstellungen, weil hier die Balance zwischen Zugaenglichkeit und Meisterschaft geregelt wird.", elements: "Zielmodus (Frei/Assistiert/Snap), Fangwinkel-Regler, Marker-Deckkraft, maximale Markeranzahl, Vollabschaltung, Vorschaufenster", platform: "PC", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "UI-006", name: "Einsatzkarte", description: "Missionsauswahl mit Map, Modus, Schwierigkeit und Modifikatoren.", elements: "Kartenansicht, Modusfilter, Schwierigkeitswahl, Modifikatorliste, Belohnungsvorschau", platform: "PC", prio: "Must", effort_pd: "12", status: "Offen"),
    (id: "UI-007", name: "Ausruestung", description: "Verwaltung von Vector Gear, Klingen und Lanzen.", elements: "Upgrade-Budget, Statvorschau, Zielkonfliktanzeige", platform: "PC", prio: "Must", effort_pd: "10", status: "Offen"),
    (id: "UI-008", name: "Faehigkeitenbaum", description: "Interaktiver Baum mit vier Aesten.", elements: "Knoten, Verbindungen, exklusive Pfade, Respec-Button, Punktezaehler", platform: "PC", prio: "Must", effort_pd: "14", status: "Offen"),
    (id: "UI-009", name: "Perk-Verwaltung", description: "Ausruesten und Vergleichen von Perks.", elements: "Vier Slots, Perk-Inventar, Filter, Vergleichsansicht", platform: "PC", prio: "Must", effort_pd: "8", status: "Offen"),
    (id: "UI-010", name: "Lineage-Halle", description: "Herkunftslinien, Ziehungen und Pity-Anzeige.", elements: "Aktuelle Linie, Ziehung, Pity-Zaehler, Sammlungsuebersicht", platform: "PC", prio: "Should", effort_pd: "8", status: "Offen"),
    (id: "UI-011", name: "Loadout-Verwaltung", description: "Speichern und Wechseln von Build-Profilen.", elements: "Fuenf Slots, Benennung, Schnellwechsel", platform: "PC", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "UI-012", name: "Build-Simulator", description: "Rechnerische Vorschau auf Kampfwerte.", elements: "DPS, Time-to-Kill, Gasreichweite, Vergleich zweier Builds", platform: "PC", prio: "Should", effort_pd: "10", status: "Offen"),
    (id: "UI-013", name: "Kompendium", description: "Vollstaendige Wissensdatenbank im Spiel.", elements: "Gegnerlexikon, Formeln, Drop-Raten, Pity-Uebersicht, Statwirkungen", platform: "PC", prio: "Should", effort_pd: "12", status: "Offen"),
    (id: "UI-014", name: "Inventar", description: "Gegenstandsverwaltung mit Filter und Auto-Verkauf-Regeln.", elements: "Raster, Filter, Sortierung, Verkaufsregeln, Massenaktionen", platform: "PC", prio: "Must", effort_pd: "8", status: "Offen"),
    (id: "UI-015", name: "Kosmetik", description: "Anpassung des Erscheinungsbilds.", elements: "Kategorien, 3D-Vorschau, Farbkanaele, Speichern als Set", platform: "PC", prio: "Should", effort_pd: "10", status: "Offen"),
    (id: "UI-016", name: "Shop", description: "Kaufbildschirm mit voller Vorschau.", elements: "Kategorien, 3D-Ansicht, Preis, Inhaltsdetails", platform: "PC", prio: "Should", effort_pd: "8", status: "Offen"),
    (id: "UI-017", name: "Saisonpass", description: "Zweispurige Belohnungsuebersicht.", elements: "Fortschrittsleiste, Stufen, Belohnungsvorschau, Wochenziele", platform: "PC", prio: "Could", effort_pd: "8", status: "Offen"),
    (id: "UI-018", name: "Auswertungsbildschirm", description: "Ergebnis nach Mission oder Raid.", elements: "Kills nach Typ, Genauigkeit, Ø Geschwindigkeit, Combo, Beitrag, Belohnungen, Weiter/Wiederholen", platform: "PC", prio: "Must", effort_pd: "8", status: "Offen"),
    (id: "UI-019", name: "Raid-Warteschlange", description: "Matchmaking-Oberflaeche.", elements: "Raid-Auswahl, Schwierigkeit, Gruppenstatus, Wartezeit", platform: "PC", prio: "Should", effort_pd: "6", status: "Offen"),
    (id: "UI-020", name: "Gruppenverwaltung", description: "Party-Bildung und -Steuerung.", elements: "Mitgliederliste, Einladung, Code, Bereitschaftsstatus", platform: "PC", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "UI-039", name: "Schnellsuche", description: "Ein-Klick-Einstieg in eine passende Instanz mit Fortschrittsanzeige der Suche.", elements: "Modusfilter, Schwierigkeitsfilter, Suchstatus, Abbrechen, geschaetzte Wartezeit", platform: "PC", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "UI-040", name: "Instanz-Browser", description: "Manuelle Auswahl laufender Einsaetze.", elements: "Liste mit Map, Modus, Schwierigkeit, Modifikatoren, Spielerzahl, Ping, Freundesmarkierung, Filter, Aktualisierung", platform: "PC", prio: "Should", effort_pd: "8", status: "Offen"),
    (id: "UI-041", name: "Bereitschaftspruefung", description: "Bestaetigungsfenster vor dem Einsatzstart.", elements: "Mitgliederliste mit Status, Countdown, Bereit/Nicht bereit, Einsatzuebersicht", platform: "PC", prio: "Should", effort_pd: "3", status: "Offen"),
    (id: "UI-042", name: "Spielerliste im Einsatz", description: "Uebersicht aller Spieler in der laufenden Instanz.", elements: "Name, Lebensleiste, Gas, Verletzungen, Beitragsanteil, Ping, Stummschaltung, Melden", platform: "PC", prio: "Must", effort_pd: "5", status: "Offen"),
    (id: "UI-043", name: "Kampfunfaehigkeit", description: "Anzeige im niedergestreckten Zustand und beim Wiederbeleben.", elements: "Timer, Position der Helfer, Wiederbelebungsfortschritt, Aufgeben", platform: "PC", prio: "Must", effort_pd: "4", status: "Offen"),
    (id: "UI-044", name: "Wiederverbindung", description: "Rueckkehr in eine laufende Instanz nach Verbindungsabbruch.", elements: "Statusmeldung, verbleibende Reservierungszeit, Erneut verbinden, Abbrechen", platform: "PC", prio: "Must", effort_pd: "3", status: "Offen"),
    (id: "UI-045", name: "Markierungs-Radialmenue", description: "Auswahl der Teammarkierung auf einer Taste.", elements: "Vier bis sechs Markierungsarten, Vorschau, Tastenbelegung", platform: "PC", prio: "Must", effort_pd: "4", status: "Offen"),
    (id: "UI-046", name: "Abstimmung", description: "Gruppenabstimmung ohne Spielunterbrechung.", elements: "Antragstext, Ja/Nein, Zaehler, Zeitlimit", platform: "PC", prio: "Should", effort_pd: "3", status: "Offen"),
    (id: "UI-021", name: "Regiments", description: "Gildenoberflaeche.", elements: "Mitglieder, Wochenziele, Rangliste, Emblem-Editor", platform: "PC", prio: "Could", effort_pd: "10", status: "Offen"),
    (id: "UI-022", name: "Bestenlisten", description: "Rangdarstellung mehrerer Kategorien.", elements: "Filter nach Map, Modus, Zeitraum, Eingabegeraet", platform: "PC", prio: "Should", effort_pd: "6", status: "Offen"),
    (id: "UI-023", name: "Handel", description: "Handelsoberflaeche mit Sicherheitsmechanik.", elements: "Beide Angebote, Steuer, Bestaetigungs-Countdown, Historie", platform: "PC", prio: "Could", effort_pd: "10", status: "Offen"),
    (id: "UI-024", name: "Erfolge", description: "Meilensteinuebersicht mit Fortschritt.", elements: "Kategorien, Fortschrittsleisten, Belohnungen, Titel", platform: "PC", prio: "Should", effort_pd: "6", status: "Offen"),
    (id: "UI-025", name: "Einstellungen", description: "Vollstaendige Konfiguration.", elements: "Grafik, Audio, Steuerung, Barrierefreiheit, Sprache", platform: "PC", prio: "Must", effort_pd: "10", status: "Offen"),
    (id: "UI-026", name: "Tastenbelegung", description: "Freie Zuweisung fuer Tastatur und Maus mit Konflikterkennung. Einziges unterstuetztes Eingabegeraet.", elements: "Aktionsliste, Presets (Standard/Linkshaender/Kompakt), Konfliktwarnung, Zuruecksetzen", platform: "PC", prio: "Must", effort_pd: "6", status: "Offen"),
    (id: "UI-028", name: "Tutorial-Overlay", description: "Kontextuelle Anleitungselemente.", elements: "Hinweisblasen, Hervorhebungen, Fortschrittsanzeige", platform: "PC", prio: "Must", effort_pd: "8", status: "Offen"),
    (id: "UI-029", name: "Medic-Station", description: "Verletzungsuebersicht und Heilung.", elements: "Verletzungsliste, Wirkung, Heilungskosten", platform: "PC", prio: "Should", effort_pd: "4", status: "Offen"),
    (id: "UI-030", name: "Ascension", description: "Zuruecksetzung und Talentwahl.", elements: "Voraussetzungen, Verlustuebersicht, Talentkarten, Bestaetigung", platform: "PC", prio: "Should", effort_pd: "7", status: "Offen"),
    (id: "UI-031", name: "Artefakt-Verwaltung", description: "Artefakte und Substat-Neuwuerfe.", elements: "Slots, Substats, Sperre, Kosten", platform: "PC", prio: "Could", effort_pd: "7", status: "Offen"),
    (id: "UI-032", name: "Vessel-Verwaltung", description: "Verwaltung der Verwandlungsformen.", elements: "Formauswahl, Faehigkeitenbaum, Fortschritt", platform: "PC", prio: "Should", effort_pd: "8", status: "Offen"),
    (id: "UI-033", name: "Ladebildschirm", description: "Uebergangsbildschirm mit Tipps.", elements: "Fortschritt, Tipp, Mapvorschau", platform: "PC", prio: "Should", effort_pd: "3", status: "Offen"),
    (id: "UI-034", name: "Pausenmenue", description: "Ingame-Menue ohne Spielunterbrechung fuer andere.", elements: "Fortsetzen, Einstellungen, Ziele, Verlassen", platform: "PC", prio: "Must", effort_pd: "4", status: "Offen"),
    (id: "UI-035", name: "Kill-Feed und Benachrichtigungen", description: "Laufende Ereignisanzeige im Einsatz.", elements: "Teamkills, Ziele, Warnungen, Drops", platform: "PC", prio: "Should", effort_pd: "5", status: "Offen"),
    (id: "UI-036", name: "Traversal-HUD", description: "Spezialoverlay fuer den Zeitrennmodus.", elements: "Timer, Checkpointzaehler, Bestzeit, Geistabstand", platform: "PC", prio: "Should", effort_pd: "5", status: "Offen"),
    (id: "UI-037", name: "Zuschauermodus", description: "Beobachtungsoberflaeche.", elements: "Spielerwechsel, Kameramodi, HUD-Umschaltung", platform: "PC", prio: "Could", effort_pd: "5", status: "Offen"),
]
