eintraege: [
    (id: "VFX-001", name: "Gasausstoss", beschreibung: "Weisser Dampfstrahl aus den Duesen des Vector Gear, Intensitaet skaliert mit Verbrauch. Kernfeedback fuer Geschwindigkeit.", technik: "ParticleEmitter + Beam", ausloeser: "Boost, Dash, Reel-In", prio: "Must", status: "Offen"),
    (id: "VFX-002", name: "Gas-Restwarnung", beschreibung: "Stotternder, ausduennender Ausstoss bei unter 15 Prozent Gas.", technik: "ParticleEmitter", ausloeser: "Gas niedrig", prio: "Must", status: "Offen"),
    (id: "VFX-003", name: "Seilvisualisierung", beschreibung: "Ankerseil als Beam mit scrollender Textur und leichtem Durchhang.", technik: "Beam", ausloeser: "Haken aktiv", prio: "Must", status: "Offen"),
    (id: "VFX-004", name: "Hakeneinschlag", beschreibung: "Materialabhaengiger Aufprall: Steinsplitter, Holzspaene, Blutdampf.", technik: "ParticleEmitter", ausloeser: "Haken trifft", prio: "Must", status: "Offen"),
    (id: "VFX-005", name: "Speedlines", beschreibung: "Radiale Streifen am Bildrand ab definierter Geschwindigkeit.", technik: "ScreenGui + Bildschirmeffekt", ausloeser: "Velocity-Schwelle", prio: "Must", status: "Offen"),
    (id: "VFX-006", name: "Geschwindigkeits-Vignette", beschreibung: "Randabdunklung und Chromatische Aberration bei Hoechsttempo. Abschaltbar.", technik: "PostEffect", ausloeser: "Velocity-Schwelle", prio: "Should", status: "Offen"),
    (id: "VFX-007", name: "Klingen-Trail", beschreibung: "Nachziehende Schneidspur, Farbe als Kosmetik-Slot.", technik: "Trail", ausloeser: "Klingenangriff", prio: "Must", status: "Offen"),
    (id: "VFX-008", name: "Cortex-Schnitt", beschreibung: "Dampf- und Blutschwaden aus der Schnittwunde, kein realistisches Blut.", technik: "ParticleEmitter", ausloeser: "Cortex-Treffer", prio: "Must", status: "Offen"),
    (id: "VFX-009", name: "Gliedmassen-Schnitt", beschreibung: "Kleinere Dampfwolke an Arm- oder Beinwunde plus abfallendes Mesh.", technik: "ParticleEmitter", ausloeser: "Gliedmassentreffer", prio: "Must", status: "Offen"),
    (id: "VFX-010", name: "Titan-Aufloesung", beschreibung: "Aufsteigende Dampfsaeule und schwindendes Mesh ueber 3 Sekunden.", technik: "ParticleEmitter + Transparenzkurve", ausloeser: "Titan-Tod", prio: "Must", status: "Offen"),
    (id: "VFX-011", name: "Cortex-Markierung", beschreibung: "Sanftes Pulsieren des Nackenbereichs, aus Distanz sichtbar.", technik: "Emissive + Pulskurve", ausloeser: "Titan aktiv", prio: "Must", status: "Offen"),
    (id: "VFX-012", name: "Kritischer Treffer", beschreibung: "Kurzer Lichtblitz und zusaetzliche Funken.", technik: "ParticleEmitter", ausloeser: "Crit", prio: "Should", status: "Offen"),
    (id: "VFX-013", name: "Hit-Stop-Blitz", beschreibung: "Einzelframe-Aufhellung beim Nape-Kill.", technik: "PostEffect", ausloeser: "Cortex-Kill", prio: "Must", status: "Offen"),
    (id: "VFX-014", name: "Lanzeneinschlag", beschreibung: "Haftmarkierung mit blinkender Zuendanzeige.", technik: "ParticleEmitter + Highlight", ausloeser: "Lanze haftet", prio: "Should", status: "Offen"),
    (id: "VFX-015", name: "Lanzenexplosion", beschreibung: "Kugelfoermige Druckwelle mit Rauchring und Funkenwurf.", technik: "ParticleEmitter + Shockwave-Mesh", ausloeser: "Detonation", prio: "Should", status: "Offen"),
    (id: "VFX-016", name: "Aufprallstaub", beschreibung: "Bodenstaub bei harter Landung, materialabhaengig.", technik: "ParticleEmitter", ausloeser: "Harte Landung", prio: "Should", status: "Offen"),
    (id: "VFX-017", name: "Titanenschrittstaub", beschreibung: "Staubwolke unter Titanenfuessen, Groesse skaliert mit Titan.", technik: "ParticleEmitter", ausloeser: "Titan-Schritt", prio: "Should", status: "Offen"),
    (id: "VFX-018", name: "Bodenerschuetterung", beschreibung: "Sichtbare Ringwelle bei Stomp und schweren Schritten.", technik: "Mesh-Skalierung", ausloeser: "Stomp", prio: "Should", status: "Offen"),
    (id: "VFX-019", name: "Verletzungsvignette", beschreibung: "Rote Randverfaerbung, Intensitaet nach Verletzungsstufe.", technik: "PostEffect", ausloeser: "Verletzung aktiv", prio: "Should", status: "Offen"),
    (id: "VFX-020", name: "Heilungseffekt", beschreibung: "Gruenlicher Aufwaertsstrom bei Verbandsnutzung.", technik: "ParticleEmitter", ausloeser: "Heilung", prio: "Should", status: "Offen"),
    (id: "VFX-021", name: "Vessel-Transformation", beschreibung: "Blitzentladung und massive Dampfsaeule.", technik: "ParticleEmitter + Beam + Licht", ausloeser: "Verwandlung", prio: "Should", status: "Offen"),
    (id: "VFX-022", name: "Vessel-Dampfaura", beschreibung: "Permanenter Dampf entlang des Koerpers der Verwandlungsform.", technik: "ParticleEmitter", ausloeser: "Vessel aktiv", prio: "Should", status: "Offen"),
    (id: "VFX-023", name: "Raserei-Aura", beschreibung: "Rot pulsierende Aura fuer Boss- und Spieler-Raserei-Zustaende.", technik: "ParticleEmitter + Emissive", ausloeser: "Raserei", prio: "Should", status: "Offen"),
    (id: "VFX-024", name: "Panzerbruch", beschreibung: "Absplitternde Plattenstuecke mit Funkenwurf.", technik: "ParticleEmitter + Debris", ausloeser: "Bulwark-Panzerbruch", prio: "Should", status: "Offen"),
    (id: "VFX-025", name: "Kanonenschuss", beschreibung: "Muendungsfeuer, Rauchwolke und Rueckstoss.", technik: "ParticleEmitter", ausloeser: "Kanone feuert", prio: "Should", status: "Offen"),
    (id: "VFX-026", name: "Nachschubstation aktiv", beschreibung: "Zischender Gasstrom und Signallicht waehrend des Nachladens.", technik: "ParticleEmitter + Licht", ausloeser: "Nachladen", prio: "Must", status: "Offen"),
    (id: "VFX-027", name: "Nachschubstation leer", beschreibung: "Ausgehendes Licht und Rauchfahne bei erschoepfter Station.", technik: "ParticleEmitter", ausloeser: "Station leer", prio: "Should", status: "Offen"),
    (id: "VFX-028", name: "Beutetruhe", beschreibung: "Lichtsaeule und aufsteigende Partikel, Farbe nach Seltenheit.", technik: "ParticleEmitter + Beam", ausloeser: "Truhe offen", prio: "Should", status: "Offen"),
    (id: "VFX-029", name: "Levelaufstieg", beschreibung: "Aufsteigender Lichtring um den Spieler.", technik: "ParticleEmitter", ausloeser: "Levelup", prio: "Should", status: "Offen"),
    (id: "VFX-030", name: "Checkpoint", beschreibung: "Pulsierender Ring im Traversal-Modus, Farbwechsel bei Durchflug.", technik: "Mesh + Emissive", ausloeser: "Checkpoint", prio: "Should", status: "Offen"),
    (id: "VFX-031", name: "Umgebungspartikel Stadt", beschreibung: "Schwebender Staub und Asche in Lichtstrahlen.", technik: "ParticleEmitter", ausloeser: "Ambient", prio: "Could", status: "Offen"),
    (id: "VFX-032", name: "Umgebungspartikel Wald", beschreibung: "Fallende Blaetter und Pollen.", technik: "ParticleEmitter", ausloeser: "Ambient", prio: "Could", status: "Offen"),
    (id: "VFX-033", name: "Regen", beschreibung: "Regenpartikel mit Bodenaufprall, reduziert Ankerhaftung im Modifikator.", technik: "ParticleEmitter", ausloeser: "Regen-Modifikator", prio: "Should", status: "Offen"),
    (id: "VFX-034", name: "Nebel", beschreibung: "Volumetrisch wirkender Bodennebel, reduziert Sichtweite.", technik: "Atmosphere + ParticleEmitter", ausloeser: "Nebel-Modifikator", prio: "Should", status: "Offen"),
    (id: "VFX-035", name: "Markierungs-Ping", beschreibung: "Schwebendes Symbol mit Aufwaertsbewegung und Verfall.", technik: "BillboardGui", ausloeser: "Ping gesetzt", prio: "Should", status: "Offen"),
    (id: "VFX-036", name: "Ankermarker", beschreibung: "Schwebende Symbole an allen gueltigen Ankerpunkten im Sichtfeld. Vier Zustaende ueber Form UND Farbe: Kandidat (kleiner Ring), bestes Ziel links (Ring mit Q-Symbol), bestes Ziel rechts (Ring mit E-Symbol), verankert (gefuellt). Deckkraft faellt mit Distanz.", technik: "BillboardGui + Atlas-Sprites", ausloeser: "Ankerpunkt in Reichweite", prio: "Must", status: "Offen"),
    (id: "VFX-037", name: "Snap-Zielwechsel", beschreibung: "Kurzer Aufpuls am neu gewaehlten besten Ankerpunkt, wenn die Bewertungsfunktion das Ziel wechselt. Macht die Auswahl des Systems nachvollziehbar.", technik: "BillboardGui-Skalierungskurve", ausloeser: "Bestes Ziel wechselt", prio: "Must", status: "Offen"),
    (id: "VFX-038", name: "Snap-Bestaetigung", beschreibung: "Aufleuchtender Ring am Ankerpunkt im Moment des Verankerns, gefolgt vom Seil-Beam.", technik: "BillboardGui + Beam", ausloeser: "Haken verankert", prio: "Should", status: "Offen"),
    (id: "VFX-039", name: "Fehlversuch-Rueckzug", beschreibung: "Ins Leere gefeuerter Haken mit sichtbarem Seilrueckzug statt stillem Nichtereignis.", technik: "Beam + Trail", ausloeser: "Kein gueltiges Ziel", prio: "Must", status: "Offen"),
]
