entries: [
    (id: "VFX-001", name: "Gasausstoss", description: "Weisser Dampfstrahl aus den Duesen des Vector Gear, Intensitaet skaliert mit Verbrauch. Kernfeedback fuer Geschwindigkeit.", technique: "ParticleEmitter + Beam", trigger: "Boost, Dash, Reel-In", prio: "Must", status: "Offen"),
    (id: "VFX-002", name: "Gas-Restwarnung", description: "Stotternder, ausduennender Ausstoss bei unter 15 Prozent Gas.", technique: "ParticleEmitter", trigger: "Gas niedrig", prio: "Must", status: "Offen"),
    (id: "VFX-003", name: "Seilvisualisierung", description: "Ankerseil als Beam mit scrollender Textur und leichtem Durchhang.", technique: "Beam", trigger: "Haken aktiv", prio: "Must", status: "Offen"),
    (id: "VFX-004", name: "Hakeneinschlag", description: "Materialabhaengiger Aufprall: Steinsplitter, Holzspaene, Blutdampf.", technique: "ParticleEmitter", trigger: "Haken trifft", prio: "Must", status: "Offen"),
    (id: "VFX-005", name: "Speedlines", description: "Radiale Streifen am Bildrand ab definierter Geschwindigkeit.", technique: "ScreenGui + Bildschirmeffekt", trigger: "Velocity-Schwelle", prio: "Must", status: "Offen"),
    (id: "VFX-006", name: "Geschwindigkeits-Vignette", description: "Randabdunklung und Chromatische Aberration bei Hoechsttempo. Abschaltbar.", technique: "PostEffect", trigger: "Velocity-Schwelle", prio: "Should", status: "Offen"),
    (id: "VFX-007", name: "Klingen-Trail", description: "Nachziehende Schneidspur, Farbe als Kosmetik-Slot.", technique: "Trail", trigger: "Klingenangriff", prio: "Must", status: "Offen"),
    (id: "VFX-008", name: "Cortex-Schnitt", description: "Dampf- und Blutschwaden aus der Schnittwunde, kein realistisches Blut.", technique: "ParticleEmitter", trigger: "Cortex-Treffer", prio: "Must", status: "Offen"),
    (id: "VFX-009", name: "Gliedmassen-Schnitt", description: "Kleinere Dampfwolke an Arm- oder Beinwunde plus abfallendes Mesh.", technique: "ParticleEmitter", trigger: "Gliedmassentreffer", prio: "Must", status: "Offen"),
    (id: "VFX-010", name: "Titan-Aufloesung", description: "Aufsteigende Dampfsaeule und schwindendes Mesh ueber 3 Sekunden.", technique: "ParticleEmitter + Transparenzkurve", trigger: "Titan-Tod", prio: "Must", status: "Offen"),
    (id: "VFX-011", name: "Cortex-Markierung", description: "Sanftes Pulsieren des Nackenbereichs, aus Distanz sichtbar.", technique: "Emissive + Pulskurve", trigger: "Titan aktiv", prio: "Must", status: "Offen"),
    (id: "VFX-012", name: "Kritischer Treffer", description: "Kurzer Lichtblitz und zusaetzliche Funken.", technique: "ParticleEmitter", trigger: "Crit", prio: "Should", status: "Offen"),
    (id: "VFX-013", name: "Hit-Stop-Blitz", description: "Einzelframe-Aufhellung beim Nape-Kill.", technique: "PostEffect", trigger: "Cortex-Kill", prio: "Must", status: "Offen"),
    (id: "VFX-014", name: "Lanzeneinschlag", description: "Haftmarkierung mit blinkender Zuendanzeige.", technique: "ParticleEmitter + Highlight", trigger: "Lanze haftet", prio: "Should", status: "Offen"),
    (id: "VFX-015", name: "Lanzenexplosion", description: "Kugelfoermige Druckwelle mit Rauchring und Funkenwurf.", technique: "ParticleEmitter + Shockwave-Mesh", trigger: "Detonation", prio: "Should", status: "Offen"),
    (id: "VFX-016", name: "Aufprallstaub", description: "Bodenstaub bei harter Landung, materialabhaengig.", technique: "ParticleEmitter", trigger: "Harte Landung", prio: "Should", status: "Offen"),
    (id: "VFX-017", name: "Titanenschrittstaub", description: "Staubwolke unter Titanenfuessen, Groesse skaliert mit Titan.", technique: "ParticleEmitter", trigger: "Titan-Schritt", prio: "Should", status: "Offen"),
    (id: "VFX-018", name: "Bodenerschuetterung", description: "Sichtbare Ringwelle bei Stomp und schweren Schritten.", technique: "Mesh-Skalierung", trigger: "Stomp", prio: "Should", status: "Offen"),
    (id: "VFX-019", name: "Verletzungsvignette", description: "Rote Randverfaerbung, Intensitaet nach Verletzungsstufe.", technique: "PostEffect", trigger: "Verletzung aktiv", prio: "Should", status: "Offen"),
    (id: "VFX-020", name: "Heilungseffekt", description: "Gruenlicher Aufwaertsstrom bei Verbandsnutzung.", technique: "ParticleEmitter", trigger: "Heilung", prio: "Should", status: "Offen"),
    (id: "VFX-021", name: "Vessel-Transformation", description: "Blitzentladung und massive Dampfsaeule.", technique: "ParticleEmitter + Beam + Licht", trigger: "Verwandlung", prio: "Should", status: "Offen"),
    (id: "VFX-022", name: "Vessel-Dampfaura", description: "Permanenter Dampf entlang des Koerpers der Verwandlungsform.", technique: "ParticleEmitter", trigger: "Vessel aktiv", prio: "Should", status: "Offen"),
    (id: "VFX-023", name: "Raserei-Aura", description: "Rot pulsierende Aura fuer Boss- und Spieler-Raserei-Zustaende.", technique: "ParticleEmitter + Emissive", trigger: "Raserei", prio: "Should", status: "Offen"),
    (id: "VFX-024", name: "Panzerbruch", description: "Absplitternde Plattenstuecke mit Funkenwurf.", technique: "ParticleEmitter + Debris", trigger: "Bulwark-Panzerbruch", prio: "Should", status: "Offen"),
    (id: "VFX-025", name: "Kanonenschuss", description: "Muendungsfeuer, Rauchwolke und Rueckstoss.", technique: "ParticleEmitter", trigger: "Kanone feuert", prio: "Should", status: "Offen"),
    (id: "VFX-026", name: "Nachschubstation aktiv", description: "Zischender Gasstrom und Signallicht waehrend des Nachladens.", technique: "ParticleEmitter + Licht", trigger: "Nachladen", prio: "Must", status: "Offen"),
    (id: "VFX-027", name: "Nachschubstation leer", description: "Ausgehendes Licht und Rauchfahne bei erschoepfter Station.", technique: "ParticleEmitter", trigger: "Station leer", prio: "Should", status: "Offen"),
    (id: "VFX-028", name: "Beutetruhe", description: "Lichtsaeule und aufsteigende Partikel, Farbe nach Seltenheit.", technique: "ParticleEmitter + Beam", trigger: "Truhe offen", prio: "Should", status: "Offen"),
    (id: "VFX-029", name: "Levelaufstieg", description: "Aufsteigender Lichtring um den Spieler.", technique: "ParticleEmitter", trigger: "Levelup", prio: "Should", status: "Offen"),
    (id: "VFX-030", name: "Checkpoint", description: "Pulsierender Ring im Traversal-Modus, Farbwechsel bei Durchflug.", technique: "Mesh + Emissive", trigger: "Checkpoint", prio: "Should", status: "Offen"),
    (id: "VFX-031", name: "Umgebungspartikel Stadt", description: "Schwebender Staub und Asche in Lichtstrahlen.", technique: "ParticleEmitter", trigger: "Ambient", prio: "Could", status: "Offen"),
    (id: "VFX-032", name: "Umgebungspartikel Wald", description: "Fallende Blaetter und Pollen.", technique: "ParticleEmitter", trigger: "Ambient", prio: "Could", status: "Offen"),
    (id: "VFX-033", name: "Regen", description: "Regenpartikel mit Bodenaufprall, reduziert Ankerhaftung im Modifikator.", technique: "ParticleEmitter", trigger: "Regen-Modifikator", prio: "Should", status: "Offen"),
    (id: "VFX-034", name: "Nebel", description: "Volumetrisch wirkender Bodennebel, reduziert Sichtweite.", technique: "Atmosphere + ParticleEmitter", trigger: "Nebel-Modifikator", prio: "Should", status: "Offen"),
    (id: "VFX-035", name: "Markierungs-Ping", description: "Schwebendes Symbol mit Aufwaertsbewegung und Verfall.", technique: "BillboardGui", trigger: "Ping gesetzt", prio: "Should", status: "Offen"),
    (id: "VFX-036", name: "Ankermarker", description: "Schwebende Symbole an allen gueltigen Ankerpunkten im Sichtfeld. Vier Zustaende ueber Form UND Farbe: Kandidat (kleiner Ring), bestes Ziel links (Ring mit Q-Symbol), bestes Ziel rechts (Ring mit E-Symbol), verankert (gefuellt). Deckkraft faellt mit Distanz.", technique: "BillboardGui + Atlas-Sprites", trigger: "Ankerpunkt in Reichweite", prio: "Must", status: "Offen"),
    (id: "VFX-037", name: "Snap-Zielwechsel", description: "Kurzer Aufpuls am neu gewaehlten besten Ankerpunkt, wenn die Bewertungsfunktion das Ziel wechselt. Macht die Auswahl des Systems nachvollziehbar.", technique: "BillboardGui-Skalierungskurve", trigger: "Bestes Ziel wechselt", prio: "Must", status: "Offen"),
    (id: "VFX-038", name: "Snap-Bestaetigung", description: "Aufleuchtender Ring am Ankerpunkt im Moment des Verankerns, gefolgt vom Seil-Beam.", technique: "BillboardGui + Beam", trigger: "Haken verankert", prio: "Should", status: "Offen"),
    (id: "VFX-039", name: "Fehlversuch-Rueckzug", description: "Ins Leere gefeuerter Haken mit sichtbarem Seilrueckzug statt stillem Nichtereignis.", technique: "Beam + Trail", trigger: "Kein gueltiges Ziel", prio: "Must", status: "Offen"),
]
